<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EggIncognito.Tooling</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pre-1.0: pin exactly. 0.9.x is a DI/ASP.NET-Core rewrite (namespace Unobtanium.Web.Proxy,
         hosted-service based, selective decrypt via ProxyServerEvents.ShouldDecryptNewConnection).
         Pulls in the .Events sub-package transitively. Requires the ASP.NET Core shared framework. -->
    <PackageReference Include="Unobtanium.Web.Proxy" Version="[0.9.1-beta.2]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIncognito.Core\EggIncognito.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure helpers carved out for unit tests (LanForwarder.CleanConnectHead / DeviceIp /
         IndexOfDoubleCrlf) are internal; expose them to the test assembly only. -->
    <InternalsVisibleTo Include="EggIncognito.Tests" />
  </ItemGroup>
</Project>
