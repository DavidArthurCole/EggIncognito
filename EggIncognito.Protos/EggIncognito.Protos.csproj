<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>EggIncognito.Protos</PackageId>
    <Description>EggIncognito's versioned ei.proto snapshot: the exact proto this EggIncognito release compiles against, not necessarily the latest game proto. Ships the .proto file only, no generated code; consumers run their own codegen against the $(EggIncProtoPath) MSBuild property exposed by the packaged props.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\EggIncognito.Core\Proto\ei.proto" Pack="true" PackagePath="proto\" />
    <None Include="build\EggIncognito.Protos.props" Pack="true" PackagePath="build\" />
  </ItemGroup>
</Project>
