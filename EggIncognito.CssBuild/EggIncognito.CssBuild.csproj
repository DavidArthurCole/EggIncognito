<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Build-time CSS compiler for EggIncognito: scans .razor/.html/.js/.cs content for utility/component class tokens and compiles wwwroot/styles.css via MonorailCss + EggIdentity.Styles.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonorailCss" />
    <PackageReference Include="EggIdentity.Styles" />
  </ItemGroup>

</Project>
