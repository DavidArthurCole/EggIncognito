@rendermode @(RenderMode.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject DataWorkbenchState State
@inject ILogger<DataWorkbenchModal> Logger
@using EggIncognito.Components.Shared.Workbench
@using EggIncognito.Core
@using EggIncognito.Services.Data
@implements IAsyncDisposable

<WorkbenchModal Open="_open" Title="Data" TitleId="dataWorkbenchTitle" CardClass="ds-card"
                Notice="_notice" OnClose="CloseAsync">
    <Rail>
        <WorkbenchRail>
            <WorkbenchLoad T="SourceRow" Items="@_sources" EmptyText="No data sources on this instance."
                           Context="sources">
                @foreach (var group in Groups(sources)) {
                    <WorkbenchSection Label="@GroupLabel(group)">
                        @foreach (var root in RootsOf(sources, group)) {
                            <WorkbenchEntry @key="root.Url"
                                            Selected="@(State.Sub is null && State.Group == root.Group && State.Id == root.Id)"
                                            Title="@root.Url" OnClick="@(_ => Select(root, null))">
                                <Name>@root.DisplayName</Name>
                                <MetaLine>@root.Id</MetaLine>
                            </WorkbenchEntry>
                            @foreach (var child in ChildrenOf(root)) {
                                <WorkbenchEntry @key="child.Url" Class="ds-sub"
                                                Selected="@(State.Sub == child.Id && State.Group == root.Group && State.Id == root.Id)"
                                                Title="@child.Url" OnClick="@(_ => Select(root, child))">
                                    <Name>@child.DisplayName</Name>
                                    <MetaLine>@child.Id</MetaLine>
                                </WorkbenchEntry>
                            }
                        }
                    </WorkbenchSection>
                }
            </WorkbenchLoad>
        </WorkbenchRail>
    </Rail>
    <ChildContent>
        @if (Current is { } s) {
            <div class="ds-pane">
                <header class="ds-head">
                    <div class="ds-head-row">
                        <h4 class="ds-title">@s.DisplayName</h4>
                        @if (!s.AcceptsName) {
                            <a class="btn-mini no-underline" href="@s.Url" download="@DownloadName(s)"
                               target="_blank" rel="noopener">
                                Download
                            </a>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(s.Description)) {
                        <p class="ds-desc">@s.Description</p>
                    }
                    <dl class="ds-facts">
                        <div class="ds-kv">
                            <dt class="ds-kv-k">Group</dt>
                            <dd class="ds-kv-v">@GroupLabel(s.Group)</dd>
                        </div>
                        <div class="ds-kv">
                            <dt class="ds-kv-k">Provenance</dt>
                            <dd class="ds-kv-v">@ProvenanceLabel(s.Provenance)</dd>
                        </div>
                        <div class="ds-kv">
                            <dt class="ds-kv-k">Access</dt>
                            <dd class="ds-kv-v">@AccessLabel(s.Access)</dd>
                        </div>
                        @if (s.Bytes is { } bytes) {
                            <div class="ds-kv">
                                <dt class="ds-kv-k">Size</dt>
                                <dd class="ds-kv-v font-mono">@ByteFormat.Compact(bytes)</dd>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(s.Feed)) {
                            <div class="ds-kv">
                                <dt class="ds-kv-k">Feed</dt>
                                <dd class="ds-kv-v font-mono">@s.Feed</dd>
                            </div>
                        }
                        @if (s.Meta?.BinaryVersion is { Length: > 0 } binaryVersion) {
                            <div class="ds-kv">
                                <dt class="ds-kv-k">Binary</dt>
                                <dd class="ds-kv-v">
                                    <VersionLine App="@binaryVersion"/>
                                </dd>
                            </div>
                        }
                        <div class="ds-kv ds-kv-wide">
                            <dt class="ds-kv-k">Route</dt>
                            <dd class="ds-kv-v font-mono">
                                <a class="ds-route" href="@s.Url" target="_blank" rel="noopener">@s.Url</a>
                            </dd>
                        </div>
                    </dl>
                    <div class="ds-curl">
                        <code class="ds-curl-text">@CurlLine(s)</code>
                        <CopyButton GetText="@(() => CurlLine(s))" ButtonClass="btn-mini" IconClass="icon-sm"
                                    Label="Copy" CopiedLabel="Copied"/>
                    </div>
                </header>
                <div class="ds-body">
                    @if (s.AcceptsName) {
                        var name = State.NameFor(State.Key);
                        <label class="sub-field ds-field">
                            <span class="sub-field-label">Asset name</span>
                            <input class="field-input" value="@name" @oninput="OnNameInput"/>
                        </label>
                        @if (name.Length > 0) {
                            <img class="ds-asset" src="@AssetUrl(s, name)" alt="@name"/>
                            <div>
                                <a class="btn-mini no-underline" href="@AssetUrl(s, name)"
                                   download="@($"{name}.png")" target="_blank" rel="noopener">
                                    Download
                                </a>
                            </div>
                        } else {
                            <p class="ds-note">
                                This source serves one asset per name. Type a name, for example
                                <span class="font-mono">afx_ornate_gusset_2</span>.
                            </p>
                        }
                    } else if (State.Payloads.GetValueOrDefault(s.Url) is not { } entry) {
                        <p class="ds-note">Loading...</p>
                    } else if (entry.Status == 401) {
                        <div class="ds-gate">
                            <p class="ds-note">
                                This dataset is served to accounts and API keys only. Log in to read it here,
                                or mint an API key and call the route above.
                            </p>
                            <LoginButton Label="Log in" Placement="LoginMenuPlacement.Right"/>
                        </div>
                    } else if (entry.Status is < 200 or > 299) {
                        <StatusNote Severity="StatusNote.Kind.Error">
                            @(entry.Status == 0 ? "The request failed." : $"HTTP {entry.Status}")
                        </StatusNote>
                    } else {
                        <CodeFormats Key="@s.Url" ShowLabel="false" Json="@entry.Text" View="State.View"
                                     Choice="State.Formats" MaxHeight="52vh"/>
                    }
                </div>
            </div>
        } else {
            <div class="ds-body">
                <p class="ds-note">Select a dataset.</p>
            </div>
        }
    </ChildContent>
</WorkbenchModal>

@code {
    bool _open;
    bool _hashWired;
    WorkbenchNotice? _notice;

    IJSObjectReference? _nav;
    IJSObjectReference? _navHandle;
    DotNetObjectReference<DataWorkbenchModal>? _selfRef;

    List<SourceRow>? _sources;
    string _origin = "";

    SourceRow? Current {
        get {
            var root = _sources?.FirstOrDefault(s => s.Group == State.Group && s.Id == State.Id);
            if (root is null) return null;
            if (State.Sub is not { Length: > 0 } sub) return root;
            return root.Children?.FirstOrDefault(c => c.Id == sub);
        }
    }

    static IEnumerable<string> Groups(IReadOnlyCollection<SourceRow> sources) {
        return sources.Select(s => s.Group).Distinct(StringComparer.Ordinal);
    }

    static List<SourceRow> RootsOf(IReadOnlyCollection<SourceRow> sources, string group) {
        return [.. sources.Where(s => string.Equals(s.Group, group, StringComparison.Ordinal))];
    }

    static IReadOnlyList<SourceRow> ChildrenOf(SourceRow root) {
        return root.Children ?? [];
    }

    static string GroupLabel(string key) {
        return key switch {
            "periodical" => "Periodical",
            "gamedata" => "Game data",
            "asset" => "Assets",
            _ => TitleCase(key)
        };
    }

    static string TitleCase(string raw) {
        var words = raw.Split([' ', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return words.Length == 0
            ? raw
            : string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant()));
    }

    static string ProvenanceLabel(string raw) {
        return raw switch {
            "WireFixture" => "wire fixture",
            "DerivedExtract" => "derived extract",
            "Database" => "database document",
            "Asset" => "game asset",
            _ => raw
        };
    }

    static string AccessLabel(string raw) {
        return string.Equals(raw, "Authenticated", StringComparison.Ordinal) ? "account or API key" : "public";
    }

    string CurlLine(SourceRow s) {
        return $"curl -H \"X-Api-Key: <your-key>\" {_origin}{s.Url}";
    }

    static string DownloadName(SourceRow s) {
        return $"{s.Id}.json";
    }

    static string AssetUrl(SourceRow s, string name) {
        return $"{s.Url}?name={Uri.EscapeDataString(name)}";
    }

    public async Task Open(string? group = null, string? id = null) {
        _open = true;
        if (group is { Length: > 0 } g && id is { Length: > 0 } i) State.Select(g, i, null);
        await LoadIndex();
        EnsureSelection();
        await EnsureLoaded();
        await WriteHash(true);
        StateHasChanged();
    }

    async Task CloseAsync() {
        _open = false;
        await WriteHash(true, true);
        StateHasChanged();
    }

    protected override void OnInitialized() {
        base.OnInitialized();
        _origin = SelfBaseAddress;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        try {
            _nav = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/hashnav.js"));
            _selfRef = DotNetObjectReference.Create(this);
            _navHandle = await _nav.InvokeAsync<IJSObjectReference>("listen", _selfRef);
            _hashWired = true;
            var hash = await _nav.InvokeAsync<string>("read");
            await ApplyHash(hash);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "hash navigation could not be wired");
        }
    }

    [JSInvokable]
    public async Task OnHashChanged(string hash) {
        await ApplyHash(hash);
        StateHasChanged();
    }

    async Task ApplyHash(string hash) {
        if (!State.ApplyHash(hash)) {
            if (_open) {
                _open = false;
                StateHasChanged();
            }

            return;
        }

        _open = true;
        await LoadIndex();
        EnsureSelection();
        await EnsureLoaded();
        StateHasChanged();
    }

    async Task WriteHash(bool push = false, bool clear = false) {
        if (!_hashWired || _nav is null) return;
        var hash = clear ? "" : State.Hash() ?? "";
        await _nav.InvokeVoidAsync(push ? "push" : "write", hash);
    }

    async Task LoadIndex() {
        if (_sources is not null) return;
        var index = await Client().OneAsync<DataIndex>("/api/v1/data", Logger);
        _sources = index?.Sources ?? [];
        if (_sources.Count == 0) _notice = new WorkbenchNotice("The source catalog could not be read.", StatusNote.Kind.Error);
    }

    void EnsureSelection() {
        if (Current is not null) return;
        var first = _sources?.FirstOrDefault();
        if (first is null) return;
        State.Select(first.Group, first.Id, null);
    }

    async Task Select(SourceRow root, SourceRow? child) {
        State.Select(root.Group, root.Id, child?.Id);
        _notice = null;
        await EnsureLoaded();
        await WriteHash();
    }

    async Task EnsureLoaded() {
        if (Current is not { } s || s.AcceptsName) return;
        if (State.Payloads.ContainsKey(s.Url)) return;
        State.Payloads[s.Url] = await FetchAsync(s.Url);
    }

    async Task<DataPayloadEntry> FetchAsync(string url) {
        try {
            var res = await Client().GetAsync(url);
            var body = await res.Content.ReadAsStringAsync();
            return new DataPayloadEntry((int)res.StatusCode, body);
        }
        catch (Exception ex) {
            Logger.LogDebug(ex, "data source {Url} could not be read", url);
            return new DataPayloadEntry(0, "");
        }
    }

    void OnNameInput(ChangeEventArgs e) {
        State.Names[State.Key] = e.Value?.ToString() ?? "";
    }

    public async ValueTask DisposeAsync() {
        try {
            if (_navHandle is not null) {
                await _navHandle.InvokeVoidAsync("dispose");
                await _navHandle.DisposeAsync();
            }

            if (_nav is not null) await _nav.DisposeAsync();
        }
        catch (JSDisconnectedException) {
        }
        catch (ObjectDisposedException) {
        }

        _selfRef?.Dispose();
    }

    public sealed record DataIndex(int Count, List<SourceRow> Sources);

    public sealed record SourceRow(
        string Id,
        string Group,
        string Url,
        string DisplayName,
        string? Description,
        string Provenance,
        string Access,
        string? Feed,
        bool AcceptsName,
        long? Bytes,
        MetaRow? Meta,
        List<SourceRow>? Children);

    public sealed record MetaRow(string? BinaryVersion);

}
