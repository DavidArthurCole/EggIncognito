@* Capture notifications as a collapsible side-column widget (was the nav notification popover). Sits
   between the controls and the stats. Collapsed by default; the header shows the unread badge and toggles
   open. Opening marks notices read. *@
@using EggIncognito.Capture
@using EggIncognito.Components.Shared

<section class="panel capture-notices">
  <div class="flex items-center justify-between cursor-pointer select-none" @onclick="ToggleOpen">
    <h3 class="text-sm font-semibold m-0 flex items-center gap-2">
      Notifications
      @if (Unread > 0)
      {
        <span class="notif-badge-inline">@(Unread > 99 ? "99+" : Unread.ToString())</span>
      }
    </h3>
    <div class="flex items-center gap-2">
      @if (Notices.Count > 0)
      {
        <button type="button" class="btn-mini" @onclick:stopPropagation="true" @onclick="ClearAllNotices">Clear all</button>
      }
      <Icon Name="chevronDown" Class="@($"icon-sm transition-transform {(_open ? "rotate-180" : "")}")" />
    </div>
  </div>

  @if (_open)
  {
    <div class="notif-list mt-2">
      @foreach (var n in Notices)
      {
        <div class="notif-item notif-@n.Severity">
          <div class="notif-body">
            <div class="notif-msg">@n.Message</div>
            @if (!string.IsNullOrEmpty(n.Timestamp))
            {
              <div class="notif-time">@n.Timestamp</div>
            }
          </div>
          <button class="notif-dismiss" title="Dismiss" aria-label="Dismiss notification"
                  @onclick="@(() => DismissNotice(n.Id))"><Icon Name="x" Class="icon-sm" /></button>
        </div>
      }
      @if (Notices.Count == 0)
      {
        <div class="notif-empty">No notifications.</div>
      }
    </div>
  }
</section>

@code {
    [Parameter] public IReadOnlyList<NoticeItem> Notices { get; set; } = [];
    [Parameter] public int Unread { get; set; }
    [Parameter] public EventCallback<int> OnDismissNotice { get; set; }
    [Parameter] public EventCallback OnClearNotices { get; set; }
    [Parameter] public EventCallback OnNoticesRead { get; set; }

    bool _open;

    async Task ToggleOpen()
    {
        _open = !_open;
        if (_open) await OnNoticesRead.InvokeAsync();
    }

    Task DismissNotice(int id) => OnDismissNotice.InvokeAsync(id);
    Task ClearAllNotices() => OnClearNotices.InvokeAsync();

    public sealed record NoticeItem(int Id, string Severity, string Message, string Timestamp);
}
