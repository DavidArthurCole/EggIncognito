@using System.Text.Json
@using System.Net.Http.Json

@* Hosted-capture connection card: the caller's per-user IPv6 proxy host, the port, and the CA install
   steps. The front door identifies the user by destination address, so the proxy uses no auth. *@
<section id="hostedSetupCard" class="panel">
  <div class="flex items-start justify-between gap-3 mb-2">
    <h2 class="text-base mt-0 mb-0 text-fg">Hosted proxy setup</h2>
    <button type="button" class="btn-primary inline-flex items-center gap-2 shrink-0"
            @onclick="OnStart" disabled="@StartBusy">
      <Icon Name="@(Running ? "pause" : "play")" Class="icon-sm" />
      @(Running ? "Stop capture" : "Start capture")
    </button>
  </div>
  <p class="text-muted text-sm mt-0 mb-3">Click <strong>Start capture</strong> and the bot DMs you a
    one-tap CA install profile. Set your device's Wi-Fi HTTP proxy to the host and port below, leave
    authentication off, then install and trust the DM'd CA.</p>

  <div class="mb-3">
    <div class="mb-1"><span class="text-muted text-xs">Proxy host</span> <span class="code-chip" id="proxyHost">@(_proxyHost ?? "loading...")</span></div>
    <div class="mb-1"><span class="text-muted text-xs">Proxy port</span> <span class="code-chip">@Port</span></div>
    <div class="mb-1"><span class="text-muted text-xs">Authentication</span> <span class="code-chip">off</span></div>
  </div>

  @if (_caDmFailed)
  {
    <p class="text-muted text-xs mb-3" id="caDmFailedNotice">Could not DM you the setup. This usually means
      you are not in the Discord server, or your DMs from server members are off
      (Settings &gt; Privacy &amp; Safety). Everything you need is on this card.
      @if (!string.IsNullOrWhiteSpace(InviteUrl))
      {
        <span>Join the server: <a href="@InviteUrl" target="_blank" rel="noopener" class="text-accent2 underline">@InviteUrl</a>, enable DMs, then restart the capture to retry.</span>
      }
      else
      {
        <span>Enable DMs, then restart the capture to retry.</span>
      }
    </p>
  }

  <details class="setup-steps" open="@(!Connected)">
    <summary class="setup-summary">Setup instructions</summary>

    <ol class="text-muted text-sm leading-relaxed pl-5 mt-2 mb-3">
      <li>Set the device's Wi-Fi HTTP proxy to the host + port above, and leave authentication off.</li>
      <li>Open the DM'd install profile and trust the CA, see your platform below.</li>
      <li>Start the capture session, then open Egg, Inc. - flows appear live below.</li>
    </ol>

    <div class="setup-platforms">
      <div class="setup-platform">
        <div class="setup-platform-name">iOS</div>
        <p class="text-muted text-xs leading-relaxed m-0">Open the CA profile (from the DM or Safari),
          install it, then enable full trust under Settings &gt; General &gt; About &gt; Certificate
          Trust Settings.</p>
      </div>
      <div class="setup-platform">
        <div class="setup-platform-name">Android</div>
        <p class="text-muted text-xs leading-relaxed m-0">Since Android 7, apps ignore user-installed CAs,
          so Egg, Inc. will not decrypt on a stock device. Needs a rooted phone with the CA in the system
          trust store (e.g. a Magisk cert module).</p>
      </div>
    </div>

    <p class="text-muted text-xs mt-3 mb-0">Only Egg, Inc. traffic is decrypted; everything else passes
      through untouched, so your other apps keep working normally with the proxy on.</p>
  </details>
</section>

@code {
    [Parameter] public int Port { get; set; }
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }
    // Drives the instructions collapsing once a device is talking to the proxy.
    [Parameter] public bool Connected { get; set; }
    // Mirrors the toolbar capture toggle so the prominent in-card button starts/stops the session.
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool StartBusy { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }
    // Discord invite shown in the DM-failed notice so the user can join + enable DMs. Null hides the link.
    [Parameter] public string? InviteUrl { get; set; }

    string? _proxyHost;
    bool _caDmFailed;

    // After the interactive circuit is live (ClientFactory can forward the auth cookie), fetch the
    // user's proxy address and poll status once to surface a failed CA DM.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || ClientFactory is null) return;
        try
        {
            var res = await ClientFactory().GetAsync("/api/capture/proxy-address");
            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                _proxyHost = doc.RootElement.GetProperty("host").GetString();
                StateHasChanged();
            }
        }
        catch { /* address unavailable (no session / prerender); the placeholder stays */ }
        try
        {
            var res = await ClientFactory().GetAsync("/api/capture/status");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("caDmFailed", out var f)
                && f.ValueKind == JsonValueKind.True)
            {
                _caDmFailed = true;
                StateHasChanged();
            }
        }
        catch { /* status unavailable (no session / prerender); the download button stays the fallback */ }
    }
}
