@using System.Text.Json

@* Hosted-capture connection card: the public proxy endpoint, the caller's credentials, and the CA
   install steps. The token plaintext is shown exactly once per mint; only its hash is stored. *@
<section id="hostedSetupCard" class="panel">
  <div class="flex items-start justify-between gap-3 mb-2">
    <h2 class="text-base mt-0 mb-0 text-fg">Hosted proxy setup</h2>
    <button type="button" class="btn-primary inline-flex items-center gap-2 shrink-0"
            @onclick="OnStart" disabled="@StartBusy">
      <Icon Name="@(Running ? "pause" : "play")" Class="icon-sm" />
      @(Running ? "Stop capture" : "Start capture")
    </button>
  </div>
  <p class="text-muted text-sm mt-0 mb-3">Click <strong>Start capture</strong> and the bot DMs you a
    one-tap CA install profile plus your proxy details. Point your device's Wi-Fi proxy at the endpoint
    below; the username is your Discord ID and the password is your capture token.</p>

  <div class="mb-3">
    <div class="mb-1"><span class="text-muted text-xs">Proxy host</span> <span class="code-chip">@Host</span></div>
    <div class="mb-1"><span class="text-muted text-xs">Proxy port</span> <span class="code-chip">@Port</span></div>
    <div class="mb-1"><span class="text-muted text-xs">Username</span> <span class="code-chip">@Username</span></div>
    <div class="flex items-center gap-2">
      <span class="text-muted text-xs">Token</span>
      @if (_token is null)
      {
        <span class="text-muted text-xs">sent in the DM each time you start a capture</span>
      }
      else
      {
        <span class="code-chip" id="mintedToken">@_token</span>
        <span class="text-muted text-xs">also sent in your DM</span>
      }
      <button type="button" class="icon-btn icon-btn-sm" title="Cycle token" aria-label="Cycle token"
              @onclick="MintToken" disabled="@_busy"><Icon Name="refresh" Class="icon-sm" /></button>
    </div>
  </div>

  <div class="mb-3">
    <div class="text-muted text-xs mb-1">Auto-proxy profile (iOS, optional)</div>
    <div class="flex items-center gap-2">
      <input type="text" @bind="_ssid" @bind:event="oninput" placeholder="Your Wi-Fi network name (SSID)"
             class="bg-bg border border-border rounded px-2 py-1 text-xs" />
      <a class="btn-mini @(string.IsNullOrWhiteSpace(_ssid) || _busy ? "pointer-events-none opacity-50" : "")"
         href="@ProxyProfileUrl()" download
         aria-disabled="@(string.IsNullOrWhiteSpace(_ssid) || _busy)">Download proxy profile</a>
    </div>
    <p class="text-muted text-xs mt-1 mb-0">iOS applies the proxy automatically when you join this
      network. Omits your Wi-Fi password.</p>
  </div>

  @if (_caDmFailed)
  {
    <p class="text-muted text-xs mb-3" id="caDmFailedNotice">Could not DM you the setup. This usually means
      you are not in the Discord server, or your DMs from server members are off
      (Settings &gt; Privacy &amp; Safety). Everything you need is on this card.
      @if (!string.IsNullOrWhiteSpace(InviteUrl))
      {
        <span>Join the server: <a href="@InviteUrl" target="_blank" rel="noopener" class="text-accent2 underline">@InviteUrl</a>, enable DMs, then cycle your token to retry.</span>
      }
      else
      {
        <span>Enable DMs, then cycle your token to retry.</span>
      }
    </p>
  }
  @if (_error is not null)
  {
    <p class="text-muted text-xs mb-3">@_error</p>
  }

  <details class="setup-steps" open="@(!Connected)">
    <summary class="setup-summary">Setup instructions</summary>

    <ol class="text-muted text-sm leading-relaxed pl-5 mt-2 mb-3">
      <li>Set the device's Wi-Fi proxy to the host + port above, with the username + token as credentials.</li>
      <li>Open the DM'd install profile and trust the CA, see your platform below.</li>
      <li>Start the capture session, then open Egg, Inc. - flows appear live below.</li>
    </ol>

    <div class="setup-platforms">
      <div class="setup-platform">
        <div class="setup-platform-name">iOS</div>
        <p class="text-muted text-xs leading-relaxed m-0">Open the CA profile (from the DM or Safari),
          install it, then enable full trust under Settings &gt; General &gt; About &gt; Certificate
          Trust Settings.</p>
      </div>
      <div class="setup-platform">
        <div class="setup-platform-name">Android</div>
        <p class="text-muted text-xs leading-relaxed m-0">Since Android 7, apps ignore user-installed CAs,
          so Egg, Inc. will not decrypt on a stock device. Needs a rooted phone with the CA in the system
          trust store (e.g. a Magisk cert module).</p>
      </div>
    </div>

    <p class="text-muted text-xs mt-3 mb-0">Only Egg, Inc. traffic is decrypted; everything else passes
      through untouched, so your other apps keep working normally with the proxy on.</p>
  </details>
</section>

@code {
    [Parameter] public string Host { get; set; } = "";
    [Parameter] public int Port { get; set; }
    [Parameter] public string Username { get; set; } = "";
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }
    // Drives the instructions collapsing once a device is talking to the proxy.
    [Parameter] public bool Connected { get; set; }
    // Mirrors the toolbar capture toggle so the prominent in-card button starts/stops the session.
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool StartBusy { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }
    // Discord invite shown in the DM-failed notice so the user can join + enable DMs. Null hides the link.
    [Parameter] public string? InviteUrl { get; set; }

    string? _token;
    string? _error;
    string _ssid = "";
    bool _busy;
    bool _caDmFailed;

    string ProxyProfileUrl() =>
        $"/api/capture/proxy-profile?ssid={Uri.EscapeDataString(_ssid)}";

    // After the interactive circuit is live (ClientFactory can forward the auth cookie), poll status once
    // to surface a failed CA DM. The live dashboard also toasts it; this is the persistent fallback line.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || ClientFactory is null) return;
        try
        {
            var res = await ClientFactory().GetAsync("/api/capture/status");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("caDmFailed", out var f)
                && f.ValueKind == JsonValueKind.True)
            {
                _caDmFailed = true;
                StateHasChanged();
            }
        }
        catch { /* status unavailable (no session / prerender); the download button stays the fallback */ }
    }

    async Task MintToken()
    {
        if (ClientFactory is null) return;
        _busy = true;
        _error = null;
        try
        {
            var res = await ClientFactory().PostAsync("/api/capture/proxy-token", null);
            if (!res.IsSuccessStatusCode)
            {
                _error = $"Token mint failed ({(int)res.StatusCode}).";
                return;
            }
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            _token = doc.RootElement.GetProperty("token").GetString();
        }
        catch
        {
            _error = "Token mint failed.";
        }
        finally
        {
            _busy = false;
        }
    }
}
