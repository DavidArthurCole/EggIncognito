@using System.Text.Json
@using System.Net.Http.Json

@* Hosted-capture connection card: the caller's per-user IPv6 proxy host, the port, and the CA install
   steps. The front door identifies the user by destination address, so the proxy uses no auth. *@
<section id="hostedSetupCard" class="panel">
  <h2 class="text-base mt-0 mb-2 text-fg">Hosted proxy setup</h2>
  <p class="text-muted text-sm mt-0 mb-3"><strong>Start capture</strong> (in the Controls widget) DMs you
    the CA. Set your Wi-Fi proxy to Manual with the values below, install the CA, open Egg, Inc.</p>

  <div class="mb-3">
    <div class="mb-1 flex items-center gap-2">
      <span class="text-muted text-xs">Server</span>
      <span class="code-chip" id="proxyHost">@(_proxyHost ?? "loading...")</span>
      <button type="button" class="icon-btn icon-btn-sm" title="Rotate address" aria-label="Rotate address"
              @onclick="RotateAddress" disabled="@_rotating"><Icon Name="refresh" Class="icon-sm" /></button>
    </div>
    <div class="mb-1"><span class="text-muted text-xs">Port</span> <span class="code-chip">@Port</span></div>
    <div class="mb-1"><span class="text-muted text-xs">Authentication</span> <span class="code-chip">off</span></div>
    @if (_rotated)
    {
      <p class="text-muted text-xs mt-1 mb-0" id="rotatedNotice">New address issued. The old one no longer works. Update your device's proxy Server to the value above.</p>
    }
  </div>

  @if (_caDmFailed)
  {
    <p class="text-muted text-xs mb-3" id="caDmFailedNotice">Could not DM you the setup. This usually means
      you are not in the Discord server, or your DMs from server members are off
      (Settings &gt; Privacy &amp; Safety). Everything you need is on this card.
      @if (!string.IsNullOrWhiteSpace(InviteUrl))
      {
        <span>Join the server: <a href="@InviteUrl" target="_blank" rel="noopener" class="text-accent2 underline">@InviteUrl</a>, enable DMs, then restart the capture to retry.</span>
      }
      else
      {
        <span>Enable DMs, then restart the capture to retry.</span>
      }
    </p>
  }

  <div class="setup-steps">
    <div class="setup-summary">Setup instructions</div>

    <ol class="text-muted text-sm leading-relaxed pl-5 mt-2 mb-3">
      <li>Wi-Fi proxy to Manual: Server + Port above, auth off.</li>
      <li>Install + trust the DM'd CA, see your platform below.</li>
      <li>Open Egg, Inc. Flows appear live below.</li>
    </ol>

    <div class="setup-platforms">
      <div class="setup-platform">
        <span class="setup-platform-name">iOS</span>
        <span class="text-muted text-xs leading-snug">Open the CA profile (DM or Safari), install it,
          then full-trust under Settings &gt; General &gt; About &gt; Certificate Trust Settings.</span>
      </div>
      <div class="setup-platform">
        <span class="setup-platform-name">Android</span>
        <span class="text-muted text-xs leading-snug">Android 7+ ignores user CAs, so EI will not decrypt
          on stock. Needs a rooted phone with the CA in the system trust store (Magisk cert module).</span>
      </div>
    </div>

    <p class="text-muted text-xs mt-2 mb-0">Only Egg, Inc. traffic is decrypted; everything else passes
      through untouched.</p>
  </div>
</section>

@code {
    [Parameter] public int Port { get; set; }
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }
    // Discord invite shown in the DM-failed notice so the user can join + enable DMs. Null hides the link.
    [Parameter] public string? InviteUrl { get; set; }

    string? _proxyHost;
    bool _caDmFailed;
    bool _rotating;
    bool _rotated;

    // Mint a fresh random address, killing the old (leaked) one. The server replaces the stored address
    // so the old one stops resolving; the user re-points their device at the new value shown.
    async Task RotateAddress()
    {
        if (ClientFactory is null || _rotating) return;
        _rotating = true;
        _rotated = false;
        try
        {
            var res = await ClientFactory().PostAsync("/api/capture/proxy-address/rotate", null);
            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                _proxyHost = doc.RootElement.GetProperty("host").GetString();
                _rotated = true;
            }
        }
        catch { /* leave the current address shown */ }
        finally { _rotating = false; }
    }

    // After the interactive circuit is live (ClientFactory can forward the auth cookie), fetch the
    // user's proxy address and poll status once to surface a failed CA DM.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || ClientFactory is null) return;
        try
        {
            var res = await ClientFactory().GetAsync("/api/capture/proxy-address");
            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                _proxyHost = doc.RootElement.GetProperty("host").GetString();
                StateHasChanged();
            }
        }
        catch { /* address unavailable (no session / prerender); the placeholder stays */ }
        try
        {
            var res = await ClientFactory().GetAsync("/api/capture/status");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("caDmFailed", out var f)
                && f.ValueKind == JsonValueKind.True)
            {
                _caDmFailed = true;
                StateHasChanged();
            }
        }
        catch { /* status unavailable (no session / prerender); the download button stays the fallback */ }
    }
}
