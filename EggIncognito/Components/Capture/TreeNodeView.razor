@* One node of the JSON tree, rendered recursively. Ported from buildTreeNode/renderLeafValue in
   tree.js: caret + key + colon + (summary | leaf value), with search <mark> highlighting, long-string
   clamp/expand on click, blur-reveal of sensitive leaves, and dim of non-matching branches. *@
@using EggIncognito.Components.Capture

@if (FlattenRoot)
{
  <div class="jtree-flat">
    @foreach (var child in Node.Children)
    {
      <TreeNodeView Node="child" View="View" Search="@Search" />
    }
  </div>
}
else
{
  <div class="jtree-node @(IsRoot ? "jtree-root" : "") @(Node.Expanded ? "jtree-expanded" : "") @(Node.Dim ? "jtree-dim" : "") @(Node.SelfMatch ? "jtree-match" : "")">
    <div class="jtree-row" @onclick="ToggleRow">
      <span class="jtree-caret @(Node.IsContainer ? "" : "jtree-caret-leaf")"></span>
      @if (Node.KeyText is not null)
      {
        <span class="jtree-key">@Highlight(Node.KeyText, Node.KeyTextLower)</span>
        <span class="jtree-colon">: </span>
      }
      @if (Node.IsContainer)
      {
        <span class="jtree-summary">@Node.Summary</span>
      }
      else
      {
        @LeafSpan()
      }
    </div>
    @if (Node.IsContainer && Node.Expanded)
    {
      <div class="jtree-children">
        @foreach (var child in Node.Children)
        {
          <TreeNodeView Node="child" View="View" Search="@Search" />
        }
      </div>
    }
  </div>
}

@code {
    [Parameter] public TreeNode Node { get; set; } = default!;
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public bool IsRoot { get; set; }

   
    bool _clampOpen;
    bool _revealed;

    void ToggleRow()
    {
        if (Node.IsContainer) Node.Expanded = !Node.Expanded;
    }


    bool FlattenRoot => IsRoot && Node.IsContainer && Node.DescendantCount <= TreeNode.SmallChildLimit;


    bool IsEmptyLeaf => Node.Kind == "string" && Node.LeafText == "\"\"";

    bool IsSensitive => View.IsSensitiveKey(Node.KeyName) && !IsEmptyLeaf;

   
   
    string LeafDisplay()
    {
        var full = Node.LeafText;
        var searching = Search.Length > 0;
        if (Node.Kind == "string" && full.Length > TreeNode.ValueClamp + 2 && !_clampOpen && !searching)
        {
           
            var inner = full.Substring(1, Math.Min(TreeNode.ValueClamp, full.Length - 2));
            return "\"" + inner + "...\"";
        }
        return full;
    }

    bool IsClamped =>
        Node.Kind == "string" && Node.LeafText.Length > TreeNode.ValueClamp + 2;

    RenderFragment LeafSpan() => builder =>
    {
        var clamped = IsClamped;
        var cls = "jv jv-" + Node.Kind;
        if (clamped) cls += " jv-clamped";
        if (_clampOpen) cls += " jv-open";
        if (IsSensitive)
        {
            cls += " blurred";
            if (_revealed) cls += " revealed";
        }

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", cls);
        if (clamped || IsSensitive)
        {
            builder.AddAttribute(2, "title", IsSensitive ? "Click to reveal" : "Click to expand");
            builder.AddAttribute(3, "onclick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, OnLeafClick));
            builder.AddEventStopPropagationAttribute(4, "onclick", true);
        }
        builder.AddContent(5, Highlight(LeafDisplay(), Search.Length > 0 ? Node.LeafTextLower : null));
        builder.CloseElement();
    };

    void OnLeafClick()
    {
        if (IsSensitive) _revealed = !_revealed;
        else if (IsClamped) _clampOpen = !_clampOpen;
    }

    RenderFragment Highlight(string text, string? lowerHint = null) => builder =>
    {
        var needle = Search;
        if (needle.Length == 0)
        {
            builder.AddContent(0, text);
            return;
        }
        var lower = lowerHint ?? text.ToLowerInvariant();
        var idx = lower.IndexOf(needle, StringComparison.Ordinal);
        if (idx < 0)
        {
            builder.AddContent(0, text);
            return;
        }
        var seq = 0;
        var pos = 0;
        while (idx >= 0)
        {
            if (idx > pos) builder.AddContent(seq++, text.Substring(pos, idx - pos));
            builder.OpenElement(seq++, "mark");
            builder.AddContent(seq++, text.Substring(idx, needle.Length));
            builder.CloseElement();
            pos = idx + needle.Length;
            idx = lower.IndexOf(needle, pos, StringComparison.Ordinal);
        }
        if (pos < text.Length) builder.AddContent(seq++, text.Substring(pos));
    };
}
