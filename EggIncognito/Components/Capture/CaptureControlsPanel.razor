@* Capture controls as a side-column widget (was the nav toolbar): start/stop, clear, HAR export, and the
   view/redaction settings. Actions raise to the page; view settings mutate the shared CaptureViewState and
   call OnViewChanged so the page persists + re-renders. One popover open at a time. *@
@using EggIncognito.Capture
@using EggIncognito.Components.Shared

<section class="panel capture-controls">
  <h3 class="text-sm font-semibold mt-0 mb-2">Controls</h3>
  <div class="flex items-center justify-between gap-2">
    <div class="flex items-center gap-1.5">
      <button type="button" class="icon-btn @(Running ? "capture-stop" : "capture-start")" disabled="@ToggleBusy"
              title="@(Running ? "Stop capture" : "Start capture")"
              aria-label="@(Running ? "Stop capture" : "Start capture")" @onclick="OnToggleCapture">
        <Icon Name="@(Running ? "pause" : "play")" />
      </button>

      <div class="settings-wrap" style="position: relative;">
        <button type="button" class="icon-btn" title="Clear list" aria-label="Clear list"
                aria-haspopup="true" aria-expanded="@(_open == "clear")" @onclick="@(() => Toggle("clear"))"><Icon Name="trash" /></button>
        <div class="settings-menu confirm-menu @(_open == "clear" ? "open" : "")">
          <div class="settings-title">Clear list?</div>
          <div class="settings-hint">Removes the captured requests shown here. Saved endpoints, captured HAR(s), and exported files are kept.</div>
          <div class="confirm-actions">
            <button type="button" class="btn-mini" @onclick="@(() => _open = null)">Cancel</button>
            <button type="button" class="btn-mini btn-danger" @onclick="ConfirmClear">Clear</button>
          </div>
        </div>
      </div>

      <div class="settings-wrap" style="position: relative;">
        <button type="button" class="icon-btn" title="Export" aria-label="Export"
                aria-haspopup="true" aria-expanded="@(_open == "export")" @onclick="@(() => Toggle("export"))"><Icon Name="download" /></button>
        <div class="settings-menu @(_open == "export" ? "open" : "")">
          <div class="settings-title">Export</div>
          <a class="export-item" href="/api/capture/har" download>HAR (all requests)</a>
        </div>
      </div>

      @if (Hosted)
      {
        <button type="button" class="icon-btn" title="DM me my setup config (CA + proxy address)"
                aria-label="DM setup config" disabled="@_dmBusy" @onclick="SendConfig"><Icon Name="bell" /></button>
        <button type="button" class="icon-btn" title="Rotate my proxy address (invalidates the old one)"
                aria-label="Rotate proxy address" disabled="@_rotateBusy" @onclick="RotateAddress"><Icon Name="refresh" /></button>
      }

      <div class="settings-wrap" style="position: relative;">
        <button type="button" class="icon-btn" title="Settings" aria-label="Settings"
                aria-haspopup="true" aria-expanded="@(_open == "settings")" @onclick="@(() => Toggle("settings"))"><Icon Name="gear" /></button>
        <div class="settings-menu @(_open == "settings" ? "open" : "")">
          <div class="settings-title">Redaction</div>
          <div class="settings-hint">How sensitive values appear in the detail pane.</div>
          <div class="settings-seg" role="radiogroup" aria-label="Redaction mode">
            <button type="button" class="seg-btn @(View.RedactionMode == "off" ? "active" : "")" @onclick="@(() => SetMode("off"))">Off</button>
            <button type="button" class="seg-btn @(View.RedactionMode == "blur" ? "active" : "")" @onclick="@(() => SetMode("blur"))">Blur</button>
            <button type="button" class="seg-btn @(View.RedactionMode == "redact" ? "active" : "")" @onclick="@(() => SetMode("redact"))">Redact</button>
          </div>

          <div class="settings-title">Headers</div>
          <label class="settings-check"><input type="checkbox" checked="@View.ShowHeaders" @onchange="OnShowHeaders" /> Show captured headers</label>

          <div class="settings-title">List</div>
          <label class="settings-check"><input type="checkbox" checked="@View.AutoScroll" @onchange="OnAutoScroll" /> Auto-scroll to newest</label>

          <div class="settings-title">Compare to known data</div>
          <div class="settings-hint">Tag each capture by how it compares to the checked-in endpoint set (wrote / upd / same / diff / loss).</div>
          <label class="settings-check"><input type="checkbox" checked="@View.CompareToKnown" @onchange="OnCompare" /> Show comparison tags</label>

          <div class="settings-title">Default format</div>
          <div class="settings-hint">The view request/response data opens in.</div>
          <select class="data-format settings-select" value="@View.DefaultFormat" @onchange="OnDefaultFormat">
            <option value="json-tree">JSON (tree)</option>
            <option value="json">JSON (raw)</option>
            <option value="yaml">YAML</option>
            <option value="xml">XML</option>
            <option value="js">JS object</option>
            <option value="hex">Hex</option>
            <option value="bin">Binary</option>
          </select>
        </div>
      </div>
    </div>
  </div>
  <div class="text-xs text-muted mt-2.5">@(Running ? "Capturing." : "Stopped.") Start/stop, clear the list, export a HAR, or tune the view.</div>
  @if (_actionMsg is not null) { <div class="text-xs mt-1 @(_actionOk ? "text-green-400" : "text-err")">@_actionMsg</div> }
</section>

@code {
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool ToggleBusy { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public EventCallback OnToggleCapture { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnViewChanged { get; set; }
    // Hosted-only: the DM-config + rotate-address controls (moved here from the setup card). ClientFactory
    // forwards the auth cookie; OnAddressRotated lets the page refresh the displayed server address.
    [Parameter] public bool Hosted { get; set; }
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }
    [Parameter] public EventCallback<string> OnAddressRotated { get; set; }

    string? _open;
    bool _dmBusy;
    bool _rotateBusy;
    string? _actionMsg;
    bool _actionOk;

    void Toggle(string which) => _open = _open == which ? null : which;

    async Task SendConfig()
    {
        if (ClientFactory is null) return;
        _dmBusy = true; _actionMsg = null;
        try
        {
            var res = await ClientFactory().PostAsync("/api/capture/send-config", null);
            _actionOk = res.IsSuccessStatusCode;
            _actionMsg = _actionOk ? "Setup DM sent." : "Could not DM your setup (start a session + enable DMs).";
        }
        catch (Exception ex) { _actionOk = false; _actionMsg = $"DM failed: {ex.Message}"; }
        _dmBusy = false;
    }

    async Task RotateAddress()
    {
        if (ClientFactory is null) return;
        _rotateBusy = true; _actionMsg = null;
        try
        {
            var res = await ClientFactory().PostAsync("/api/capture/proxy-address/rotate", null);
            if (res.IsSuccessStatusCode)
            {
                using var doc = System.Text.Json.JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                var host = doc.RootElement.GetProperty("host").GetString();
                _actionOk = true; _actionMsg = "New address issued. Update your device's proxy server.";
                if (host is not null) await OnAddressRotated.InvokeAsync(host);
            }
            else { _actionOk = false; _actionMsg = $"Rotate failed (HTTP {(int)res.StatusCode})."; }
        }
        catch (Exception ex) { _actionOk = false; _actionMsg = $"Rotate failed: {ex.Message}"; }
        _rotateBusy = false;
    }

    async Task SetMode(string mode) { View.RedactionMode = mode; await OnViewChanged.InvokeAsync(); }
    async Task OnShowHeaders(ChangeEventArgs e) { View.ShowHeaders = e.Value is bool b && b; await OnViewChanged.InvokeAsync(); }
    async Task OnAutoScroll(ChangeEventArgs e) { View.AutoScroll = e.Value is bool b && b; await OnViewChanged.InvokeAsync(); }
    async Task OnCompare(ChangeEventArgs e) { View.CompareToKnown = e.Value is bool b && b; await OnViewChanged.InvokeAsync(); }
    async Task OnDefaultFormat(ChangeEventArgs e) { View.DefaultFormat = e.Value?.ToString() ?? "json-tree"; await OnViewChanged.InvokeAsync(); }

    async Task ConfirmClear() { _open = null; await OnClear.InvokeAsync(); }
}
