@* The middle flow list: row construction (time, path, known dot, outcome tag, status badge, type
   chips), filters (group/path/type), select, and device-aware empty state. *@
@using System.Globalization
@using EggIncognito.Capture
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject IServiceProvider Services
@inject ILogger<FlowList> Logger

<section id="flowsPanel" class="panel">
    <div class="flow-head">
        <h2>Requests</h2>
        <div class="flow-filters">
            <span class="flow-filters-label">Filters</span>
            <select class="flow-filter-select" title="API group" value="@_group" @onchange="OnGroupChange">
                <option value="">All groups</option>
                @foreach (var g in GroupOptions()) {
                    <option value="@g">@g</option>
                }
            </select>
            <div class="flow-combo">
                <input class="flow-filter-input" type="search" placeholder="path..." autocomplete="off"
                       data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                       value="@_pathFilter" @oninput="OnPathInput"
                       @onfocus="@(() => _openCombo = "path")" @onblur="CloseCombo"/>
                @if (_openCombo == "path") {
                    <div class="popover popover-combo open">
                        @{ var pathOpts = PathOptions().ToList(); }
                        @if (pathOpts.Count == 0) {
                            <div class="combo-empty">No matches</div>
                        }
                        @foreach (var p in pathOpts) {
                            <button type="button" class="popover-combo-opt" @onmousedown:preventDefault="true" @onclick="@(() => PickPath(p))">@p</button>
                        }
                    </div>
                }
            </div>
            <div class="flow-combo">
                <input class="flow-filter-input" type="search" placeholder="request/response type..." autocomplete="off"
                       data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                       value="@_typeFilter" @oninput="OnTypeInput"
                       @onfocus="@(() => _openCombo = "type")" @onblur="CloseCombo"/>
                @if (_openCombo == "type") {
                    <div class="popover popover-combo open">
                        @{ var typeOpts = TypeOptions().ToList(); }
                        @if (typeOpts.Count == 0) {
                            <div class="combo-empty">No matches</div>
                        }
                        @foreach (var t in typeOpts) {
                            <button type="button" class="popover-combo-opt" @onmousedown:preventDefault="true" @onclick="@(() => PickType(t))">@t</button>
                        }
                    </div>
                }
            </div>
            <button type="button" class="icon-btn icon-btn-sm" title="Reset all filters" aria-label="Reset all filters" @onclick="ClearFilters">
                <Icon Name="x"/>
            </button>
        </div>
    </div>
    <div id="flowList" class="flow-list" @ref="_listRef">
        @if (Flows.Count == 0) {
            <div class="empty-state">
                @if (Connected) {
                    @:No requests captured yet.
                } else {
                    @:No device connected yet.
                    <div class="empty-hint">
                        Point the device's Wi-Fi proxy at this machine and install the CA cert.
                        The device only registers once an app sends a request through the proxy - the Settings app
                        alone usually sends nothing, so open a browser or Egg, Inc. to generate traffic.
                    </div>
                }
            </div>
        } else {
            TimeSpan? prevTime = null;
            var first = true;
            foreach (var flow in Flows) {
                var t = ParseTime(flow.Timestamp);
                if (!Filtering && !first && prevTime is { } p && t is { } cur) {
                    var gap = cur - p;
                    if (gap < TimeSpan.Zero) gap += TimeSpan.FromDays(1);
                    if (gap >= BurstGap) {
                        <div class="flow-burst-sep">
                            <span>@flow.Timestamp</span>
                            <span class="burst-gap">+@FormatGap(gap)</span>
                        </div>
                    }
                }

                if (t is not null) prevTime = t;
                first = false;
                @Row(flow)
            }
        }
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<DashboardFlow> Flows { get; set; } = [];
    [Parameter] public long? SelectedId { get; set; }
    [Parameter] public bool Connected { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public EventCallback<long> OnSelect { get; set; }

    static readonly TimeSpan BurstGap = TimeSpan.FromSeconds(3);

    string _group = "";
    string _pathFilter = "";
    string _typeFilter = "";
    string? _openCombo;

    bool Filtering => !string.IsNullOrEmpty(_group) || !string.IsNullOrEmpty(_pathFilter) || !string.IsNullOrEmpty(_typeFilter);

    static TimeSpan? ParseTime(string? ts) =>
        TimeSpan.TryParseExact(ts, @"hh\:mm\:ss", CultureInfo.InvariantCulture, out var t) ? t : null;

    static string FormatGap(TimeSpan gap) =>
        gap >= TimeSpan.FromMinutes(1) ? $"{(int)gap.TotalMinutes}m {gap.Seconds}s" : $"{(int)gap.TotalSeconds}s";

    ElementReference _listRef;
    IJSObjectReference? _scroll;
    int _lastFlowCount;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            try {
                _scroll = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/scroll.js"));
            }
            catch {
                /* JS unavailable (e.g. test prerender); auto-scroll is best-effort. */
            }
        }

        var count = Flows.Count;
        if (count > _lastFlowCount && View.AutoScroll && _scroll is not null) {
            try {
                await _scroll.InvokeVoidAsync("scrollToBottom", _listRef);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
                Logger.LogDebug(ex, "flow list auto-scroll failed");
            }
        }

        _lastFlowCount = count;
    }

    public ValueTask DisposeAsync() {
        return _scroll.DisposeModuleQuietAsync(logger: Logger);
    }

    void OnGroupChange(ChangeEventArgs e) => _group = e.Value?.ToString() ?? "";
    void OnPathInput(ChangeEventArgs e) => _pathFilter = (e.Value?.ToString() ?? "").Trim();
    void OnTypeInput(ChangeEventArgs e) => _typeFilter = (e.Value?.ToString() ?? "").Trim();

    void ClearFilters() {
        _group = "";
        _pathFilter = "";
        _typeFilter = "";
    }

    void CloseCombo() => _openCombo = null;

    void PickPath(string p) {
        _pathFilter = p;
        _openCombo = null;
    }

    void PickType(string t) {
        _typeFilter = t;
        _openCombo = null;
    }

    IEnumerable<string> GroupOptions() {
        var set = new SortedSet<string>(StringComparer.Ordinal);
        if (Services.GetService(typeof(AuxbrainSurface)) is AuxbrainSurface surface) set.UnionWith(surface.Namespaces);
        foreach (var f in Flows) {
            var p = f.Path ?? "";
            var i = p.IndexOf('/');
            if (i > 0) set.Add(p[..i]);
        }

        return set;
    }

    IEnumerable<string> PathOptions() {
        var seen = new SortedSet<string>(StringComparer.Ordinal);
        foreach (var f in Flows)
            if (!string.IsNullOrEmpty(f.Path))
                seen.Add(f.Path);
        var q = _pathFilter.ToLowerInvariant();
        return q.Length == 0 ? seen : seen.Where(p => p.ToLowerInvariant().Contains(q));
    }

    IEnumerable<string> TypeOptions() {
        var q = _typeFilter.ToLowerInvariant();
        return q.Length == 0 ? SeenTypes() : SeenTypes().Where(t => t.ToLowerInvariant().Contains(q));
    }

    IEnumerable<string> SeenTypes() {
        var set = new SortedSet<string>(StringComparer.Ordinal);
        foreach (var f in Flows) {
            if (!string.IsNullOrEmpty(f.RequestType)) set.Add(f.RequestType);
            if (!string.IsNullOrEmpty(f.ResponseType)) set.Add(f.ResponseType);
        }

        return set;
    }

    bool Matches(DashboardFlow flow) {
        var path = (flow.Path ?? "").ToLowerInvariant();
        if (!string.IsNullOrEmpty(_group) && (flow.Path ?? "").Split('/')[0] != _group) return false;
        if (!string.IsNullOrEmpty(_pathFilter) && !path.Contains(_pathFilter.ToLowerInvariant())) return false;
        if (!string.IsNullOrEmpty(_typeFilter)) {
            var t = ((flow.RequestType ?? "") + " " + (flow.ResponseType ?? "")).ToLowerInvariant();
            if (!t.Contains(_typeFilter.ToLowerInvariant())) return false;
        }

        return true;
    }

    RenderFragment Row(DashboardFlow flow) => @<div class="flow-row @(SelectedId == flow.Id ? "active" : "") @(Matches(flow) ? "" : "filtered-out")"
                                                    @onclick="@(() => OnSelect.InvokeAsync(flow.Id))">
                                                  @{
                                                      var noReqBody = string.IsNullOrEmpty(flow.RequestDataB64);
                                                      var outcome = View.CompareToKnown ? CaptureHelpers.Outcome(flow.Outcome) : null;
                                                      var reqType = flow.RequestType ?? (noReqBody ? "(none)" : "(unknown)");
                                                      var respType = flow.ResponseType ?? "(unknown)";
                                                  }
                                                  <span class="fseq">#@flow.Id</span>
                                                  <span class="ftime">@flow.Timestamp</span>
                                                  <span class="fpath" title="@flow.Path">@flow.Path</span>
                                                  <span class="ftypes" title="@($"{reqType} › {respType}")">
                                                      <span class="@(flow.RequestType is null ? "unknown" : "")">@reqType</span>
                                                      <span class="type-arrow">›</span>
                                                      <span class="@(flow.ResponseType is null ? "unknown" : "")">@respType</span>
                                                  </span>
                                                  @if (flow.Known || flow.Saved) {
                                                      <span class="known-dot" title="@KnownDotTitle(flow)"></span>
                                                  }
                                                  @if (outcome is not null) {
                                                      @OutcomeTag(flow, outcome)
                                                  }
                                                  @if (flow.Status is >= 200 and < 300) {
                                                      <span class="status-dot" title="HTTP @flow.Status"></span>
                                                  } else {
                                                      <span class="status-badge @CaptureHelpers.StatusClass(flow.Status)">@flow.Status</span>
                                                  }
                                              </div>;

    static string KnownDotTitle(DashboardFlow flow) {
        if (flow.Known)
            return "Known endpoint" + (flow.ResponseType is not null ? $" ({flow.ResponseType})" : "");
        return "Saved as endpoint";
    }


    RenderFragment OutcomeTag(DashboardFlow flow, CaptureHelpers.OutcomeMeta meta) => builder => {
        var seq = 0;
        var hasCounts = CaptureHelpers.HasDiffCounts(flow.Outcome, flow.DiffAdded, flow.DiffRemoved);
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "outcome-tag outcome-" + meta.Kind + (hasCounts ? " outcome-diff-counts" : ""));
        if (hasCounts) {
            builder.AddAttribute(seq++, "title", $"endpoint: diff (+{flow.DiffAdded} -{flow.DiffRemoved})");
            if (flow.DiffAdded > 0) {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "diff-add");
                builder.AddContent(seq++, "+" + flow.DiffAdded);
                builder.CloseElement();
            }

            if (flow.DiffRemoved > 0) {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "diff-del");
                builder.AddContent(seq, "-" + flow.DiffRemoved);
                builder.CloseElement();
            }
        } else {
            builder.AddAttribute(seq++, "title", "endpoint: " + meta.Label);
            builder.AddContent(seq, meta.Label);
        }

        builder.CloseElement();
    };

}
