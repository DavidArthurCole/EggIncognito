@* Interactive login CTA. Click reveals the native provider buttons fetched from SyncKit's
   /login/sources; each is a plain top-level <a> into Authentik (mode=redirect), which returns to
   /auth/callback. No popup, no iframe. The one-line sendBeacon stashes the return path on a browser
   request (the circuit can't set browser cookies) right before the anchor navigates away. *@
@rendermode @(RenderMode.InteractiveServer)
@inject AuthState Auth
@inject NavigationManager Nav
@inject SyncKit.Identity.Client.IdentityApiClient Identity

@if (!Auth.WidgetEnabled)
{
  <span class="@CssClass" style="opacity:0.6;cursor:not-allowed;">Login unavailable (identity service not configured)</span>
}
else if (_sources is not null)
{
  <div class="auth-source-list">
    @foreach (var s in _sources)
    {
      <a class="auth-source-btn" href="@s.Url" onclick="@BeaconJs">
        @if (!string.IsNullOrEmpty(s.IconUrl))
        {
          <img class="auth-source-logo" src="@s.IconUrl" alt="" width="16" height="16" style="width:16px;height:16px;" />
        }
        <span>@s.Name</span>
      </a>
    }
  </div>
}
else
{
  <button type="button" class="@CssClass" @onclick="Reveal" disabled="@_loading">
    @(_loading ? "Loading..." : Label)
  </button>
}
@if (_error is not null)
{
  <p class="text-red-500 text-sm">@_error</p>
}

@code {
    [Parameter] public string ReturnPath { get; set; } = "/";
    [Parameter] public string CssClass { get; set; } = "btn-primary inline-block no-underline";
    [Parameter] public string Label { get; set; } = "Log in";

    private IReadOnlyList<SyncKit.Contract.LoginSourceResponse>? _sources;
    private bool _loading;
    private string? _error;

    private string BeaconJs =>
        $"navigator.sendBeacon('/auth/login-return', {System.Text.Json.JsonSerializer.Serialize(ReturnPath)})";

    private async Task Reveal()
    {
        _error = null;
        _loading = true;
        try
        {
            var origin = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
            var resp = await Identity.GetLoginSourcesAsync(origin, "redirect", CancellationToken.None);
            if (resp.Sources.Count == 0)
            {
                _error = "No login providers configured.";
                return;
            }
            _sources = resp.Sources;
        }
        catch (Exception)
        {
            _error = "Login temporarily unavailable.";
        }
        finally
        {
            _loading = false;
        }
    }
}
