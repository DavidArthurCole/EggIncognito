@* The interactive half of LoginButton: drives the SyncKit popup widget. No redirect fallback -
   shows an inline error if the widget fails to load or the login attempt throws. *@
@rendermode @(RenderMode.InteractiveServer)
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Auth.WidgetEnabled)
{
  <button type="button" class="@CssClass" disabled="@_busy" @onclick="WidgetLogin">
    @(_busy ? "Signing in..." : Label)
  </button>
  @if (_error is not null)
  {
    <p class="text-red-500 text-sm">@_error</p>
  }
}
else
{
  <span class="@CssClass" style="opacity:0.6;cursor:not-allowed;">Login unavailable (identity service not configured)</span>
}

@code {
    [Parameter] public string ReturnPath { get; set; } = "/";
    [Parameter] public string CssClass { get; set; } = "btn-primary inline-block no-underline";
    [Parameter] public string Label { get; set; } = "Log in";

    private IJSObjectReference? _widgetMod;
    private bool _busy;
    private string? _error;

    async Task WidgetLogin()
    {
        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            _widgetMod ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/synckitLogin.js");
            await _widgetMod.InvokeAsync<bool>("login", Auth.IdentityHostUrl);
            Nav.NavigateTo(ReturnPath, forceLoad: true);
            return;
        }
        catch (JSException)
        {
            _error = "Login unavailable, try again.";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_widgetMod is not null)
        {
            try { await _widgetMod.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
