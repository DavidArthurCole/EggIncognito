@* Interactive login CTA. Click reveals the native provider buttons fetched from SyncKit's
   /login/sources; each is a plain top-level <a> into SyncKit's /login/go/{provider} (mode=redirect),
   which returns the browser to this exact page with ?code appended. No popup, no iframe, no app-side
   return-path handling: SyncKit round-trips the full returnUrl. The menu is fixed-positioned by
   loginMenu.js so it escapes any overflow-clipped container (e.g. the /protos modal). *@
@rendermode @(RenderMode.InteractiveServer)
@inject AuthState Auth
@inject NavigationManager Nav
@inject SyncKit.Identity.Client.IdentityApiClient Identity
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!Auth.WidgetEnabled)
{
  <span class="@CssClass" style="opacity:0.6;cursor:not-allowed;">Login unavailable (identity service not configured)</span>
}
else
{
  <div class="auth-source-anchor">
    <button type="button" class="@CssClass" @onclick="Toggle" disabled="@_loading" @ref="_button">
      @(_loading ? "Loading..." : Label)
    </button>
    @if (_sources is not null)
    {
      <div class="auth-source-menu" @ref="_menu">
        @foreach (var s in _sources)
        {
          <a class="auth-source-btn" href="@s.Url">
            @if (!string.IsNullOrEmpty(s.IconUrl))
            {
              <img class="auth-source-logo" src="@s.IconUrl" alt="" width="16" height="16" style="width:16px;height:16px;" />
            }
            <span>@s.Name</span>
          </a>
        }
      </div>
    }
    else if (_error is not null)
    {
      <div class="auth-source-menu" @ref="_menu"><p class="text-red-500 text-sm" style="margin:0;padding:0.3rem 0.5rem;">@_error</p></div>
    }
  </div>
}

@code {
    [Parameter] public string CssClass { get; set; } = "btn-primary inline-block no-underline";
    [Parameter] public string Label { get; set; } = "Log in";
    [Parameter] public LoginMenuPlacement Placement { get; set; } = LoginMenuPlacement.BottomRight;

    private IReadOnlyList<SyncKit.Contract.LoginSourceResponse>? _sources;
    private bool _loading;
    private string? _error;
    private ElementReference _button;
    private ElementReference _menu;
    private IJSObjectReference? _mod;
    private bool _positioned;

    private async Task Toggle()
    {
        if (_sources is not null || _error is not null)
        {
            await CloseMenuAsync();
            _sources = null;
            _error = null;
            return;
        }
        _error = null;
        _loading = true;
        try
        {
            // Full current URL: SyncKit returns the user to this exact page with ?code appended.
            var resp = await Identity.GetLoginSourcesAsync(Nav.Uri, "redirect", CancellationToken.None);
            if (resp.Sources.Count == 0)
                _error = "No login providers configured.";
            else
                _sources = resp.Sources;
        }
        catch (Exception)
        {
            _error = "Login temporarily unavailable.";
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var menuOpen = _sources is not null || _error is not null;
        if (menuOpen && !_positioned)
        {
            _mod ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/loginMenu.js");
            await _mod.InvokeVoidAsync("open", _button, _menu, Placement.ToString());
            _positioned = true;
        }
        else if (!menuOpen && _positioned)
        {
            _positioned = false;
        }
    }

    private async Task CloseMenuAsync()
    {
        if (_mod is not null)
        {
            try { await _mod.InvokeVoidAsync("close"); } catch (JSDisconnectedException) { }
        }
        _positioned = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_mod is not null)
        {
            try { await _mod.InvokeVoidAsync("close"); } catch (JSDisconnectedException) { }
            try { await _mod.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
