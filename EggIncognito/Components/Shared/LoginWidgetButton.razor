@* The interactive half of LoginButton: drives the SyncKit inline login widget. Clicking reveals
   an iframe container in place of the button. No redirect fallback - shows an inline error if
   the widget fails to load or the login attempt throws. *@
@rendermode @(RenderMode.InteractiveServer)
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Auth.WidgetEnabled)
{
  @if (_showContainer)
  {
    <div @ref="_containerRef" class="@ContainerCssClass"></div>
  }
  else
  {
    <button type="button" class="@CssClass" @onclick="ShowContainer">
      @Label
    </button>
  }
  @if (_error is not null)
  {
    <p class="text-red-500 text-sm">@_error</p>
  }
}
else
{
  <span class="@CssClass" style="opacity:0.6;cursor:not-allowed;">Login unavailable (identity service not configured)</span>
}

@code {
    [Parameter] public string ReturnPath { get; set; } = "/";
    [Parameter] public string CssClass { get; set; } = "btn-primary inline-block no-underline";
    [Parameter] public string Label { get; set; } = "Log in";
    [Parameter] public string ContainerCssClass { get; set; } = "";

    private ElementReference _containerRef;
    private IJSObjectReference? _widgetMod;
    private bool _showContainer;
    private bool _started;
    private string? _error;

    private void ShowContainer()
    {
        _error = null;
        _showContainer = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_showContainer || _started) return;
        _started = true;
        try
        {
            _widgetMod ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/synckitLogin.js");
            await _widgetMod.InvokeAsync<bool>("loginInline", Auth.IdentityHostUrl, _containerRef);
            Nav.NavigateTo(ReturnPath, forceLoad: true);
        }
        catch (JSException)
        {
            _error = "Login unavailable, try again.";
            _showContainer = false;
            _started = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_widgetMod is not null)
        {
            try { await _widgetMod.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
