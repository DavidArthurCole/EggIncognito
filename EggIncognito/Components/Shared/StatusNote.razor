<div class="status-note status-note-@Severity.ToString().ToLowerInvariant()" role="status">
    <Icon Name="@IconFor(Severity)" Class="icon-sm shrink-0"/>
    <span class="min-w-0">@ChildContent</span>
    @Actions
    @if (OnDismiss.HasDelegate) {
        <button type="button" class="status-note-x" aria-label="Dismiss" @onclick="@(() => OnDismiss.InvokeAsync())">
            <Icon Name="x" Class="icon-sm"/>
        </button>
    }
</div>

@code {

    [Parameter] public StatusNoteKind Severity { get; set; } = StatusNoteKind.Info;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    static string IconFor(StatusNoteKind k) {
        return k switch {
            StatusNoteKind.Ok => "check",
            StatusNoteKind.Error => "x",
            StatusNoteKind.Busy => "clock",
            _ => "info"
        };
    }

}
