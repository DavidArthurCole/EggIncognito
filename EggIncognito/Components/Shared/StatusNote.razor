<div class="status-note status-note-@Severity.ToString().ToLowerInvariant()"
     role="@(Severity == StatusNoteKind.Error ? "alert" : "status")">
    <Icon Name="@IconFor(Severity)" Class="icon-sm status-note-icon"/>
    <span class="status-note-text">@ChildContent</span>
    @if (Actions is not null) {
        <span class="status-note-actions">@Actions</span>
    }
    @if (OnDismiss.HasDelegate) {
        <button type="button" class="status-note-x" aria-label="Dismiss" @onclick="@(() => OnDismiss.InvokeAsync())">
            <Icon Name="x" Class="icon-sm"/>
        </button>
    }
</div>

@code {

    [Parameter] public StatusNoteKind Severity { get; set; } = StatusNoteKind.Info;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    static string IconFor(StatusNoteKind k) {
        return k switch {
            StatusNoteKind.Ok => "check",
            StatusNoteKind.Error => "alert",
            StatusNoteKind.Busy => "clock",
            _ => "info"
        };
    }

}
