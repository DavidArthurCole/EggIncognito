<span class="tt @Class" style="@Style">
    @ChildContent
    <span class="tt-pop" role="tooltip">@Tip</span>
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Tip { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }
}
