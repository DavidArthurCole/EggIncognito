@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<TemplateEditor> Logger
@using EggIncognito.Services.Feed
@implements IAsyncDisposable

<div class="tpl-editor">
    @if (Tokens.Count > 0) {
        <div class="tpl-palette">
            @foreach (var name in Tokens) {
                <button type="button" class="tpl-token" title="@($"Insert {Wrap(name)}")"
                        @onclick="@(() => Insert(name))">
                    @Wrap(name)
                </button>
            }
        </div>
    }
    <textarea class="field-input w-full font-mono text-xs" rows="@Rows" spellcheck="false"
              placeholder="@Placeholder" value="@Value" @oninput="OnInput" @ref="_area"></textarea>
    @if (Unknown() is { Count: > 0 } unknown) {
        <span class="tpl-warn">
            @(unknown.Count == 1 ? "Unknown variable" : "Unknown variables"): @string.Join(", ", unknown.Select(Wrap))
        </span>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Tokens { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int Rows { get; set; } = 4;

    ElementReference _area;
    IJSObjectReference? _module;

    static string Wrap(string name) {
        return "{{" + name + "}}";
    }

    List<string> Unknown() {
        var missing = new List<string>();
        foreach (var name in FeedTemplate.Tokens(Value)) {
            if (!Tokens.Contains(name, StringComparer.Ordinal)) missing.Add(name);
        }

        return missing;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || _module is not null) return;
        try {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/caretInsert.js"));
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "caret insert interop could not be loaded");
        }
    }

    Task OnInput(ChangeEventArgs e) {
        return ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }

    async Task Insert(string name) {
        var token = Wrap(name);
        var next = (Value ?? "") + token;
        if (_module is not null) {
            try {
                next = await _module.InvokeAsync<string>("insert", _area, token);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
                Logger.LogDebug(ex, "caret insert failed, appending instead");
                next = (Value ?? "") + token;
            }
        }

        await ValueChanged.InvokeAsync(next);
    }

    public ValueTask DisposeAsync() {
        return _module.DisposeModuleQuietAsync(null, Logger);
    }

}
