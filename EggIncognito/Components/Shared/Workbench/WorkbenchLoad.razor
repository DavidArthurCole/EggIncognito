@typeparam T

@if (Items is null) {
    <div class="@Class">@LoadingText</div>
} else if (Items.Count == 0) {
    <div class="@Class">@EmptyText</div>
} else if (ChildContent is not null) {
    @ChildContent(Items)
}

@code {
    [Parameter] public IReadOnlyCollection<T>? Items { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Loading...";
    [Parameter] public string EmptyText { get; set; } = "Nothing yet.";
    [Parameter] public string Class { get; set; } = "wb-note";
    [Parameter] public RenderFragment<IReadOnlyCollection<T>>? ChildContent { get; set; }

}
