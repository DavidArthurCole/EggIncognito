<section class="wb-sec">
    <div class="wb-sec-head">
        <span>@Label</span>
        @if (Tools is not null) {
            <span class="wb-sec-tools">@Tools</span>
        }
    </div>
    <div class="@BodyCss" style="@BodyStyle">
        @ChildContent
    </div>
</section>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? Tools { get; set; }
    [Parameter] public bool Scroll { get; set; }
    [Parameter] public string? MaxHeight { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string BodyCss => Scroll ? "wb-sec-body wb-scroll" : "wb-sec-body";

    string? BodyStyle => Scroll && !string.IsNullOrWhiteSpace(MaxHeight) ? $"max-height: {MaxHeight}" : null;

}
