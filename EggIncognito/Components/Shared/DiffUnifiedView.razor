@using Microsoft.AspNetCore.Components.Web.Virtualization
<div class="duni @(WordWrap ? "duni-wrap" : "")" style="@Style">
    <Virtualize Items="@Visible()" Context="line" ItemSize="20">
        <div class="duni-row duni-@(line.Kind)">@line.Text</div>
    </Virtualize>
</div>

@code {
    [Parameter] public string? UnifiedText { get; set; }
    [Parameter] public string? Filter { get; set; }
    [Parameter] public bool WordWrap { get; set; }
    [Parameter] public string MaxHeight { get; set; } = "";

    sealed record Line(string Kind, string Text);

    List<Line> _lines = [];
    string? _builtText;
    string? _builtFilter;

    string? Style => string.IsNullOrEmpty(MaxHeight) ? null : $"max-height:{MaxHeight}";

    protected override void OnParametersSet() {
        var q = Filter?.Trim() ?? "";
        if (ReferenceEquals(_builtText, UnifiedText) && _builtFilter == q) return;
        _builtText = UnifiedText;
        _builtFilter = q;
        _lines = [];
        if (string.IsNullOrEmpty(UnifiedText)) return;
        foreach (var raw in UnifiedText.Split('\n')) {
            var text = raw.EndsWith('\r') ? raw[..^1] : raw;
            if (q.Length > 0 && !text.Contains(q, StringComparison.OrdinalIgnoreCase)) continue;
            _lines.Add(new Line(KindOf(text), text));
        }
    }

    List<Line> Visible() {
        return _lines;
    }

    static string KindOf(string text) {
        if (text.StartsWith("@@", StringComparison.Ordinal)) return "head";
        if (text.StartsWith("---", StringComparison.Ordinal)) return "meta";
        if (text.StartsWith("+++", StringComparison.Ordinal)) return "meta";
        if (text.StartsWith('\\')) return "meta";
        if (text.StartsWith('+')) return "add";
        if (text.StartsWith('-')) return "rem";
        return "ctx";
    }

}
