@rendermode @(RenderModes.InteractiveServer)
@implements IDisposable
@inject ToastService Toasts

<div class="toast-host">
    @foreach (var t in Toasts.Items) {
        <div class="toast toast-@t.Kind.ToString().ToLowerInvariant()" @key="t.Id"
             role="@(t.Kind == StatusNoteKind.Error ? "alert" : "status")">
            <span class="toast-text">@t.Text</span>
            @if (t.ActionLabel is { Length: > 0 } label) {
                <button type="button" class="btn-mini" @onclick="@(() => Toasts.Act(t.Id))">@label</button>
            }
            <button type="button" class="status-note-x" aria-label="Dismiss" @onclick="@(() => Toasts.Dismiss(t.Id))">
                <Icon Name="x" Class="icon-sm"/>
            </button>
        </div>
    }
</div>

@code {

    protected override void OnInitialized() {
        Toasts.Changed += OnChanged;
    }

    void OnChanged() {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() {
        Toasts.Changed -= OnChanged;
    }

}
