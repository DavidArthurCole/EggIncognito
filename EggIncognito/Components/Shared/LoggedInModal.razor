@rendermode @(RenderMode.InteractiveServer)
@inject ICurrentUser User

@if (_open) {
    <ModalShell Title="@Title" OnClose="Close">
        <div class="modal-body">
            @if (User.IsAuthenticated) {
                @ChildContent
            } else {
                <div class="sub-login-note">
                    <p class="text-muted text-sm m-0 mb-2">@LoginPrompt</p>
                    <LoginButton Label="Log in" Placement="LoginMenuPlacement.Right"/>
                </div>
            }
        </div>
    </ModalShell>
}

@code {
    [Parameter] public string Title { get; set; } = "";

    [Parameter] public string LoginPrompt { get; set; } = "Log in to continue.";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    bool _open;

    public void Open() {
        _open = true;
        StateHasChanged();
    }

    public void Close() {
        _open = false;
        StateHasChanged();
    }

}
