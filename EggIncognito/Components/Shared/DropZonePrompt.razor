<div class="text-accent" aria-hidden="true">
    <Icon Name="upload" Class="@IconClass"/>
</div>
<div class="text-[0.95rem]"><strong class="text-fg font-semibold">@Prompt</strong> or click to browse</div>

@code {
    [Parameter] public string Prompt { get; set; } = "";
    [Parameter] public string IconClass { get; set; } = "dropzone-icon";
}
