@* Login CTA used everywhere a page offers to log in. Always delegates to the embedded widget -
   no raw Discord/Authentik redirect is ever rendered client-facing. *@
@inject AuthState Auth

@if (Auth.Enabled)
{
  <LoginWidgetButton CssClass="@CssClass" Label="@Label" />
}
else
{
  <span class="@CssClass" style="opacity:0.6;cursor:not-allowed;">Login unavailable</span>
}

@code {
    [Parameter] public string CssClass { get; set; } = "btn-primary inline-block no-underline";
    [Parameter] public string Label { get; set; } = "Log in";
}
