@* Login CTA used everywhere a page offers to log in. Always delegates to the embedded widget -
   no raw Discord/Authentik redirect is ever rendered client-facing. *@
@inject AuthState Auth

@if (Auth.Enabled) {
    <LoginWidgetButton CssClass="@CssClass" Label="@Label" Placement="@Placement"/>
} else if (Auth.LocalIdentityActive) {
    <span class="text-muted">Local identity active; the role comes from Auth:LocalIdentity:Role.</span>
} else {
    <span class="text-muted">Login is not configured on this instance.</span>
}

@code {
    [Parameter] public string CssClass { get; set; } = "btn-primary inline-block no-underline";
    [Parameter] public string Label { get; set; } = "Log in";
    [Parameter] public LoginMenuPlacement Placement { get; set; } = LoginMenuPlacement.BottomRight;
}
