@using EggIncognito.Services.ProtoExtract
@using Microsoft.AspNetCore.Components.Web.Virtualization
<div class="dsp @(WordWrap ? "dsp-wrap" : "")" style="@Style">
    <Virtualize Items="@Visible()" Context="line" ItemSize="20">
        <div class="dsp-row dsp-@(Kind(line.Row))" @onclick="@(() => RaiseHunk(line))">
            <span class="dsp-no">@line.Row.LeftNo</span>
            <span class="dsp-gut">@Glyph(line.Row, true)</span>
            <span class="dsp-txt">@Ink(line.Row.Left, line.Row.LeftInk, "dsp-ink-rem")</span>
            <span class="dsp-no">@line.Row.RightNo</span>
            <span class="dsp-gut">@Glyph(line.Row, false)</span>
            <span class="dsp-txt">@Ink(line.Row.Right, line.Row.RightInk, "dsp-ink-add")</span>
        </div>
    </Virtualize>
</div>

@code {
    [Parameter] public SideBySideResult? Result { get; set; }
    [Parameter] public string? Filter { get; set; }
    [Parameter] public bool WordWrap { get; set; }
    [Parameter] public string MaxHeight { get; set; } = "";
    [Parameter] public EventCallback<int> OnHunk { get; set; }

    sealed record Line(DiffRow Row, int Hunk);

    List<Line> _lines = [];
    SideBySideResult? _builtFrom;
    string? _builtFilter;

    string? Style => string.IsNullOrEmpty(MaxHeight) ? null : $"max-height:{MaxHeight}";

    protected override void OnParametersSet() {
        var q = Filter?.Trim() ?? "";
        if (ReferenceEquals(_builtFrom, Result) && _builtFilter == q) return;
        _builtFrom = Result;
        _builtFilter = q;
        _lines = [];
        if (Result is null) return;
        var starts = Result.HunkStarts;
        var next = 0;
        var hunk = -1;
        for (var i = 0; i < Result.Rows.Count; i++) {
            while (next < starts.Count && starts[next] <= i) {
                hunk = next;
                next++;
            }

            var row = Result.Rows[i];
            if (q.Length > 0 && !Matches(row, q)) continue;
            _lines.Add(new Line(row, row.Kind == DiffRowKind.Context ? -1 : hunk));
        }
    }

    List<Line> Visible() {
        return _lines;
    }

    static bool Matches(DiffRow row, string q) {
        return (row.Left?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
               || (row.Right?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    Task RaiseHunk(Line line) {
        if (line.Hunk < 0 || !OnHunk.HasDelegate) return Task.CompletedTask;
        return OnHunk.InvokeAsync(line.Hunk);
    }

    static string Kind(DiffRow row) {
        return row.Kind switch {
            DiffRowKind.Added => "add",
            DiffRowKind.Removed => "rem",
            DiffRowKind.Changed => "chg",
            _ => "ctx"
        };
    }

    static string Glyph(DiffRow row, bool left) {
        if (left) return row.Kind is DiffRowKind.Removed or DiffRowKind.Changed ? "-" : "";
        return row.Kind is DiffRowKind.Added or DiffRowKind.Changed ? "+" : "";
    }

    static RenderFragment Ink(string? text, IReadOnlyList<InkSpan>? spans, string inkClass) {
        return builder => {
            if (text is null) return;
            if (spans is null || spans.Count == 0) {
                builder.AddContent(0, text);
                return;
            }

            var seq = 0;
            var pos = 0;
            foreach (var span in spans) {
                var start = Math.Clamp(span.Start, pos, text.Length);
                var end = Math.Clamp(span.Start + span.Length, start, text.Length);
                if (start > pos) builder.AddContent(seq++, text[pos..start]);
                if (end > start) {
                    builder.OpenElement(seq++, "span");
                    builder.AddAttribute(seq++, "class", inkClass);
                    builder.AddContent(seq++, text[start..end]);
                    builder.CloseElement();
                }

                pos = end;
            }

            if (pos < text.Length) builder.AddContent(seq, text[pos..]);
        };
    }

}
