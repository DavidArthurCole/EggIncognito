<div class="mt-3">
  <button type="button" class="text-xs text-accent2 hover:underline disabled:opacity-60" disabled="@_busy" @onclick="Toggle">
    @(_busy ? "Loading…" : _open ? "Hide" : Label)
  </button>
  @if (_open && _body is not null)
  {
    <pre class="result-pre mt-2 max-h-[55vh] overflow-auto">@_body</pre>
  }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Feed { get; set; } = "";
    [Parameter] public Func<string, Task<string>>? Fetch { get; set; }

    bool _open;
    bool _busy;
    string? _body;

    async Task Toggle()
    {
        _open = !_open;
        if (_open && _body is null && Fetch is not null)
        {
            _busy = true;
            try { _body = await Fetch(Feed); }
            finally { _busy = false; }
        }
    }
}
