@using EggIncognito.Components.Capture
@inject IJSRuntime JS

<div class="ds-chip-row">
    @foreach (var it in Items) {
        <button type="button" class="ds-chip @(_selected == it.Endpoint ? "ds-chip-on" : "")" @onclick="() => Select(it)">
            <span class="truncate">@it.Title</span>
            @if (it.Bytes is { } b) {
                <span class="mono text-muted text-[10px]">@Kb(b)</span>
            }
            @if (it.VersionChip is { } v) {
                <span class="ds-meta-chip">v@v</span>
            }
        </button>
    }
</div>
@if (SelectedItem is { } sel) {
    <div class="mt-2">
        <div class="ds-head flex items-center justify-between gap-3">
            <span class="font-medium truncate">@sel.Title</span>
            <div class="flex items-center gap-1.5 shrink-0">
                <button type="button" class="reg-edit-btn" title="@CopyTitle" aria-label="Copy endpoint path" @onclick="CopyPath">
                    <Icon Name="@(_copied ? "check" : "copy")"/>
                </button>
                <a class="reg-edit-btn" href="@sel.Endpoint" download="@sel.DownloadName" target="_blank" rel="noopener" title="Download JSON" aria-label="Download JSON">
                    <Icon Name="download"/>
                </a>
            </div>
        </div>
        <div class="mt-2">
            @if (!_cache.TryGetValue(sel.Endpoint, out var json)) {
                <div class="text-muted text-xs">Loading…</div>
            } else {
                <FormatView Label="" JsonStr="@json" View="View" FormatChoice="FormatChoice"/>
            }
        </div>
    </div>
}

@code {
    public record SubDataset(string Title, string Endpoint, string DownloadName, long? Bytes, string? VersionChip);

    [Parameter] public List<SubDataset> Items { get; set; } = [];
    [Parameter] public Func<string, Task<string>>? Fetch { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public Dictionary<string, string> FormatChoice { get; set; } = new();

    string? _selected;
    bool _copied;
    IJSObjectReference? _copy;
    readonly Dictionary<string, string> _cache = new();

    SubDataset? SelectedItem => Items.FirstOrDefault(i => i.Endpoint == _selected);

    string CopyTitle => _copied ? "Copied" : "Copy endpoint path";

    async Task Select(SubDataset item) {
        if (_selected == item.Endpoint) {
            _selected = null;
            return;
        }

        _selected = item.Endpoint;
        if (!_cache.ContainsKey(item.Endpoint) && Fetch is not null) {
            _cache[item.Endpoint] = await Fetch(item.Endpoint);
        }
    }

    async Task CopyPath() {
        if (SelectedItem is not { } sel) return;
        try {
            _copy ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/copy.js");
            await _copy.InvokeAsync<bool>("writeText", sel.Endpoint);
            _copied = true;
            StateHasChanged();
            await Task.Delay(1200);
            _copied = false;
        }
        catch {
        }
    }

    static string Kb(long bytes) => $"{bytes / 1024.0:0.#} KB";

}
