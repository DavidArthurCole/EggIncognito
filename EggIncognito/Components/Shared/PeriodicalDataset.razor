@using EggIncognito.Capture
@using EggIncognito.Components.Capture
@inject IJSRuntime JS

<div class="@RowClass">
  <div class="flex items-center justify-between gap-3">
    <div class="flex items-center gap-2 min-w-0">
      @if (Nested) { <span class="ds-elbow" aria-hidden="true"></span> }
      <span class="font-medium truncate" title="@Endpoint">@Title</span>
      @Badges
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
      <button type="button" class="reg-edit-btn" title="@CopyTitle" aria-label="Copy endpoint path" @onclick="CopyPath">
        <Icon Name="@(_copied ? "check" : "copy")" />
      </button>
      <a class="reg-edit-btn" href="@Endpoint" download="@DownloadName" target="_blank" rel="noopener" title="Download JSON" aria-label="Download JSON"><Icon Name="download" /></a>
      <button type="button" class="btn-mini" @onclick="Toggle">@(_open ? "Hide" : "View")</button>
    </div>
  </div>
  @if (_open)
  {
    <div class="mt-2">
      @if (_json is null)
      {
        <div class="text-muted text-xs">Loading…</div>
      }
      else
      {
        <FormatView Label="" JsonStr="@_json" View="View" FormatChoice="FormatChoice" />
      }
    </div>
  }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Badges { get; set; }
    [Parameter] public string Endpoint { get; set; } = "";
    [Parameter] public string DownloadName { get; set; } = "data.json";
    [Parameter] public string? RowClass { get; set; }
    [Parameter] public bool Nested { get; set; }
    [Parameter] public Func<string, Task<string>>? Fetch { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public Dictionary<string, string> FormatChoice { get; set; } = new();

    bool _open;
    string? _json;
    bool _copied;
    IJSObjectReference? _copy;

    string CopyTitle => _copied ? "Copied" : Endpoint;

    async Task Toggle()
    {
        _open = !_open;
        if (_open && _json is null && Fetch is not null) _json = await Fetch(Endpoint);
    }

    async Task CopyPath()
    {
        try
        {
            _copy ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/copy.js");
            await _copy.InvokeAsync<bool>("writeText", Endpoint);
            _copied = true;
            StateHasChanged();
            await Task.Delay(1200);
            _copied = false;
        }
        catch { }
    }
}
