@if (ShowIcon) {
    <label class="@WrapCss">
        <Icon Name="search" Class="icon-sm filter-glass"/>
        @Field()
    </label>
} else {
    @Field()
}

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Filter";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowIcon { get; set; }
    [Parameter] public string? WrapClass { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Additional { get; set; }

    IReadOnlyDictionary<string, object> Attrs {
        get {
            if (Additional is null || Additional.Count == 0) return InputAttrs.NoAutofill;
            Dictionary<string, object> merged = new(InputAttrs.NoAutofill, StringComparer.Ordinal);
            foreach (var pair in Additional) merged[pair.Key] = pair.Value;
            return merged;
        }
    }

    string WrapCss => string.IsNullOrWhiteSpace(WrapClass) ? "filter-field" : $"filter-field {WrapClass}";

    RenderFragment Field() => @<input type="search" class="@Class" id="@Id" placeholder="@Placeholder" aria-label="@AriaLabel"
                                      disabled="@Disabled" value="@Value" @oninput="OnInput" @attributes="Attrs"/>;

    Task OnInput(ChangeEventArgs e) {
        return ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }

}
