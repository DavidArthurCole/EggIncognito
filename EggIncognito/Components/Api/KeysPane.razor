@inherits SelfCallComponentBase
@inject ILogger<KeysPane> Logger
@using EggIncognito.Models.AdminUi
@using TableApiKeyRow = EggIncognito.Models.Admin.ApiKeyRow

@if (!AllScope) {
    <div class="awb-pane">
        <h4 class="awb-pane-title">Your API keys</h4>
        <ApiKeysPanel/>
    </div>
} else {
    <div class="awb-pane">
        <h4 class="awb-pane-title">All API keys</h4>
        @if (_rows.Count == 0) {
            <p class="text-muted text-sm m-0">no api keys</p>
        } else {
            <ApiKeysTable Rows="@TableRows" ShowOwner="true" Busy="_busy" OnRevoke="Revoke" OnDelete="Delete"/>
        }
        @if (_msg is not null) {
            <StatusNote>@_msg</StatusNote>
        }
    </div>
}

@code {
    [Parameter] public bool AllScope { get; set; }

    List<ApiKeyRow> _rows = [];
    bool _busy;
    string? _msg;

    List<TableApiKeyRow> TableRows => _rows.Select(r => new TableApiKeyRow(r.Id, r.OwnerUserId, r.Name, r.Prefix, r.LastUsedAt, r.RequestCount, r.Revoked)).ToList();

    protected override async Task OnInitializedAsync() {
        if (AllScope) await Load();
    }

    async Task Load() {
        _rows = await Client().ListAsync<ApiKeyRow>("/api/admin/api-keys", Logger);
    }

    async Task Revoke(long id) {
        _busy = true;
        _msg = null;
        var ok = await DeleteAsync($"/api/admin/api-keys/{id}");
        _msg = ok ? $"revoked key {id}" : "revoke failed";
        await Load();
        _busy = false;
    }

    async Task Delete(long id) {
        _busy = true;
        _msg = null;
        var ok = await DeleteAsync($"/api/admin/api-keys/{id}/purge");
        _msg = ok ? $"deleted key {id}" : "delete failed";
        await Load();
        _busy = false;
    }

    async Task<bool> DeleteAsync(string url) {
        try {
            return (await Client().DeleteAsync(url)).IsSuccessStatusCode;
        }
        catch (HttpRequestException) {
            return false;
        }
    }

}
