@page "/protos"
@page "/protos/{Platform}/{Build}"
@page "/data"
@page "/periodicals"
@rendermode @(RenderMode.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<Protos> Logger
@inject ProtoWorkbenchState State
@using System.Globalization
@using System.Text.Json
@using EggIncognito.Components.Protos
@using EggIncognito.Services.ProtoExtract
@using EggIncognito.Services.Protos
@using static Components.Protos.ProtoEditDialog
@implements IAsyncDisposable

<PageTitle>EggIncognito - Protos & Data</PageTitle>

<main class="page page-wide pt-6 pb-8">
<h1 class="text-[1.3rem] mt-0 mb-4">Protos &amp; Data</h1>

<div class="pd-grid">
<div class="pd-mod pd-head">
    <DeviceStatusPanel OnManage="OpenDeviceWorkbench"/>
    <section class="panel panel-hcards">
        <h3 class="text-sm font-semibold m-0 mb-2">Versions</h3>
        <div class="pd-versions">
            <LatestVersionsPanel Rows="_rows" OnOpen="OpenVersion"/>
            <div class="pd-vergroup">
                <div class="pd-vergroup-head">
                    <span class="ds-state-k">Server</span>
                    @if (_serverBuiltAt is { } built) {
                        <span class="verline-sep">|</span>
                        <TimeAgo Value="@built"/>
                    }
                </div>
                <div class="pd-serverline">
                    <VersionLine App="@_serverVersion"/><span class="verline-sep">|</span><a class="pd-server-sha" href="@_serverCommitUrl" target="_blank" rel="noopener">@_serverSha</a>
                </div>
            </div>
        </div>
    </section>
    <section class="panel pd-note">
        <div class="min-w-0">
            <h3 class="text-sm font-semibold m-0">Notifications</h3>
            <p class="text-muted text-xs m-0 mt-1">Discord webhooks that fire on new proto builds and periodicals updates.</p>
        </div>
        <button type="button" class="btn-primary" @onclick="OpenNotifications">Manage notifications</button>
    </section>
</div>
<div class="pd-mod pd-main pd-stack">
@if (_isAdmin && _addOpen) {
    <div class="panel">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-2">
            <label class="text-xs text-muted">
                Platform
                <select class="protos-filter w-full" @bind="_addPlatform">
                    <option value="android">android</option>
                    <option value="ios">ios</option>
                </select>
            </label>
            <label class="text-xs text-muted">
                App version
                <FilterInput Class="protos-filter w-full" Placeholder="" AriaLabel="App version" @bind-Value="_addAppVersion"/>
            </label>
            <label class="text-xs text-muted">
                Build
                <FilterInput Class="protos-filter w-full" Placeholder="" AriaLabel="Build" @bind-Value="_addBuild"/>
            </label>
            <label class="text-xs text-muted">
                Client version
                <FilterInput Class="protos-filter w-full" Placeholder="" AriaLabel="Client version" @bind-Value="_addClient"/>
            </label>
            <label class="text-xs text-muted">
                Source
                <FilterInput Class="protos-filter w-full" Placeholder="" AriaLabel="Source" @bind-Value="_addSource"/>
            </label>
        </div>
        <label class="text-xs text-muted block mb-2">
            Proto (optional)
            <textarea class="protos-filter w-full font-mono text-xs" rows="6" @bind="_addProto"></textarea>
        </label>
        <div class="flex items-center gap-2">
            <button type="button" class="btn-primary" disabled="@_addBusy" @onclick="AddVersion">@(_addBusy ? "Saving..." : "Save")</button>
            <span class="text-xs @(_addMsg == "saved" ? "text-accent" : "text-muted")">@_addMsg</span>
        </div>
    </div>
}
@if (_isAdmin || _isContributor) {
    <StagedReviewPanel @ref="_stagedPanel" IsAdmin="_isAdmin" OnChanged="OnMutated"/>
}
@if (_isAdmin && _suggestions.Count > 0) {
    <div class="panel">
        <div class="text-sm font-semibold mb-2">Suggested merges</div>
        <div class="text-xs text-muted mb-2">Same app version + proto SHA across platforms. Merge links them under one entry.</div>
        @foreach (var s in _suggestions) {
            <div class="flex items-center gap-2 flex-wrap mb-1">
                <span class="code-chip">@s.AppVersion</span>
                <span class="text-xs text-muted font-mono">@(s.ProtoSha.Length > 12 ? s.ProtoSha[..12] : s.ProtoSha)</span>
                <span class="text-xs inline-flex items-center gap-1 flex-wrap">
                    @for (var i = 0; i < s.Members.Count; i++) {
                        var member = s.Members[i];
                        if (i > 0) {
                            <span class="text-muted">+</span>
                        }

                        <PlatformIcon Platform="@member.Platform"/>
                        <span>@member.Build</span>
                    }
                </span>
                <button type="button" class="btn-mini" @onclick="@(() => AcceptSuggestion(s))">Merge</button>
            </div>
        }
    </div>
}
@if (_isAdmin && _selected.Count > 0) {
    <ProtoSelectionBar Selected="_selected" Post="PostJson" OnChanged="OnMutated" OnClear="ClearSelection"/>
}
<section class="reg-wrap">
    <div class="reg-toolbar">
        <div class="reg-sort">
            <label class="reg-sort-label" for="regSort">Sort</label>
            <select id="regSort" class="reg-filter-input reg-sort-sel" value="@_sortCol" @onchange="OnSortSelect">
                <option value="platform">Platform</option>
                <option value="appVersion">App version</option>
                <option value="build">Build</option>
                <option value="client">Client</option>
                <option value="sha">Proto SHA</option>
                <option value="detected">Detected</option>
            </select>
            <button type="button" class="reg-sort-dir" aria-label="Toggle sort direction" @onclick="ToggleSortDir">
                @(_sortDesc ? "▾" : "▴")
            </button>
        </div>
        <div class="reg-toolbar-end">
            @if (AnyFilter) {
                <button type="button" class="reg-filter-clear" aria-label="Clear filters" @onclick="ClearFilters">×</button>
            }
            <label id="protoPageDrop" class="reg-intake reg-intake-drop" for="wbFile"
                   title="Drop .ipa, .apk, or bundle files here, or click to browse"
                   aria-label="Drop .ipa, .apk, or bundle files here, or click to browse">
                <Icon Name="arrow-up" Class="icon-sm"/>
            </label>
            <button type="button" class="reg-intake" title="Open the proto workbench"
                    aria-label="Open the proto workbench" @onclick="@(() => _workbench?.Open())">
                <Icon Name="chevronRight" Class="icon-sm"/>
            </button>
            @if (_isAdmin) {
                <button type="button" class="reg-add-toggle" aria-label="@(_addOpen ? "Close add version" : "Add version")"
                        @onclick="@(() => _addOpen = !_addOpen)">
                    @(_addOpen ? "×" : "+")
                </button>
            }
        </div>
    </div>
    @if (_loading && _rows.Count == 0) {
        <div class="backfill-empty">Loading...</div>
    } else if (_rows.Count == 0) {
        <div class="reg-empty">
            <div>No proto versions yet.</div>
            <div class="reg-empty-hint">Drop a build on the toolbar, or open the proto workbench, to add one.</div>
        </div>
    } else {
        var releases = SortedReleases;
        var laneRows = ShaLanes.Build(
            releases.Select(r => r.Key).ToList(),
            releases.Select(r => r.Primary.Key()).ToList(),
            AllReleases.Select(r => r.Primary.Key()).ToList());
        <div class="reg-scroll">
            <table class="data-table reg-table" style="--reg-gutter: @Gutter(ShaLanes.LaneCount(laneRows))">
                <thead>
                <tr>
                    @if (_isAdmin) {
                        <th class="reg-c-sel">
                            <input type="checkbox" checked="@AllSelected" @onchange="ToggleAll"/>
                        </th>
                    }
                    <th class="reg-th-sort reg-c-plat" @onclick="@(() => Sort("platform"))">
                        <span>Platform</span>@Caret("platform")
                    </th>
                    <th class="reg-th-sort reg-c-app" @onclick="@(() => Sort("appVersion"))">
                        <span>App version</span>@Caret("appVersion")
                    </th>
                    <th class="reg-th-sort reg-c-build" @onclick="@(() => Sort("build"))">
                        <span>Build</span>@Caret("build")
                    </th>
                    <th class="reg-th-sort reg-c-client" @onclick="@(() => Sort("client"))">
                        <span>Client</span>@Caret("client")
                    </th>
                    <th class="reg-th-sort reg-c-sha" @onclick="@(() => Sort("sha"))">
                        <span>Proto SHA</span>@Caret("sha")
                    </th>
                    <th class="reg-th-sort reg-c-det" @onclick="@(() => Sort("detected"))">
                        <span>Detected</span>@Caret("detected")
                    </th>
                    <th class="reg-c-act"></th>
                </tr>
                <tr class="reg-filter-row">
                    @if (_isAdmin) {
                        <th class="reg-c-sel"></th>
                    }
                    <th class="reg-c-plat">
                        <select class="reg-filter-input" aria-label="Filter by platform" value="@_fPlatform" @onchange="@(e => { _fPlatform = e.Value?.ToString() ?? ""; })">
                            <option value="">all</option>
                            <option value="android">android</option>
                            <option value="ios">ios</option>
                        </select>
                    </th>
                    <th class="reg-c-app">
                        <FilterInput Class="reg-filter-input" AriaLabel="Filter by app version"
                                     Value="@_fVersion" ValueChanged="@(v => _fVersion = v)"/>
                    </th>
                    <th class="reg-c-build">
                        <FilterInput Class="reg-filter-input" AriaLabel="Filter by build"
                                     Value="@_fBuild" ValueChanged="@(v => _fBuild = v)"/>
                    </th>
                    <th class="reg-c-client">
                        <FilterInput Class="reg-filter-input" AriaLabel="Filter by client version"
                                     Value="@_fClient" ValueChanged="@(v => _fClient = v)"/>
                    </th>
                    <th class="reg-c-sha">
                        <FilterInput Class="reg-filter-input" AriaLabel="Filter by proto sha"
                                     Value="@_fSha" ValueChanged="@(v => _fSha = v)"/>
                    </th>
                    <th class="reg-c-det"></th>
                    <th class="reg-c-act"></th>
                </tr>
                </thead>
                <tbody>
                @if (releases.Count == 0) {
                    <tr>
                        <td colspan="@EditColspan" class="reg-empty">No versions match this filter.</td>
                    </tr>
                }
                @foreach (var rel in releases) {
                    var primary = rel.Primary;
                    var lane = laneRows.GetValueOrDefault(rel.Key);
                    <tr class="reg-row cursor-pointer" @onclick="@(() => OpenVersion(primary))">
                        @if (_isAdmin) {
                            <td class="reg-c-sel" @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@IsSelected(primary)" @onchange="@(() => ToggleRelease(rel))"/>
                            </td>
                        }
                        <td class="reg-c-plat" data-label="Platform">
                            <span class="reg-plats">
                                @foreach (var m in rel.Platforms) {
                                    <a class="reg-plat-link" href="@VersionHref(m)"
                                       @onclick:stopPropagation="true" @onclick:preventDefault="true"
                                       @onclick="@(() => OpenVersion(m))">
                                        <PlatformIcon Platform="@m.Platform"/>
                                    </a>
                                }
                            </span>
                        </td>
                        <td class="reg-version reg-c-app" data-label="App version">@primary.AppVersion</td>
                        <td class="reg-c-build" data-label="Build">
                            @if (rel.IsGrouped) {
                                <span class="reg-builds">
                                    @foreach (var m in rel.Members) {
                                        <a class="reg-build-link" href="@VersionHref(m)" @onclick:stopPropagation="true"
                                           @onclick:preventDefault="true" @onclick="@(() => OpenVersion(m))">
                                            <PlatformIcon Platform="@m.Platform"/>
                                            <span class="reg-num @(m.BuildFlag is null ? "" : "reg-num-bad")">@m.Build</span>
                                        </a>
                                    }
                                </span>
                            } else {
                                <span class="reg-num @(primary.BuildFlag is null ? "" : "reg-num-bad")">@primary.Build</span>
                            }
                            @if (ClientText(primary).Length > 0) {
                                <span class="reg-fold">
                                    <span class="reg-fold-k">client</span><span class="reg-num">@ClientText(primary)</span>
                                </span>
                            }
                            @if (DetectedText(primary).Length > 0) {
                                <span class="reg-fold">
                                    <span class="reg-fold-k">detected</span>@DetectedText(primary)
                                </span>
                            }
                        </td>
                        <td class="reg-num reg-c-client" data-label="Client">@ClientText(primary)</td>
                        <td class="reg-c-sha reg-sha-cell" data-label="Proto SHA">
                            @if (lane is not null) {
                                foreach (var seg in lane.Segments) {
                                    <span class="@LaneClass(seg.Mark)" style="--lane: @seg.Lane"></span>
                                }
                            }
                            <span class="inline-flex items-center gap-1">
                                <span class="code-chip reg-sha"
                                      @onclick:stopPropagation="true" @onclick="@(() => FilterBySha(primary))">
                                    @Short(primary.ProtoSha)
                                </span>
                                @if (primary.SortOrder is { } so && so != 0) {
                                    <span class="text-muted text-xs">@OrderLabel(so)</span>
                                }
                            </span>
                        </td>
                        <td class="text-muted text-xs reg-c-det" data-label="Detected">@DetectedText(primary)</td>
                        <td class="reg-actions reg-c-act" @onclick:stopPropagation="true">
                            <div class="reg-actions-row">
                                <a class="reg-edit-btn" download="@($"{primary.Platform}-{primary.Build}.proto")"
                                   href="@($"/api/protos/versions/{primary.Platform}/{Uri.EscapeDataString(primary.Build)}/proto")"
                                   aria-label="Download .proto">
                                    <Icon Name="download"/>
                                </a>
                                @if (_canWrite) {
                                    <button type="button" class="reg-edit-btn @(_editingKey == rel.Key ? "active" : "")"
                                            aria-label="Edit" @onclick="@(() => ToggleEdit(rel))">
                                        <Icon Name="pencil"/>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (_canWrite && _editingKey == rel.Key) {
                        <tr class="reg-edit-row">
                            <td colspan="@EditColspan">
                                <ProtoEditDialog Targets="EditTargets(rel)" ProtoSha="@primary.ProtoSha"
                                                 ShaOrder="primary.SortOrder ?? 0" CanOrder="_isAdmin"
                                                 Patch="PatchJson" Post="PostJson"
                                                 FetchText="GetText" OnChanged="OnMutated" OnClose="@(() => _editingKey = null)"/>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
</section>
</div>
<div class="pd-mod pd-side">
    <PeriodicalsPanel/>
</div>
</div>
</main>

<NotificationsWorkbenchModal @ref="_notificationsModal"/>
<ProtoWorkbenchModal @ref="_workbench" OnChanged="OnMutated" OnRefChanged="OnWorkbenchRef" OnClosed="OnWorkbenchClosed"/>
<DeviceWorkbenchModal @ref="_deviceWorkbench" OnChanged="OnMutated"/>

@code {
    ProtoWorkbenchModal? _workbench;
    DeviceWorkbenchModal? _deviceWorkbench;

    Task OpenDeviceWorkbench(string? deviceId) {
        return _deviceWorkbench?.Open(deviceId) ?? Task.CompletedTask;
    }

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    List<ProtoRegistryRow> _rows = [];


    string _fPlatform = "";
    string _fVersion = "";
    string _fBuild = "";
    string _fClient = "";
    string _fSha = "";
    bool _loading = true;
    bool _isAdmin;
    bool _isContributor;
    bool _canWrite;


    string _sortCol = "appVersion";
    bool _sortDesc = true;

    bool _addOpen;
    bool _addBusy;
    string _addMsg = "";
    string _addPlatform = "android";
    string _addAppVersion = "";
    string _addBuild = "";
    string _addClient = "";
    string _addSource = "";
    string _addProto = "";

    readonly List<ProtoSelectionBar.SelectionKey> _selected = [];
    long? _editingKey;
    List<MergeSuggestion> _suggestions = [];
    StagedReviewPanel? _stagedPanel;
    NotificationsWorkbenchModal? _notificationsModal;

    Task OpenNotifications() {
        return _notificationsModal?.Open() ?? Task.CompletedTask;
    }

    string _serverVersion = "";
    string _serverSha = "";
    string _serverCommitUrl = "";
    DateTimeOffset? _serverBuiltAt;

    [Parameter] public string? Platform { get; set; }

    [Parameter] public string? Build { get; set; }

    IJSObjectReference? _hashnav;
    IJSObjectReference? _hashListener;
    DotNetObjectReference<Protos>? _selfRef;

    bool HasVersionRoute {
        get {
            if (string.IsNullOrWhiteSpace(Platform) || string.IsNullOrWhiteSpace(Build)) return false;
            if (Platform.Equals("subscribe", StringComparison.OrdinalIgnoreCase)) return false;
            return !Platform.Equals("sources", StringComparison.OrdinalIgnoreCase);
        }
    }

    static string VersionHref(ProtoRegistryRow r) {
        return $"/protos/{r.Platform}/{Uri.EscapeDataString(r.Build)}";
    }

    async Task OpenVersion(ProtoRegistryRow r) {
        var value = new ProtoRef(ProtoRefSource.Registry, r.Platform, r.Build, null);
        _workbench?.OpenAt(value, null, null);
        await PushHash(value.Format());
    }

    Task OnWorkbenchRef(WorkbenchRef value) {
        return WriteHash(ProtoRefParser.Format(value));
    }

    bool _closingFromHash;

    Task OnWorkbenchClosed() {
        return _closingFromHash ? Task.CompletedTask : PushHash("");
    }

    [JSInvokable]
    public Task OnHashChanged(string hash) {
        return InvokeAsync(() => ApplyRef(ProtoRefParser.Parse(hash)));
    }

    void ApplyRef(WorkbenchRef value) {
        if (value.A is null) {
            _closingFromHash = true;
            try {
                _workbench?.Close();
            }
            finally {
                _closingFromHash = false;
            }

            return;
        }

        _workbench?.OpenAt(value.A, value.B, value.Mode);
    }

    async Task StartHashNav() {
        try {
            _hashnav ??= await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/hashnav.js"));
            _selfRef ??= DotNetObjectReference.Create(this);
            _hashListener ??= await _hashnav.InvokeAsync<IJSObjectReference>("listen", _selfRef);
            if (HasVersionRoute) {
                var build = Uri.UnescapeDataString(Build!);
                _workbench?.OpenAt(new ProtoRef(ProtoRefSource.Registry, Platform!, build, null), null, null);
                await _hashnav.InvokeVoidAsync("replacePath", "/protos", $"{Platform}_{build}");
                return;
            }

            ApplyRef(ProtoRefParser.Parse(await _hashnav.InvokeAsync<string>("read")));
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "hash navigation could not be wired");
        }
    }

    async Task WriteHash(string hash) {
        await CallHashNav("write", hash);
    }

    async Task PushHash(string hash) {
        await CallHashNav("push", hash);
    }

    async Task CallHashNav(string fn, string hash) {
        if (_hashnav is null) return;
        try {
            await _hashnav.InvokeVoidAsync(fn, hash);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "the workbench hash could not be updated");
        }
    }


    bool AnyFilter => _fPlatform.Length > 0 || _fVersion.Length > 0 || _fBuild.Length > 0
                      || _fClient.Length > 0 || _fSha.Length > 0;

    static bool Has(string field, string needle) {
        return needle.Length == 0 || field.Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    List<ProtoRegistryRow> Filtered =>
        _rows.Where(r =>
            (_fPlatform.Length == 0 || string.Equals(r.Platform, _fPlatform, StringComparison.OrdinalIgnoreCase))
            && Has(r.AppVersion ?? "", _fVersion)
            && Has(r.Build, _fBuild)
            && Has(r.ClientVersion ?? "", _fClient)
            && Has(r.ProtoSha ?? "", _fSha)).ToList();

    void ClearFilters() {
        _fPlatform = _fVersion = _fBuild = _fClient = _fSha = "";
    }

    static int ByVersion(ProtoRegistryRow a, ProtoRegistryRow b) {
        return ProtoVersionOrdering.Compare(b.Key(), a.Key());
    }

    Comparison<ProtoRegistryRow> RowComparison {
        get {
            Comparison<ProtoRegistryRow> primary = _sortCol switch {
                "platform" => (a, b) => string.Compare(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase),
                "appVersion" => (a, b) => ByVersion(a, b),
                "build" => (a, b) => {
                    var p = string.Compare(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase);
                    return p != 0 ? p : CompareBuild(a.Build, b.Build);
                },
                "client" => (a, b) => CompareNumeric(a.ClientVersion, b.ClientVersion),
                "sha" => (a, b) => string.Compare(a.ProtoSha, b.ProtoSha, StringComparison.OrdinalIgnoreCase),
                _ => (a, b) => a.DetectedAt.GetValueOrDefault().CompareTo(b.DetectedAt.GetValueOrDefault())
            };
            return (a, b) => {
                var v = primary(a, b);
                return v != 0 ? v : ByVersion(a, b);
            };
        }
    }

    List<ProtoRegistryRow> Sorted {
        get {
            var sorted = Filtered;
            sorted.Sort(RowComparison);
            if (_sortDesc) sorted.Reverse();
            return sorted;
        }
    }


    static List<Release> ReleasesOf(IEnumerable<ProtoRegistryRow> rows) {
        var byKey = new Dictionary<long, List<ProtoRegistryRow>>();
        foreach (var r in rows) {
            var key = ReleaseKey(r);
            if (!byKey.TryGetValue(key, out var list)) {
                list = [];
                byKey[key] = list;
            }

            list.Add(r);
        }

        return byKey
            .Select(kv => new Release(kv.Key, kv.Value.OrderBy(m => m.Platform, StringComparer.OrdinalIgnoreCase)
                .ThenByDescending(m => m.Build, BuildComparer).ToList()))
            .ToList();
    }

    List<Release> AllReleases => ReleasesOf(_rows);

    List<Release> SortedReleases {
        get {
            var releases = ReleasesOf(Filtered);
            var cmp = RowComparison;
            releases.Sort((x, y) => cmp(x.Primary, y.Primary));
            if (_sortDesc) releases.Reverse();
            return releases;
        }
    }

    void Sort(string col) {
        if (_sortCol == col) _sortDesc = !_sortDesc;
        else {
            _sortCol = col;
            _sortDesc = false;
        }
    }

    void OnSortSelect(ChangeEventArgs e) {
        var col = e.Value?.ToString() ?? "";
        if (col.Length == 0 || col == _sortCol) return;
        Sort(col);
    }

    void ToggleSortDir() {
        _sortDesc = !_sortDesc;
    }

    void FilterBySha(ProtoRegistryRow r) {
        _fSha = r.ProtoSha ?? "";
    }

    static string Gutter(int lanes) {
        return FormattableString.Invariant($"{lanes * 0.5:0.###}rem");
    }

    static string LaneClass(ShaLaneMark mark) {
        return mark switch {
            ShaLaneMark.Start => "reg-lane reg-lane-start",
            ShaLaneMark.Node => "reg-lane reg-lane-node",
            ShaLaneMark.End => "reg-lane reg-lane-end",
            _ => "reg-lane reg-lane-pass"
        };
    }

    static string ClientText(ProtoRegistryRow r) {
        return r.ClientVersion ?? "";
    }

    static string DetectedText(ProtoRegistryRow r) {
        return r.DetectedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "";
    }

    MarkupString Caret(string col) {
        return new MarkupString(_sortCol == col ? _sortDesc ? " ▾" : " ▴" : "");
    }

    static readonly IComparer<string> BuildComparer = Comparer<string>.Create((a, b) => CompareBuild(a, b));

    static int CompareBuild(string? a, string? b) {
        var an = long.TryParse(a, out var al);
        var bn = long.TryParse(b, out var bl);
        if (an && bn) return al.CompareTo(bl);
        return an != bn ? an.CompareTo(bn) : CompareSemver(a, b);
    }


    static int CompareNumeric(string? a, string? b) {
        var ax = long.TryParse(a, out var al);
        var bx = long.TryParse(b, out var bl);
        if (ax && bx) return al.CompareTo(bl);
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }


    static int CompareSemver(string? a, string? b) {
        var ap = (a ?? "").Split('.');
        var bp = (b ?? "").Split('.');
        var n = Math.Max(ap.Length, bp.Length);
        for (var i = 0; i < n; i++) {
            var av = i < ap.Length && long.TryParse(ap[i], out var x) ? x : 0;
            var bv = i < bp.Length && long.TryParse(bp[i], out var y) ? y : 0;
            if (av != bv) return av.CompareTo(bv);
        }

        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized() {
        base.OnInitialized();

        _isAdmin = User.IsAtLeast(UserRole.Admin);
        _isContributor = User.IsAtLeast(UserRole.Contributor);
        _canWrite = User.IsAtLeast(UserRole.Contributor);

        var b = BuildInfo.FromAssembly("https://github.com/davidarthurcole/EggIncognito");
        _serverVersion = $"v{b.Version}";
        _serverSha = b.ShortSha;
        _serverCommitUrl = b.CommitUrl;
        _serverBuiltAt = DateTime.TryParse(b.BuildDate, CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var built)
            ? new DateTimeOffset(built, TimeSpan.Zero)
            : null;
    }

    protected override async Task OnInitializedAsync() {
        await Load();


        _refresh = ComponentTimers.Every(TimeSpan.FromSeconds(30), () => InvokeAsync(RefreshAll));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        try {
            _protoDrop ??= await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/protoStrip.js"));
            await _protoDrop.InvokeAsync<bool>("wireDrop", "protoPageDrop", "wbFile");
        }
        catch (JSDisconnectedException ex) {
            Logger.LogDebug(ex, "proto drop zone not wired, the circuit is already gone");
        }

        await StartHashNav();
    }

    Timer? _refresh;
    PageVisibility? _vis;
    IJSObjectReference? _protoDrop;

    PageVisibility Vis => _vis ??= new PageVisibility(JS, Env);


    async Task RefreshAll() {
        if (_loading || _busyMutating) return;
        if (!await Vis.IsVisibleAsync()) return;
        await Load(true);
        if (_stagedPanel is not null) await _stagedPanel.Load();
        StateHasChanged();
    }

    bool _busyMutating;

    async Task Load(bool background = false) {
        if (!background) _loading = true;
        try {
            _rows = await Client().GetFromJsonAsync<List<ProtoRegistryRow>>("/api/protos/versions", JsonOpts) ?? [];
            State.Registry = _rows;
            State.RegistryLoadedAt = DateTime.UtcNow;
        }
        catch (Exception ex) {
            if (ex is not OperationCanceledException) Logger.LogWarning(ex, "proto registry load failed");
            if (!background) _rows = [];
        }

        await LoadSuggestions(background);
        if (!background) _loading = false;
    }


    async Task LoadSuggestions(bool background = false) {
        if (!_isAdmin) {
            _suggestions = [];
            return;
        }

        try {
            _suggestions = await Client().GetFromJsonAsync<List<MergeSuggestion>>(
                "/api/protos/versions/merge-suggestions", JsonOpts) ?? [];
        }
        catch {
            if (!background) _suggestions = [];
        }
    }


    async Task AcceptSuggestion(MergeSuggestion s) {
        if (s.Members.Count < 2) return;
        var canonical = new { s.Members[0].Platform, s.Members[0].Build };
        var aliases = s.Members.Skip(1).Select(m => new { m.Platform, m.Build }).ToList();
        var ok = await PostJson("/api/protos/versions/merge", new { canonical, aliases });
        if (ok) await OnMutated();
    }

    public sealed record MergeSuggestion(string AppVersion, string ProtoSha, List<MergeMember> Members);

    public sealed record MergeMember(string Platform, string Build);


    async Task<bool> PostJson(string url, object body) {
        try {
            return (await Client().PostAsJsonAsync(url, body, JsonOpts)).IsSuccessStatusCode;
        }
        catch {
            return false;
        }
    }

    async Task<bool> PatchJson(string url, object body) {
        try {
            return (await Client().PatchAsJsonAsync(url, body, JsonOpts)).IsSuccessStatusCode;
        }
        catch {
            return false;
        }
    }

    async Task<string?> GetText(string url) {
        try {
            var res = await Client().GetAsync(url);
            return res.IsSuccessStatusCode ? await res.Content.ReadAsStringAsync() : "";
        }
        catch {
            return "";
        }
    }

    async Task AddVersion() {
        if (string.IsNullOrWhiteSpace(_addPlatform) || string.IsNullOrWhiteSpace(_addAppVersion) ||
            string.IsNullOrWhiteSpace(_addBuild)) {
            _addMsg = "platform, app version, build required";
            return;
        }

        _addBusy = true;
        _addMsg = "";
        var body = new {
            platform = _addPlatform,
            appVersion = _addAppVersion,
            build = _addBuild,
            clientVersion = string.IsNullOrWhiteSpace(_addClient) ? null : _addClient,
            source = string.IsNullOrWhiteSpace(_addSource) ? null : _addSource,
            proto = string.IsNullOrWhiteSpace(_addProto) ? null : _addProto
        };
        var ok = await PostJson("/api/protos/versions", body);
        _addBusy = false;
        if (ok) {
            _addMsg = "saved";
            _addAppVersion = _addBuild = _addClient = _addSource = _addProto = "";
            _addOpen = false;
            await OnMutated();
        } else {
            _addMsg = "failed (contributor+? build taken?)";
        }
    }

    async Task OnMutated() {
        _busyMutating = true;
        try {
            ClearSelection();
            _editingKey = null;
            await Load();
            if (_stagedPanel is not null) await _stagedPanel.Load();
        }
        finally {
            _busyMutating = false;
        }
    }

    bool IsSelected(ProtoRegistryRow r) {
        return _selected.Any(k => k.Platform == r.Platform && k.Build == r.Build);
    }

    bool AllSelected => Sorted.Count > 0 && Sorted.All(IsSelected);

    void ToggleAll(ChangeEventArgs e) {
        _selected.Clear();
        if (e.Value is true)
            foreach (var r in Sorted)
                _selected.Add(new ProtoSelectionBar.SelectionKey(r.Platform, r.Build));
    }


    void ToggleRelease(Release rel) {
        var allSelected = rel.Members.All(IsSelected);
        foreach (var m in rel.Members) {
            var existing = _selected.FirstOrDefault(k => k.Platform == m.Platform && k.Build == m.Build);
            if (allSelected) {
                if (existing is not null) _selected.Remove(existing);
            } else if (existing is null) _selected.Add(new ProtoSelectionBar.SelectionKey(m.Platform, m.Build));
        }
    }

    void ClearSelection() {
        _selected.Clear();
    }


    void ToggleEdit(Release rel) {
        _editingKey = _editingKey == rel.Key ? null : rel.Key;
    }

    List<Row> EditTargets(Release rel) {
        return rel.Members.Select(m => new Row(m.Platform, m.Build, m.AppVersion ?? "", m.ClientVersion, m.Source ?? ""))
            .ToList();
    }


    int EditColspan => 6 + (_isAdmin ? 1 : 0) + 1;

    static string OrderLabel(int order) {
        return order > 0 ? $"+{order}" : $"{order}";
    }

    static string Short(string? sha) {
        return string.IsNullOrEmpty(sha) ? "" : sha.Length <= 12 ? sha : sha[..12];
    }

    public async ValueTask DisposeAsync() {
        if (_refresh is not null) await _refresh.DisposeAsync();
        if (_vis is not null) await _vis.DisposeAsync();
        await _protoDrop.DisposeModuleAsync(logger: Logger);
        await _hashListener.DisposeModuleAsync("dispose", Logger);
        await _hashnav.DisposeModuleAsync(logger: Logger);
        _selfRef?.Dispose();
    }

    sealed record Release(long Key, IReadOnlyList<ProtoRegistryRow> Members) {
        public ProtoRegistryRow Primary => Members[0];
        public bool IsGrouped => Members.Count > 1;

        public IEnumerable<ProtoRegistryRow> Platforms =>
            Members.DistinctBy(m => m.Platform, StringComparer.OrdinalIgnoreCase);
    }

    static long ReleaseKey(ProtoRegistryRow r) {
        return r.CanonicalId ?? r.Id;
    }

}
