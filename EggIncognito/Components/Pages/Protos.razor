@page "/protos"
@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@using EggIncognito.Components.Layout
@using EggIncognito.Components.Protos
@using EggIncognito.Data.Models
@using Microsoft.JSInterop
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject ICurrentUser User
@inject IJSRuntime JS

<PageTitle>EggIncognito - Proto Registry</PageTitle>

@* Controls project into the top nav (the Inspector/Capture pattern); the page body holds the table. *@
<SectionContent SectionName="@NavSections.Toolbar">
  <ProtosToolbar Platform="@_platform" Filter="@_filter" IsAdmin="_isAdmin"
                 OnPlatformChanged="SetPlatform" OnFilterChanged="SetFilter" OnTrigger="OnTrigger" />
</SectionContent>

<main class="px-4 sm:px-8 pt-6 pb-8">
  <h1 class="text-[1.3rem] mt-0 mb-1">Proto Registry</h1>
  <p class="text-muted mb-4">Versioned Egg, Inc. proto definitions, one row per detected build.</p>

  <section class="reg-wrap">
    @if (_loading)
    {
      <div class="backfill-empty">Loading...</div>
    }
    else if (Filtered.Count == 0)
    {
      <div class="reg-empty">
        @if (_rows.Count == 0)
        {
          <div>No proto versions yet.</div>
          <div class="reg-empty-hint">The device farm and the backfill importers populate this registry as
            new game builds are detected.</div>
        }
        else
        {
          <div>No versions match this filter.</div>
        }
      </div>
    }
    else
    {
      <table class="reg-table">
        <thead>
          <tr>
            <th class="reg-th-sort" @onclick="@(() => Sort("platform"))"><span>Platform</span>@Caret("platform")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("appVersion"))"><span>App Version</span>@Caret("appVersion")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("build"))"><span>Build</span>@Caret("build")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("client"))"><span>Client</span>@Caret("client")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("sha"))"><span>Proto SHA</span>@Caret("sha")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("detected"))"><span>Detected</span>@Caret("detected")</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var r in Sorted)
          {
            var href = $"/protos/{r.Platform}/{Uri.EscapeDataString(r.Build)}";
            <tr class="reg-row" @onclick="@(() => Navigate(href))">
              <td><span class="code-chip">@r.Platform</span></td>
              <td class="reg-version">@r.AppVersion</td>
              <td class="mono">@r.Build</td>
              <td class="mono text-muted">@(string.IsNullOrEmpty(r.ClientVersion) ? "-" : r.ClientVersion)</td>
              <td>
                <button type="button" class="code-chip reg-sha" title="@r.ProtoSha"
                        @onclick:stopPropagation="true" @onclick="@(() => Copy(r.ProtoSha))">
                  @Short(r.ProtoSha)
                </button>
              </td>
              <td class="text-muted text-xs">@r.DetectedAt.ToString("u")</td>
            </tr>
          }
        </tbody>
      </table>
    }
  </section>

  @if (_isAdmin)
  {
    <BackfillPanel />
  }
</main>

@code {
    static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new(System.Text.Json.JsonSerializerDefaults.Web);

    List<VersionRow> _rows = [];
    string? _platform;
    string _filter = "";
    bool _loading = true;
    bool _isAdmin;
    string _sortCol = "detected";
    bool _sortDesc = true;

    string _baseAddress = "";
    string? _cookie;
    IJSObjectReference? _copy;

    List<VersionRow> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? _rows
            : _rows.Where(r => r.AppVersion.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                            || r.Build.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    List<VersionRow> Sorted
    {
        get
        {
            var rows = Filtered;
            Comparison<VersionRow> cmp = _sortCol switch
            {
                "platform" => (a, b) => string.Compare(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase),
                "appVersion" => (a, b) => CompareSemver(a.AppVersion, b.AppVersion),
                "build" => (a, b) => CompareNumeric(a.Build, b.Build),
                "client" => (a, b) => CompareNumeric(a.ClientVersion, b.ClientVersion),
                "sha" => (a, b) => string.Compare(a.ProtoSha, b.ProtoSha, StringComparison.OrdinalIgnoreCase),
                _ => (a, b) => a.DetectedAt.CompareTo(b.DetectedAt),
            };
            var sorted = rows.ToList();
            sorted.Sort(cmp);
            if (_sortDesc) sorted.Reverse();
            return sorted;
        }
    }

    void Sort(string col)
    {
        if (_sortCol == col) _sortDesc = !_sortDesc;
        else { _sortCol = col; _sortDesc = false; }
    }

    MarkupString Caret(string col) =>
        new(_sortCol == col ? (_sortDesc ? " ▾" : " ▴") : "");

    // Numeric strings (versionCode/client) compared as longs; non-numeric falls back to ordinal.
    static int CompareNumeric(string? a, string? b)
    {
        var ax = long.TryParse(a, out var al);
        var bx = long.TryParse(b, out var bl);
        if (ax && bx) return al.CompareTo(bl);
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    // Dotted version compared segment-by-segment numerically so 1.9 < 1.10.
    static int CompareSemver(string? a, string? b)
    {
        var ap = (a ?? "").Split('.');
        var bp = (b ?? "").Split('.');
        var n = Math.Max(ap.Length, bp.Length);
        for (var i = 0; i < n; i++)
        {
            var av = i < ap.Length && long.TryParse(ap[i], out var x) ? x : 0;
            var bv = i < bp.Length && long.TryParse(bp[i], out var y) ? y : 0;
            if (av != bv) return av.CompareTo(bv);
        }
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized()
    {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
        // Snapshot the admin gate during the request; the interactive circuit has no HttpContext.
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    protected override Task OnInitializedAsync() => Load();

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    Task SetPlatform(string? p)
    {
        _platform = p;
        return Load();
    }

    void SetFilter(string f) => _filter = f;

    async Task OnTrigger(string which)
    {
        var url = which switch
        {
            "github" => "/api/protos/backfill/elgranjero",
            "android" => "/api/protos/backfill/list/fandom",
            "apple" => "/api/protos/backfill/list/itunes",
            "resync" => "/api/protos/backfill/runner-resync",
            _ => null,
        };
        if (url is null) return;
        try { await Client().PostAsync(url, null); } catch { }
    }

    async Task Load()
    {
        _loading = true;
        try
        {
            var url = _platform is null ? "/api/protos/versions" : $"/api/protos/versions?platform={_platform}";
            _rows = await Client().GetFromJsonAsync<List<VersionRow>>(url, JsonOpts) ?? [];
        }
        catch { _rows = []; }
        _loading = false;
    }

    void Navigate(string href) => JS.InvokeVoidAsync("location.assign", href);

    async Task Copy(string sha)
    {
        if (string.IsNullOrEmpty(sha)) return;
        try
        {
            _copy ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/copy.js");
            await _copy.InvokeAsync<bool>("writeText", sha);
        }
        catch { }
    }

    static string Short(string sha) => string.IsNullOrEmpty(sha) ? "" : (sha.Length <= 12 ? sha : sha[..12]);

    record VersionRow(string Platform, string AppVersion, string Build, string? ClientVersion,
        string Package, string ProtoSha, DateTimeOffset DetectedAt);
}
