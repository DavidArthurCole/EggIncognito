@page "/protos"
@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@using System.Text.Json
@using EggIncognito.Components.Protos
@using EggIncognito.Data.Models
@using Microsoft.JSInterop
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject ICurrentUser User
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>EggIncognito - Proto Registry</PageTitle>

<main class="px-4 sm:px-8 pt-6 pb-8 max-w-7xl mx-auto w-full">
  <h1 class="text-[1.3rem] mt-0 mb-1">Proto Registry</h1>
  <p class="text-muted mb-4">Versioned Egg, Inc. proto definitions. Drop an .ipa/.apk to analyze, or browse detected builds.</p>

  @* Hero: ephemeral upload-and-analyze (everyone), full width above the registry. *@
  <section class="mb-6">
    <ProtoDropZone OnResult="OnExtracted" />
    @if (_result is not null)
    {
      <ProtoAnalysisResult Result="_result" CanWrite="_canWrite" OnSaved="OnMutated" />
    }
  </section>

  @* Registry beside the side column on wide screens; stacked on smaller ones. The registry (the data-rich
     table) gets the larger share. The side column always shows the device farm (everyone can see it); the
     backfill/discovery panel is added there for admins only. *@
  <div class="grid grid-cols-1 xl:grid-cols-[2fr_1fr] gap-6 items-start">
  @* Registry table + management. *@
  <section class="reg-wrap">
    @if (_isAdmin || _isContributor)
    {
      <StagedReviewPanel @ref="_stagedPanel" IsAdmin="_isAdmin" OnChanged="OnMutated" />
    }
    @if (_isAdmin && _suggestions.Count > 0)
    {
      <div class="panel mb-3">
        <div class="text-sm font-semibold mb-2">Suggested merges</div>
        <div class="text-xs text-muted mb-2">
          These entries share an app version + proto SHA across platforms (the same release on iOS + Android).
          Merging links them under one canonical entry.
        </div>
        @foreach (var s in _suggestions)
        {
          <div class="flex items-center gap-2 flex-wrap mb-1">
            <span class="code-chip">@s.AppVersion</span>
            <span class="text-xs text-muted font-mono">@(s.ProtoSha.Length > 12 ? s.ProtoSha[..12] : s.ProtoSha)</span>
            <span class="text-xs">@string.Join(" + ", s.Members.Select(m => $"{m.Platform}/{m.Build}"))</span>
            <button type="button" class="btn-mini" @onclick="@(() => AcceptSuggestion(s))">Merge</button>
          </div>
        }
      </div>
    }
    @if (_isAdmin && _selected.Count > 0)
    {
      <ProtoSelectionBar Selected="_selected" Post="PostJson" OnChanged="OnMutated" OnClear="ClearSelection" />
    }
    @if (_loading)
    {
      <div class="backfill-empty">Loading...</div>
    }
    else if (Filtered.Count == 0)
    {
      <div class="reg-empty">
        @if (_rows.Count == 0)
        {
          <div>No proto versions yet.</div>
          <div class="reg-empty-hint">Drop a binary above to analyze one, or let the device farm + backfill
            importers populate this registry as new builds are detected.</div>
        }
        else
        {
          <div>No versions match this filter.</div>
        }
      </div>
    }
    else
    {
      <table class="reg-table">
        <thead>
          <tr>
            @if (_isAdmin)
            {
              <th class="w-8"><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" /></th>
            }
            <th class="reg-th-sort" @onclick="@(() => Sort("platform"))"><span>Platform</span>@Caret("platform")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("appVersion"))"><span>App Version</span>@Caret("appVersion")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("build"))"><span>Build</span>@Caret("build")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("client"))"><span>Client</span>@Caret("client")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("sha"))"><span>Proto SHA</span>@Caret("sha")</th>
            <th class="reg-th-sort" @onclick="@(() => Sort("detected"))"><span>Detected</span>@Caret("detected")</th>
            @if (_canWrite)
            {
              <th class="w-10"></th>
            }
          </tr>
          @* ServiceNow-style per-column filter row: a control per column. Replaces the old platform
             segmented slider + the standalone "Filter version" box. Any active filter shows a Clear chip. *@
          <tr class="reg-filter-row">
            @if (_isAdmin)
            {
              <th>
                @if (AnyFilter)
                {
                  <button type="button" class="reg-filter-clear" title="Clear filters" @onclick="ClearFilters">×</button>
                }
              </th>
            }
            <th>
              <select class="reg-filter-input" value="@_fPlatform" @onchange="@(e => { _fPlatform = e.Value?.ToString() ?? ""; })">
                <option value="">all</option>
                <option value="android">android</option>
                <option value="ios">ios</option>
              </select>
            </th>
            <th><input class="reg-filter-input" placeholder="filter" value="@_fVersion" @oninput="@(e => _fVersion = e.Value?.ToString() ?? "")" /></th>
            <th><input class="reg-filter-input" placeholder="filter" value="@_fBuild" @oninput="@(e => _fBuild = e.Value?.ToString() ?? "")" /></th>
            <th><input class="reg-filter-input" placeholder="filter" value="@_fClient" @oninput="@(e => _fClient = e.Value?.ToString() ?? "")" /></th>
            <th><input class="reg-filter-input" placeholder="filter" value="@_fSha" @oninput="@(e => _fSha = e.Value?.ToString() ?? "")" /></th>
            <th></th>
            @if (_canWrite) { <th></th> }
          </tr>
        </thead>
        <tbody>
          @foreach (var rel in SortedReleases)
          {
            var primary = rel.Primary;
            @* The whole row opens the primary member's detail; the checkbox, SHA, and Edit cells stop
               propagation so they keep their own behavior, and a grouped release's per-platform chips/builds
               override with their own member link. *@
            <tr class="reg-row cursor-pointer"
                @onclick="@(() => Navigate($"/protos/{primary.Platform}/{Uri.EscapeDataString(primary.Build)}"))">
              @if (_isAdmin)
              {
                <td @onclick:stopPropagation="true">
                  @* select toggles every member of the release together *@
                  <input type="checkbox" checked="@IsSelected(primary)" @onchange="@(() => ToggleRelease(rel))" />
                </td>
              }
              <td>
                @* one chip per platform in the release; each links to its own detail page *@
                <div class="flex flex-wrap gap-1">
                  @foreach (var m in rel.Members)
                  {
                    <span class="code-chip cursor-pointer" @onclick:stopPropagation="true"
                          @onclick="@(() => Navigate($"/protos/{m.Platform}/{Uri.EscapeDataString(m.Build)}"))">@m.Platform</span>
                  }
                </div>
              </td>
              <td class="reg-version">@primary.AppVersion</td>
              <td class="mono">
                @if (rel.IsGrouped)
                {
                  <div class="flex flex-col gap-0.5">
                    @foreach (var m in rel.Members)
                    {
                      <span class="cursor-pointer flex flex-col gap-0.5 items-start" @onclick:stopPropagation="true" @onclick="@(() => Navigate($"/protos/{m.Platform}/{Uri.EscapeDataString(m.Build)}"))">
                        <span><span class="text-muted text-xs">@m.Platform</span> @m.Build</span>
                        @if (m.BuildFlag is not null) { <span class="reg-badwarn" title="@BuildFlagTitle(m.BuildFlag)">bad build</span> }
                      </span>
                    }
                  </div>
                }
                else
                {
                  <div class="flex flex-col gap-0.5 items-start">
                    <span>@primary.Build</span>
                    @if (primary.BuildFlag is not null) { <span class="reg-badwarn" title="@BuildFlagTitle(primary.BuildFlag)">bad build</span> }
                  </div>
                }
              </td>
              <td class="mono text-muted">@(string.IsNullOrEmpty(primary.ClientVersion) ? "-" : primary.ClientVersion)</td>
              <td>
                <button type="button" class="code-chip reg-sha" title="@primary.ProtoSha"
                        @onclick:stopPropagation="true" @onclick="@(() => Copy(primary.ProtoSha))">
                  @Short(primary.ProtoSha)
                </button>
              </td>
              <td class="text-muted text-xs">@primary.DetectedAt.ToString("u")</td>
              @if (_canWrite)
              {
                <td @onclick:stopPropagation="true">
                  @* pencil per release; opens an inline editor row right below this one (no scroll to top) *@
                  <button type="button" class="reg-edit-btn @(_editingKey == rel.Key ? "active" : "")"
                          title="Edit" aria-label="Edit" @onclick="@(() => ToggleEdit(rel))">
                    <Icon Name="pencil" />
                  </button>
                </td>
              }
            </tr>
            @if (_canWrite && _editingKey == rel.Key)
            {
              <tr class="reg-edit-row">
                <td colspan="@EditColspan">
                  <ProtoEditDialog Targets="EditTargets(rel)" Patch="PatchJson"
                                   OnChanged="OnMutated" OnClose="@(() => _editingKey = null)" />
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
    }
  </section>

  @* Side column: device farm + missing-versions (everyone), then the Notifications + Sources widgets
     (formerly modals). Sources carries the admin-only backfill trigger buttons; each panel gates its own
     write actions, the server ACL is the real gate. *@
  <div class="flex flex-col gap-6">
    <DeviceStatusPanel OnSaved="OnMutated" />
    <MissingVersionsPanel />
    <section class="panel">
      <h3 class="text-sm font-semibold mt-0 mb-2">Notifications</h3>
      <ProtoSubscribePanel />
    </section>
    <section class="panel">
      <h3 class="text-sm font-semibold mt-0 mb-2">Sources</h3>
      <ProtoSourcesPanel IsAdmin="_isAdmin" OnTrigger="OnTrigger" />
    </section>
  </div>
  </div>
</main>


@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    List<VersionRow> _rows = [];
    // Per-column filters (the ServiceNow-style filter row). All are AND-combined, case-insensitive substring;
    // platform is an exact dropdown. Replaces the old platform slider + single "filter version" box.
    string _fPlatform = "";
    string _fVersion = "";
    string _fBuild = "";
    string _fClient = "";
    string _fSha = "";
    bool _loading = true;
    bool _isAdmin;
    bool _isContributor;
    bool _canWrite;
    // Default sort = app version desc. Detected-date is useless as the default because bulk imports (backfill,
    // crawl approvals) all land with today's date; app version groups releases sensibly newest-first.
    string _sortCol = "appVersion";
    bool _sortDesc = true;

    ProtoDropZone.ExtractResult? _result;
    readonly List<ProtoSelectionBar.VersionKey> _selected = [];
    int? _editingKey;   // release key whose inline editor row is open (null = none)
    List<MergeSuggestion> _suggestions = [];
    StagedReviewPanel? _stagedPanel;

    string _baseAddress = "";
    string? _cookie;
    IJSObjectReference? _copy;

    bool AnyFilter => _fPlatform.Length > 0 || _fVersion.Length > 0 || _fBuild.Length > 0
                   || _fClient.Length > 0 || _fSha.Length > 0;

    static bool Has(string field, string needle) =>
        needle.Length == 0 || field.Contains(needle, StringComparison.OrdinalIgnoreCase);

    List<VersionRow> Filtered =>
        _rows.Where(r =>
            (_fPlatform.Length == 0 || string.Equals(r.Platform, _fPlatform, StringComparison.OrdinalIgnoreCase))
            && Has(r.AppVersion, _fVersion)
            && Has(r.Build, _fBuild)
            && Has(r.ClientVersion ?? "", _fClient)
            && Has(r.ProtoSha, _fSha)).ToList();

    void ClearFilters()
    {
        _fPlatform = _fVersion = _fBuild = _fClient = _fSha = "";
    }

    List<VersionRow> Sorted
    {
        get
        {
            var rows = Filtered;
            Comparison<VersionRow> cmp = _sortCol switch
            {
                "platform" => (a, b) => string.Compare(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase),
                "appVersion" => (a, b) => CompareSemver(a.AppVersion, b.AppVersion),
                "build" => (a, b) => CompareNumeric(a.Build, b.Build),
                "client" => (a, b) => CompareNumeric(a.ClientVersion, b.ClientVersion),
                "sha" => (a, b) => string.Compare(a.ProtoSha, b.ProtoSha, StringComparison.OrdinalIgnoreCase),
                _ => (a, b) => a.DetectedAt.CompareTo(b.DetectedAt),
            };
            var sorted = rows.ToList();
            sorted.Sort(cmp);
            if (_sortDesc) sorted.Reverse();
            return sorted;
        }
    }

    // Releases in the sorted order of their primary (first-appearing member). Grouping a merged release into
    // one row means the table iterates releases, not raw rows. A release's primary = the highest-ranked member
    // under the current sort (it appears first in Sorted), so first-seen order preserves the column sort.
    List<Release> SortedReleases
    {
        get
        {
            var byKey = new Dictionary<int, List<VersionRow>>();
            var order = new List<int>();
            foreach (var r in Sorted)
            {
                var key = ReleaseKey(r);
                if (!byKey.TryGetValue(key, out var list)) { list = []; byKey[key] = list; order.Add(key); }
                list.Add(r);
            }
            return order.Select(k => new Release(k, byKey[k].OrderBy(m => m.Platform).ToList())).ToList();
        }
    }

    void Sort(string col)
    {
        if (_sortCol == col) _sortDesc = !_sortDesc;
        else { _sortCol = col; _sortDesc = false; }
    }

    MarkupString Caret(string col) => new(_sortCol == col ? (_sortDesc ? " ▾" : " ▴") : "");

    static int CompareNumeric(string? a, string? b)
    {
        var ax = long.TryParse(a, out var al);
        var bx = long.TryParse(b, out var bl);
        if (ax && bx) return al.CompareTo(bl);
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    // Human label for a computed build-quality flag (see ProtoVersionQuality).
    static string BuildFlagTitle(string flag) => flag switch
    {
        "android_build_on_ios" => "iOS row has an Android-style integer build (versionCode) - mislabeled data",
        _ => "build does not match platform",
    };

    static int CompareSemver(string? a, string? b)
    {
        var ap = (a ?? "").Split('.');
        var bp = (b ?? "").Split('.');
        var n = Math.Max(ap.Length, bp.Length);
        for (var i = 0; i < n; i++)
        {
            var av = i < ap.Length && long.TryParse(ap[i], out var x) ? x : 0;
            var bv = i < bp.Length && long.TryParse(bp[i], out var y) ? y : 0;
            if (av != bv) return av.CompareTo(bv);
        }
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized()
    {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
        // Snapshot the gates during the request; the interactive circuit has no HttpContext.
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        _isContributor = User.IsAtLeast(UserRole.Contributor);
        _canWrite = User.IsAtLeast(UserRole.Contributor);
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
        // Hyper-reactive: poll every few seconds so changes from ANY source (other reviewers, the heartbeat,
        // a device save, a staged approve in another tab) surface here promptly - the registry table, the
        // merge suggestions, and the staged queue all reload together. Local mutations still refresh instantly
        // via OnMutated; this is the background safety net. Runs on the circuit thread via InvokeAsync.
        _refresh = new Timer(async _ => await InvokeAsync(RefreshAll), null,
            TimeSpan.FromSeconds(6), TimeSpan.FromSeconds(6));
    }

    Timer? _refresh;

    // Reload everything the page shows, without touching the user's current selection/edit state mid-action.
    async Task RefreshAll()
    {
        if (_loading || _busyMutating) return; // don't fight an in-flight load or a mutation
        await Load();
        if (_stagedPanel is not null) await _stagedPanel.Load();
        StateHasChanged();
    }

    bool _busyMutating;

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    void OnExtracted(ProtoDropZone.ExtractResult r) => _result = r;

    async Task OnTrigger(string which)
    {
        var url = which switch
        {
            "github" => "/api/protos/backfill/elgranjero",
            "android" => "/api/protos/backfill/list/fandom",
            "resync" => "/api/protos/backfill/runner-resync",
            "farm" => "/api/devices/refresh-all",
            _ => null,
        };
        if (url is null) return;
        try { await Client().PostAsync(url, null); } catch { }
    }

    async Task Load()
    {
        _loading = true;
        try
        {
            // Always fetch the full set; the per-column filter row narrows it client-side.
            _rows = await Client().GetFromJsonAsync<List<VersionRow>>("/api/protos/versions", JsonOpts) ?? [];
        }
        catch { _rows = []; }
        await LoadSuggestions();
        _loading = false;
    }

    // Cross-platform merge suggestions: rows sharing app version + proto SHA across platforms. Admin-only UI
    // (the merge action is admin-gated server-side too). Best-effort; a failure just hides the banner.
    async Task LoadSuggestions()
    {
        if (!_isAdmin) { _suggestions = []; return; }
        try { _suggestions = await Client().GetFromJsonAsync<List<MergeSuggestion>>(
            "/api/protos/versions/merge-suggestions", JsonOpts) ?? []; }
        catch { _suggestions = []; }
    }

    // One-click: merge a suggested group, keeping the FIRST member (alphabetical by platform = android) as the
    // canonical, the rest as aliases. Admin-gated server-side.
    async Task AcceptSuggestion(MergeSuggestion s)
    {
        if (s.Members.Count < 2) return;
        var canonical = new { s.Members[0].Platform, s.Members[0].Build };
        var aliases = s.Members.Skip(1).Select(m => new { m.Platform, m.Build }).ToList();
        var ok = await PostJson("/api/protos/versions/merge", new { canonical, aliases });
        if (ok) await OnMutated();
    }

    public sealed record MergeSuggestion(string AppVersion, string ProtoSha, List<MergeMember> Members);
    public sealed record MergeMember(string Platform, string Build);

    // Generic authed self-calls for the management components.
    async Task<bool> PostJson(string url, object body)
    {
        try { return (await Client().PostAsJsonAsync(url, body, JsonOpts)).IsSuccessStatusCode; }
        catch { return false; }
    }

    async Task<bool> PatchJson(string url, object body)
    {
        try { return (await Client().PatchAsJsonAsync(url, body, JsonOpts)).IsSuccessStatusCode; }
        catch { return false; }
    }

    async Task OnMutated()
    {
        _busyMutating = true;
        try
        {
            ClearSelection();
            _editingKey = null;
            await Load();
            if (_stagedPanel is not null) await _stagedPanel.Load();
        }
        finally { _busyMutating = false; }
    }

    bool IsSelected(VersionRow r) => _selected.Any(k => k.Platform == r.Platform && k.Build == r.Build);

    void ToggleRow(VersionRow r)
    {
        var existing = _selected.FirstOrDefault(k => k.Platform == r.Platform && k.Build == r.Build);
        if (existing is not null) _selected.Remove(existing);
        else _selected.Add(new ProtoSelectionBar.VersionKey(r.Platform, r.Build));
    }

    bool AllSelected => Sorted.Count > 0 && Sorted.All(IsSelected);

    void ToggleAll(ChangeEventArgs e)
    {
        _selected.Clear();
        if (e.Value is true)
            foreach (var r in Sorted) _selected.Add(new ProtoSelectionBar.VersionKey(r.Platform, r.Build));
    }

    // A release's checkbox toggles every member at once (so a delete/merge of a grouped release acts on all
    // its platform rows). Mixed state counts as "select all members".
    void ToggleRelease(Release rel)
    {
        var allSelected = rel.Members.All(IsSelected);
        foreach (var m in rel.Members)
        {
            var existing = _selected.FirstOrDefault(k => k.Platform == m.Platform && k.Build == m.Build);
            if (allSelected) { if (existing is not null) _selected.Remove(existing); }
            else if (existing is null) _selected.Add(new ProtoSelectionBar.VersionKey(m.Platform, m.Build));
        }
    }

    void ClearSelection() => _selected.Clear();

    // Inline editor: clicking the pencil opens an editor row directly under the release (toggle to close).
    // A standalone row edits one member; a merged release edits all its platform members in one dialog.
    void ToggleEdit(Release rel) => _editingKey = _editingKey == rel.Key ? null : rel.Key;

    List<ProtoEditDialog.Row> EditTargets(Release rel) =>
        rel.Members
            .Select(m => new ProtoEditDialog.Row(m.Platform, m.Build, m.AppVersion, m.ClientVersion, m.Source))
            .ToList();

    // Span the inline editor row across every column: checkbox (admin) + 6 data + actions (canWrite).
    int EditColspan => 6 + (_isAdmin ? 1 : 0) + (_canWrite ? 1 : 0);

    void Navigate(string href) => _ = JS.InvokeVoidAsync("location.assign", href);

    async Task Copy(string sha)
    {
        if (string.IsNullOrEmpty(sha)) return;
        try
        {
            _copy ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/copy.js");
            await _copy.InvokeAsync<bool>("writeText", sha);
        }
        catch { }
    }

    static string Short(string sha) => string.IsNullOrEmpty(sha) ? "" : (sha.Length <= 12 ? sha : sha[..12]);

    public async ValueTask DisposeAsync()
    {
        if (_refresh is not null) await _refresh.DisposeAsync();
        if (_copy is not null)
            try { await _copy.DisposeAsync(); } catch { }
    }

    record VersionRow(int Id, int? CanonicalId, string Platform, string AppVersion, string Build,
        string? ClientVersion, string Source, string Package, string ProtoSha, DateTimeOffset DetectedAt,
        string? BuildFlag = null);

    // A release = a canonical row + any aliases merged into it (same app version + proto across platforms).
    // ReleaseKey groups them: an alias keys on its CanonicalId, a standalone row on its own Id. Members are
    // ordered platform-stably so the grouped row renders deterministically.
    sealed record Release(int Key, IReadOnlyList<VersionRow> Members)
    {
        public VersionRow Primary => Members[0];
        public bool IsGrouped => Members.Count > 1;
    }

    static int ReleaseKey(VersionRow r) => r.CanonicalId ?? r.Id;

    List<Release> GroupedReleases(IEnumerable<VersionRow> rows) =>
        rows.GroupBy(ReleaseKey)
            .Select(g => new Release(g.Key, g.OrderBy(m => m.Platform).ToList()))
            .ToList();
}
