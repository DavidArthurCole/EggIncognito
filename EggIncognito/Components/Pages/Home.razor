@page "/"
<PageTitle>EggIncognito</PageTitle>
<main class="page page-hero pt-12 pb-12">
    <h1 class="sr-only">EggIncognito</h1>
    @if (LoginError == 1) {
        <p class="panel text-red-500 text-sm mb-6">Login failed. Please try again.</p>
    }
    <img class="block w-full max-w-[420px] h-auto mb-4" src="/brand/wordmark.png" alt="EggIncognito"/>
    <p class="text-[0.9375rem] text-muted mb-8">A mock server and toolkit for the Egg, Inc. API.</p>
    <div class="flex flex-wrap gap-3 mb-16">
        <a class="btn-primary" href="/inspector/">Inspector</a>
        <a class="btn-primary" href="/capture/">Capture</a>
        <a class="btn-primary" href="/protos">Protos &amp; Data</a>
    </div>

    <footer class="home-footer">
        <p class="text-muted text-sm leading-relaxed mb-3">
            EggIncognito is an independent, fan-made tool and is not affiliated with, endorsed by, or
            sponsored by Auxbrain Inc.<br/>Egg, Inc. and related marks are the property of their respective owners.
        </p>
        <p class="text-muted text-sm m-0">
            <a href="/terms" class="text-accent underline">Terms</a>
            <span class="mx-2">/</span>
            <a href="/privacy" class="text-accent underline">Privacy &amp; Cookies</a>
            <span class="mx-2">/</span>
            <a href="https://github.com/DavidArthurCole/EggIncognito/blob/main/LICENSE" target="_blank" rel="noopener" class="text-accent underline">MIT License</a>
            <span class="mx-2">/</span>
            © 2026 David Cole
        </p>
    </footer>
</main>

@code {

    [SupplyParameterFromQuery(Name = "login_error")]
    public int LoginError { get; set; }

}
