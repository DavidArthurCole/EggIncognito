    public async ValueTask DisposeAsync()
    {
        if (_mod is not null)
        {
            try { await _mod.InvokeVoidAsync("dispose"); } catch { }
            try { await _mod.DisposeAsync(); } catch { }
        }
        if (_designer is not null)
        {
            try { await _designer.InvokeVoidAsync("disposeDesigner"); } catch { }
            try { await _designer.DisposeAsync(); } catch { }
        }
        if (_autosave is not null) { try { await _autosave.DisposeAsync(); } catch { } }
        if (_recorder is not null) { try { await _recorder.DisposeAsync(); } catch { } }
        _autosaveCts?.Cancel();
        _selfRef?.Dispose();
    }
