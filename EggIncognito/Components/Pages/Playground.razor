@page "/playground"
@rendermode @(RenderMode.InteractiveServer)
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using System.Net.Http.Json
@using EggIncognito.Services.ProtoExtract
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

<PageTitle>EggIncognito - 3D Playground</PageTitle>

@if (!_isAdmin)
{
  <main class="px-8 pt-6 pb-8 max-w-[1100px]">
    <h1 class="text-[1.3rem] mt-0 mb-4">3D Playground</h1>
    <div class="panel">Admin access required. <a class="auth-btn" href="/login?returnUrl=/playground">Log in</a></div>
  </main>
}
else
{
<main class="px-8 pt-6 pb-8">
  <h1 class="text-[1.3rem] mt-0 mb-1">3D Playground</h1>
  <p class="text-muted text-xs mb-4">
    Free-place game elements: add habs, silos, chickens and shells, drag the gizmo to arrange them, light the
    scene, and save named designs. Drag to orbit, scroll to zoom.
  </p>

  <div class="flex gap-4 flex-wrap">
    <section class="panel flex-1 min-w-[480px]" style="overflow: visible;">
      <div class="canvas-wrap relative">
        <canvas @ref="_canvas" id="playgroundCanvas"></canvas>
        @if (!string.IsNullOrEmpty(_fatalError))
        {
          <div class="canvas-error-overlay">
            <div class="canvas-error-box">
              <div class="font-semibold mb-1">Playground error</div>
              <div class="text-xs mb-3">@_fatalError</div>
              <button class="btn-secondary" @onclick="DismissFatal">Dismiss</button>
            </div>
          </div>
        }
      </div>
    </section>

    <section class="w-[340px] flex flex-col gap-2 self-start max-h-[85vh] overflow-auto">
      <div class="designer-section">
        <div class="designer-section-head">Scene</div>
        <div class="designer-section-body flex flex-col gap-3">
          <button class="btn-secondary w-full" @onclick="ResetView">Reset view</button>
        </div>
      </div>

      <div class="designer-section">
        <div class="designer-section-head flex items-center justify-between">
          <span>Design</span>
          @if (!string.IsNullOrEmpty(_currentDesign))
          {
            <span class="text-muted text-[11px]">@_currentDesign@(_dirty ? " •" : "")</span>
          }
        </div>
        <div class="designer-section-body flex flex-col gap-2 text-xs">
          @if (string.IsNullOrEmpty(_currentDesign))
          {
            <div class="text-muted">New design (unsaved). Name it + save to start its history.</div>
            <input class="reg-filter-input w-full" placeholder="Design name…" value="@_designName" @oninput="OnDesignNameInput" />
          }
          else
          {
            <div class="text-muted">Editing <b>@_currentDesign</b> (v@_currentVersion). Saving adds a new version.</div>
          }
          <input class="reg-filter-input w-full" placeholder="Version note (optional)…" value="@_versionNote" @oninput="e => _versionNote = e.Value?.ToString() ?? string.Empty" />
          <div class="flex gap-2">
            <button class="btn-primary flex-1" @onclick="SaveDesign" disabled="@(SaveDisabled)">@(string.IsNullOrEmpty(_currentDesign) ? "Save design" : "Save new version")</button>
            @if (!string.IsNullOrEmpty(_currentDesign))
            {
              <button class="btn-secondary" @onclick="NewDesign" title="Start a fresh design">New</button>
            }
          </div>

          <div class="border-t border-border pt-2 mt-1 flex flex-col gap-2">
            <select class="reg-filter-input w-full" @bind="_selectedDesign" @bind:after="LoadDesign">
              <option value="">Open a saved design…</option>
              @foreach (var n in _savedDesigns) { <option value="@n">@n</option> }
            </select>
            @if (!string.IsNullOrEmpty(_currentDesign))
            {
              <button class="btn-secondary w-full" @onclick="DeleteDesign">Delete this design</button>
            }
          </div>

          @if (!string.IsNullOrEmpty(_currentDesign) && _versions.Count > 0)
          {
            <div class="border-t border-border pt-2 mt-1">
              <div class="picker-group-title">History</div>
              <div class="flex flex-col gap-1 max-h-48 overflow-auto">
                @foreach (var v in _versions)
                {
                  <div class="flex items-center justify-between gap-2 px-2 py-1 rounded-md bg-panel2 border border-border">
                    <span class="truncate">v@(v.VersionNo)@(v.VersionNo == _currentVersion ? " (current)" : "")@(string.IsNullOrEmpty(v.Note) ? "" : $" — {v.Note}")</span>
                    @if (v.VersionNo != _currentVersion)
                    {
                      <button class="element-del" title="Roll back to this version" @onclick="() => RollbackTo(v.VersionNo)">restore</button>
                    }
                  </div>
                }
              </div>
            </div>
          }
        </div>
      </div>

      <div class="designer-section">
        <div class="designer-section-head">Lighting + Colors</div>
        <div class="designer-section-body grid grid-cols-2 gap-3 text-xs">
          <label class="light-field"><span>Background</span>
            <span class="flex items-center gap-2">
              <input type="color" class="bg-picker-input" @bind="_bgColor" @bind:event="oninput" @bind:after="ApplyBackground" disabled="@_bgTransparent" />
              <label class="settings-check"><input type="checkbox" @bind="_bgTransparent" @bind:after="ApplyBackground" /><span class="text-muted ml-1">None</span></label>
            </span>
          </label>
          <div></div>
          <label class="light-field"><span>Sun azimuth</span><input type="range" min="0" max="360" class="w-full" @bind="_lighting.SunAzimuthDeg" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Sun elevation</span><input type="range" min="0" max="90" class="w-full" @bind="_lighting.SunElevationDeg" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Sun color</span><input type="color" class="bg-picker-input" @bind="_lighting.SunColor" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Sun intensity</span><input type="range" min="0" max="3" step="0.05" class="w-full" @bind="_lighting.SunIntensity" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Ambient fill</span><input type="range" min="0" max="2" step="0.05" class="w-full" @bind="_lighting.AmbientIntensity" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Sky fill</span><input type="range" min="0" max="2" step="0.05" class="w-full" @bind="_lighting.HemiIntensity" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Emission (vibrancy)</span><input type="range" min="0" max="1.5" step="0.05" class="w-full" @bind="_lighting.Emission" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Tone mapping</span>
            <select class="reg-filter-input w-full" @bind="_lighting.ToneMapping" @bind:after="ApplyLighting">
              <option value="none">None (punchy)</option>
              <option value="linear">Linear</option>
              <option value="aces">ACES filmic</option>
              <option value="reinhard">Reinhard</option>
              <option value="cineon">Cineon</option>
            </select>
          </label>
          <label class="light-field"><span>Exposure</span><input type="range" min="0.1" max="3" step="0.05" class="w-full" @bind="_lighting.Exposure" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Fog color</span><input type="color" class="bg-picker-input" @bind="_lighting.FogColor" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Fog density</span><input type="range" min="0" max="0.03" step="0.0005" class="w-full" @bind="_lighting.FogDensity" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
        </div>
      </div>

      @if (_designMode)
      {
        <div class="designer-section">
          <div class="designer-section-head">Record loop GIF</div>
          <div class="designer-section-body flex flex-col gap-2 text-xs">
            <label class="light-field"><span>FPS</span>
              <input type="number" min="5" max="30" class="reg-filter-input w-[70px]" @bind="_gifFps" />
            </label>
            <label class="light-field"><span>Size</span>
              <select class="reg-filter-input w-full" @bind="_gifMaxWidth">
                <option value="0">Full</option>
                <option value="640">Medium (640)</option>
                <option value="400">Small (400)</option>
              </select>
            </label>
            <button class="btn-secondary" @onclick="RecordGif" disabled="@(!_anyAnimated || _recording)">
              @(_recording ? "Recording…" : "Record GIF")
            </button>
            @if (!_anyAnimated)
            {
              <div class="text-muted">Set an animation on an element to record.</div>
            }
            @if (_recording)
            {
              <div class="text-muted">@_recordStage @($"{_recordFraction * 100:0}%")</div>
            }
          </div>
        </div>
      }
    </section>

    @if (_designMode)
    {
      <section class="w-[300px] flex flex-col gap-2 self-start max-h-[85vh] overflow-auto">
        <div class="designer-section">
          <div class="designer-section-head">Elements</div>
          <div class="designer-section-body">
            <button class="btn-primary w-full" @onclick="() => _pickerOpen = !_pickerOpen">@(_pickerOpen ? "Close picker" : "Add element")</button>
            <button class="btn-secondary w-full mt-2" @onclick="AutoArrangeFarm" disabled="@_busy">Auto-arrange farm</button>
            @if (!string.IsNullOrEmpty(_status))
            {
              <div class="text-xs mt-1 @(_error ? "err" : "text-muted")">@_status</div>
            }
            @if (_pickerOpen)
            {
              <div class="picker mt-2">
                <div class="flex mb-1">
                  <button class="picker-tab @(_pickerTab == "building" ? "active" : "")" @onclick='() => _pickerTab = "building"'>Buildings</button>
                  <button class="picker-tab @(_pickerTab == "chicken" ? "active" : "")" @onclick='() => _pickerTab = "chicken"'>Chicken</button>
                  <button class="picker-tab @(_pickerTab == "actor" ? "active" : "")" @onclick='() => _pickerTab = "actor"'>Actors</button>
                </div>
                <div class="picker-body">
                  @if (_pickerTab == "building")
                  {
                    @if (_catalogPieces.Count == 0) { <div class="text-xs text-muted">Catalog empty.</div> }
                    @foreach (var grp in _catalogPieces.Where(p => p.Group != "Vehicles" && p.Group != "Ships").GroupBy(p => p.Group))
                    {
                      <div class="picker-group-title">@grp.Key</div>
                      @* one entry per family (placing the highest tier; tier is changed on the placed element);
                         non-family pieces shown individually. *@
                      @foreach (var entry in FamilyPickerEntries(grp))
                      {
                        var reason = PlacementBlockedReason(entry.Piece);
                        <button class="picker-item" @onclick='() => AddElement("env", entry.Piece.Stem, entry.Piece.Label)' disabled="@(reason is not null)">@entry.Display@(reason is null ? "" : $" ({reason})")</button>
                      }
                    }
                  }
                  else if (_pickerTab == "actor")
                  {
                    <div class="picker-group-title">Chicken</div>
                    @if (_chickens.Count > 0)
                    {
                      var firstChick = _chickens[0];
                      <button class="picker-item" @onclick='() => AddActor("chicken", firstChick.Identifier, "Running chicken")'>Running chicken</button>
                    }
                    else { <div class="text-xs text-muted">No chickens (ingest a config in Admin).</div> }
                    <div class="picker-group-title">Vehicles</div>
                    @foreach (var v in _catalogPieces.Where(p => p.Group == "Vehicles"))
                    {
                      <button class="picker-item" @onclick='() => AddActor("vehicle", v.Stem, v.Label)'>@v.Label</button>
                    }
                    <div class="picker-group-title">Rocket</div>
                    @foreach (var s in _catalogPieces.Where(p => p.Group == "Ships"))
                    {
                      <button class="picker-item" @onclick='() => AddActor("rocket", s.Stem, s.Label)'>@s.Label</button>
                    }
                  }
                  else
                  {
                    @if (_chickens.Count == 0) { <div class="text-xs text-muted">No chickens (ingest a config in Admin).</div> }
                    @foreach (var c in _chickens)
                    {
                      <button class="picker-item" @onclick='() => AddElement("chicken", c.Identifier, c.Name ?? c.Identifier)'>@(c.Name ?? c.Identifier)</button>
                    }
                  }
                </div>
              </div>
            }
            <div class="text-xs text-muted mt-2">
              @if (_elements.Count == 0) { <span>No elements. Add one above.</span> }
              else { <span>@_elements.Count element(s). Click one in the scene to select it.</span> }
            </div>
            <div class="flex gap-2 mt-2">
              <button class="btn-secondary flex-1" disabled="@(_undo.Count == 0)" @onclick="OnUndo" title="Undo (Ctrl+Z)">Undo</button>
              <button class="btn-secondary flex-1" disabled="@(_redo.Count == 0)" @onclick="OnRedo" title="Redo (Ctrl+Y)">Redo</button>
            </div>
          </div>
        </div>

        @if (Selected is { } sel)
        {
          <div class="designer-section">
            <div class="designer-section-head">Selected: @sel.Label</div>
            <div class="designer-section-body text-xs flex flex-col gap-2">
              <div class="flex gap-2">
                <button class="btn-secondary flex-1" @onclick='() => SetGizmoMode("translate")'>Move</button>
                <button class="btn-secondary flex-1" @onclick='() => SetGizmoMode("rotate")'>Rotate</button>
              </div>
              @TransformFields(sel)
              @if (_familyOptions.Count > 1)
              {
                <label class="block">Variation
                  <select class="reg-filter-input w-full" @bind="sel.Ref" @bind:after="() => SwapVariation(sel)">
                    @foreach (var f in _familyOptions) { <option value="@f.Stem">@f.Label</option> }
                  </select>
                </label>
              }
              @if (sel.Kind != "actor")
              {
                <label class="block">Animation
                  <select class="reg-filter-input w-full" @bind="sel.Anim" @bind:after="() => OnAnimChanged(sel)">
                    <option value="none">None</option>
                    <option value="SpinY">Spin (Y)</option>
                    <option value="SpinZ">Spin (Z)</option>
                    <option value="HoverSpin">Hover + spin</option>
                  </select>
                </label>
                @if (sel.Ref == "hab_chicken_universe")
                {
                  <label class="settings-check mt-1">
                    <input type="checkbox" checked="@sel.Effect" @onchange="e => OnEffectToggled(sel, e.Value is true)" />
                    <span class="ml-2">Galaxy particles (extracted)</span>
                  </label>
                }
              }
              @if (sel.Kind == "actor" && sel.Motion is { } mo)
              {
                <div class="text-xs text-muted">Motion: @mo.Kind</div>
                @if (mo.Kind == "path")
                {
                  <label class="block">Speed
                    <input type="range" min="0.5" max="12" step="0.5" class="w-full" @bind="mo.Speed" @bind:event="oninput" @bind:after="() => PushElementMotion(sel)" />
                  </label>
                  <label class="block">Loop
                    <select class="reg-filter-input w-full" @bind="mo.Loop" @bind:after="() => PushElementMotion(sel)">
                      <option value="cycle">Cycle</option>
                      <option value="pingpong">Ping-pong</option>
                    </select>
                  </label>
                  @if (sel.Actor == "chicken")
                  {
                    <label class="block">Chickens running
                      <input type="number" min="1" max="50" class="reg-filter-input w-[80px]" @bind="mo.Count" @bind:after="() => PushElementMotion(sel)" />
                    </label>
                  }
                  @if (sel.Actor == "vehicle")
                  {
                    <label class="block">Vehicles
                      <input type="number" min="1" max="20" class="reg-filter-input w-[80px]" @bind="mo.Count" @bind:after="() => PushElementMotion(sel)" />
                    </label>
                    <label class="block">Depot stop (s)
                      <input type="range" min="0" max="5" step="0.5" class="w-full" @bind="mo.StopSeconds" @bind:event="oninput" @bind:after="() => PushElementMotion(sel)" />
                    </label>
                  }
                }
                else
                {
                  <label class="block">Launch height
                    <input type="range" min="4" max="40" step="1" class="w-full" @bind="mo.Height" @bind:event="oninput" @bind:after="() => PushElementMotion(sel)" />
                  </label>
                  <label class="block">Period (s)
                    <input type="range" min="2" max="15" step="0.5" class="w-full" @bind="mo.Period" @bind:event="oninput" @bind:after="() => PushElementMotion(sel)" />
                  </label>
                }
              }
              @if (sel.Kind is "env" or "shell")
              {
                <label class="block">Shell
                  <select class="reg-filter-input w-full" @bind="sel.Shell" @bind:after="OnShellChanged">
                    <option value="">Base mesh</option>
                    @foreach (var s in ShellsForAssetTypeOf(sel)) { <option value="@s.Identifier">@(s.Name ?? s.Identifier)</option> }
                  </select>
                </label>
              }
              @if (sel.Kind == "chicken")
              {
                <label class="block">Skin
                  <select class="reg-filter-input w-full" @bind="sel.Ref" @bind:after="() => OnChickenSkinChanged(sel)">
                    @foreach (var c in _chickens) { <option value="@c.Identifier">@(c.Name ?? c.Identifier)</option> }
                  </select>
                </label>
                <label class="block">Hat
                  <select class="reg-filter-input w-full" @bind="sel.Hat" @bind:after="() => OnHatChanged(sel)">
                    <option value="">No hat</option>
                    @foreach (var h in _hats) { <option value="@h.Identifier">@(h.Name ?? h.Identifier)</option> }
                  </select>
                </label>
              }
              <div class="border-t border-border mt-1 pt-2">
                @if (_confirmDeleteId == sel.Id)
                {
                  <div class="text-xs text-muted mb-1">Delete @sel.Label?</div>
                  <div class="flex gap-2">
                    <button class="btn-danger flex-1" @onclick="() => ConfirmDelete(sel)">Delete</button>
                    <button class="btn-secondary flex-1" @onclick="() => _confirmDeleteId = null">Cancel</button>
                  </div>
                }
                else
                {
                  <button class="btn-secondary w-full" @onclick="() => _confirmDeleteId = sel.Id">Delete element</button>
                }
              </div>
            </div>
          </div>
        }

        @if (_shellSets.Count > 0 || _decorators.Count > 0)
        {
          <div class="designer-section">
            <button class="designer-section-head flex w-full items-center justify-between" @onclick="() => _shellSetsOpen = !_shellSetsOpen">
              <span>Shell sets</span>
              <span class="text-muted">@(_shellSetsOpen ? "▾" : "▸")</span>
            </button>
            @if (_shellSetsOpen)
            {
            <div class="designer-section-body text-xs flex flex-col gap-2">
              <label class="block">Apply mode
                <select class="reg-filter-input w-full" @bind="_setApplyMode">
                  <option value="all">All matching elements</option>
                  <option value="selected">Selected element only</option>
                </select>
              </label>
              @if (_shellSets.Count > 0)
              {
                <input class="reg-filter-input w-full" placeholder="Search shell sets…" value="@_shellSetSearch" @oninput="e => _shellSetSearch = e.Value?.ToString() ?? string.Empty" />
                <div class="flex flex-col gap-1 max-h-60 overflow-auto">
                  @foreach (var set in FilteredShellSets())
                  {
                    <button class="btn-secondary text-left" @onclick="() => ApplyShellSet(set)">@(set.Name ?? set.Identifier) <span class="text-muted">(@(set.Members?.Length ?? 0))</span></button>
                  }
                  @if (!FilteredShellSets().Any()) { <div class="text-muted">No matches.</div> }
                </div>
              }
              @if (_decorators.Count > 0)
              {
                <label class="block">Farm decorator
                  <select class="reg-filter-input w-full" @bind="_decoratorId" @bind:after="ApplyDecorator">
                    <option value="">None</option>
                    @foreach (var d in _decorators) { <option value="@d.Identifier">@(d.Name ?? d.Identifier)</option> }
                  </select>
                </label>
              }
            </div>
            }
          </div>
        }
      </section>
    }
  </div>
</main>
}

@code {
    bool _isAdmin;
    ElementReference _canvas;
    IJSObjectReference? _mod;
    IJSObjectReference? _designer;
    IJSObjectReference? _autosave;
    IJSObjectReference? _recorder;
    int _gifFps = 20;
    int _gifMaxWidth = 0; // 0 = full
    bool _recording;
    string _recordStage = "";
    double _recordFraction;
    bool _anyAnimated;
    DotNetObjectReference<Playground>? _selfRef;
    string _appVersion = "";
    System.Threading.CancellationTokenSource? _autosaveCts;

    const string ShellPlatform = "ios";

    List<ShellObjRow> _chickens = [];
    List<ShellObjRow> _hats = [];
    List<ShellRow> _allShells = [];
    List<EnvPieceRow> _catalogPieces = [];

    // The playground is ALWAYS in design mode now (no view-only state). Kept as a const-true field so the many
    // `@if (_designMode)` blocks + the JS setDesignMode call still read naturally.
    const bool _designMode = true;
    readonly List<DesignElement> _elements = [];
    string? _selectedElementId;
    LightingState _lighting = new();
    int _elementSeq;

    readonly Stack<List<DesignElement>> _undo = new();
    readonly Stack<List<DesignElement>> _redo = new();
    const int HistoryCap = 50;
    bool _restoringHistory; // guards re-entrant history push + autosave storm during a rebuild

    string? _decoratorId; // farm-wide decorator selection (null/empty = none)
    string _setApplyMode = "all"; // "all" | "selected"
    List<ShellSetRow> _shellSets = [];
    List<ShellSetRow> _decorators = [];
    bool _shellSetsOpen;
    string _shellSetSearch = "";

    IEnumerable<ShellSetRow> FilteredShellSets() =>
        string.IsNullOrWhiteSpace(_shellSetSearch)
            ? _shellSets
            : _shellSets.Where(s => ((s.Name ?? s.Identifier) ?? "").Contains(_shellSetSearch, StringComparison.OrdinalIgnoreCase));

    bool _pickerOpen;
    string _pickerTab = "building";
    List<FamilyOption> _familyOptions = [];
    string? _confirmDeleteId;

    string _designName = "";
    string _selectedDesign = "";
    List<string> _savedDesigns = [];

    // Stateful design editing: the design the user is working on (empty = a new unsaved one), the version they
    // last saved/loaded, the version timeline, an optional note for the next save, and a dirty flag set on any
    // scene change since the last save.
    string _currentDesign = "";
    int _currentVersion;
    string _versionNote = "";
    bool _dirty;
    List<DesignVersionRow> _versions = [];

    bool SaveDisabled =>
        _busy || (string.IsNullOrEmpty(_currentDesign) && string.IsNullOrWhiteSpace(_designName));

    record DesignVersionRow(int VersionNo, string? Note, DateTimeOffset CreatedAt, string? AuthorUserId, int? RolledBackFrom);
    record DesignVersionsResult(DesignVersionRow[]? Versions);

    string _bgColor = "#1a1a1f";
    bool _bgTransparent = true;
    bool _busy;
    bool _error;
    string _status = "";
    string _fatalError = "";

    string _baseAddress = "";
    string? _cookie;

    DesignElement? Selected => _elements.FirstOrDefault(e => e.Id == _selectedElementId);

    protected override void OnInitialized()
    {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_isAdmin) return;
        try
        {
            _mod = await JS.InvokeAsync<IJSObjectReference>("import", $"./interop/playground.js?v={InteropVersion()}");
            await _mod.InvokeVoidAsync("init", _canvas);
            await EnsureDesigner();
            await ApplyBackground();
            await ApplyLighting();
            await LoadShellObjects();
            await LoadShells();
            await LoadShellSets();
            await LoadCatalog();
            await RefreshDesigns();
            _autosave = await JS.InvokeAsync<IJSObjectReference>("import", $"./interop/playgroundAutosave.js?v={InteropVersion()}");
            _recorder = await JS.InvokeAsync<IJSObjectReference>("import", $"./interop/playgroundRecorder.js?v={InteropVersion()}");
            try { _appVersion = (await Client().GetFromJsonAsync<AppVersionDto>("/api/app/version"))?.Version ?? ""; }
            catch { _appVersion = ""; }
            await TryRestoreAutosave();
        }
        catch (Exception ex) { FatalError($"3D init failed: {ex.Message}"); }
    }

    string InteropVersion()
    {
        try
        {
            var fi = Env.WebRootFileProvider.GetFileInfo("interop/playground.js");
            if (fi.Exists) return fi.LastModified.UtcTicks.ToString();
        }
        catch { }
        return "1";
    }

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

