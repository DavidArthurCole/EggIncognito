@page "/playground"
@rendermode @(RenderMode.InteractiveServer)
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

<PageTitle>EggIncognito - 3D Playground</PageTitle>

@if (!_isAdmin)
{
  <main class="px-8 pt-6 pb-8 max-w-[1100px]">
    <h1 class="text-[1.3rem] mt-0 mb-4">3D Playground</h1>
    <div class="panel">Admin access required. <a class="auth-btn" href="/login?returnUrl=/playground">Log in</a></div>
  </main>
}
else
{
<main class="px-8 pt-6 pb-8 max-w-[1280px]">
  <h1 class="text-[1.3rem] mt-0 mb-1">3D Playground</h1>
  <p class="text-muted text-xs mb-4">
    Compose several sources at once: pull a mesh off a device, dress a chicken in a hat, stack farm-element
    shells, or load exported / uploaded models. Toggle a widget to add or remove it; set X/Y/Z offsets to
    arrange the scene. Drag to orbit, scroll to zoom.
  </p>

  <div class="flex gap-4 flex-wrap">
    <section class="panel flex-1 min-w-[480px]" style="overflow: visible;">
      <div class="canvas-wrap">
        <canvas @ref="_canvas" id="playgroundCanvas"></canvas>
      </div>
      <div class="flex gap-2 mt-3">
        <button class="btn-secondary flex-1" @onclick="TogglePlay" disabled="@(_active.Count == 0)">@(_playing ? "Pause" : "Play")</button>
        <button class="btn-secondary flex-1" @onclick="ResetView" disabled="@(_active.Count == 0)">Reset view</button>
        <select class="reg-filter-input w-[150px]" @bind="_kind" @bind:after="ApplyAnimation">
          <option value="none">No animation</option>
          <option value="SpinY">Spin (Y)</option>
          <option value="SpinZ">Spin (Z)</option>
          <option value="HoverSpin">Hover + spin</option>
        </select>
      </div>
      @if (!string.IsNullOrEmpty(_status))
      {
        <div class="text-xs mt-2 @(_error ? "err" : "text-muted")">@_status</div>
      }
    </section>

    <section class="w-[320px] flex flex-col gap-3">
      <div class="widget-card">
        <div class="widget-head">
          <span class="settings-title m-0">Device files</span>
          <label class="wtoggle"><input type="checkbox" checked="@_active.Contains("device")" @onchange="@(e => Toggle("device", e))" /><span></span></label>
        </div>
        <select class="reg-filter-input w-full" @bind="_selectedDevice" @bind:after="LoadDeviceMeshes">
          <option value="">Choose a device…</option>
          @foreach (var d in _devices) { <option value="@d.Id">@d.Label (@d.Platform)</option> }
        </select>
        @if (_deviceMeshes.Count > 0)
        {
          <select class="reg-filter-input w-full mt-2" @bind="_selectedDeviceMesh" @bind:after="@(() => OnSelectChanged("device"))">
            <option value="">Choose a mesh…</option>
            @foreach (var m in _deviceMeshes) { <option value="@m">@m</option> }
          </select>
        }
        @if (_active.Contains("device")) { @OffsetInputs("device") }
      </div>

      <div class="widget-card">
        <div class="widget-head">
          <span class="settings-title m-0">Chicken + Hat</span>
          <label class="wtoggle"><input type="checkbox" checked="@_active.Contains("chickenhat")" @onchange="@(e => Toggle("chickenhat", e))" /><span></span></label>
        </div>
        <select class="reg-filter-input w-full" @bind="_selectedChicken" @bind:after="@(() => OnSelectChanged("chickenhat"))">
          <option value="">Choose a chicken…</option>
          @foreach (var c in _chickens) { <option value="@c.Identifier">@(c.Name ?? c.Identifier)</option> }
        </select>
        <select class="reg-filter-input w-full mt-2" @bind="_selectedHat" @bind:after="@(() => OnSelectChanged("chickenhat"))" disabled="@ChickenNoHats">
          <option value="">@(ChickenNoHats ? "This chicken takes no hat" : "Choose a hat…")</option>
          @foreach (var h in _hats) { <option value="@h.Identifier">@(h.Name ?? h.Identifier)</option> }
        </select>
        @if (_active.Contains("chickenhat")) { @OffsetInputs("chickenhat") }
      </div>

      <div class="widget-card">
        <div class="widget-head">
          <span class="settings-title m-0">Shell compatibles</span>
          <label class="wtoggle"><input type="checkbox" checked="@_active.Contains("shell")" @onchange="@(e => Toggle("shell", e))" /><span></span></label>
        </div>
        <select class="reg-filter-input w-full" @bind="_shellAssetType" @bind:after="FilterShells">
          <option value="">Asset type…</option>
          @foreach (var a in _compatAssetTypes) { <option value="@a">@a</option> }
        </select>
        @if (_filteredShells.Count > 0)
        {
          <select class="reg-filter-input w-full mt-2" @bind="_selectedShell" @bind:after="@(() => OnSelectChanged("shell"))">
            <option value="">Choose a shell…</option>
            @foreach (var s in _filteredShells) { <option value="@s.Identifier">@(s.Name ?? s.Identifier)</option> }
          </select>
        }
        @if (_active.Contains("shell")) { @OffsetInputs("shell") }
      </div>

      <div class="widget-card">
        <div class="widget-head">
          <span class="settings-title m-0">Static game models</span>
          <label class="wtoggle"><input type="checkbox" checked="@_active.Contains("static")" @onchange="@(e => Toggle("static", e))" /><span></span></label>
        </div>
        <select class="reg-filter-input w-full" @bind="_selectedShip" @bind:after="@(() => OnSelectChanged("static"))">
          <option value="">Choose an asset…</option>
          @foreach (var s in _ships) { <option value="@s">@s</option> }
        </select>
        <div class="mt-2"><InputFile OnChange="OnUpload" accept=".glb" class="text-xs" /></div>
        @if (_active.Contains("static")) { @OffsetInputs("static") }
      </div>
    </section>
  </div>
</main>
}

@code {
    bool _isAdmin;
    ElementReference _canvas;
    IJSObjectReference? _mod;

    const string ShellPlatform = "ios";

    List<string> _ships = [];
    string _selectedShip = "";

    List<DeviceRow> _devices = [];
    string _selectedDevice = "";
    List<string> _deviceMeshes = [];
    string _selectedDeviceMesh = "";

    List<ShellObjRow> _chickens = [];
    List<ShellObjRow> _hats = [];
    string _selectedChicken = "";
    string _selectedHat = "";

    List<ShellRow> _allShells = [];
    List<string> _compatAssetTypes = [];
    List<ShellRow> _filteredShells = [];
    string _shellAssetType = "";
    string _selectedShell = "";

    readonly HashSet<string> _active = new(StringComparer.Ordinal);
    // per-group manual offsets, keyed by group id: [x, y, z].
    readonly Dictionary<string, float[]> _offsets = new(StringComparer.Ordinal);

    string _kind = "none";
    bool _playing = true;
    bool _error;
    string _status = "";
    byte[]? _uploadGlb;

    string _baseAddress = "";
    string? _cookie;

    bool ChickenNoHats => _chickens.FirstOrDefault(c => c.Identifier == _selectedChicken)?.NoHats ?? false;

    protected override void OnInitialized()
    {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_isAdmin) return;
        try
        {
            // version query busts a stale browser/CDN cache after a deploy ships a new module shape. Keyed on
            // the served file's last-write ticks so it changes exactly when playground.js changes.
            _mod = await JS.InvokeAsync<IJSObjectReference>("import", $"./interop/playground.js?v={InteropVersion()}");
            await _mod.InvokeVoidAsync("init", _canvas);
            await LoadShipList();
            await LoadDevices();
            await LoadShellObjects();
            await LoadShells();
        }
        catch (Exception ex) { Fail($"3D init failed: {ex.Message}"); }
    }

    // The 3-float offset for a group (defaults to 0,0,0). Index 0=x,1=y,2=z.
    float[] Off(string id)
    {
        if (!_offsets.TryGetValue(id, out var o)) { o = new float[3]; _offsets[id] = o; }
        return o;
    }

    // Renders the X/Y/Z manual offset inputs for an active group; editing pushes the offset live.
    RenderFragment OffsetInputs(string id) => builder =>
    {
        var o = Off(id);
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "offset-row");
        void Axis(int seq, int idx, string label)
        {
            builder.OpenElement(seq, "label");
            builder.AddAttribute(seq + 1, "class", "offset-axis");
            builder.AddContent(seq + 2, label);
            builder.OpenElement(seq + 3, "input");
            builder.AddAttribute(seq + 4, "type", "number");
            builder.AddAttribute(seq + 5, "step", "0.1");
            builder.AddAttribute(seq + 6, "class", "reg-filter-input w-[64px]");
            builder.AddAttribute(seq + 7, "value", o[idx]);
            builder.AddAttribute(seq + 8, "onchange",
                EventCallback.Factory.Create<ChangeEventArgs>(this, async e =>
                {
                    o[idx] = float.TryParse(e.Value?.ToString(), out var v) ? v : 0;
                    await PushOffset(id);
                }));
            builder.CloseElement();
            builder.CloseElement();
        }
        Axis(2, 0, "X");
        Axis(12, 1, "Y");
        Axis(22, 2, "Z");
        builder.CloseElement();
    };

    async Task PushOffset(string id)
    {
        if (_mod is null) return;
        var o = Off(id);
        await _mod.InvokeVoidAsync("setGroupOffset", id, o[0], o[1], o[2]);
    }

    // Toggle a widget on/off. On = render its current selection as that group; off = remove the group but
    // keep the dropdown selection so re-toggling re-renders without re-picking.
    async Task Toggle(string id, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on)
        {
            _active.Add(id);
            await RenderGroup(id);
        }
        else
        {
            _active.Remove(id);
            if (_mod is not null) await _mod.InvokeVoidAsync("removeGroup", id);
        }
        StateHasChanged();
    }

    // A dropdown changed: if that group is active, reload it; otherwise just hold the selection.
    async Task OnSelectChanged(string id)
    {
        if (_active.Contains(id)) await RenderGroup(id);
        else StateHasChanged();
    }

    // Fetch the selected mesh(es) for a group and add it to the scene. Chicken+hat composes two meshes.
    async Task RenderGroup(string id)
    {
        if (_mod is null) return;
        Status("Loading…");
        try
        {
            var glb = await FetchGroupGlb(id);
            if (glb is null) { return; }

            if (id == "chickenhat" && !string.IsNullOrEmpty(_selectedHat) && !ChickenNoHats)
            {
                var hat = await FetchRaw($"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(_selectedHat)}/glb");
                var anchor = _chickens.FirstOrDefault(c => c.Identifier == _selectedChicken)?.Anchor ?? [];
                await _mod.InvokeAsync<string[]>("addGroup", id, Convert.ToBase64String(glb),
                    new { hatBase64 = hat is null ? null : Convert.ToBase64String(hat), anchor });
            }
            else
            {
                await _mod.InvokeAsync<string[]>("addGroup", id, Convert.ToBase64String(glb), new { });
            }
            await PushOffset(id);
            await ApplyAnimation();
            Status("");
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    // The raw glb bytes for a group's current selection. Spin/hover is a client-side whole-group transform
    // (so chicken+hat rotate as one), not baked per-mesh; the mesh's own embedded clips still play. Null =
    // nothing picked.
    async Task<byte[]?> FetchGroupGlb(string id)
    {
        if (id == "static" && string.IsNullOrEmpty(_selectedShip) && _uploadGlb is not null)
            return _uploadGlb;

        string? url = id switch
        {
            "device" when !string.IsNullOrEmpty(_selectedDevice) && !string.IsNullOrEmpty(_selectedDeviceMesh)
                => $"/api/devices/{_selectedDevice}/mesh/{_selectedDeviceMesh}",
            "chickenhat" when !string.IsNullOrEmpty(_selectedChicken)
                => $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(_selectedChicken)}/glb",
            "shell" when !string.IsNullOrEmpty(_selectedShell)
                => $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(_selectedShell)}/glb",
            "static" when !string.IsNullOrEmpty(_selectedShip)
                => $"/api/ship-assets/glb/{_selectedShip}",
            _ => null,
        };
        if (url is null) { Status("Pick a selection for this widget."); return null; }
        return await FetchRaw(url);
    }

    async Task<byte[]?> FetchRaw(string url)
    {
        var res = await Client().GetAsync(url);
        if (!res.IsSuccessStatusCode) { Fail($"load failed: HTTP {(int)res.StatusCode}"); return null; }
        return await res.Content.ReadAsByteArrayAsync();
    }

    async Task ApplyAnimation()
    {
        if (_mod is not null) await _mod.InvokeVoidAsync("setAnimation", _kind, 6);
    }

    async Task OnUpload(InputFileChangeEventArgs e)
    {
        Status("Uploading…");
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(100_000_000).CopyToAsync(ms);
            _uploadGlb = ms.ToArray();
            _selectedShip = "";
            _active.Add("static");
            await RenderGroup("static");
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { StateHasChanged(); }
    }

    async Task LoadShipList()
    {
        try { _ships = (await Client().GetFromJsonAsync<ListResult>("/api/ship-assets/list"))?.Ships?.ToList() ?? []; }
        catch { _ships = []; }
        StateHasChanged();
    }

    async Task LoadDevices()
    {
        try { _devices = (await Client().GetFromJsonAsync<DeviceRow[]>("/api/devices/status"))?.ToList() ?? []; }
        catch { _devices = []; }
        StateHasChanged();
    }

    async Task LoadDeviceMeshes()
    {
        _deviceMeshes = []; _selectedDeviceMesh = "";
        if (string.IsNullOrEmpty(_selectedDevice)) { StateHasChanged(); return; }
        try { _deviceMeshes = (await Client().GetFromJsonAsync<MeshListResult>($"/api/devices/{_selectedDevice}/list-meshes"))?.Meshes?.ToList() ?? []; }
        catch { _deviceMeshes = []; }
        StateHasChanged();
    }

    async Task LoadShellObjects()
    {
        try
        {
            _chickens = (await Client().GetFromJsonAsync<ShellObjResult>($"/api/shells/objects?platform={ShellPlatform}&type=chicken"))?.Objects?.ToList() ?? [];
            _hats = (await Client().GetFromJsonAsync<ShellObjResult>($"/api/shells/objects?platform={ShellPlatform}&type=hat"))?.Objects?.ToList() ?? [];
        }
        catch { _chickens = []; _hats = []; }
        StateHasChanged();
    }

    // Shells for widget 3: every shell asset type except CHICKEN / HAT (those are the chicken+hat widget).
    async Task LoadShells()
    {
        try
        {
            var res = await Client().GetFromJsonAsync<ShellListResult>($"/api/shells?platform={ShellPlatform}");
            _allShells = res?.Shells?.ToList() ?? [];
            _compatAssetTypes = (res?.AssetTypes ?? [])
                .Where(a => !a.Equals("Chicken", StringComparison.OrdinalIgnoreCase) && !a.Equals("Hat", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        catch { _allShells = []; _compatAssetTypes = []; }
        StateHasChanged();
    }

    void FilterShells()
    {
        _selectedShell = "";
        _filteredShells = string.IsNullOrEmpty(_shellAssetType) ? [] : _allShells.Where(s => s.AssetType == _shellAssetType).ToList();
        StateHasChanged();
    }

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    async Task TogglePlay()
    {
        if (_mod is null) return;
        _playing = !_playing;
        await _mod.InvokeVoidAsync("setPlaying", _playing);
    }

    async Task ResetView()
    {
        if (_mod is not null) await _mod.InvokeVoidAsync("resetView");
    }

    void Status(string s) { _error = false; _status = s; StateHasChanged(); }
    void Fail(string s) { _error = true; _status = s; StateHasChanged(); }

    // Cache-bust token = last-write ticks of the served interop module (falls back to a constant offline).
    string InteropVersion()
    {
        try
        {
            var fi = Env.WebRootFileProvider.GetFileInfo("interop/playground.js");
            if (fi.Exists) return fi.LastModified.UtcTicks.ToString();
        }
        catch { }
        return "1";
    }

    record ListResult(string[]? Ships);
    record MeshListResult(string[]? Meshes);
    record DeviceRow(string Id, string Platform, string Label);
    record ShellRow(string Identifier, string? Name, string AssetType, string Url, bool ModifiedGeometry);
    record ShellListResult(bool Ok, string[]? AssetTypes, ShellRow[]? Shells);
    record ShellObjRow(string Identifier, string? Name, string AssetType, string Url, float[]? Anchor, bool NoHats)
    {
        public float[] Anchor { get; init; } = Anchor ?? [];
    }
    record ShellObjResult(bool Ok, ShellObjRow[]? Objects);

    public async ValueTask DisposeAsync()
    {
        if (_mod is not null)
        {
            try { await _mod.InvokeVoidAsync("dispose"); } catch { }
            try { await _mod.DisposeAsync(); } catch { }
        }
    }
}
