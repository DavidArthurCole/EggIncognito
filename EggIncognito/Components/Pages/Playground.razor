@page "/playground"
@rendermode @(RenderMode.InteractiveServer)
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

<PageTitle>EggIncognito - 3D Playground</PageTitle>

@if (!_isAdmin)
{
  <main class="px-8 pt-6 pb-8 max-w-[1100px]">
    <h1 class="text-[1.3rem] mt-0 mb-4">3D Playground</h1>
    <div class="panel">Admin access required. <a class="auth-btn" href="/login?returnUrl=/playground">Log in</a></div>
  </main>
}
else
{
<main class="px-8 pt-6 pb-8 max-w-[1280px]">
  <h1 class="text-[1.3rem] mt-0 mb-1">3D Playground</h1>
  <p class="text-muted text-xs mb-4">
    View a saved environment, or flip on Design mode to free-place game elements: add habs, silos, chickens
    and shells, drag the gizmo to arrange them, light the scene, and save named designs. Drag to orbit, scroll
    to zoom.
  </p>

  <div class="flex gap-4 flex-wrap">
    <section class="panel flex-1 min-w-[480px]" style="overflow: visible;">
      <div class="canvas-wrap">
        <canvas @ref="_canvas" id="playgroundCanvas"></canvas>
      </div>
    </section>

    <section class="w-[340px] flex flex-col gap-2">
      <label class="settings-check"><input type="checkbox" @bind="_designMode" @bind:after="ToggleDesignMode" /><span class="ml-2 font-semibold">Design mode</span></label>

      <div class="designer-section">
        <div class="designer-section-head">Scene</div>
        <div class="designer-section-body">
          <div class="flex gap-2">
            <button class="btn-secondary flex-1" @onclick="TogglePlay">@(_playing ? "Pause" : "Play")</button>
            <button class="btn-secondary flex-1" @onclick="ResetView">Reset view</button>
          </div>
        </div>
      </div>

      <div class="designer-section">
        <div class="designer-section-head">Lighting + Colors</div>
        <div class="designer-section-body grid grid-cols-2 gap-3 text-xs">
          <label class="light-field"><span>Background</span>
            <span class="flex items-center gap-2">
              <input type="color" class="bg-picker-input" @bind="_bgColor" @bind:event="oninput" @bind:after="ApplyBackground" disabled="@_bgTransparent" />
              <label class="settings-check"><input type="checkbox" @bind="_bgTransparent" @bind:after="ApplyBackground" /><span class="text-muted ml-1">None</span></label>
            </span>
          </label>
          <div></div>
          <label class="light-field"><span>Sun azimuth</span><input type="range" min="0" max="360" class="w-full" @bind="_lighting.SunAzimuthDeg" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Sun elevation</span><input type="range" min="0" max="90" class="w-full" @bind="_lighting.SunElevationDeg" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Sun color</span><input type="color" class="bg-picker-input" @bind="_lighting.SunColor" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Sun intensity</span><input type="range" min="0" max="3" step="0.05" class="w-full" @bind="_lighting.SunIntensity" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Fog color</span><input type="color" class="bg-picker-input" @bind="_lighting.FogColor" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
          <label class="light-field"><span>Fog density</span><input type="range" min="0" max="0.15" step="0.002" class="w-full" @bind="_lighting.FogDensity" @bind:event="oninput" @bind:after="ApplyLighting" /></label>
        </div>
      </div>

      <div class="designer-section">
        <div class="designer-section-head">Design</div>
        <div class="designer-section-body flex flex-col gap-2">
          @if (_designMode)
          {
            <input class="reg-filter-input w-full" placeholder="Design name…" @bind="_designName" @bind:event="oninput" />
            <button class="btn-secondary" @onclick="SaveDesign" disabled="@string.IsNullOrWhiteSpace(_designName)">Save design</button>
          }
          <select class="reg-filter-input w-full" @bind="_selectedDesign" @bind:after="LoadDesign">
            <option value="">@(_designMode ? "Load design…" : "Choose a design…")</option>
            @foreach (var n in _savedDesigns) { <option value="@n">@n</option> }
          </select>
          @if (_designMode)
          {
            <button class="btn-secondary" @onclick="DeleteDesign" disabled="@string.IsNullOrEmpty(_selectedDesign)">Delete design</button>
          }
        </div>
      </div>

      @if (!string.IsNullOrEmpty(_status))
      {
        <div class="text-xs mt-1 @(_error ? "err" : "text-muted")">@_status</div>
      }
    </section>

    @if (_designMode)
    {
      <section class="w-[300px] flex flex-col gap-2">
        <div class="designer-section">
          <div class="designer-section-head">Elements</div>
          <div class="designer-section-body">
            <button class="btn-primary w-full" @onclick="() => _pickerOpen = !_pickerOpen">@(_pickerOpen ? "Close picker" : "Add element")</button>
            <button class="btn-secondary w-full mt-2" @onclick="AutoArrangeFarm" disabled="@_busy">Auto-arrange farm</button>
            @if (_pickerOpen)
            {
              <div class="picker mt-2">
                <div class="flex mb-1">
                  <button class="picker-tab @(_pickerTab == "building" ? "active" : "")" @onclick='() => _pickerTab = "building"'>Buildings</button>
                  <button class="picker-tab @(_pickerTab == "chicken" ? "active" : "")" @onclick='() => _pickerTab = "chicken"'>Chicken</button>
                </div>
                <div class="picker-body">
                  @if (_pickerTab == "building")
                  {
                    @if (_catalogPieces.Count == 0) { <div class="text-xs text-muted">Catalog empty.</div> }
                    @foreach (var grp in _catalogPieces.GroupBy(p => p.Group))
                    {
                      <div class="picker-group-title">@grp.Key</div>
                      @foreach (var p in grp)
                      {
                        var placed = p.Singleton && _elements.Any(e => e.Kind == "env" && e.Ref == p.Stem);
                        <button class="picker-item" @onclick='() => AddElement("env", p.Stem, p.Label)' disabled="@placed">@p.Label@(placed ? " (placed)" : "")</button>
                      }
                    }
                  }
                  else
                  {
                    @if (_chickens.Count == 0) { <div class="text-xs text-muted">No chickens (ingest a config in Admin).</div> }
                    @foreach (var c in _chickens)
                    {
                      <button class="picker-item" @onclick='() => AddElement("chicken", c.Identifier, c.Name ?? c.Identifier)'>@(c.Name ?? c.Identifier)</button>
                    }
                  }
                </div>
              </div>
            }
            <div class="element-list mt-2">
              @foreach (var el in _elements)
              {
                <div class="element-row @(el.Id == _selectedElementId ? "active" : "")">
                  <button class="element-name" @onclick="() => SelectElement(el.Id)">@el.Label</button>
                  <button class="element-del" @onclick="() => DeleteElement(el)">✕</button>
                </div>
              }
              @if (_elements.Count == 0) { <div class="text-xs text-muted">No elements. Add one above.</div> }
            </div>
          </div>
        </div>

        @if (Selected is { } sel)
        {
          <div class="designer-section">
            <div class="designer-section-head">Selected: @sel.Label</div>
            <div class="designer-section-body text-xs flex flex-col gap-2">
              <div class="flex gap-2">
                <button class="btn-secondary flex-1" @onclick='() => SetGizmoMode("translate")'>Move</button>
                <button class="btn-secondary flex-1" @onclick='() => SetGizmoMode("rotate")'>Rotate</button>
              </div>
              @TransformFields(sel)
              @if (_familyOptions.Count > 1)
              {
                <label class="block">Variation
                  <select class="reg-filter-input w-full" @bind="sel.Ref" @bind:after="() => SwapVariation(sel)">
                    @foreach (var f in _familyOptions) { <option value="@f.Stem">@f.Label</option> }
                  </select>
                </label>
              }
              <label class="block">Animation
                <select class="reg-filter-input w-full" @bind="sel.Anim" @bind:after="() => ApplyElementAnimation(sel)">
                  <option value="none">None</option>
                  <option value="SpinY">Spin (Y)</option>
                  <option value="SpinZ">Spin (Z)</option>
                  <option value="HoverSpin">Hover + spin</option>
                </select>
              </label>
              @if (sel.Kind is "env" or "shell")
              {
                <label class="block">Shell
                  <select class="reg-filter-input w-full" @bind="sel.Shell" @bind:after="ReshellSelected">
                    <option value="">Base mesh</option>
                    @foreach (var s in ShellsForAssetTypeOf(sel)) { <option value="@s.Identifier">@(s.Name ?? s.Identifier)</option> }
                  </select>
                </label>
              }
              @if (sel.Kind == "chicken")
              {
                <label class="block">Hat
                  <select class="reg-filter-input w-full" @bind="sel.Hat" @bind:after="() => RenderAndReselect(sel)">
                    <option value="">No hat</option>
                    @foreach (var h in _hats) { <option value="@h.Identifier">@(h.Name ?? h.Identifier)</option> }
                  </select>
                </label>
              }
            </div>
          </div>
        }
      </section>
    }
  </div>
</main>
}

@code {
    bool _isAdmin;
    ElementReference _canvas;
    IJSObjectReference? _mod;
    IJSObjectReference? _designer;
    DotNetObjectReference<Playground>? _selfRef;

    const string ShellPlatform = "ios";

    List<ShellObjRow> _chickens = [];
    List<ShellObjRow> _hats = [];
    List<ShellRow> _allShells = [];
    List<EnvPieceRow> _catalogPieces = [];

    bool _designMode;
    readonly List<DesignElement> _elements = [];
    string? _selectedElementId;
    LightingState _lighting = new();
    int _elementSeq;

    bool _pickerOpen;
    string _pickerTab = "building";
    List<FamilyOption> _familyOptions = [];

    string _designName = "";
    string _selectedDesign = "";
    List<string> _savedDesigns = [];

    string _bgColor = "#1a1a1f";
    bool _bgTransparent = true;
    bool _playing = true;
    bool _busy;
    bool _error;
    string _status = "";

    string _baseAddress = "";
    string? _cookie;

    DesignElement? Selected => _elements.FirstOrDefault(e => e.Id == _selectedElementId);

    protected override void OnInitialized()
    {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_isAdmin) return;
        try
        {
            _mod = await JS.InvokeAsync<IJSObjectReference>("import", $"./interop/playground.js?v={InteropVersion()}");
            await _mod.InvokeVoidAsync("init", _canvas);
            await ApplyBackground();
            await ApplyLighting();
            await LoadShellObjects();
            await LoadShells();
            await LoadCatalog();
            await RefreshDesigns();
        }
        catch (Exception ex) { Fail($"3D init failed: {ex.Message}"); }
    }

    string InteropVersion()
    {
        try
        {
            var fi = Env.WebRootFileProvider.GetFileInfo("interop/playground.js");
            if (fi.Exists) return fi.LastModified.UtcTicks.ToString();
        }
        catch { }
        return "1";
    }

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    async Task<byte[]?> FetchRaw(string url)
    {
        var res = await Client().GetAsync(url);
        if (!res.IsSuccessStatusCode) { Fail($"load failed: HTTP {(int)res.StatusCode}"); return null; }
        return await res.Content.ReadAsByteArrayAsync();
    }

    async Task ApplyBackground()
    {
        if (_mod is not null) await _mod.InvokeVoidAsync("setBackground", _bgTransparent ? null : _bgColor);
    }

    async Task ApplyElementAnimation(DesignElement el)
    {
        if (_mod is not null) await _mod.InvokeVoidAsync("setGroupAnimation", el.Id, el.Anim);
    }

    async Task ApplyLighting()
    {
        if (_mod is null) return;
        await _mod.InvokeVoidAsync("setLighting", new
        {
            sun = new { azimuthDeg = _lighting.SunAzimuthDeg, elevationDeg = _lighting.SunElevationDeg, color = _lighting.SunColor, intensity = _lighting.SunIntensity },
            fog = new { color = _lighting.FogColor, density = _lighting.FogDensity },
        });
    }

    async Task TogglePlay()
    {
        if (_mod is null) return;
        _playing = !_playing;
        await _mod.InvokeVoidAsync("setPlaying", _playing);
    }

    async Task ResetView()
    {
        if (_mod is not null) await _mod.InvokeVoidAsync("resetView");
    }

    async Task LoadShellObjects()
    {
        try
        {
            _chickens = (await Client().GetFromJsonAsync<ShellObjResult>($"/api/shells/objects?platform={ShellPlatform}&type=chicken"))?.Objects?.ToList() ?? [];
            _hats = (await Client().GetFromJsonAsync<ShellObjResult>($"/api/shells/objects?platform={ShellPlatform}&type=hat"))?.Objects?.ToList() ?? [];
        }
        catch { _chickens = []; _hats = []; }
        StateHasChanged();
    }

    async Task LoadShells()
    {
        try
        {
            var res = await Client().GetFromJsonAsync<ShellListResult>($"/api/shells?platform={ShellPlatform}");
            _allShells = res?.Shells?.ToList() ?? [];
        }
        catch { _allShells = []; }
        StateHasChanged();
    }

    async Task LoadCatalog()
    {
        try
        {
            var res = await Client().GetFromJsonAsync<EnvCatalogResult>("/api/env/catalog");
            _catalogPieces = res?.Pieces?.ToList() ?? [];
        }
        catch { _catalogPieces = []; }
    }

    async Task ToggleDesignMode()
    {
        if (_mod is not null) await _mod.InvokeVoidAsync("setDesignMode", _designMode);
        if (_designMode && _designer is null)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _designer = await JS.InvokeAsync<IJSObjectReference>("import", $"./interop/playgroundDesigner.js?v={InteropVersion()}");
            await _designer.InvokeVoidAsync("initDesigner", _selfRef);
        }
        if (!_designMode && _designer is not null) await _designer.InvokeVoidAsync("deselect");
        StateHasChanged();
    }

    // Called from the gizmo (playgroundDesigner.js) whenever a drag moves the selected element, so the numeric
    // inspector fields follow the gizmo live.
    [JSInvokable]
    public Task OnGizmoTransform(string id, double[] pos, double[] rotDeg, double scale)
    {
        var el = _elements.FirstOrDefault(e => e.Id == id);
        if (el is not null)
        {
            el.Pos = [(float)pos[0], (float)pos[1], (float)pos[2]];
            el.RotDeg = [(float)rotDeg[0], (float)rotDeg[1], (float)rotDeg[2]];
            el.Scale = (float)scale;
            InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    string NextElementId() => $"el{++_elementSeq}";

    // The glb URL for an element by kind. mesh + env share the env route; shell/chicken use the shells route.
    string? ElementGlbUrl(DesignElement el) => el.Kind switch
    {
        "env" => $"/api/env/{Uri.EscapeDataString(el.Shell ?? el.Ref)}/glb",
        "shell" => $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Shell ?? el.Ref)}/glb",
        "chicken" => $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Ref)}/glb",
        "mesh" => $"/api/env/{Uri.EscapeDataString(el.Ref)}/glb",
        _ => null,
    };

    // Render (or re-render) an element's group at its transform. Chickens compose the hat.
    async Task RenderElement(DesignElement el)
    {
        if (_mod is null) return;
        var url = ElementGlbUrl(el);
        if (url is null) return;
        var glb = await FetchRaw(url);
        if (glb is null) return;

        if (el.Kind == "chicken" && !string.IsNullOrEmpty(el.Hat))
        {
            var hat = await FetchRaw($"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Hat)}/glb");
            var anchor = _chickens.FirstOrDefault(c => c.Identifier == el.Ref)?.Anchor ?? [];
            await _mod.InvokeAsync<string[]>("addGroup", el.Id, Convert.ToBase64String(glb),
                new { hatBase64 = hat is null ? null : Convert.ToBase64String(hat), anchor });
        }
        else
        {
            await _mod.InvokeAsync<string[]>("addGroup", el.Id, Convert.ToBase64String(glb), new { });
        }
        await PushElementTransform(el);
        await ApplyElementAnimation(el);
    }

    // Set the element's placed transform on its group (works in view + design mode; the gizmo reads the same
    // base). When the gizmo is attached to this element, re-point it so it follows the new transform.
    async Task PushElementTransform(DesignElement el)
    {
        if (_mod is not null)
            await _mod.InvokeVoidAsync("setGroupTransform", el.Id, el.Pos, el.RotDeg, el.Scale);
        if (_designer is not null && _selectedElementId == el.Id)
            await _designer.InvokeVoidAsync("selectElement", el.Id);
    }

    async Task SelectElement(string id)
    {
        _selectedElementId = id;
        if (_designer is not null) await _designer.InvokeVoidAsync("selectElement", id);
        await LoadFamilyOptions();
        StateHasChanged();
    }

    // Fetch the swap-family siblings for the selected env element (hab tiers, lab levels, ...). Empty for
    // pieces with no family or non-env elements.
    async Task LoadFamilyOptions()
    {
        _familyOptions = [];
        if (Selected is { Kind: "env" } sel && !string.IsNullOrEmpty(sel.Ref))
        {
            try
            {
                var res = await Client().GetFromJsonAsync<FamilyResult>($"/api/env/family/{Uri.EscapeDataString(sel.Ref)}");
                _familyOptions = res?.Family?.ToList() ?? [];
            }
            catch { _familyOptions = []; }
        }
    }

    // Swap a placed element to another piece in its family (a different hab tier / lab level), keeping its
    // transform. sel.Ref is already updated by the bind; re-render with the new mesh + refresh the family.
    async Task SwapVariation(DesignElement sel)
    {
        var opt = _familyOptions.FirstOrDefault(f => f.Stem == sel.Ref);
        if (opt is not null) sel.Label = opt.Label;
        await RenderElement(sel);
        await SelectElement(sel.Id);
    }

    async Task DeleteElement(DesignElement el)
    {
        _elements.Remove(el);
        if (_selectedElementId == el.Id) { _selectedElementId = null; if (_designer is not null) await _designer.InvokeVoidAsync("deselect"); }
        if (_mod is not null) await _mod.InvokeVoidAsync("removeGroup", el.Id);
        StateHasChanged();
    }

    // Builds a game-like farm in one click: clears the scene, fetches the standard layout, adds each element
    // at its plot position. Honors singletons (ground/hardscape added once). A starting point to tweak, not a
    // pixel-exact game farm (positions are derived, not extracted from the binary).
    async Task AutoArrangeFarm()
    {
        if (_mod is null) return;
        _busy = true; Status("Arranging farm…");
        try
        {
            FarmLayoutResult? layout;
            try { layout = await Client().GetFromJsonAsync<FarmLayoutResult>("/api/env/farm-layout"); }
            catch (Exception ex) { Fail($"layout fetch failed: {ex.Message}"); return; }
            var placed = layout?.Elements ?? [];
            if (placed.Length == 0) { Fail("no layout returned"); return; }

            foreach (var el in _elements.ToList()) await _mod.InvokeVoidAsync("removeGroup", el.Id);
            _elements.Clear();
            _selectedElementId = null;
            if (_designer is not null) await _designer.InvokeVoidAsync("deselect");

            foreach (var pl in placed)
            {
                var el = new DesignElement
                {
                    Id = NextElementId(), Kind = "env", Ref = pl.Stem, Label = pl.Label,
                    Pos = pl.Pos, RotDeg = [0, pl.RotY, 0], Scale = pl.Scale <= 0 ? 1 : pl.Scale,
                };
                _elements.Add(el);
                await RenderElement(el);
            }
            Status($"Arranged {placed.Length} elements.");
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; StateHasChanged(); }
    }

    // Add a picked element of a kind. Selects + renders it. Singleton env pieces (ground, hardscape, ...) add
    // at most once; a repeat just selects the existing one.
    async Task AddElement(string kind, string id, string label)
    {
        if (kind == "env" && _catalogPieces.FirstOrDefault(p => p.Stem == id)?.Singleton == true)
        {
            var dup = _elements.FirstOrDefault(e => e.Kind == "env" && e.Ref == id);
            if (dup is not null) { await SelectElement(dup.Id); _pickerOpen = false; return; }
        }
        var el = new DesignElement { Id = NextElementId(), Kind = kind, Ref = id, Label = label };
        _elements.Add(el);
        await RenderElement(el);
        await SelectElement(el.Id);
        _pickerOpen = false;
        StateHasChanged();
    }

    async Task ReshellSelected()
    {
        if (Selected is { } sel) await RenderAndReselect(sel);
    }

    async Task RenderAndReselect(DesignElement el)
    {
        await RenderElement(el);
        await SelectElement(el.Id);
    }

    // Shells offered for an element's shell dropdown. v1: all shells (the env catalog carries no asset-type
    // map per stem, so a precise filter is deferred); the user picks a compatible shell.
    IEnumerable<ShellRow> ShellsForAssetTypeOf(DesignElement el) => _allShells;

    async Task SetGizmoMode(string mode)
    {
        if (_designer is not null) await _designer.InvokeVoidAsync("setGizmoMode", mode);
    }

    // The transform numeric fields for the selected element; editing pushes the transform to the gizmo + group.
    RenderFragment TransformFields(DesignElement el) => builder =>
    {
        int seq = 0;
        void Num(string label, Func<float> get, Action<float> set)
        {
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "flex items-center gap-1");
            builder.AddContent(seq++, label);
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "step", "0.1");
            builder.AddAttribute(seq++, "class", "reg-filter-input w-[60px]");
            builder.AddAttribute(seq++, "value", get());
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, async e =>
            {
                set(float.TryParse(e.Value?.ToString(), out var v) ? v : 0);
                await PushElementTransform(el);
            }));
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "flex gap-2");
        Num("X", () => el.Pos[0], v => el.Pos[0] = v);
        Num("Y", () => el.Pos[1], v => el.Pos[1] = v);
        Num("Z", () => el.Pos[2], v => el.Pos[2] = v);
        builder.CloseElement();
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "flex gap-2 mt-1");
        Num("rX", () => el.RotDeg[0], v => el.RotDeg[0] = v);
        Num("rY", () => el.RotDeg[1], v => el.RotDeg[1] = v);
        Num("rZ", () => el.RotDeg[2], v => el.RotDeg[2] = v);
        builder.CloseElement();
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "flex gap-2 mt-1");
        Num("scale", () => el.Scale, v => el.Scale = v <= 0 ? 1 : v);
        builder.CloseElement();
    };

    async Task SaveDesign()
    {
        if (string.IsNullOrWhiteSpace(_designName)) return;
        var payload = new DesignPayload
        {
            Background = _bgColor, BackgroundTransparent = _bgTransparent,
            Lighting = _lighting, Elements = _elements.ToList(),
        };
        var json = System.Text.Json.JsonSerializer.Serialize(payload);
        var res = await Client().PutAsJsonAsync($"/api/env/designs/{Uri.EscapeDataString(_designName.Trim())}", new { payload = json });
        if (res.IsSuccessStatusCode) { Status($"Saved \"{_designName.Trim()}\"."); await RefreshDesigns(); }
        else Fail($"save failed: HTTP {(int)res.StatusCode}");
    }

    async Task LoadDesign()
    {
        if (string.IsNullOrEmpty(_selectedDesign) || _mod is null) return;
        Status("Loading design…");
        try
        {
            var json = await Client().GetStringAsync($"/api/env/designs/{Uri.EscapeDataString(_selectedDesign)}");
            var payload = System.Text.Json.JsonSerializer.Deserialize<DesignPayload>(json);
            if (payload is null) { Fail("design is corrupt"); return; }

            foreach (var el in _elements.ToList()) await _mod.InvokeVoidAsync("removeGroup", el.Id);
            _elements.Clear();
            _selectedElementId = null;
            if (_designer is not null) await _designer.InvokeVoidAsync("deselect");

            _bgColor = string.IsNullOrEmpty(payload.Background) ? _bgColor : payload.Background;
            _bgTransparent = payload.BackgroundTransparent;
            _lighting = payload.Lighting ?? new();
            await ApplyBackground();
            await ApplyLighting();

            foreach (var el in payload.Elements)
            {
                _elements.Add(el);
                _elementSeq = Math.Max(_elementSeq, ParseSeq(el.Id));
                await RenderElement(el);
            }
            Status($"Loaded \"{_selectedDesign}\".");
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    static int ParseSeq(string id) => int.TryParse(id.TrimStart('e', 'l'), out var n) ? n : 0;

    async Task DeleteDesign()
    {
        if (string.IsNullOrEmpty(_selectedDesign)) return;
        var res = await Client().DeleteAsync($"/api/env/designs/{Uri.EscapeDataString(_selectedDesign)}");
        if (res.IsSuccessStatusCode) { _selectedDesign = ""; await RefreshDesigns(); }
        else Fail($"delete failed: HTTP {(int)res.StatusCode}");
    }

    async Task RefreshDesigns()
    {
        try
        {
            var res = await Client().GetFromJsonAsync<DesignListResult>("/api/env/designs");
            _savedDesigns = res?.Designs?.Select(d => d.Name).ToList() ?? [];
        }
        catch { _savedDesigns = []; }
        StateHasChanged();
    }

    void Status(string s) { _error = false; _status = s; StateHasChanged(); }
    void Fail(string s) { _error = true; _status = s; StateHasChanged(); }

    public sealed class DesignElement
    {
        public string Id { get; set; } = "";
        public string Kind { get; set; } = "env";      // env | chicken | shell | mesh
        public string Ref { get; set; } = "";           // stem or identifier
        public string Label { get; set; } = "";
        public string? Hat { get; set; }                 // chicken hat identifier
        public string? Shell { get; set; }               // applied shell identifier
        public float[] Pos { get; set; } = [0, 0, 0];
        public float[] RotDeg { get; set; } = [0, 0, 0];
        public float Scale { get; set; } = 1f;
        public string Anim { get; set; } = "none";       // none | SpinY | SpinZ | HoverSpin (per element)
    }

    public sealed class LightingState
    {
        public float SunAzimuthDeg { get; set; } = 45;
        public float SunElevationDeg { get; set; } = 55;
        public string SunColor { get; set; } = "#ffffff";
        public float SunIntensity { get; set; } = 1.0f;
        public string FogColor { get; set; } = "#1a1a1f";
        public float FogDensity { get; set; } = 0f;
    }

    public sealed class DesignPayload
    {
        public string Background { get; set; } = "";
        public bool BackgroundTransparent { get; set; } = true;
        public LightingState Lighting { get; set; } = new();
        public List<DesignElement> Elements { get; set; } = [];
    }

    record ShellRow(string Identifier, string? Name, string AssetType, string Url, bool ModifiedGeometry);
    record ShellListResult(bool Ok, string[]? AssetTypes, ShellRow[]? Shells);
    record ShellObjRow(string Identifier, string? Name, string AssetType, string Url, float[]? Anchor, bool NoHats)
    {
        public float[] Anchor { get; init; } = Anchor ?? [];
    }
    record ShellObjResult(bool Ok, ShellObjRow[]? Objects);
    record EnvPieceRow(string Stem, string Label, string Group, bool Singleton = false, string Family = "");
    record EnvCatalogResult(EnvPieceRow[]? Pieces, EnvPieceRow[]? Habs);
    record FamilyOption(string Stem, string Label);
    record FamilyResult(FamilyOption[]? Family);
    record FarmPlaced(string Stem, string Label, float[] Pos, float RotY, float Scale);
    record FarmLayoutResult(FarmPlaced[]? Elements);
    record DesignRow(string Name, DateTimeOffset UpdatedAt, string? Owner);
    record DesignListResult(DesignRow[]? Designs);

    public async ValueTask DisposeAsync()
    {
        if (_mod is not null)
        {
            try { await _mod.InvokeVoidAsync("dispose"); } catch { }
            try { await _mod.DisposeAsync(); } catch { }
        }
        if (_designer is not null)
        {
            try { await _designer.InvokeVoidAsync("disposeDesigner"); } catch { }
            try { await _designer.DisposeAsync(); } catch { }
        }
        _selfRef?.Dispose();
    }
}
