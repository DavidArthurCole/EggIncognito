    // Called from the gizmo (playgroundDesigner.js) whenever a drag moves the selected element, so the numeric
    // inspector fields follow the gizmo live.
    [JSInvokable]
    public async Task OnGizmoTransform(string id, double[] pos, double[] rotDeg, double scale)
    {
        var el = _elements.FirstOrDefault(e => e.Id == id);
        if (el is not null)
        {
            el.Pos = [(float)pos[0], (float)pos[1], (float)pos[2]];
            el.RotDeg = [(float)rotDeg[0], (float)rotDeg[1], (float)rotDeg[2]];
            el.Scale = (float)scale;
            // A moved building re-routes the actors that key off it. A moved actor is left alone (re-deriving
            // would snap it back off its own placement).
            if (el.Kind != "actor") await RederiveActors();
            await InvokeAsync(StateHasChanged);
            Autosave();
        }
    }

    // Called from the canvas raycast (playgroundDesigner.js) when the user clicks an element (or empty space).
    // The JS side already attached the gizmo + outline, so this only syncs the C# selection + inspector.
    [JSInvokable]
    public async Task OnPickElement(string? id)
    {
        _selectedElementId = id is not null && _elements.Any(e => e.Id == id) ? id : null;
        _confirmDeleteId = null;
        await LoadFamilyOptions();
        await InvokeAsync(StateHasChanged);
    }

    string NextElementId() => $"el{++_elementSeq}";

    // The glb URL for an element by kind. mesh + env share the env route; shell/chicken use the shells route.
    string? ElementGlbUrl(DesignElement el) => el.Kind switch
    {
        "env" => $"/api/env/{Uri.EscapeDataString(el.Shell ?? el.Ref)}/glb",
        "shell" => $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Shell ?? el.Ref)}/glb",
        "chicken" => $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Ref)}/glb",
        "mesh" => $"/api/env/{Uri.EscapeDataString(el.Ref)}/glb",
        "actor" => el.Actor == "chicken"
            ? $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Ref)}/glb"
            : $"/api/env/{Uri.EscapeDataString(el.Ref)}/glb",
        _ => null,
    };

    // Pushes an actor's motion descriptor to the engine (or clears it for a non-actor). Deriving the path is
    // done when the actor is added or a source building moves, not here.
    async Task PushElementMotion(DesignElement el)
    {
        if (_mod is null) return;
        object? motion = el.Kind == "actor" && el.Motion is not null
            ? new { kind = el.Motion.Kind, path = el.Motion.Path, speed = el.Motion.Speed,
                    loop = el.Motion.Loop, facePath = el.Motion.FacePath, faceOffset = el.Motion.FaceOffset,
                    height = el.Motion.Height, period = el.Motion.Period, count = el.Motion.Count,
                    stopSeconds = el.Motion.StopSeconds }
            : null;
        await _mod.InvokeVoidAsync("setGroupMotion", el.Id, motion);
        await RefreshAnimatedFlag();
    }

    // Derives an actor's motion from the placed buildings. Chicken: hatchery -> nearest hab. Vehicle: the road
    // line across the farm X bounds. Rocket: vertical from the mission control pad. Falls back to a sane local
    // path + a status note when the source building is absent.
    MotionState DeriveMotion(DesignElement actor)
    {
        if (actor.Actor == "rocket")
        {
            var mc = _elements.FirstOrDefault(e => e.Kind == "env" && e.Ref.StartsWith("ei_mission_control"));
            var pos = mc?.Pos ?? [16f, 0f, 9f];
            if (mc is null) Status("Place a mission control to launch the rocket from it.");
            else
            {
                // align the rocket to the mission control pad: sit on it + share its Y-orientation.
                actor.Pos = [pos[0], pos[1], pos[2]];
                actor.RotDeg = [0f, mc.RotDeg[1], 0f];
            }
            return new MotionState { Kind = "launch", Path = PlaygroundPaths.LaunchPath(pos, 12f), Height = 12f, Period = 6f };
        }
        if (actor.Actor == "vehicle")
        {
            var xs = _elements.Where(e => e.Kind != "actor").Select(e => e.Pos[0]).ToList();
            var minX = xs.Count > 0 ? xs.Min() - 6f : -20f;
            var maxX = xs.Count > 0 ? xs.Max() + 6f : 20f;
            // Drive one direction right -> left (from +X toward -X, looking at the farm from the front), wrapping
            // pacman-style at the end (Loop=cycle, not pingpong). FaceOffset +90deg aligns the +X-forward vehicle
            // mesh to the drive heading.
            return new MotionState
            {
                Kind = "path", Path = PlaygroundPaths.RoadPath(maxX, minX), Speed = 6f,
                Loop = "cycle", FacePath = true, FaceOffset = System.MathF.PI / 2f,
                Count = actor.Motion?.Count is > 0 ? actor.Motion.Count : 1,
                StopSeconds = actor.Motion?.StopSeconds ?? 0f,
            };
        }
        // chickens run UNI-DIRECTIONALLY hatchery-door -> hab (Loop=cycle, wrapping back to the door, never
        // pingponging back). Count > 1 runs several chickens at once, staggered in phase + offset into parallel
        // lanes by the engine.
        var count = actor.Motion?.Count is > 0 ? actor.Motion.Count : 1;
        var hatch = _elements.FirstOrDefault(e => e.Kind == "env" && e.Ref.StartsWith("ei_hatchery"));
        var habs = _elements.Where(e => e.Kind == "env" && EnvCatalog.AssetTypeOf(e.Ref) is { } at && IsHab(at)).ToList();
        if (hatch is null || habs.Count == 0)
        {
            Status("Place a hatchery and a hab to route the chicken.");
            return new MotionState { Kind = "path", Path = [[0f, 0f, 2f], [4f, 0f, -8f]], Speed = 2f, Loop = "cycle", FacePath = true, Count = count };
        }
        var nearest = habs.OrderBy(h => Dist2(h.Pos, hatch.Pos)).First();
        return new MotionState { Kind = "path", Path = PlaygroundPaths.ChickenRun(hatch.Pos, nearest.Pos), Speed = 2.5f, Loop = "cycle", FacePath = true, Count = count };
    }

    static bool IsHab(string assetType) => assetType is "Coop" or "Shack" or "SuperShack" or "ShortHouse"
        or "TheStandard" or "LongHouse" or "DoubleDecker" or "Warehouse" or "Center" or "Bunker" or "Eggkea"
        or "Hab1K" or "Hangar" or "Tower" or "Hab10K" or "Eggtopia" or "Monolith" or "PlanetPortal" or "ChickenUniverse";

    static float Dist2(float[] a, float[] b)
    {
        var dx = a[0] - b[0]; var dz = a[2] - b[2];
        return dx * dx + dz * dz;
    }

    // Place an actor (chicken / vehicle / rocket). Derives its path from the placed buildings, renders, selects.
    // Rockets (ships) are capped at one per farm; a second add selects the existing one instead.
    async Task AddActor(string actorType, string meshRef, string label)
    {
        if (actorType == "rocket")
        {
            var existing = _elements.FirstOrDefault(e => e.Kind == "actor" && e.Actor == "rocket");
            if (existing is not null) { await SelectElement(existing.Id); _pickerOpen = false; StateHasChanged(); return; }
        }
        PushHistory();
        var el = new DesignElement { Id = NextElementId(), Kind = "actor", Actor = actorType, Ref = meshRef, Label = label };
        el.Motion = DeriveMotion(el);
        _elements.Add(el);
        await RenderElement(el);
        await SelectElement(el.Id);
        _pickerOpen = false;
        StateHasChanged();
    }

    // Re-derive every actor's path (after a building moves), so motion follows the new layout.
    async Task RederiveActors()
    {
        foreach (var a in _elements.Where(e => e.Kind == "actor").ToList())
        {
            a.Motion = DeriveMotion(a); // may realign the rocket onto the mission control
            if (a.Actor == "rocket") await PushElementTransform(a);
            await PushElementMotion(a);
        }
    }

    // Render (or re-render) an element's group at its transform. Chickens compose the hat.
    async Task RenderElement(DesignElement el)
    {
        if (_mod is null) return;
        var url = ElementGlbUrl(el);
        if (url is null) return;
        var glb = await FetchRaw(url);
        if (glb is null) return;

        if (el.Kind == "chicken" && !string.IsNullOrEmpty(el.Hat))
        {
            var hat = await FetchRaw($"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Hat)}/glb");
            var anchor = _chickens.FirstOrDefault(c => c.Identifier == el.Ref)?.Anchor ?? [];
            await _mod.InvokeAsync<string[]>("addGroup", el.Id, Convert.ToBase64String(glb),
                new { hatBase64 = hat is null ? null : Convert.ToBase64String(hat), anchor });
        }
        else
        {
            // free-placed env buildings re-center so the gizmo lands on them; layout-derived ones keep their
            // authored plot offset (el.Recenter is false for auto-arranged + restored pieces).
            await _mod.InvokeAsync<string[]>("addGroup", el.Id, Convert.ToBase64String(glb), new { recenter = el.Recenter });
        }
        await PushElementTransform(el);
        await ApplyElementAnimation(el);
        await PushElementMotion(el);
        await ApplyEffect(el);
        Autosave();
    }

    // Set the element's placed transform on its group (works in view + design mode; the gizmo reads the same
    // base). When the gizmo is attached to this element, re-point it so it follows the new transform.
    async Task PushElementTransform(DesignElement el)
    {
        if (_mod is not null)
            await _mod.InvokeVoidAsync("setGroupTransform", el.Id, el.Pos, el.RotDeg, el.Scale);
        if (_designer is not null && _selectedElementId == el.Id)
            await _designer.InvokeVoidAsync("selectElement", el.Id);
        Autosave();
    }

    async Task SelectElement(string id)
    {
        _selectedElementId = id;
        _confirmDeleteId = null; // a pending delete-confirm does not carry to a newly selected element
        if (_designer is not null) await _designer.InvokeVoidAsync("selectElement", id);
        await LoadFamilyOptions();
        StateHasChanged();
    }

    // Fetch the swap-family siblings for the selected env element (hab tiers, lab levels, ...). Empty for
    // pieces with no family or non-env elements.
    async Task LoadFamilyOptions()
    {
        _familyOptions = [];
        if (Selected is { Kind: "env" } sel && !string.IsNullOrEmpty(sel.Ref))
        {
            try
            {
                var res = await Client().GetFromJsonAsync<FamilyResult>($"/api/env/family/{Uri.EscapeDataString(sel.Ref)}");
                _familyOptions = res?.Family?.ToList() ?? [];
            }
            catch { _familyOptions = []; }
        }
    }

    // Swap a placed element to another piece in its family (a different hab tier / lab level), keeping its
    // transform. sel.Ref is already updated by the bind; re-render with the new mesh + refresh the family.
    async Task SwapVariation(DesignElement sel)
    {
        PushHistory();
        var opt = _familyOptions.FirstOrDefault(f => f.Stem == sel.Ref);
        if (opt is not null) sel.Label = opt.Label;
        await RenderElement(sel);
        await SelectElement(sel.Id);
    }

    // Delete after the inline confirm. Clears the confirm + selection, removes the group.
    async Task ConfirmDelete(DesignElement el)
    {
        _confirmDeleteId = null;
        await DeleteElement(el);
    }

    async Task DeleteElement(DesignElement el)
    {
        PushHistory();
        _elements.Remove(el);
        if (_selectedElementId == el.Id) { _selectedElementId = null; if (_designer is not null) await _designer.InvokeVoidAsync("deselect"); }
        if (_mod is not null) await _mod.InvokeVoidAsync("removeGroup", el.Id);
        StateHasChanged();
        Autosave();
    }

    List<DesignElement> CloneElements() => _elements.Select(e => new DesignElement
    {
        Id = e.Id, Kind = e.Kind, Ref = e.Ref, Label = e.Label, Hat = e.Hat, Shell = e.Shell, Recenter = e.Recenter, Effect = e.Effect,
        Pos = [e.Pos[0], e.Pos[1], e.Pos[2]], RotDeg = [e.RotDeg[0], e.RotDeg[1], e.RotDeg[2]],
        Scale = e.Scale, Anim = e.Anim, Actor = e.Actor,
        Motion = e.Motion is null ? null : new MotionState
        {
            Kind = e.Motion.Kind, Path = e.Motion.Path.Select(w => (float[])w.Clone()).ToArray(),
            Speed = e.Motion.Speed, Loop = e.Motion.Loop, FacePath = e.Motion.FacePath, FaceOffset = e.Motion.FaceOffset,
            Height = e.Motion.Height, Period = e.Motion.Period, Count = e.Motion.Count, StopSeconds = e.Motion.StopSeconds,
        },
    }).ToList();

    // Snapshot the element list BEFORE a mutating action so it can be undone. Clears the redo branch. Skipped
    // while a history restore is in flight, so undo/redo do not push their own result.
    void PushHistory()
    {
        if (_restoringHistory) return;
        _undo.Push(CloneElements());
        if (_undo.Count > HistoryCap)
        {
            var keep = _undo.Take(HistoryCap).ToArray();
            _undo.Clear();
            for (var i = keep.Length - 1; i >= 0; i--) _undo.Push(keep[i]);
        }
        _redo.Clear();
    }

    [JSInvokable]
    public Task OnGizmoDragStart() { PushHistory(); return Task.CompletedTask; }

    [JSInvokable]
    public async Task OnUndo()
    {
        if (_undo.Count == 0) return;
        _redo.Push(CloneElements());
        await ApplyHistorySnapshot(_undo.Pop());
    }

    [JSInvokable]
    public async Task OnRedo()
    {
        if (_redo.Count == 0) return;
        _undo.Push(CloneElements());
        await ApplyHistorySnapshot(_redo.Pop());
    }

    // Restore a history snapshot by DIFFING it against the live scene and touching only what changed: remove
    // elements gone from the snapshot, add ones new to it, re-render ones whose mesh-affecting fields differ,
    // and just re-place (no mesh rebuild) ones where only the transform moved. A typical undo (one element
    // dragged) re-places a single group instead of tearing down + reloading the whole farm.
    async Task ApplyHistorySnapshot(List<DesignElement> snapshot)
    {
        if (_mod is null) return;
        _restoringHistory = true;
        try
        {
            var keepSel = _selectedElementId;
            var byId = _elements.ToDictionary(e => e.Id);
            var snapIds = snapshot.Select(s => s.Id).ToHashSet();

            foreach (var live in _elements.ToList())
                if (!snapIds.Contains(live.Id)) { await _mod.InvokeVoidAsync("removeGroup", live.Id); _elements.Remove(live); }

            foreach (var snap in snapshot)
            {
                if (!byId.TryGetValue(snap.Id, out var live))
                {
                    _elements.Add(snap);
                    await RenderElement(snap);
                    continue;
                }
                bool meshChanged = !MeshIdentical(live, snap);
                CopyInto(live, snap);
                if (meshChanged) await RenderElement(live);
                else await PushElementTransform(live);
            }

            _selectedElementId = null;
            if (_designer is not null) await _designer.InvokeVoidAsync("deselect");
            if (keepSel is not null && _elements.Any(e => e.Id == keepSel)) await SelectElement(keepSel);
            await RefreshAnimatedFlag();
        }
        finally { _restoringHistory = false; }
        StateHasChanged();
        Autosave();
    }

    // Mesh-affecting fields: a change here needs a full RenderElement (new geometry/shell/hat/actor). A pure
    // transform/anim change does not. Motion is compared by reference-free value via the actor/kind it rides.
    static bool MeshIdentical(DesignElement a, DesignElement b) =>
        a.Kind == b.Kind && a.Ref == b.Ref && a.Hat == b.Hat && a.Shell == b.Shell && a.Actor == b.Actor;

    // Copy a snapshot's fields onto the live element in place (keeps the same object identity so selection +
    // group bindings hold).
    static void CopyInto(DesignElement live, DesignElement snap)
    {
        live.Kind = snap.Kind; live.Ref = snap.Ref; live.Label = snap.Label; live.Hat = snap.Hat; live.Shell = snap.Shell;
        live.Pos = [snap.Pos[0], snap.Pos[1], snap.Pos[2]];
        live.RotDeg = [snap.RotDeg[0], snap.RotDeg[1], snap.RotDeg[2]];
        live.Scale = snap.Scale; live.Anim = snap.Anim; live.Actor = snap.Actor; live.Motion = snap.Motion; live.Recenter = snap.Recenter; live.Effect = snap.Effect;
    }


    // Builds a game-like farm in one click: clears the scene, fetches the standard layout, adds each element
    // at its plot position. Honors singletons (ground/hardscape added once). A starting point to tweak, not a
    // pixel-exact game farm (positions are derived, not extracted from the binary).
    async Task AutoArrangeFarm()
    {
        if (_mod is null) return;
        _busy = true; Status("Arranging farm…");
        try
        {
            FarmLayoutResult? layout;
            try { layout = await Client().GetFromJsonAsync<FarmLayoutResult>("/api/env/farm-layout"); }
            catch (Exception ex) { Fail($"layout fetch failed: {ex.Message}"); return; }
            var placed = layout?.Elements ?? [];
            if (placed.Length == 0) { Fail("no layout returned"); return; }

            foreach (var el in _elements.ToList()) await _mod.InvokeVoidAsync("removeGroup", el.Id);
            _elements.Clear();
            _selectedElementId = null;
            if (_designer is not null) await _designer.InvokeVoidAsync("deselect");

            foreach (var pl in placed)
            {
                var el = new DesignElement
                {
                    Id = NextElementId(), Kind = "env", Ref = pl.Stem, Label = pl.Label,
                    Pos = pl.Pos, RotDeg = [0, pl.RotY, 0], Scale = pl.Scale <= 0 ? 1 : pl.Scale,
                };
                _elements.Add(el);
                await RenderElement(el);
            }
            await ResetView();
            Status($"Arranged {placed.Length} elements.");
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; StateHasChanged(); }
    }

    // Per-farm placement limits. Families that allow exactly one instance regardless of tier (a farm has one
    // research lab, one mission control, one artifact hall, one hatchery, one trophy case). Plus count caps on
    // the multi-instance pieces: habs and silos.
    static readonly HashSet<string> SingleInstanceFamilies = new(StringComparer.Ordinal)
        { "lab", "mission", "hoa", "hatchery", "trophy" };
    const int MaxHabs = 4;
    const int MaxSilos = 10;

    static bool IsSilo(string stem) => stem.StartsWith("ei_silo", StringComparison.Ordinal);

    int CountFamily(string family) => _elements.Count(e =>
        e.Kind == "env" && _catalogPieces.FirstOrDefault(p => p.Stem == e.Ref)?.Family == family);
    int CountHabs() => CountFamily("hab");
    int CountSilos() => _elements.Count(e => e.Kind == "env" && IsSilo(e.Ref));

    // Why a piece cannot be placed right now (null = placeable). Drives both the disabled picker state + the
    // AddElement guard. A single-instance family already present blocks; habs/silos block at their cap.
    string? PlacementBlockedReason(EnvPieceRow p)
    {
        if (!string.IsNullOrEmpty(p.Family) && SingleInstanceFamilies.Contains(p.Family) && CountFamily(p.Family) >= 1)
            return "placed";
        if (p.Family == "hab" && CountHabs() >= MaxHabs) return "max " + MaxHabs;
        if (IsSilo(p.Stem) && CountSilos() >= MaxSilos) return "max " + MaxSilos;
        if (p.Singleton && _elements.Any(e => e.Kind == "env" && e.Ref == p.Stem)) return "placed";
        return null;
    }

    // One picker entry per family (placing the highest tier = the last catalog piece in the family), plus each
    // family-less piece on its own. Display name strips the trophy/lab-style "(n)" tier suffix for families.
    readonly record struct PickerEntry(EnvPieceRow Piece, string Display);
    IEnumerable<PickerEntry> FamilyPickerEntries(IEnumerable<EnvPieceRow> group)
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (var p in group)
        {
            if (string.IsNullOrEmpty(p.Family)) { yield return new(p, p.Label); continue; }
            if (!seen.Add(p.Family)) continue;
            // highest tier = the last catalog piece sharing this family (catalog is tier-ascending).
            var top = _catalogPieces.Last(q => q.Family == p.Family);
            yield return new(top, FamilyDisplayName(p.Family, top.Label));
        }
    }

    static string FamilyDisplayName(string family, string fallbackLabel) => family switch
    {
        "hab" => "Hab", "depot" => "Depot", "fuel" => "Fuel tank", "lab" => "Research lab",
        "mission" => "Mission control", "hoa" => "Artifact hall", "trophy" => "Trophy case",
        "hatchery" => "Hatchery", _ => StripTier(fallbackLabel),
    };

    static string StripTier(string label)
    {
        var i = label.LastIndexOf(" (", StringComparison.Ordinal);
        return i > 0 ? label[..i] : label;
    }

    // Add a picked element of a kind. Selects + renders it. Enforces the per-farm placement limits; a blocked
    // add (cap reached / single-instance present) just selects the existing one when there is one.
    async Task AddElement(string kind, string id, string label)
    {
        if (kind == "env")
        {
            var piece = _catalogPieces.FirstOrDefault(p => p.Stem == id);
            if (piece is not null && PlacementBlockedReason(piece) is not null)
            {
                var dup = _elements.FirstOrDefault(e => e.Kind == "env"
                    && (e.Ref == id || (!string.IsNullOrEmpty(piece.Family) && _catalogPieces.FirstOrDefault(p => p.Stem == e.Ref)?.Family == piece.Family)));
                if (dup is not null) await SelectElement(dup.Id);
                _pickerOpen = false; StateHasChanged();
                return;
            }
        }
        PushHistory();
        // free-placed env buildings re-center on their group origin so the gizmo lands on them. Actors +
        // chickens ride their own anchored motion; they are not re-centered.
        var el = new DesignElement { Id = NextElementId(), Kind = kind, Ref = id, Label = label, Recenter = kind == "env" };
        _elements.Add(el);
        await RenderElement(el);
        await SelectElement(el.Id);
        _pickerOpen = false;
        StateHasChanged();
    }

    async Task ReshellSelected()
    {
        if (Selected is { } sel) await RenderAndReselect(sel);
    }

    // Discrete-edit wrappers: each pushes one undo step before the underlying re-render. The inner methods are
    // also called internally (e.g. RenderElement -> ApplyElementAnimation) where a push would be wrong, so the
    // push lives in the wrapper, not the inner method.
    async Task OnAnimChanged(DesignElement sel) { PushHistory(); await ApplyElementAnimation(sel); }

    // Toggle the extracted decomp particle effect on a hab. Fetches the recovered EffectModel from the decomp
    // endpoint + attaches it (or clears it). The galaxy orbit math comes from the binary (see the effect-recovery
    // framework), so this turns the universe hab's floating particles on with the extracted motion.
    async Task OnEffectToggled(DesignElement sel, bool on)
    {
        PushHistory();
        sel.Effect = on;
        await ApplyEffect(sel);
        StateHasChanged();
    }

    async Task ApplyEffect(DesignElement el)
    {
        if (_mod is null) return;
        if (el.Effect && el.Ref == "hab_chicken_universe")
        {
            try
            {
                var model = await Client().GetFromJsonAsync<System.Text.Json.JsonElement>("/api/decomp/effect?name=galaxy-particle");
                await _mod.InvokeVoidAsync("attachEffect", el.Id, model);
            }
            catch (Exception ex) { Status($"effect unavailable: {ex.Message}"); }
        }
        else await _mod.InvokeVoidAsync("attachEffect", el.Id, null);
    }
    async Task OnShellChanged() { PushHistory(); await ReshellSelected(); }
    async Task OnHatChanged(DesignElement sel) { PushHistory(); await RenderAndReselect(sel); }

    async Task OnChickenSkinChanged(DesignElement sel)
    {
        PushHistory();
        var c = _chickens.FirstOrDefault(x => x.Identifier == sel.Ref);
        if (c is not null) sel.Label = c.Name ?? c.Identifier;
        await RenderAndReselect(sel);
    }

    async Task LoadShellSets()
    {
        try
        {
            var res = await Client().GetFromJsonAsync<ShellSetsResult>($"/api/shells/sets?platform={ShellPlatform}");
            _shellSets = res?.Sets?.ToList() ?? [];
            _decorators = res?.Decorators?.ToList() ?? [];
        }
        catch { _shellSets = []; _decorators = []; }
    }

    // Apply a shell set: for each placed element whose asset type matches a set member, set that element's Shell
    // to the member identifier and re-render. "selected" mode limits it to the selected element. One undoable
    // action. Elements with no matching member are left untouched (single cosmetic per element).
    async Task ApplyShellSet(ShellSetRow set)
    {
        var members = set.Members ?? [];
        if (members.Length == 0) return;
        var targets = _setApplyMode == "selected"
            ? (Selected is { } s ? new[] { s } : [])
            : _elements.ToArray();
        if (targets.Length == 0) return;
        PushHistory();
        foreach (var el in targets)
        {
            var at = EnvCatalog.AssetTypeOf(el.Ref);
            if (at is null) continue;
            var member = members.FirstOrDefault(m => string.Equals(m.AssetType, at, StringComparison.OrdinalIgnoreCase));
            if (member is null) continue;
            el.Shell = member.Identifier;
            await RenderElement(el);
        }
        if (_selectedElementId is not null) await SelectElement(_selectedElementId);
        Status($"Applied set \"{set.Name ?? set.Identifier}\".");
    }

    // Farm-wide decorator: a single design-level cosmetic overlay across matching elements. Applies the
    // decorator's member shells to matching elements' Shell (same match rule as a set), and records the
    // selection so it persists with the design. None clears the recorded selection (placed base meshes stay).
    async Task ApplyDecorator()
    {
        PushHistory();
        var deco = _decorators.FirstOrDefault(d => d.Identifier == _decoratorId);
        if (deco is not null)
        {
            var members = deco.Members ?? [];
            foreach (var el in _elements.ToArray())
            {
                var at = EnvCatalog.AssetTypeOf(el.Ref);
                if (at is null) continue;
                var member = members.FirstOrDefault(m => string.Equals(m.AssetType, at, StringComparison.OrdinalIgnoreCase));
                if (member is null) continue;
                el.Shell = member.Identifier;
                await RenderElement(el);
            }
            if (_selectedElementId is not null) await SelectElement(_selectedElementId);
        }
        Autosave();
    }

    async Task RenderAndReselect(DesignElement el)
    {
        await RenderElement(el);
        await SelectElement(el.Id);
    }

    // Shells offered for an element's shell dropdown. v1: all shells (the env catalog carries no asset-type
    // map per stem, so a precise filter is deferred); the user picks a compatible shell.
    IEnumerable<ShellRow> ShellsForAssetTypeOf(DesignElement el) => _allShells;

    async Task SetGizmoMode(string mode)
    {
        if (_designer is not null) await _designer.InvokeVoidAsync("setGizmoMode", mode);
    }

    // The transform numeric fields for the selected element; editing pushes the transform to the gizmo + group.
    // Compact transform editor: one row per vector (Pos, Rot, Scale) with a short row label and the axis inputs
    // sharing the row width via flex, so all three fit the narrow panel. A per-axis text label per box was too
    // wide to use; the X/Y/Z order is implicit + each input carries a placeholder.
    RenderFragment TransformFields(DesignElement el) => builder =>
    {
        int seq = 0;
        void Axis(string ph, Func<float> get, Action<float> set)
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "step", "0.1");
            builder.AddAttribute(seq++, "placeholder", ph);
            builder.AddAttribute(seq++, "class", "reg-filter-input w-full min-w-0 px-1");
            builder.AddAttribute(seq++, "value", get());
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, async e =>
            {
                PushHistory();
                set(float.TryParse(e.Value?.ToString(), out var v) ? v : 0);
                await PushElementTransform(el);
            }));
            builder.CloseElement();
        }
        void Row(string label, params (string Ph, Func<float> Get, Action<float> Set)[] axes)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "flex items-center gap-1 mt-1");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-muted w-8 shrink-0");
            builder.AddContent(seq++, label);
            builder.CloseElement();
            foreach (var (ph, get, set) in axes) Axis(ph, get, set);
            builder.CloseElement();
        }
        Row("Pos", ("X", () => el.Pos[0], v => el.Pos[0] = v), ("Y", () => el.Pos[1], v => el.Pos[1] = v), ("Z", () => el.Pos[2], v => el.Pos[2] = v));
        Row("Rot", ("X", () => el.RotDeg[0], v => el.RotDeg[0] = v), ("Y", () => el.RotDeg[1], v => el.RotDeg[1] = v), ("Z", () => el.RotDeg[2], v => el.RotDeg[2] = v));
        Row("Scale", ("", () => el.Scale, v => el.Scale = v <= 0 ? 1 : v));
    };

    // Save appends a new version to the working design's history. For a brand-new design, the typed name becomes
    // the working design. The server returns the new version number; the timeline refreshes + dirty clears.
    async Task SaveDesign()
    {
        var name = string.IsNullOrEmpty(_currentDesign) ? _designName.Trim() : _currentDesign;
        if (string.IsNullOrWhiteSpace(name)) return;
        var payload = new DesignPayload
        {
            Background = _bgColor, BackgroundTransparent = _bgTransparent,
            Lighting = _lighting, Elements = _elements.ToList(), DecoratorId = _decoratorId,
        };
        var json = System.Text.Json.JsonSerializer.Serialize(payload);
        var res = await Client().PutAsJsonAsync($"/api/env/designs/{Uri.EscapeDataString(name)}",
            new { payload = json, note = string.IsNullOrWhiteSpace(_versionNote) ? null : _versionNote.Trim() });
        if (res.IsSuccessStatusCode)
        {
            var body = await res.Content.ReadFromJsonAsync<SaveResult>();
            _currentDesign = name;
            _currentVersion = body?.Version ?? _currentVersion + 1;
            _designName = "";
            _versionNote = "";
            _dirty = false;
            Status($"Saved \"{name}\" v{_currentVersion}.");
            await RefreshDesigns();
            await LoadVersions();
            if (_autosave is not null) { try { await _autosave.InvokeVoidAsync("clear"); } catch { } }
        }
        else Fail($"save failed: HTTP {(int)res.StatusCode}");
    }

    record SaveResult(string Saved, int Version);

    async Task LoadDesign()
    {
        if (string.IsNullOrEmpty(_selectedDesign) || _mod is null) return;
        Status("Loading design…");
        try
        {
            var json = await Client().GetStringAsync($"/api/env/designs/{Uri.EscapeDataString(_selectedDesign)}");
            var payload = System.Text.Json.JsonSerializer.Deserialize<DesignPayload>(json);
            if (payload is null) { Fail("design is corrupt"); return; }
            await RestoreFromPayload(payload);
            _currentDesign = _selectedDesign;
            _selectedDesign = "";
            _dirty = false;
            await LoadVersions();
            _currentVersion = _versions.Count > 0 ? _versions[0].VersionNo : 0; // newest = head
            Status($"Loaded \"{_currentDesign}\" v{_currentVersion}.");
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    // Start a fresh, unsaved design: clear the scene + the working-design state.
    async Task NewDesign()
    {
        await ClearScene();
        _currentDesign = ""; _currentVersion = 0; _versions = []; _designName = ""; _versionNote = ""; _dirty = false;
        Status("New design.");
    }

    async Task LoadVersions()
    {
        if (string.IsNullOrEmpty(_currentDesign)) { _versions = []; return; }
        try
        {
            var res = await Client().GetFromJsonAsync<DesignVersionsResult>(
                $"/api/env/designs/{Uri.EscapeDataString(_currentDesign)}/versions");
            _versions = res?.Versions?.ToList() ?? [];
        }
        catch { _versions = []; }
    }

    // Roll back to a prior version: the server appends a new version copying it (non-destructive), then we load
    // that restored payload into the scene + refresh the timeline.
    async Task RollbackTo(int versionNo)
    {
        if (string.IsNullOrEmpty(_currentDesign)) return;
        try
        {
            var res = await Client().PostAsJsonAsync(
                $"/api/env/designs/{Uri.EscapeDataString(_currentDesign)}/rollback", new { versionNo });
            if (!res.IsSuccessStatusCode) { Fail($"rollback failed: HTTP {(int)res.StatusCode}"); return; }
            var body = await res.Content.ReadFromJsonAsync<RollbackResult>();
            var json = await Client().GetStringAsync($"/api/env/designs/{Uri.EscapeDataString(_currentDesign)}");
            var payload = System.Text.Json.JsonSerializer.Deserialize<DesignPayload>(json);
            if (payload is not null) await RestoreFromPayload(payload);
            _currentVersion = body?.NewVersion ?? _currentVersion;
            _dirty = false;
            await LoadVersions();
            Status($"Rolled back to v{versionNo} (now v{_currentVersion}).");
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    record RollbackResult(string RolledBack, int FromVersion, int NewVersion);

    // Clear the scene without touching the working-design state. Shared by NewDesign + payload restore.
    async Task ClearScene()
    {
        if (_mod is null) return;
        foreach (var el in _elements.ToList()) await _mod.InvokeVoidAsync("removeGroup", el.Id);
        _elements.Clear();
        _selectedElementId = null;
        if (_designer is not null) await _designer.InvokeVoidAsync("deselect");
    }

    // On load, silently restore a recent autosaved design (a redeploy reload or a crash left one), then clear
    // it and show a dismissible notice. Stale or absent autosave is ignored.
    async Task TryRestoreAutosave()
    {
        if (_autosave is null || _mod is null) return;
        AutosaveRecord? rec;
        try { rec = await _autosave.InvokeAsync<AutosaveRecord?>("load"); }
        catch { rec = null; }
        if (rec is null || string.IsNullOrEmpty(rec.Json)) return;
        if (!EggIncognito.Services.AutosaveRecency.IsFresh(rec.SavedAt, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()))
        {
            await _autosave.InvokeVoidAsync("clear");
            return;
        }
        try
        {
            var payload = System.Text.Json.JsonSerializer.Deserialize<DesignPayload>(rec.Json);
            if (payload is not null) { await RestoreFromPayload(payload); Status("Restored your unsaved design."); }
        }
        catch { /* corrupt autosave: ignore */ }
        finally { await _autosave.InvokeVoidAsync("clear"); }
    }

    // Debounced autosave of the current scene to the localStorage slot. Called on every meaningful change.
    void Autosave()
    {
        _dirty = true; // any scene change makes the working design dirty until the next explicit save
        _autosaveCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        _autosaveCts = cts;
        _ = Task.Delay(750, cts.Token).ContinueWith(async t =>
        {
            if (t.IsCanceled || _autosave is null) return;
            var payload = new DesignPayload
            {
                Background = _bgColor, BackgroundTransparent = _bgTransparent,
                Lighting = _lighting, Elements = _elements.ToList(), DecoratorId = _decoratorId,
            };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            try { await _autosave.InvokeVoidAsync("save", json, _appVersion, now); } catch { /* ignore */ }
        }, TaskScheduler.Default);
    }

    sealed class AutosaveRecord
    {
        public string Json { get; set; } = "";
        public string Version { get; set; } = "";
        public long SavedAt { get; set; }
    }

    record AppVersionDto(string Version, string Sha);

    // Rebuilds the scene from a design payload: clears the current groups, restores background + lighting, then
    // re-renders every element. Shared by Load-design and the autosave restore.
    async Task RestoreFromPayload(DesignPayload payload)
    {
        if (_mod is null) return;
        foreach (var el in _elements.ToList()) await _mod.InvokeVoidAsync("removeGroup", el.Id);
        _elements.Clear();
        _selectedElementId = null;
        if (_designer is not null) await _designer.InvokeVoidAsync("deselect");

        _bgColor = string.IsNullOrEmpty(payload.Background) ? _bgColor : payload.Background;
        _bgTransparent = payload.BackgroundTransparent;
        _lighting = payload.Lighting ?? new();
        _decoratorId = payload.DecoratorId;
        await ApplyBackground();
        await ApplyLighting();

        foreach (var el in payload.Elements)
        {
            _elements.Add(el);
            _elementSeq = Math.Max(_elementSeq, ParseSeq(el.Id));
            await RenderElement(el);
        }
        await ResetView();
        await RefreshAnimatedFlag();
    }

    static int ParseSeq(string id) => int.TryParse(id.TrimStart('e', 'l'), out var n) ? n : 0;

    async Task DeleteDesign()
    {
        if (string.IsNullOrEmpty(_currentDesign)) return;
        var res = await Client().DeleteAsync($"/api/env/designs/{Uri.EscapeDataString(_currentDesign)}");
        if (res.IsSuccessStatusCode)
        {
            await NewDesign();
            await RefreshDesigns();
        }
        else Fail($"delete failed: HTTP {(int)res.StatusCode}");
    }

    async Task RefreshDesigns()
    {
        try
        {
            var res = await Client().GetFromJsonAsync<DesignListResult>("/api/env/designs");
            _savedDesigns = res?.Designs?.Select(d => d.Name).ToList() ?? [];
        }
        catch { _savedDesigns = []; }
        StateHasChanged();
    }

    System.Threading.CancellationTokenSource? _statusCts;

    // Transient status: shows the message then auto-clears after a few seconds (cancels any prior clear).
    void Status(string s)
    {
        _error = false; _status = s; StateHasChanged();
        _statusCts?.Cancel();
        if (string.IsNullOrEmpty(s)) return;
        var cts = new System.Threading.CancellationTokenSource();
        _statusCts = cts;
        _ = Task.Delay(3000, cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _status = ""; InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);
    }

    void Fail(string s) { _statusCts?.Cancel(); _error = true; _status = s; StateHasChanged(); }

    // A page-wide failure (3D init crash, engine dead): shown as a prominent overlay inside the canvas box, not
    // buried in a side-widget status line. Persists until dismissed.
    void FatalError(string s) { _fatalError = s; StateHasChanged(); }
    void DismissFatal() { _fatalError = ""; StateHasChanged(); }

    public sealed class DesignElement
    {
        public string Id { get; set; } = "";
        public string Kind { get; set; } = "env"; // env | chicken | shell | mesh
        public string Ref { get; set; } = ""; // stem or identifier
        public string Label { get; set; } = "";
        public string? Hat { get; set; } // chicken hat identifier
        public string? Shell { get; set; } // applied shell identifier
        public float[] Pos { get; set; } = [0, 0, 0];
        public float[] RotDeg { get; set; } = [0, 0, 0];
        public float Scale { get; set; } = 1f;
        public string Anim { get; set; } = "none"; // none | SpinY | SpinZ | HoverSpin (per element)
        public string Actor { get; set; } = ""; // ""|chicken|vehicle|rocket (kind=="actor")
        public MotionState? Motion { get; set; }
        public bool Recenter { get; set; } // free-placed: re-center the mesh on the group origin so the gizmo lands on it
        public bool Effect { get; set; } // hab: show its extracted decomp particle effect (e.g. universe galaxy)
    }

    public sealed class MotionState
    {
        public string Kind { get; set; } = "path"; // path | launch
        public float[][] Path { get; set; } = []; // world waypoints (path kind)
        public float Speed { get; set; } = 3f;
        public string Loop { get; set; } = "cycle"; // cycle | pingpong
        public bool FacePath { get; set; } = true;
        public float FaceOffset { get; set; } = 0f; // radians added to the face-path heading (mesh forward fix)
        public float Height { get; set; } = 12f; // launch rise
        public float Period { get; set; } = 6f; // launch seconds/cycle
        public int Count { get; set; } = 1; // instances running this path at once (chickens)
        public float StopSeconds { get; set; } = 0f; // dwell at the path end before wrapping (vehicle depot stop)
    }

    public sealed class LightingState
    {
        public float SunAzimuthDeg { get; set; } = 45;
        public float SunElevationDeg { get; set; } = 55;
        public string SunColor { get; set; } = "#ffffff";
        public float SunIntensity { get; set; } = 1.0f;
        public string ToneMapping { get; set; } = "none"; // none | linear | aces | reinhard | cineon
        public float Exposure { get; set; } = 1.0f;
        public float AmbientIntensity { get; set; } = 0.55f;
        public float HemiIntensity { get; set; } = 0.5f;
        public float Emission { get; set; } = 0.85f; // 0 = fully lit/dull, 1 = flat vibrant (game look)
        public string FogColor { get; set; } = "#1a1a1f";
        public float FogDensity { get; set; } = 0f;
    }

    public sealed class DesignPayload
    {
        public string Background { get; set; } = "";
        public bool BackgroundTransparent { get; set; } = true;
        public LightingState Lighting { get; set; } = new();
        public List<DesignElement> Elements { get; set; } = [];
        public string? DecoratorId { get; set; }
    }

