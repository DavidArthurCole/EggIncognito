    // Called from the gizmo (playgroundDesigner.js) whenever a drag moves the selected element, so the numeric
    // inspector fields follow the gizmo live.
    [JSInvokable]
    public async Task OnGizmoTransform(string id, double[] pos, double[] rotDeg, double scale)
    {
        var el = _elements.FirstOrDefault(e => e.Id == id);
        if (el is not null)
        {
            el.Pos = [(float)pos[0], (float)pos[1], (float)pos[2]];
            el.RotDeg = [(float)rotDeg[0], (float)rotDeg[1], (float)rotDeg[2]];
            el.Scale = (float)scale;
            // A moved building re-routes the actors that key off it. A moved actor is left alone (re-deriving
            // would snap it back off its own placement).
            if (el.Kind != "actor") await RederiveActors();
            await InvokeAsync(StateHasChanged);
            Autosave();
        }
    }

    // Authoritative placement solve (playgroundDesigner.js calls this on drag-end / nudge). Runs PlacementSolver
    // with the current grid size: floor clamp (no building in the floor), grid snap, and footprint overlap push
    // (no two buildings occupying the same ground). Returns the corrected [x, y, z, adjusted] for the JS side to
    // snap to. The math is the tested C# core; JS only renders the result.
    [JSInvokable]
    public Task<double[]> OnPlaceSolve(string id, double[] pos, double[] rotDeg, double scale,
        FootprintDto footprint, FootprintDto[] others)
    {
        var local = new PlacementSolver.Box2(footprint.MinX, footprint.MaxX, footprint.MinZ, footprint.MaxZ);
        var otherRects = (others ?? [])
            .Select(o => new PlacementSolver.Box2(o.MinX, o.MaxX, o.MinZ, o.MaxZ))
            .ToArray();
        var req = new PlacementSolver.SolveRequest(
            [(float)pos[0], (float)pos[1], (float)pos[2]],
            [(float)rotDeg[0], (float)rotDeg[1], (float)rotDeg[2]],
            (float)scale, local, footprint.MinY, otherRects,
            _gridSnap ? _gridSize : 0f, footprint.ClampFloor);
        var r = PlacementSolver.Solve(req);
        if (r.Adjusted) { _lastAdjustReason = r.Reason; _ = ShowAdjustHint(); }
        return Task.FromResult(new double[] { r.Pos[0], r.Pos[1], r.Pos[2], r.Adjusted ? 1 : 0 });
    }

    // The grid blocked a drop (target cells occupied / off-grid); the element reverted. Surface the same hint.
    [JSInvokable]
    public Task OnPlacementBlocked()
    {
        _lastAdjustReason = "blocked";
        _ = ShowAdjustHint();
        return Task.CompletedTask;
    }

    // A transient "placement adjusted" hint after the solver moves a piece (floor / overlap), so the jump reads
    // as intentional. Cleared after a short delay.
    string? _lastAdjustReason;
    bool _showAdjustHint;
    async Task ShowAdjustHint()
    {
        _showAdjustHint = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1600);
        _showAdjustHint = false;
        await InvokeAsync(StateHasChanged);
    }

    // Called from the canvas raycast (playgroundDesigner.js) when the user clicks an element (or empty space).
    // The JS side already attached the gizmo + outline, so this only syncs the C# selection + inspector.
    [JSInvokable]
    public async Task OnPickElement(string? id)
    {
        _selectedElementId = id is not null && _elements.Any(e => e.Id == id) ? id : null;
        _confirmDeleteId = null;
        await LoadFamilyOptions();
        await InvokeAsync(StateHasChanged);
    }

    string NextElementId() => $"el{++_elementSeq}";

    // The glb URL for an element by kind. mesh + env share the env route; shell/chicken use the shells route.
    string? ElementGlbUrl(DesignElement el) => el.Kind switch
    {
        "env" => $"/api/env/{Uri.EscapeDataString(el.Shell ?? el.Ref)}/glb",
        "shell" => $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Shell ?? el.Ref)}/glb",
        "chicken" => $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Ref)}/glb",
        "mesh" => $"/api/env/{Uri.EscapeDataString(el.Ref)}/glb",
        "actor" => el.Actor == "chicken"
            ? $"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Ref)}/glb"
            : $"/api/env/{Uri.EscapeDataString(el.Ref)}/glb",
        _ => null,
    };

    // Pushes an actor's motion descriptor to the engine (or clears it for a non-actor). Deriving the path is
    // done when the actor is added or a source building moves, not here.
    async Task PushElementMotion(DesignElement el)
    {
        if (_mod is null) return;
        object? motion = el.Kind == "actor" && el.Motion is not null
            ? new { kind = el.Motion.Kind, path = el.Motion.Path, speed = el.Motion.Speed,
                    loop = el.Motion.Loop, facePath = el.Motion.FacePath, faceOffset = el.Motion.FaceOffset,
                    height = el.Motion.Height, period = el.Motion.Period, count = el.Motion.Count,
                    stopSeconds = el.Motion.StopSeconds }
            : null;
        await _mod.InvokeVoidAsync("setGroupMotion", el.Id, motion);
        await RefreshAnimatedFlag();
    }

    // Derives an actor's motion from the placed buildings. Chicken: hatchery -> nearest hab. Vehicle: the road
    // line across the farm X bounds. Rocket: vertical from the mission control pad. Falls back to a sane local
    // path + a status note when the source building is absent.
    MotionState DeriveMotion(DesignElement actor)
    {
        if (actor.Actor == "rocket")
        {
            var mc = _elements.FirstOrDefault(e => e.Kind == "env" && e.Ref.StartsWith("ei_mission_control"));
            var pos = mc?.Pos ?? [16f, 0f, 9f];
            if (mc is null) Status("Place a mission control to launch the rocket from it.");
            else
            {
                // align the rocket to the mission control pad: sit on it + share its Y-orientation.
                actor.Pos = [pos[0], pos[1], pos[2]];
                actor.RotDeg = [0f, mc.RotDeg[1], 0f];
            }
            return new MotionState { Kind = "launch", Path = PlaygroundPaths.LaunchPath(pos, 12f), Height = 12f, Period = 6f };
        }
        if (actor.Actor == "vehicle")
        {
            var xs = _elements.Where(e => e.Kind != "actor").Select(e => e.Pos[0]).ToList();
            var minX = xs.Count > 0 ? xs.Min() - 6f : -20f;
            var maxX = xs.Count > 0 ? xs.Max() + 6f : 20f;
            // Drive one direction right -> left (from +X toward -X, looking at the farm from the front), wrapping
            // pacman-style at the end (Loop=cycle, not pingpong). FaceOffset +90deg aligns the +X-forward vehicle
            // mesh to the drive heading.
            return new MotionState
            {
                Kind = "path", Path = PlaygroundPaths.RoadPath(maxX, minX), Speed = 6f,
                Loop = "cycle", FacePath = true, FaceOffset = System.MathF.PI / 2f,
                Count = actor.Motion?.Count is > 0 ? actor.Motion.Count : 1,
                StopSeconds = actor.Motion?.StopSeconds ?? 0f,
            };
        }
        // chickens run UNI-DIRECTIONALLY hatchery-door -> hab (Loop=cycle, wrapping back to the door, never
        // pingponging back). Count > 1 runs several chickens at once, staggered in phase + offset into parallel
        // lanes by the engine.
        var count = actor.Motion?.Count is > 0 ? actor.Motion.Count : 1;
        var hatch = _elements.FirstOrDefault(e => e.Kind == "env" && e.Ref.StartsWith("ei_hatchery"));
        var habs = _elements.Where(e => e.Kind == "env" && EnvCatalog.AssetTypeOf(e.Ref) is { } at && IsHab(at)).ToList();
        if (hatch is null || habs.Count == 0)
        {
            Status("Place a hatchery and a hab to route the chicken.");
            return new MotionState { Kind = "path", Path = [[0f, 0f, 2f], [4f, 0f, -8f]], Speed = 2f, Loop = "cycle", FacePath = true, Count = count };
        }
        var nearest = habs.OrderBy(h => Dist2(h.Pos, hatch.Pos)).First();
        return new MotionState { Kind = "path", Path = PlaygroundPaths.ChickenRun(hatch.Pos, nearest.Pos), Speed = 2.5f, Loop = "cycle", FacePath = true, Count = count };
    }

    static bool IsHab(string assetType) => assetType is "Coop" or "Shack" or "SuperShack" or "ShortHouse"
        or "TheStandard" or "LongHouse" or "DoubleDecker" or "Warehouse" or "Center" or "Bunker" or "Eggkea"
        or "Hab1K" or "Hangar" or "Tower" or "Hab10K" or "Eggtopia" or "Monolith" or "PlanetPortal" or "ChickenUniverse";

    static float Dist2(float[] a, float[] b)
    {
        var dx = a[0] - b[0]; var dz = a[2] - b[2];
        return dx * dx + dz * dz;
    }

    // Place an actor (chicken / vehicle / rocket). Derives its path from the placed buildings, renders, selects.
    // Rockets (ships) are capped at one per farm; a second add selects the existing one instead.
    async Task AddActor(string actorType, string meshRef, string label)
    {
        if (actorType == "rocket")
        {
            var existing = _elements.FirstOrDefault(e => e.Kind == "actor" && e.Actor == "rocket");
            if (existing is not null) { await SelectElement(existing.Id); StateHasChanged(); return; }
        }
        PushHistory();
        var el = new DesignElement { Id = NextElementId(), Kind = "actor", Actor = actorType, Ref = meshRef, Label = label };
        el.Motion = DeriveMotion(el);
        _elements.Add(el);
        await RenderElement(el);
        await SelectElement(el.Id);
        StateHasChanged();
    }

    // Re-derive every actor's path (after a building moves), so motion follows the new layout.
    async Task RederiveActors()
    {
        foreach (var a in _elements.Where(e => e.Kind == "actor").ToList())
        {
            a.Motion = DeriveMotion(a); // may realign the rocket onto the mission control
            if (a.Actor == "rocket") await PushElementTransform(a);
            await PushElementMotion(a);
        }
    }

    // Render (or re-render) an element's group at its transform. Chickens compose the hat.
    async Task RenderElement(DesignElement el)
    {
        if (_mod is null) return;
        var url = ElementGlbUrl(el);
        if (url is null) return;
        var glb = await FetchRaw(url);
        if (glb is null) return;

        if (el.Kind == "chicken" && !string.IsNullOrEmpty(el.Hat))
        {
            var hat = await FetchRaw($"/api/shells/{ShellPlatform}/{Uri.EscapeDataString(el.Hat)}/glb");
            var anchor = _chickens.FirstOrDefault(c => c.Identifier == el.Ref)?.Anchor ?? [];
            await _mod.InvokeAsync<string[]>("addGroup", el.Id, Convert.ToBase64String(glb),
                new { hatBase64 = hat is null ? null : Convert.ToBase64String(hat), anchor });
        }
        else
        {
            // free-placed env buildings re-center so the gizmo lands on them; layout-derived ones keep their
            // authored plot offset (el.Recenter is false for auto-arranged + restored pieces). The hatchery pins
            // its LEFT edge (recenterX=min) so a tier swap grows the body to the RIGHT (every tier shares the same
            // left/dock edge near the road), not leftward as a center-recenter would.
            var isHatchery = (el.Shell ?? el.Ref).StartsWith("ei_hatchery_", StringComparison.Ordinal);
            await _mod.InvokeAsync<string[]>("addGroup", el.Id, Convert.ToBase64String(glb),
                new { recenter = el.Recenter, recenterX = isHatchery ? "min" : "center" });
        }
        await PushElementTransform(el);
        await ApplyElementAnimation(el);
        await PushElementMotion(el);
        await ApplyEffect(el);
        Autosave();
    }

    // Set the element's placed transform on its group (works in view + design mode; the gizmo reads the same
    // base). When the gizmo is attached to this element, re-point it so it follows the new transform.
    async Task PushElementTransform(DesignElement el)
    {
        if (_mod is not null)
            await _mod.InvokeVoidAsync("setGroupTransform", el.Id, el.Pos, el.RotDeg, el.Scale);
        if (_designer is not null && _selectedElementId == el.Id)
            await _designer.InvokeVoidAsync("selectElement", el.Id);
        Autosave();
    }

    async Task SelectElement(string id)
    {
        _selectedElementId = id;
        _confirmDeleteId = null; // a pending delete-confirm does not carry to a newly selected element
        if (_designer is not null) await _designer.InvokeVoidAsync("selectElement", id);
        await LoadFamilyOptions();
        StateHasChanged();
    }

    // Fetch the swap-family siblings for the selected env element (hab tiers, lab levels, ...). Empty for
    // pieces with no family or non-env elements.
    async Task LoadFamilyOptions()
    {
        _familyOptions = [];
        if (Selected is { Kind: "env" } sel && !string.IsNullOrEmpty(sel.Ref))
        {
            try
            {
                var res = await Client().GetFromJsonAsync<FamilyResult>($"/api/env/family/{Uri.EscapeDataString(sel.Ref)}");
                _familyOptions = res?.Family?.ToList() ?? [];
            }
            catch { _familyOptions = []; }
        }
    }

    // Swap a placed element to another piece in its family (a different hab tier / lab level), keeping its
    // transform. sel.Ref is already updated by the bind; re-render with the new mesh + refresh the family.
    async Task SwapVariation(DesignElement sel)
    {
        PushHistory();
        var opt = _familyOptions.FirstOrDefault(f => f.Stem == sel.Ref);
        if (opt is not null) sel.Label = opt.Label;
        await RenderElement(sel);
        // a tier swap can change the building's cell footprint; on the grid, ripple neighbors out of the way.
        await RunDomino(sel.Id);
        await SelectElement(sel.Id);
    }

    // After an element resizes (tier swap), push grid neighbors it now overlaps out of the way, cascading. The
    // cell math is the tested PlacementSolver.DominoNudge; the engine supplies the grid boxes + applies the moves.
    async Task RunDomino(string changedId)
    {
        if (_mod is null || !_gridSnap) return;
        try
        {
            var boxes = await _mod.InvokeAsync<DominoBoxes>("gridBoxesForDomino", changedId);
            if (boxes?.Changed is null || boxes.Others is null || boxes.Others.Length == 0) return;

            GridBoxOf(boxes.Changed, out var changed);
            var others = boxes.Others.Select(b => { GridBoxOf(b, out var g); return g; }).ToList();
            var moves = PlacementSolver.DominoNudge(changed, others);
            if (moves.Count == 0) return;

            var payload = moves.Select(m => new { id = m.Id, deltaCol = m.DeltaCol, deltaRow = m.DeltaRow }).ToArray();
            var moved = await _mod.InvokeAsync<MovedElement[]>("applyDominoMoves", new object[] { payload });
            foreach (var mv in moved ?? [])
            {
                var el = _elements.FirstOrDefault(e => e.Id == mv.Id);
                if (el is not null && mv.Pos is { Length: 3 }) el.Pos = [mv.Pos[0], mv.Pos[1], mv.Pos[2]];
            }
            await RederiveActors();
            Autosave();
        }
        catch { /* a domino failure must never break the swap or the scene */ }
    }

    static void GridBoxOf(DominoBox b, out PlacementSolver.GridBox g) =>
        g = new PlacementSolver.GridBox(b.Id, b.Col, b.Row, b.SpanC, b.SpanR);

    public sealed class DominoBoxes { public DominoBox? Changed { get; set; } public DominoBox[]? Others { get; set; } }
    public sealed class DominoBox
    {
        public string Id { get; set; } = "";
        public int Col { get; set; }
        public int Row { get; set; }
        public int SpanC { get; set; }
        public int SpanR { get; set; }
    }
    public sealed class MovedElement { public string Id { get; set; } = ""; public float[]? Pos { get; set; } }

    // Delete after the inline confirm. Clears the confirm + selection, removes the group.
    async Task ConfirmDelete(DesignElement el)
    {
        _confirmDeleteId = null;
        await DeleteElement(el);
    }

    async Task DeleteElement(DesignElement el)
    {
        PushHistory();
        _elements.Remove(el);
        if (_selectedElementId == el.Id) { _selectedElementId = null; if (_designer is not null) await _designer.InvokeVoidAsync("deselect"); }
        if (_mod is not null) await _mod.InvokeVoidAsync("removeGroup", el.Id);
        StateHasChanged();
        Autosave();
    }

    List<DesignElement> CloneElements() => _elements.Select(e => new DesignElement
    {
        Id = e.Id, Kind = e.Kind, Ref = e.Ref, Label = e.Label, Hat = e.Hat, Shell = e.Shell, Recenter = e.Recenter, Effect = e.Effect, HasEffects = e.HasEffects, EffectCount = e.EffectCount,
        Pos = [e.Pos[0], e.Pos[1], e.Pos[2]], RotDeg = [e.RotDeg[0], e.RotDeg[1], e.RotDeg[2]],
        Scale = e.Scale, Anim = e.Anim, Actor = e.Actor,
        Motion = e.Motion is null ? null : new MotionState
        {
            Kind = e.Motion.Kind, Path = e.Motion.Path.Select(w => (float[])w.Clone()).ToArray(),
            Speed = e.Motion.Speed, Loop = e.Motion.Loop, FacePath = e.Motion.FacePath, FaceOffset = e.Motion.FaceOffset,
            Height = e.Motion.Height, Period = e.Motion.Period, Count = e.Motion.Count, StopSeconds = e.Motion.StopSeconds,
        },
    }).ToList();

    // Snapshot the element list BEFORE a mutating action so it can be undone. Clears the redo branch. Skipped
    // while a history restore is in flight, so undo/redo do not push their own result.
    void PushHistory()
    {
        if (_restoringHistory) return;
        _undo.Push(CloneElements());
        if (_undo.Count > HistoryCap)
        {
            var keep = _undo.Take(HistoryCap).ToArray();
            _undo.Clear();
            for (var i = keep.Length - 1; i >= 0; i--) _undo.Push(keep[i]);
        }
        _redo.Clear();
    }

    [JSInvokable]
    public Task OnGizmoDragStart() { PushHistory(); return Task.CompletedTask; }

    [JSInvokable]
    public async Task OnUndo()
    {
        if (_undo.Count == 0) return;
        _redo.Push(CloneElements());
        await ApplyHistorySnapshot(_undo.Pop());
    }

    [JSInvokable]
    public async Task OnRedo()
    {
        if (_redo.Count == 0) return;
        _undo.Push(CloneElements());
        await ApplyHistorySnapshot(_redo.Pop());
    }

    // Restore a history snapshot by DIFFING it against the live scene and touching only what changed: remove
    // elements gone from the snapshot, add ones new to it, re-render ones whose mesh-affecting fields differ,
    // and just re-place (no mesh rebuild) ones where only the transform moved. A typical undo (one element
    // dragged) re-places a single group instead of tearing down + reloading the whole farm.
    async Task ApplyHistorySnapshot(List<DesignElement> snapshot)
    {
        if (_mod is null) return;
        _restoringHistory = true;
        try
        {
            var keepSel = _selectedElementId;
            var byId = _elements.ToDictionary(e => e.Id);
            var snapIds = snapshot.Select(s => s.Id).ToHashSet();

            foreach (var live in _elements.ToList())
                if (!snapIds.Contains(live.Id)) { await _mod.InvokeVoidAsync("removeGroup", live.Id); _elements.Remove(live); }

            foreach (var snap in snapshot)
            {
                if (!byId.TryGetValue(snap.Id, out var live))
                {
                    _elements.Add(snap);
                    await RenderElement(snap);
                    continue;
                }
                bool meshChanged = !MeshIdentical(live, snap);
                CopyInto(live, snap);
                if (meshChanged) await RenderElement(live);
                else await PushElementTransform(live);
            }

            _selectedElementId = null;
            if (_designer is not null) await _designer.InvokeVoidAsync("deselect");
            if (keepSel is not null && _elements.Any(e => e.Id == keepSel)) await SelectElement(keepSel);
            await RefreshAnimatedFlag();
        }
        finally { _restoringHistory = false; }
        StateHasChanged();
        Autosave();
    }

    // Mesh-affecting fields: a change here needs a full RenderElement (new geometry/shell/hat/actor). A pure
    // transform/anim change does not. Motion is compared by reference-free value via the actor/kind it rides.
    static bool MeshIdentical(DesignElement a, DesignElement b) =>
        a.Kind == b.Kind && a.Ref == b.Ref && a.Hat == b.Hat && a.Shell == b.Shell && a.Actor == b.Actor;

    // Copy a snapshot's fields onto the live element in place (keeps the same object identity so selection +
    // group bindings hold).
    static void CopyInto(DesignElement live, DesignElement snap)
    {
        live.Kind = snap.Kind; live.Ref = snap.Ref; live.Label = snap.Label; live.Hat = snap.Hat; live.Shell = snap.Shell;
        live.Pos = [snap.Pos[0], snap.Pos[1], snap.Pos[2]];
        live.RotDeg = [snap.RotDeg[0], snap.RotDeg[1], snap.RotDeg[2]];
        live.Scale = snap.Scale; live.Anim = snap.Anim; live.Actor = snap.Actor; live.Motion = snap.Motion; live.Recenter = snap.Recenter; live.Effect = snap.Effect; live.HasEffects = snap.HasEffects; live.EffectCount = snap.EffectCount;
    }


    // Builds a game-like farm in one click: clears the scene, fetches the standard layout, adds each element
    // at its plot position. Honors singletons (ground/hardscape added once). A starting point to tweak, not a
    // pixel-exact game farm (positions are derived, not extracted from the binary).
    async Task AutoArrangeFarm()
    {
        if (_mod is null) return;
        _busy = true; Status("Arranging farm…");
        try
        {
            FarmLayoutResult? layout;
            try { layout = await Client().GetFromJsonAsync<FarmLayoutResult>("/api/env/farm-layout"); }
            catch (Exception ex) { Fail($"layout fetch failed: {ex.Message}"); return; }
            var placed = layout?.Elements ?? [];
            if (placed.Length == 0) { Fail("no layout returned"); return; }

            foreach (var el in _elements.ToList()) await _mod.InvokeVoidAsync("removeGroup", el.Id);
            _elements.Clear();
            _selectedElementId = null;
            if (_designer is not null) await _designer.InvokeVoidAsync("deselect");

            foreach (var pl in placed)
            {
                var el = new DesignElement
                {
                    Id = NextElementId(), Kind = "env", Ref = pl.Stem, Label = pl.Label,
                    Pos = pl.Pos, RotDeg = [0, pl.RotY, 0], Scale = pl.Scale <= 0 ? 1 : pl.Scale,
                    Recenter = pl.Recenter, // core buildings recenter so the layout Pos is authoritative
                };
                _elements.Add(el);
                await RenderElement(el);
            }
            await ResetView();
            Status($"Arranged {placed.Length} elements.");
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; StateHasChanged(); }
    }

    // Per-farm placement limits. Families that allow exactly one instance regardless of tier (a farm has one
    // research lab, one mission control, one artifact hall, one hatchery, one trophy case, one depot, one fuel
    // tank). Plus count caps on the multi-instance pieces: habs and silos.
    static readonly HashSet<string> SingleInstanceFamilies = new(StringComparer.Ordinal)
        { "lab", "mission", "hoa", "hatchery", "trophy", "depot", "fuel" };
    const int MaxHabs = 4;
    const int MaxSilos = 10;

    static bool IsSilo(string stem) => stem.StartsWith("ei_silo", StringComparison.Ordinal);

    int CountFamily(string family) => _elements.Count(e =>
        e.Kind == "env" && _catalogPieces.FirstOrDefault(p => p.Stem == e.Ref)?.Family == family);
    int CountHabs() => CountFamily("hab");
    int CountSilos() => _elements.Count(e => e.Kind == "env" && IsSilo(e.Ref));

    // Why a piece cannot be placed right now (null = placeable). Drives both the disabled picker state + the
    // AddElement guard. A single-instance family already present blocks; habs/silos block at their cap.
    string? PlacementBlockedReason(EnvPieceRow p)
    {
        if (!string.IsNullOrEmpty(p.Family) && SingleInstanceFamilies.Contains(p.Family) && CountFamily(p.Family) >= 1)
            return "placed";
        if (p.Family == "hab" && CountHabs() >= MaxHabs) return "max " + MaxHabs;
        if (IsSilo(p.Stem) && CountSilos() >= MaxSilos) return "max " + MaxSilos;
        if (p.Singleton && _elements.Any(e => e.Kind == "env" && e.Ref == p.Stem)) return "placed";
        return null;
    }

    // One picker entry per family (placing the highest tier = the last catalog piece in the family), plus each
    // family-less piece on its own. Display name strips the trophy/lab-style "(n)" tier suffix for families.
    readonly record struct PickerEntry(EnvPieceRow Piece, string Display);
    IEnumerable<PickerEntry> FamilyPickerEntries(IEnumerable<EnvPieceRow> group)
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (var p in group)
        {
            if (string.IsNullOrEmpty(p.Family)) { yield return new(p, p.Label); continue; }
            if (!seen.Add(p.Family)) continue;
            // highest tier = the last catalog piece sharing this family (catalog is tier-ascending).
            var top = _catalogPieces.Last(q => q.Family == p.Family);
            yield return new(top, FamilyDisplayName(p.Family, top.Label));
        }
    }

    static string FamilyDisplayName(string family, string fallbackLabel) => family switch
    {
        "hab" => "Hab", "depot" => "Depot", "fuel" => "Fuel tank", "lab" => "Research lab",
        "mission" => "Mission control", "hoa" => "Artifact hall", "trophy" => "Trophy case",
        "hatchery" => "Hatchery", _ => StripTier(fallbackLabel),
    };

    static string StripTier(string label)
    {
        var i = label.LastIndexOf(" (", StringComparison.Ordinal);
        return i > 0 ? label[..i] : label;
    }

    // Add a picked element of a kind. Selects + renders it. Enforces the per-farm placement limits; a blocked
    // add (cap reached / single-instance present) just selects the existing one when there is one.
    async Task AddElement(string kind, string id, string label)
    {
        if (kind == "env")
        {
            var piece = _catalogPieces.FirstOrDefault(p => p.Stem == id);
            if (piece is not null && PlacementBlockedReason(piece) is not null)
            {
                var dup = _elements.FirstOrDefault(e => e.Kind == "env"
                    && (e.Ref == id || (!string.IsNullOrEmpty(piece.Family) && _catalogPieces.FirstOrDefault(p => p.Stem == e.Ref)?.Family == piece.Family)));
                if (dup is not null) await SelectElement(dup.Id);
                StateHasChanged();
                return;
            }
        }
        PushHistory();
        // free-placed env buildings re-center on their group origin so the gizmo lands on them. Actors +
        // chickens ride their own anchored motion; they are not re-centered.
        var el = new DesignElement { Id = NextElementId(), Kind = kind, Ref = id, Label = label, Recenter = kind == "env" };
        _elements.Add(el);
        await RenderElement(el);
        await SelectElement(el.Id);
        StateHasChanged();
    }

    async Task ReshellSelected()
    {
        if (Selected is { } sel) await RenderAndReselect(sel);
    }

    // Discrete-edit wrappers: each pushes one undo step before the underlying re-render. The inner methods are
    // also called internally (e.g. RenderElement -> ApplyElementAnimation) where a push would be wrong, so the
    // push lives in the wrapper, not the inner method.
    async Task OnAnimChanged(DesignElement sel) { PushHistory(); await ApplyElementAnimation(sel); }

    // Toggle the extracted decomp particle effect on a hab. Fetches the recovered EffectModel from the decomp
    // endpoint + attaches it (or clears it). The galaxy orbit math comes from the binary (see the effect-recovery
    // framework), so this turns the universe hab's floating particles on with the extracted motion.
    async Task OnEffectToggled(DesignElement sel, bool on)
    {
        PushHistory();
        sel.Effect = on;
        await ApplyEffect(sel);
        StateHasChanged();
    }

    // Render (or clear) a building's extracted effects. The set of effects is DISCOVERED from the binary by the
    // building-effect resolver (no hardcoded per-stem list); this fetches whatever was found for el.Ref + hands
    // the models to the engine. HasEffects/EffectCount are populated so the toggle only shows when there is
    // something to render.
    async Task ApplyEffect(DesignElement el)
    {
        if (_mod is null || el.Kind != "env") return;
        // hatchery floating effect = real sub-meshes (bolt/probe/rings/tops) hovering the body, NOT particles.
        if (el.Ref.StartsWith("ei_hatchery", StringComparison.Ordinal))
        {
            await ApplyHatcheryParts(el);
            return;
        }
        try
        {
            var res = await Client().GetFromJsonAsync<System.Text.Json.JsonElement>($"/api/decomp/building-effects?stem={Uri.EscapeDataString(el.Ref)}");
            var hasEffects = res.TryGetProperty("effects", out var effects) && effects.ValueKind == System.Text.Json.JsonValueKind.Array && effects.GetArrayLength() > 0;
            el.HasEffects = hasEffects;
            el.EffectCount = hasEffects ? effects.GetArrayLength() : 0;
            await _mod.InvokeVoidAsync("attachEffects", el.Id, el.Effect && hasEffects ? effects : (object?)null);
        }
        catch { el.HasEffects = false; el.EffectCount = 0; await _mod.InvokeVoidAsync("attachEffects", el.Id, null); }
        StateHasChanged();
    }

    // Load a hatchery's floating sub-pieces + orbit them around the body. Resolves the tier's parts via
    // /api/env/hatchery-effects, fetches each part's glb, and hands them to attachHatcheryParts. The orbit radius
    // is a STOPGAP (scaled from the body, see attachHatcheryParts) until the exact RPA1 curve / FarmScene hab
    // constants are extracted. el.Effect toggles it; HasEffects/EffectCount drive the UI badge.
    async Task ApplyHatcheryParts(DesignElement el)
    {
        if (_mod is null) return;
        try
        {
            var tier = HatcheryTierOf(el.Ref);
            var res = await Client().GetFromJsonAsync<System.Text.Json.JsonElement>($"/api/env/hatchery-effects?tier={Uri.EscapeDataString(tier)}");
            var floating = new List<string>();
            if (res.TryGetProperty("effects", out var effects) && effects.ValueKind == System.Text.Json.JsonValueKind.Array)
                foreach (var e in effects.EnumerateArray())
                    if (e.TryGetProperty("floating", out var fl) && fl.ValueKind == System.Text.Json.JsonValueKind.Array)
                        foreach (var f in fl.EnumerateArray())
                            if (f.GetString() is { } s) floating.Add(s);

            el.HasEffects = floating.Count > 0;
            el.EffectCount = floating.Count;

            if (!el.Effect || floating.Count == 0)
            {
                await _mod.InvokeVoidAsync("clearHatcheryParts", el.Id);
                StateHasChanged();
                return;
            }

            // Build the EXTRACTED state-machine model: orb at the assembly anchor; the disc piece = orbiting probes
            // (count/rate from rotate_pyramid); the spike piece = the beam fired probe->orb intermittently. Pieces
            // are classified by their decode-stats bounds (spike = Y-extent >> X/Z). All motion params come from the
            // binary; what does not recover is left null (that aspect is not animated). No invented orbit.
            // cache the built model per tier (it holds the piece glbs); a re-toggle or tier re-visit is instant.
            if (!_hatcheryModelCache.TryGetValue(tier, out var model))
            {
                var dump = await FetchHatcheryDump();
                model = await BuildHatcheryModel(tier, floating, dump);
                _hatcheryModelCache[tier] = model;
            }
            await _mod.InvokeVoidAsync("attachHatcheryParts", el.Id, model);
        }
        catch { el.HasEffects = false; el.EffectCount = 0; await _mod.InvokeVoidAsync("clearHatcheryParts", el.Id); }
        StateHasChanged();
    }

    // The hatchery dump (all tiers + bounds + assembly) is the SAME for every hatchery; fetching it pulls the
    // device archive, which is slow. Cache it for the session + dedupe concurrent fetches so toggling effects /
    // swapping tiers does not re-pull each time. Prefetched on init so the first toggle is instant.
    System.Text.Json.JsonElement? _hatcheryDump;
    Task<System.Text.Json.JsonElement?>? _hatcheryDumpTask;
    readonly Dictionary<string, object?> _hatcheryModelCache = new(StringComparer.Ordinal);

    Task<System.Text.Json.JsonElement?> FetchHatcheryDump()
    {
        if (_hatcheryDump is not null) return Task.FromResult(_hatcheryDump);
        return _hatcheryDumpTask ??= FetchHatcheryDumpUncached();
    }

    async Task<System.Text.Json.JsonElement?> FetchHatcheryDumpUncached()
    {
        try
        {
            var d = await Client().GetFromJsonAsync<System.Text.Json.JsonElement>("/api/env/hatchery-dump");
            _hatcheryDump = d;
            return d;
        }
        catch { return null; }
        finally { _hatcheryDumpTask = null; }
    }

    // Build the state-machine model for one tier from the extracted dump. Classifies each floating piece by its
    // bounds (a spike = the beam; a flat disc = a probe), fetches the glbs, and reads the orbit/beam params from
    // the extracted rotate_pyramid + anchor. Params that did not recover stay null (not animated).
    async Task<object?> BuildHatcheryModel(string tier, List<string> floating, System.Text.Json.JsonElement? dump)
    {
        // orb position relative to the body group origin. The body mesh self-places at its plot; the anchor is the
        // orb's world pos, so orb-local = (0, anchorY, 0) approximated (anchor X/Z == body center). Default upper-body.
        float[] orb = [0f, 2.15f, 0f];
        // ~10-12 probes observed in game, flying in 3D around the orb (runtime frandom, no static count). DISPLAY
        // value, not extracted. The binary's rotate_pyramid `3` is the quarter-turn segment count, a red herring.
        int probeCount = 12;
        float orbitRadius = 0f;    // from the frandom scatter; filled from extracted translation magnitude if present
        float orbitSpeed = 0.5f;   // rotate_pyramid easing/rate
        float beamInterval = 0f, beamDuration = 0.2f;
        bool beamRandom = false;   // true => fire delay is the frandom output, renderer jitters the interval

        if (dump is { } d && d.TryGetProperty("assembly", out var asmEl))
        {
            // orb position is set below from anchor + bodyShift (needs the body bounds, resolved after this block).
            // timing recovered from rotate_pyramid's ActionBuilder tween call ARGS (waitFor/smooth), not from
            // unordered float constants: waitFor = the beam-fire delay, smoothDuration = the eased anim duration,
            // orbitSegments = the piece/segment count. These are the binary's own param bindings.
            if (asmEl.TryGetProperty("timing", out var tm) && tm.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                // NOTE: orbitSegments (rotate_pyramid's `3`) is the pyramid QUARTER-TURN segment count, NOT the
                // probe count. In game the orb has ~10-12 probes flying in 3D all around it (observed), spawned by
                // a runtime frandom loop with no static count in the binary. So probeCount is a DISPLAY value, like
                // orbitRadius: see probeCount default below (not read from orbitSegments).
                if (tm.TryGetProperty("smoothDuration", out var sd) && sd.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    var dur = (float)sd.GetDouble();
                    if (dur > 0.01f) { orbitSpeed = (float)(Math.PI / 2 / dur); beamDuration = dur; } // quarter-turn / duration
                }
                // waitFor = the beam fire delay. A constant value sets a fixed interval. waitForRandom = the delay
                // is the frandom() output (random by design): fire on a random cadence, with smoothDuration as the
                // mean. Either way the beam fires; only a missing-and-not-random case holds.
                if (tm.TryGetProperty("waitFor", out var wf) && wf.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    var w = (float)wf.GetDouble();
                    if (w > 0.001f) { beamInterval = w; beamRandom = false; }
                }
                else if (tm.TryGetProperty("waitForRandom", out var wr) && wr.ValueKind == System.Text.Json.JsonValueKind.True)
                {
                    beamRandom = true;
                    if (beamInterval <= 0f) beamInterval = Math.Max(beamDuration, 1f); // mean cadence; renderer jitters it
                }
            }
            // orbit radius from a recovered piece translation distance from the anchor (the frandom scatter extent).
            if (asmEl.TryGetProperty("transforms", out var tr) && tr.ValueKind == System.Text.Json.JsonValueKind.Array
                && asmEl.TryGetProperty("anchor", out var a2) && a2.ValueKind == System.Text.Json.JsonValueKind.Array && a2.GetArrayLength() == 3)
            {
                foreach (var t in tr.EnumerateArray())
                    if (t.TryGetProperty("translation", out var tl) && tl.ValueKind == System.Text.Json.JsonValueKind.Array && tl.GetArrayLength() == 3)
                    {
                        var dx = tl[0].GetDouble() - a2[0].GetDouble();
                        var dz = tl[2].GetDouble() - a2[2].GetDouble();
                        var r = (float)Math.Sqrt(dx * dx + dz * dz);
                        if (r > orbitRadius) orbitRadius = r;
                    }
            }
        }

        // Classify EACH floating piece from its authored .rpo bounds (the geometry IS the data): a world-placed
        // roof spike renders static at its spot; a centered piece is driven by the extracted state machine
        // (beam fires probe->orb, probes orbit, rings spin, shells/orb hover). One generic piece list replaces
        // the universe-only probe/beam pair so every tier (ai tops, darkmatter rings, vision shells) renders.
        var fullBounds = HatcheryFullBounds(tier, dump);
        // The body mesh is RECENTERED (recenter=true for an added env piece): addGroup shifts it by -bbox.center
        // in X/Z and -bbox.min.y in Y so the group origin is the body's ground-center. Floating sub-pieces live
        // in the SAME mesh coords, so the renderer must apply the SAME shift or they land off the body (the AI
        // roof tops were authored at world X 8..18 and rendered across the road). bodyShift = that offset.
        // bodyShift MUST match the body's recenter (recenterX="min" for the hatchery): pin the LEFT edge (-minX)
        // in X, center in Z, base-snap in Y. A center shift here would desync the floating pieces from the body.
        float[] bodyShift = [0f, 0f, 0f];
        if (fullBounds.TryGetValue($"ei_hatchery_{tier}", out var bodyB))
            bodyShift = [-bodyB.MinX, -bodyB.MinY, -(bodyB.MinZ + bodyB.MaxZ) * 0.5f];

        // the orb = the visible dome sphere on TOP of the body. Derive it from the BODY BOUNDS, not the extracted
        // anchor: the anchor (11.319, 2.15, 2.997) is the building's farm-PLOT position, NOT the orb's mesh-local
        // point, so using it placed the orb at a corner. The dome sits over the body's footprint center, near the
        // top. All recentered coords (the body is recenter=min, so the local center = bounds center + bodyShift).
        // domeRadius approximates the visible sphere; the probes ring OUTSIDE it. DISPLAY values (the dome is baked
        // into the body mesh, not a separately-extractable orb).
        float domeRadius = 1.5f;
        if (fullBounds.TryGetValue($"ei_hatchery_{tier}", out var bForOrb))
        {
            float h = bForOrb.MaxY - bForOrb.MinY;
            float cx = (bForOrb.MinX + bForOrb.MaxX) * 0.5f + bodyShift[0]; // footprint center X, recentered
            float cz = (bForOrb.MinZ + bForOrb.MaxZ) * 0.5f + bodyShift[2]; // footprint center Z, recentered
            orb = [cx, h * 0.62f, cz];                                      // dome center over the body top
            domeRadius = Math.Clamp(h * 0.30f, 0.8f, 2.5f);
        }

        var pieces = new List<object>();
        foreach (var stem in floating)
        {
            if (!fullBounds.TryGetValue(stem, out var bb)) continue;
            var role = HatcheryPieceClassifier.Classify(bb);
            var glb = await FetchRaw($"/api/env/{Uri.EscapeDataString(stem)}/glb");
            if (glb is null) continue;
            pieces.Add(new
            {
                glb = Convert.ToBase64String(glb),
                role = role.ToString(),
                worldPlaced = role == HatcheryPieceClassifier.Role.WorldPlaced,
                // the body recenter shift, applied to every piece so it stays aligned to the recentered body.
                shift = bodyShift,
                // a centered ring/shell uses its own radius (its bounds half-extent) as the orbit/spin radius.
                size = Math.Max(bb.ExtentX, bb.ExtentZ) * 0.5f,
            });
        }

        // The probe orbit RADIUS is the one value not statically resolvable (the game scatters probes with
        // frandom at runtime, no literal in the binary). When unrecovered, fall back to a small DISPLAY radius
        // derived from the body's footprint so the probes visibly orbit instead of stacking on the orb. This is
        // a render approximation, NOT an extracted value (marked so per CLAUDE.md): the true scatter is runtime
        // random. The orbit rate/count/beam-timing ARE extracted (rotate_pyramid).
        // radius must CLEAR the dome so probes ring it visibly outside, not hidden inside the opaque sphere.
        if (orbitRadius <= 0f)
            orbitRadius = domeRadius + 0.8f;

        return new
        {
            orb, // fallback only; the renderer derives the orb from the live body-mesh bbox (orbYFrac up the body)
            orbYFrac = 0.62f,
            pieces,
            probeCount,
            orbitSpeed,
            orbitRadius,
            orbitRadiusApprox = true, // the radius is a display fallback, not an extracted scatter value
            beam = new { fireInterval = beamInterval, fireDuration = beamDuration, fireRandom = beamRandom },
        };
    }

    // Full per-stem bounds (HatcheryPieceClassifier.Bounds) for the tier, from the dump's decode-stats. Carries
    // the whole min/max so the classifier can read center + per-axis extents (the role depends on both).
    Dictionary<string, HatcheryPieceClassifier.Bounds> HatcheryFullBounds(string tier, System.Text.Json.JsonElement? dump)
    {
        var map = new Dictionary<string, HatcheryPieceClassifier.Bounds>(StringComparer.Ordinal);
        if (dump is not { } d || !d.TryGetProperty("tiers", out var tiers) || tiers.ValueKind != System.Text.Json.JsonValueKind.Array) return map;
        foreach (var t in tiers.EnumerateArray())
        {
            if (!t.TryGetProperty("tier", out var tn) || tn.GetString() != tier) continue;
            if (!t.TryGetProperty("pieces", out var pcs) || pcs.ValueKind != System.Text.Json.JsonValueKind.Array) continue;
            foreach (var p in pcs.EnumerateArray())
            {
                if (!p.TryGetProperty("stem", out var sn) || sn.GetString() is not { } stem) continue;
                if (!p.TryGetProperty("bounds", out var bd) || bd.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                if (!bd.TryGetProperty("min", out var mn) || !bd.TryGetProperty("max", out var mx)) continue;
                map[stem] = new HatcheryPieceClassifier.Bounds(
                    (float)mn[0].GetDouble(), (float)mn[1].GetDouble(), (float)mn[2].GetDouble(),
                    (float)mx[0].GetDouble(), (float)mx[1].GetDouble(), (float)mx[2].GetDouble());
            }
        }
        return map;
    }

    // The tier token of a hatchery stem (ei_hatchery_universe -> universe). Mirrors HatcheryEffectParts.TierOf;
    // kept simple here since the UI only needs the body tier, which is the remainder after the prefix with any
    // trailing floating-part suffix stripped server-side anyway (we pass the body stem's tier).
    static string HatcheryTierOf(string stem)
    {
        const string prefix = "ei_hatchery_";
        return stem.StartsWith(prefix, StringComparison.Ordinal) ? stem[prefix.Length..] : stem;
    }
