@page "/admin"
@rendermode @(RenderModes.InteractiveServer)
@inject ICurrentUser User

<PageTitle>EggIncognito - Admin</PageTitle>
<main id="adminMain" class="page page-wide pt-6 pb-8">
    <h1 class="text-[1.3rem] mt-0 mb-4">Admin</h1>
    @if (!_isAdmin) {
        <div class="admin-gate" id="denied">
            <div class="panel admin-gate-card">
                <Icon Name="lock" Class="icon-lg admin-gate-icon"/>
                <h3 class="admin-gate-title">Admin access required</h3>
                <p class="admin-gate-desc">Sign in with an admin account to manage devices, game data and notifications for EggIncognito.</p>
                <ul class="admin-gate-features">
                    <li><Icon Name="device" Class="icon-sm"/> Device fleet, capture and recert</li>
                    <li><Icon Name="database" Class="icon-sm"/> Game data, protos and staged review</li>
                    <li><Icon Name="bell" Class="icon-sm"/> Notifications, sessions and bot config</li>
                </ul>
                <LoginButton CssClass="btn-primary admin-gate-btn" Label="Log in" Placement="LoginMenuPlacement.BottomLeft"/>
            </div>
        </div>
    } else {
        <AdminWorkbench/>
    }
</main>

@code {
    bool _isAdmin;

    protected override void OnInitialized() {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

}
