@page "/admin"
@using EggIncognito.Components.Protos
@rendermode @(RenderMode.InteractiveServer)
@inject ICurrentUser User

<PageTitle>EggIncognito - Admin</PageTitle>
<main id="adminMain" class="page page-wide pt-6 pb-8">
    <h1 class="text-[1.3rem] mt-0 mb-4">Admin</h1>
    @if (!_isAdmin) {
        <div class="panel" id="denied">Admin access required. <LoginButton CssClass="auth-btn" Label="Log in" Placement="LoginMenuPlacement.BottomLeft"/></div>
    } else {
        <div class="admin-top mb-4">
            <AdminTrafficPanel/>
            <DeviceStatusPanel OnManage="OpenDeviceWorkbench"/>
        </div>
        <div class="admin-cards">
            <AdminBotConfigPanel/>
            <AdminRoutesPanel/>
            <AdminUsersPanel/>
            <AdminSessionsPanel/>
            <AdminApiKeysPanel/>
            <AdminBinariesPanel/>
            <AdminEventsPanel/>
            <AdminThemePolicyPanel/>
            <AdminConsolePanel/>
        </div>
    }
</main>

<DeviceWorkbenchModal @ref="_deviceWorkbench"/>

@code {
    bool _isAdmin;
    DeviceWorkbenchModal? _deviceWorkbench;

    Task OpenDeviceWorkbench(string? deviceId) {
        return _deviceWorkbench?.Open(deviceId) ?? Task.CompletedTask;
    }

    protected override void OnInitialized() {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

}
