@page "/admin"
@rendermode @(RenderMode.InteractiveServer)
@inject ICurrentUser User
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>EggIncognito - Admin</PageTitle>
<main id="adminMain" class="px-8 pt-6 pb-8 max-w-[1100px]">
  <h1 class="text-[1.3rem] mt-0 mb-4">Admin</h1>
  @if (!_isAdmin)
  {
    <div class="panel" id="denied">Admin access required. <a class="auth-btn" href="/login?returnUrl=/admin">Log in</a></div>
  }
  else
  {
    @* Live API-rate metrics (DB-backed per-minute rollups, inline SVG charts). *@
    <AdminMetricsPanel ClientFactory="Client" />

    @* Active capture sessions: list + kill. *@
    <AdminSessionsPanel ClientFactory="Client" />

    <section class="panel mb-4">
      <div class="admin-panel-head">
        <h2 class="admin-panel-title">Users</h2>
        <span class="text-muted text-xs">@_users.Count total</span>
      </div>
      <div class="reg-wrap">
        <table class="reg-table admin-users-table">
          <thead>
            <tr><th>User</th><th>Discord ID</th><th>Role</th><th>Last login</th></tr>
          </thead>
          <tbody>
            @foreach (var u in _users)
            {
              <tr>
                <td class="font-medium">@u.Username</td>
                <td class="mono text-muted text-xs">@u.DiscordId</td>
                <td>
                  <select class="reg-filter-input w-auto" value="@u.Role" @onchange="e => SetRole(u.DiscordId, (string?)e.Value)">
                    @foreach (var role in Roles)
                    {
                      <option value="@role">@role</option>
                    }
                  </select>
                </td>
                <td class="text-muted text-xs">@u.LastLoginAt.ToLocalTime().ToString("g")</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </section>

    @* Orbital ship 3D assets: pull the 4 CDN-only ship meshes live from get_config, decode to .glb, and
       (when ShipAssets:OutputDir is set) write them into the asset-repo layout. *@
    <section class="panel mb-4">
      <div class="admin-panel-head">
        <h2 class="admin-panel-title">Ship 3D assets</h2>
        <span class="text-muted text-xs">Galeggtica, Defihent, Voyegger, Henerprise (CDN shells)</span>
      </div>
      <p class="text-muted text-xs mb-3">
        Pulls the 4 orbital ship meshes from the live game config, decodes to glTF, and writes
        <code class="code-chip">ships/&lt;EnumName&gt;.glb</code> to the configured output dir. The 7 bundled
        ships come from a device pull (Devices panel).
      </p>
      <button class="btn-primary" @onclick="PullShipAssets" disabled="@_shipBusy">
        @(_shipBusy ? "Pulling…" : "Pull ship meshes from live")
      </button>

      @if (_shipResult is not null)
      {
        <div class="mt-3 text-sm">
          <div class="mb-2">
            Resolved <span class="font-medium">@_shipResult.Count</span>/4
            @if (_shipResult.WroteToDisk) { <span class="text-muted">→ wrote to @_shipResult.OutputDir</span> }
          </div>
          @if (_shipResult.Ships.Count > 0)
          {
            <table class="reg-table">
              <thead><tr><th>Ship</th><th>SHA-256</th><th>Source</th></tr></thead>
              <tbody>
                @foreach (var s in _shipResult.Ships)
                {
                  <tr>
                    <td class="font-medium">@s.EnumName</td>
                    <td class="mono text-muted text-xs">@s.Sha256[..12]…</td>
                    <td class="mono text-muted text-xs truncate max-w-[280px]">@s.Url</td>
                  </tr>
                }
              </tbody>
            </table>
          }
          @if (_shipResult.Unresolved.Count > 0)
          {
            <div class="mt-2 text-muted text-xs">
              Unresolved:
              @foreach (var u in _shipResult.Unresolved)
              {
                <div>@u.EnumName — @u.Diagnostics</div>
              }
            </div>
          }
        </div>
      }
    </section>

    @if (!string.IsNullOrEmpty(_log))
    {
      <pre id="log" class="result-pre">@_log</pre>
    }
  }
</main>

@code {
    static readonly string[] Roles = Enum.GetValues<UserRole>().Select(UserRoles.ToName).ToArray();
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    bool _isAdmin;
    string _log = "";
    List<UserRow> _users = [];

    bool _shipBusy;
    ShipPullResult? _shipResult;

    // Captured in OnInitializedAsync while HttpContext is live; reused for circuit-time calls (the
    // SignalR circuit has no HttpContext, so the auth cookie must be forwarded from the request).
    string _baseAddress = "";
    string? _cookie;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
        if (!_isAdmin) return;
        await LoadUsers();
    }

    // Self-call client forwarding the captured auth cookie so the admin ACL on the controller sees the role.
    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    async Task LoadUsers()
    {
        try
        {
            var res = await Client().GetAsync("/api/admin/users");
            _users = res.IsSuccessStatusCode
                ? await res.Content.ReadFromJsonAsync<List<UserRow>>(JsonOpts) ?? []
                : [];
        }
        catch (Exception ex) { _users = []; _log = $"load users failed: {ex.Message}"; }
    }

    async Task SetRole(string discordId, string? role)
    {
        if (string.IsNullOrEmpty(role)) return;
        try
        {
            var res = await Client().PostAsJsonAsync($"/api/admin/users/{discordId}/role", new { role });
            if (res.IsSuccessStatusCode)
            {
                var d = await res.Content.ReadFromJsonAsync<SetRoleResult>(JsonOpts);
                var i = _users.FindIndex(x => x.DiscordId == discordId);
                if (i >= 0 && d is not null) _users[i] = _users[i] with { Role = d.Role };
                _log = $"set {discordId} -> {d?.Role}";
            }
            else
            {
                var d = await ReadError(res);
                _log = d ?? $"HTTP {(int)res.StatusCode}";
            }
        }
        catch (Exception ex) { _log = ex.Message; }
    }

    static async Task<string?> ReadError(HttpResponseMessage res)
    {
        try
        {
            var d = await res.Content.ReadFromJsonAsync<ErrorResult>(JsonOpts);
            return d?.Error;
        }
        catch { return null; }
    }

    // Fires the live ship-mesh pull: server signs get_config, resolves the 4 CDN ships, decodes, and writes
    // the .glb set (when an output dir is configured). Renders the resolved/unresolved breakdown.
    async Task PullShipAssets()
    {
        _shipBusy = true;
        _shipResult = null;
        _log = "";
        try
        {
            var res = await Client().PostAsync("/api/ship-assets/pull-from-live?write=true", null);
            if (res.IsSuccessStatusCode)
            {
                _shipResult = await res.Content.ReadFromJsonAsync<ShipPullResult>(JsonOpts);
                if (_shipResult is { Ok: false })
                    _log = $"ship pull: {_shipResult.Diagnostics ?? "no ships resolved"}";
            }
            else
            {
                _log = await ReadError(res) ?? $"HTTP {(int)res.StatusCode}";
            }
        }
        catch (Exception ex) { _log = ex.Message; }
        finally { _shipBusy = false; }
    }

    record UserRow(string DiscordId, string Username, string Role, DateTimeOffset LastLoginAt);
    record SetRoleResult(string DiscordId, string Role);
    record ErrorResult(string Error);

    // Ships/Unresolved default to empty so an ok=false response (which omits them) renders without an NRE.
    record ShipPullResult(bool Ok, int Count, string? Diagnostics, bool WroteToDisk, string? OutputDir)
    {
        public List<ShipRow> Ships { get; init; } = [];
        public List<UnresolvedRow> Unresolved { get; init; } = [];
    }
    record ShipRow(string EnumName, string File, string Url, string Sha256);
    record UnresolvedRow(string EnumName, string? AfxName, string Diagnostics);
}
