@page "/admin"
@using EggIncognito.Components.Playground
@using EggIncognito.Components.Protos
@rendermode @(RenderMode.InteractiveServer)
@inject ICurrentUser User
@inject NavigationManager Nav

<PageTitle>EggIncognito - Admin</PageTitle>
<main id="adminMain" class="page page-wide pt-6 pb-8">
    <h1 class="text-[1.3rem] mt-0 mb-4">Admin</h1>
    @if (!_isAdmin) {
        <div class="panel" id="denied">Admin access required. <LoginButton CssClass="auth-btn" Label="Log in" Placement="LoginMenuPlacement.BottomLeft"/></div>
    } else {
        <div class="admin-top mb-4">
            <AdminTrafficPanel/>
            <DeviceStatusPanel OnManage="OpenDeviceWorkbench"/>
        </div>
        <AdminSection Title="Access">
            <AdminUsersPanel/>
            <AdminNotificationsPanel/>
            <AdminThemePolicyPanel/>
        </AdminSection>
        <AdminSection Title="Data">
            <AdminDataStatusPanel/>
            <AdminBinariesPanel/>
            <AdminGameDataPanel/>
            <AdminEventsPanel/>
            <AdminStagedPanel/>
        </AdminSection>
        <AdminSection Title="Ops">
            <AdminSessionsPanel/>
            <AdminConsolePanel/>
            <AdminBotConfigPanel/>
            <AdminMaintenancePanel/>
            <AdminPlaygroundPanel OnOpen="OpenPlayground"/>
        </AdminSection>
    }
</main>

<DeviceWorkbenchModal @ref="_deviceWorkbench"/>
<PlaygroundWorkbenchModal @ref="_playground"/>

@code {
    bool _isAdmin;
    DeviceWorkbenchModal? _deviceWorkbench;
    PlaygroundWorkbenchModal? _playground;

    Task OpenDeviceWorkbench(string? deviceId) {
        return _deviceWorkbench?.Open(deviceId) ?? Task.CompletedTask;
    }

    Task OpenPlayground() {
        return _playground?.Open() ?? Task.CompletedTask;
    }

    protected override void OnInitialized() {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || !_isAdmin) return;
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        if (string.Equals(fragment, "playground", StringComparison.Ordinal)) await OpenPlayground();
    }

}
