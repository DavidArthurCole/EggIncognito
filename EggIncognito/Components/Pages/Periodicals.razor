@page "/periodicals"
@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@using System.Text.Json
@using EggIncognito.Components.Shared
@inject ICurrentUser User
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>EggIncognito - Periodicals</PageTitle>
<main class="px-4 sm:px-8 pt-6 pb-8 max-w-7xl mx-auto w-full">
  <h1 class="text-[1.3rem] mt-0 mb-1">Periodicals</h1>
  <p class="text-muted mb-4">Rotating game data captured from server-attached devices, plus magnitudes extracted from the binary. Admin only.</p>

  @if (!_isAdmin)
  {
    <div class="panel">Admin access required. <LoginButton CssClass="auth-btn" Label="Log in" Placement="LoginMenuPlacement.BottomLeft" /></div>
  }
  else if (_summary is null)
  {
    <div class="panel text-muted text-sm">Loading…</div>
  }
  else
  {
    <div class="grid grid-cols-1 xl:grid-cols-[2fr_1fr] gap-6 items-start">
      <div class="flex flex-col gap-6">
        <section class="panel">
          <h3 class="text-sm font-semibold mt-0 mb-3">Extracted periodicals</h3>
          <table class="reg-table">
            <thead><tr><th>Family</th><th class="text-right">Rows</th><th>Provenance</th></tr></thead>
            <tbody>
              @foreach (var g in _summary.Extracted)
              {
                <tr>
                  <td class="reg-version">@g.Key</td>
                  <td class="text-right mono">@g.Count</td>
                  <td><span class="prov-chip @Prov(g.Provenance).Cls" title="@g.Provenance">@Prov(g.Provenance).Label</span></td>
                </tr>
              }
            </tbody>
          </table>
        </section>

        <section class="panel">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-semibold m-0">Colleggtibles</h3>
            @if (_summary.Colleggtibles is { } cg)
            {
              <span class="text-muted text-xs">@cg.Count eggs</span>
            }
          </div>
          @if (_summary.Colleggtibles is { } c)
          {
            <table class="reg-table">
              <thead><tr><th>Identifier</th><th>Dimension</th><th>Tier values</th></tr></thead>
              <tbody>
                @foreach (var e in c.Eggs)
                {
                  <tr>
                    <td class="reg-version">@e.Identifier</td>
                    <td class="mono text-muted text-xs">@e.Dimension</td>
                    <td class="mono text-xs">@string.Join(", ", e.TierValues)</td>
                  </tr>
                }
              </tbody>
            </table>
            <FeedViewer Label="Full get_periodicals response" Feed="periodicals" Fetch="Fetch" />
          }
          else
          {
            <div class="text-muted text-sm">No colleggtible data.</div>
          }
        </section>

        <section class="panel">
          <h3 class="text-sm font-semibold mt-0 mb-1">eiafx_data</h3>
          <p class="text-muted text-xs mt-0 mb-2">Baked artifact catalog: structure, crafting prices, quality and rarities from ei_afx/config; icons from the get_config DLC catalog. All extracted, nothing authored.</p>
          <FeedViewer Label="View baked eiafx_data" Feed="__eiafx" Fetch="Fetch" />
        </section>
      </div>

      <div class="flex flex-col gap-6">
        <section class="panel">
          <h3 class="text-sm font-semibold mt-0 mb-3">Config store</h3>
          @if (!_summary.Config.Enabled)
          {
            <div class="text-muted text-sm">Not configured.</div>
          }
          else if (_summary.Config.Platforms.Count == 0)
          {
            <div class="text-muted text-sm">Nothing stored yet.</div>
          }
          else
          {
            <table class="reg-table">
              <thead><tr><th>Platform</th><th class="text-right">Size</th><th>Stored</th></tr></thead>
              <tbody>
                @foreach (var pf in _summary.Config.Platforms)
                {
                  <tr>
                    <td class="reg-version">@pf.Platform</td>
                    <td class="text-right mono">@Kb(pf.Bytes)</td>
                    <td class="text-muted text-xs">@pf.SavedAt.ToLocalTime().ToString("g")</td>
                  </tr>
                }
              </tbody>
            </table>
          }
        </section>

        <section class="panel">
          <h3 class="text-sm font-semibold mt-0 mb-3">Raw feeds</h3>
          <FeedViewer Label="ei_afx/config" Feed="afx-config" Fetch="Fetch" />
          <FeedViewer Label="ei_ctx/get_season_infos_v2" Feed="season-infos" Fetch="Fetch" />
        </section>
      </div>
    </div>
  }
</main>

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    bool _isAdmin;
    Summary? _summary;
    string _baseAddress = "";
    string? _cookie;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
        if (!_isAdmin) return;
        try { _summary = await Client().GetFromJsonAsync<Summary>("/api/periodicals/summary", JsonOpts); }
        catch { }
    }

    HttpClient Client() => EggIncognito.Services.SelfCallClient.Create(HttpFactory, _baseAddress, _cookie);

    async Task<string> Fetch(string feed)
    {
        var route = feed == "__eiafx" ? "/api/periodicals/eiafx-data" : $"/api/periodicals/feed/{feed}";
        try
        {
            var res = await Client().GetAsync(route);
            var body = await res.Content.ReadAsStringAsync();
            return res.IsSuccessStatusCode ? body : $"HTTP {(int)res.StatusCode}: {body}";
        }
        catch (Exception ex) { return ex.Message; }
    }

    static string Kb(long bytes) => bytes >= 1024 ? $"{bytes / 1024}KB" : $"{bytes}B";

    static (string Label, string Cls) Prov(string p)
    {
        if (p.StartsWith("captured@", StringComparison.Ordinal)) return ("captured", "prov-captured");
        if (p.StartsWith("binary@", StringComparison.Ordinal)) return ("binary", "prov-binary");
        if (p.StartsWith("extracted@", StringComparison.Ordinal)) return ("extracted", "prov-extracted");
        return (string.IsNullOrEmpty(p) ? "unknown" : "mixed", "prov-unknown");
    }

    record Summary(List<ExtractedRow> Extracted, ColleggtiblesInfo? Colleggtibles, ConfigInfo Config);
    record ExtractedRow(string Key, int Count, string Provenance);
    record ColleggtiblesInfo(int Count, string Provenance, List<EggRow> Eggs);
    record EggRow(string Identifier, string Dimension, List<double> TierValues);
    record ConfigInfo(bool Enabled, List<PlatformRow> Platforms);
    record PlatformRow(string Platform, DateTimeOffset SavedAt, long Bytes);
}
