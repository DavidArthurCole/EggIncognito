@page "/periodicals"
@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@using System.Text.Json
@using EggIncognito.Components.Capture
@using EggIncognito.Components.Shared
@inject ICurrentUser User
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>EggIncognito - Periodicals</PageTitle>
<main class="px-4 sm:px-8 pt-6 pb-8 max-w-7xl mx-auto w-full">
  <h1 class="text-[1.3rem] mt-0 mb-4">Periodicals</h1>

  @if (!_isAdmin)
  {
    <div class="panel">Admin access required. <LoginButton CssClass="auth-btn" Label="Log in" Placement="LoginMenuPlacement.BottomLeft" /></div>
  }
  else if (_summary is null)
  {
    <div class="panel text-muted text-sm">Loading…</div>
  }
  else
  {
    <div class="grid grid-cols-1 xl:grid-cols-[2fr_1fr] gap-6 items-start">
      <div class="flex flex-col gap-6">
        <section class="panel">
          <h3 class="text-sm font-semibold mt-0 mb-3">Extracted</h3>
          <div class="flex flex-col divide-y divide-border">
            @foreach (var g in _summary.Extracted)
            {
              <PeriodicalDataset Title="@g.Key" Endpoint="@($"/api/periodicals/gamedata/{g.Key}")"
                                 DownloadName="@($"{g.Key}.json")" Fetch="Fetch" View="_view" FormatChoice="_fc">
                <Badges>
                  <span class="mono text-muted text-xs">@g.Count rows</span>
                  <span class="prov-chip @Prov(g.Provenance).Cls" title="@g.Provenance">@Prov(g.Provenance).Label</span>
                </Badges>
              </PeriodicalDataset>
            }
            <PeriodicalDataset Title="eiafx_data" Endpoint="/api/periodicals/eiafx-data"
                               DownloadName="eiafx-data.json" Fetch="Fetch" View="_view" FormatChoice="_fc" />
          </div>
        </section>

        <section class="panel">
          <h3 class="text-sm font-semibold mt-0 mb-3">Feeds</h3>
          <div class="flex flex-col divide-y divide-border">
            <PeriodicalDataset Title="get_periodicals" Endpoint="/api/periodicals/feed/periodicals"
                               DownloadName="get_periodicals.json" Fetch="Fetch" View="_view" FormatChoice="_fc">
              <Badges><span class="mono text-muted text-xs">@FeedSize("periodicals")</span></Badges>
            </PeriodicalDataset>
            <PeriodicalDataset Title="ei_afx/config" Endpoint="/api/periodicals/feed/afx-config"
                               DownloadName="ei_afx_config.json" Fetch="Fetch" View="_view" FormatChoice="_fc">
              <Badges><span class="mono text-muted text-xs">@FeedSize("afx-config")</span></Badges>
            </PeriodicalDataset>
            <PeriodicalDataset Title="get_season_infos_v2" Endpoint="/api/periodicals/feed/season-infos"
                               DownloadName="get_season_infos_v2.json" Fetch="Fetch" View="_view" FormatChoice="_fc">
              <Badges><span class="mono text-muted text-xs">@FeedSize("season-infos")</span></Badges>
            </PeriodicalDataset>
          </div>
        </section>

        @if (_summary.Colleggtibles is { } c)
        {
          <section class="panel">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold m-0">Colleggtibles</h3>
              <div class="flex items-center gap-2">
                <span class="text-muted text-xs">@c.Count</span>
                <a class="btn-mini no-underline" href="/api/periodicals/gamedata/colleggtibles" download="colleggtibles.json" title="Download JSON"><Icon Name="download" Class="icon-sm" /></a>
              </div>
            </div>
            <table class="reg-table">
              <thead><tr><th class="w-8"></th><th>Identifier</th><th>Dimension</th><th>Tier values</th></tr></thead>
              <tbody>
                @foreach (var e in c.Eggs)
                {
                  <tr>
                    <td>
                      @if (!string.IsNullOrEmpty(e.Icon))
                      {
                        <img class="w-6 h-6 object-contain" src="@e.Icon" alt="" loading="lazy" />
                      }
                    </td>
                    <td class="reg-version">@e.Identifier</td>
                    <td class="mono text-muted text-xs">@e.Dimension</td>
                    <td class="mono text-xs">@string.Join(", ", e.TierValues)</td>
                  </tr>
                }
              </tbody>
            </table>
          </section>
        }
      </div>

      <div class="flex flex-col gap-6">
        <section class="panel">
          <h3 class="text-sm font-semibold mt-0 mb-3">Config store</h3>
          @if (!_summary.Config.Enabled)
          {
            <div class="text-muted text-sm">Not configured.</div>
          }
          else if (_summary.Config.Platforms.Count == 0)
          {
            <div class="text-muted text-sm">Nothing stored.</div>
          }
          else
          {
            <table class="reg-table">
              <thead><tr><th>Platform</th><th class="text-right">Size</th><th>Stored</th></tr></thead>
              <tbody>
                @foreach (var pf in _summary.Config.Platforms)
                {
                  <tr>
                    <td class="reg-version">@pf.Platform</td>
                    <td class="text-right mono">@Kb(pf.Bytes)</td>
                    <td class="text-muted text-xs">@pf.SavedAt.ToLocalTime().ToString("g")</td>
                  </tr>
                }
              </tbody>
            </table>
          }
        </section>
      </div>
    </div>
  }
</main>

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    bool _isAdmin;
    Summary? _summary;
    readonly CaptureViewState _view = new();
    readonly Dictionary<string, string> _fc = new();
    string _baseAddress = "";
    string? _cookie;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
        if (!_isAdmin) return;
        try { _summary = await Client().GetFromJsonAsync<Summary>("/api/periodicals/summary", JsonOpts); }
        catch { }
    }

    HttpClient Client() => EggIncognito.Services.SelfCallClient.Create(HttpFactory, _baseAddress, _cookie);

    async Task<string> Fetch(string route)
    {
        try
        {
            var res = await Client().GetAsync(route);
            var body = await res.Content.ReadAsStringAsync();
            return res.IsSuccessStatusCode ? body : $"HTTP {(int)res.StatusCode}: {body}";
        }
        catch (Exception ex) { return ex.Message; }
    }

    string FeedSize(string name)
    {
        var f = _summary?.Feeds.FirstOrDefault(x => x.Name == name);
        return f is null || !f.Present ? "-" : Kb(f.Bytes);
    }

    static string Kb(long bytes) => bytes >= 1024 ? $"{bytes / 1024}KB" : $"{bytes}B";

    static (string Label, string Cls) Prov(string p)
    {
        if (p.StartsWith("captured@", StringComparison.Ordinal)) return ("captured", "prov-captured");
        if (p.StartsWith("binary@", StringComparison.Ordinal)) return ("binary", "prov-binary");
        if (p.StartsWith("extracted@", StringComparison.Ordinal)) return ("extracted", "prov-extracted");
        return (string.IsNullOrEmpty(p) ? "unknown" : "mixed", "prov-unknown");
    }

    record Summary(List<ExtractedRow> Extracted, ColleggtiblesInfo? Colleggtibles, ConfigInfo Config, List<FeedInfo> Feeds);
    record ExtractedRow(string Key, int Count, string Provenance);
    record ColleggtiblesInfo(int Count, string Provenance, List<EggRow> Eggs);
    record EggRow(string Identifier, string Dimension, List<double> TierValues, string? Icon);
    record ConfigInfo(bool Enabled, List<PlatformRow> Platforms);
    record PlatformRow(string Platform, DateTimeOffset SavedAt, long Bytes);
    record FeedInfo(string Name, string Path, bool Present, long Bytes);
}
