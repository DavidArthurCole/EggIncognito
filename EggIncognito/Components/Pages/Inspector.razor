@page "/inspector"
@rendermode @(RenderMode.InteractiveServer)
@inject NavigationManager Nav

@code {

    protected override void OnAfterRender(bool firstRender) {
        if (!firstRender) return;
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        var target = fragment.Length > 0 && !fragment.StartsWith("api", StringComparison.Ordinal)
            ? $"/protos#api/{fragment}"
            : fragment.Length > 0
                ? $"/protos#{fragment}"
                : "/protos#api";
        Nav.NavigateTo(target, replace: true);
    }

}
