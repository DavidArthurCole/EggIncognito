@page "/inspector"
@rendermode @(RenderMode.InteractiveServer)
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Reflection
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.JSInterop
@using EggIncognito.Components.Inspector
@inject IRouteCatalog Catalog
@inject IProtoReflection Reflection
@inject IAppMode AppMode
@inject ICurrentUser User
@inject ISealedProxy SealedProxy
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS

<PageTitle>EggIncognito - Transport Inspector</PageTitle>

@* Responsive: on phones the three panes stack in one scrolling column (auto height); on >=lg they
   become the fixed 240px endpoint list + two equal builder/response columns filling the viewport. The
   left column carries the controls (Postman download + salt) above the endpoint/object explorer. *@
<main class="inspector-main grid gap-3 p-3 min-h-0">
  <div class="inspector-side flex flex-col gap-3 min-h-0">
    <section class="panel inspector-controls">
      <div class="flex items-center justify-between gap-2">
        <h3 class="text-sm font-semibold m-0">Controls</h3>
        <div class="flex items-center gap-1.5">
          <a class="icon-btn" href="/api/tools/postman-collection" download
             title="Download Postman collection" aria-label="Download Postman collection"><Icon Name="download" /></a>
          <button type="button" class="badge @(_hasSalt ? "signed" : "unsigned")"
                  title="@(_hasSalt ? "Signing salt is set (stored in this browser). Click to change it." : "No signing salt set. Click to set it.")"
                  @onclick="OpenSaltModal">@(_hasSalt ? "Salt Set" : "Salt Unset")</button>
        </div>
      </div>
    </section>
    <aside class="panel min-h-0">
      <EndpointList Mode="@_listMode" ModeChanged="SetListMode"
                    Selected="@_selected" SelectedObject="@_selectedObject"
                    OnSelectEndpoint="SelectEndpoint" OnSelectObject="SelectObject"
                    StatusLoading="@_statusLoading" StatusOpen="@_statusOpen"
                    StatusCounts="@_statusCounts" StatusOut="@_statusOut"
                    OnToggleStatus="ToggleStatus" OnRefreshStatus="RefreshStatus" />
    </aside>
  </div>

  <section class="panel">
    @* The builder chrome (request header, env panel, body, send bar) always renders in Endpoints mode;
       the body details fill in once an endpoint is selected. This keeps the send bar visible like the
       old cshtml #builder shell. *@
    <div class="@(_listMode == "endpoints" ? "" : "hidden")">
      <h2>Request <span class="muted">@(_selected is null ? "" : $"({ReqTypeLabel(_selected)})")</span></h2>

      <details class="env-box" open>
        <summary>Environment (BasicRequestInfo overrides)</summary>
        <div class="env-grid">
          @foreach (var row in _envRows)
          {
            var r = row;
            var invalid = r.IsInvalid();
            <label class="env-cell" title="@r.Key">
              <span class="env-key">@r.Key</span>
              @if (r.Editor == "select")
              {
                <select class="env-input" value="@r.Value" @onchange="e => OnEnvInput(r, e.Value?.ToString())">
                  @foreach (var opt in r.Options ?? [])
                  {
                    <option value="@opt">@opt</option>
                  }
                </select>
              }
              else if (r.Editor == "bool")
              {
                <input class="env-check" type="checkbox" checked="@(r.Value == "true")"
                       @onchange="e => OnEnvBool(r, e)" />
              }
              else if (r.Editor == "eid")
              {
                <input class="env-input @(invalid ? "env-invalid" : "")" list="recentEids" value="@r.Value"
                       placeholder="@r.Hint" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                       @oninput="e => OnEnvInput(r, e.Value?.ToString())" />
              }
              else
              {
                <input class="env-input @(invalid ? "env-invalid" : "")" value="@r.Value"
                       placeholder="@r.Hint" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                       @oninput="e => OnEnvInput(r, e.Value?.ToString())" />
              }
            </label>
          }
        </div>
      </details>

      @if (_selected?.PathParam == true)
      {
        <div class="path-param-row">
          <label>URL path parameter (e.g. EID)
            <button type="button" class="forget-eids" title="Clear remembered EIDs" @onclick="ForgetEids">forget</button>
          </label>
          <input list="recentEids" placeholder="EI1234567890123456" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other" @bind="_pathParam" @bind:event="oninput" />
        </div>
      }
      <datalist id="recentEids">
        @foreach (var eid in _recentEids)
        {
          <option value="@eid" />
        }
      </datalist>

      <div class="tree-head">
        <span>Body</span>
        <label class="raw-toggle"><input type="checkbox" checked="@_rawMode" @onchange="ToggleRaw" /> raw JSON</label>
      </div>

      @if (_selected is null)
      {
        <div class="fields"><span class="muted">Select an endpoint on the left.</span></div>
      }
      else if (_rawMode)
      {
        <textarea class="raw-json" spellcheck="false" style="width: 100%; min-height: 200px;"
                  autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                  @bind="_rawJson" @bind:event="oninput"></textarea>
        @if (_rawError is not null)
        {
          <div class="muted">@_rawError</div>
        }
      }
      else
      {
        <div class="fields">
          @if (_selected.PathParamOnly)
          {
            <span class="muted">No request body. Identity (EID) is supplied via the URL path parameter; nothing to fill in here.</span>
          }
          else if (_selected.Request is null)
          {
            @if (_hosted)
            {
              <span class="muted">No known request type for this endpoint. An admin needs to map a <code>request:</code> type for this route.</span>
            }
            else
            {
              <span class="muted">No known request type for this endpoint. Add a <code>request:</code> type in routes.yaml.</span>
            }
          }
          else
          {
            @if (_selected.RequestWrapped)
            {
              <div class="wrap-note">These are the inner request fields. On Build they will be wrapped and signed in an AuthenticatedMessage.</div>
            }
            @if (_fieldNodes is null)
            {
              <span class="muted">no schema for @_selected.Request</span>
            }
            else
            {
              <FieldTree Nodes="_fieldNodes" OnChanged="OnTreeChanged" />
            }
          }
        </div>
      }

      <div class="sendbar">
        <div class="target-toggle" role="radiogroup" aria-label="Target">
          <button type="button" class="target-opt @(_target == "mock" ? "active" : "")"
                  @onclick="@(() => SelectTarget("mock"))">Mock</button>
          <button type="button"
                  class="target-opt @(_target == "real" ? "active" : "") @(_liveDisabled ? "target-opt-disabled" : "")"
                  disabled="@_liveDisabled"
                  title="@(_liveDisabled ? "Log in to use Live API" : "")"
                  @onclick="@(() => RequestTarget("real"))">Live API <DocHelp Kind="endpoint" Key="__live_api" /></button>
          <button type="button" class="target-opt @(_target == "custom" ? "active" : "")"
                  @onclick="@(() => SelectTarget("custom"))">Custom</button>
        </div>
        <div class="sendbar-actions">
          <button class="btn-info" disabled="@(_selected is null || _busy)" @onclick="Build">Build</button>
          <button class="btn-primary" disabled="@(_lastBuild is null || _busy)" @onclick="Send">Send</button>
        </div>
      </div>

      @if (_target == "custom")
      {
        <div class="custom-config">
          <label>Custom proxy URL</label>
          <input type="url" placeholder="https://your-proxy.example/" spellcheck="false"
                 autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                 value="@_customTarget" @oninput="OnCustomTargetInput" />
          <span class="muted">Your browser posts the built request directly to this URL (this server is
            bypassed); the proxy must reach auxbrain and allow this origin (CORS).</span>
        </div>
      }

      @if (_target == "real" && _sealedAvailable)
      {
        <div class="sealed-config">
          <label class="settings-check">
            <input type="checkbox" checked="@_sealed" @onchange="OnSealedToggle" />
            Sealed API proxy
          </label>
          <span class="muted">Routes this send through an authenticated tunnel that hides your identity
            from the Live API. Supporter perk.</span>
        </div>
      }
    </div>

    @if (_listMode == "objects")
    {
      <ObjectView Name="@_selectedObject" OnSelectEndpoint="SelectFromObject" />
    }
  </section>

  @* Pipeline + Response live behind sub-tabs (mirrors the Capture detail pane's tab pattern) so each
     section owns its own scroll region instead of the whole pane scrolling as one cramped column. *@
  <section class="panel insp-result">
    <div class="detail-tabs insp-tabs">
      <div class="tab-bar">
        <button type="button" class="tab-btn @(_resultTab == 0 ? "active" : "")" @onclick="@(() => _resultTab = 0)">Pipeline</button>
        <button type="button" class="tab-btn @(_resultTab == 1 ? "active" : "")" @onclick="@(() => _resultTab = 1)">Response</button>
        <button type="button" class="tab-btn @(_resultTab == 2 ? "active" : "")" @onclick="@(() => _resultTab = 2)">Diagnose</button>
        @if (_resultTab == 1 && _canSaveDb && _response?.Json is not null)
        {
          <button type="button" class="btn-mini ml-auto" title="Save this response as a stored endpoint" @onclick="SaveToDb">Save to DB</button>
        }
      </div>
      <div class="tab-body insp-tab-body">
        @if (_resultTab == 0)
        {
          <Pipeline Stages="_buildStages" />
        }
        else if (_resultTab == 1)
        {
          <ResponsePanel Response="_response" />
          <pre class="settings-out">@_saveOut</pre>
        }
        else
        {
          <Forensics Result="_diagnosis" RootType="@(_selected?.Response)" ClientFactory="Client" />
        }
      </div>
    </div>
  </section>
</main>

@if (_saltModalOpen)
{
  <div class="modal-overlay" @onkeydown="OnModalKeyDown">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="saltModalTitle">
      <h3 id="saltModalTitle">Signing salt</h3>
      <p>Signs requests. Stored in this browser only; never sent to the server beyond the build request.</p>
      <input type="password" placeholder="EGG_INC_API_SALT value" autocomplete="off" spellcheck="false"
             data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
             class="settings-input" @ref="_saltInputRef" @bind="_saltInput" @bind:event="oninput" />
      <div class="modal-actions">
        <button type="button" class="btn-secondary" @onclick="@(() => _saltModalOpen = false)">Cancel</button>
        <button type="button" class="btn-primary" @onclick="SaveSalt">Save salt</button>
      </div>
    </div>
  </div>
}

@if (_liveConsentOpen)
{
  <div class="modal-overlay" @onkeydown="OnModalKeyDown">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="liveConsentTitle">
      <h3 id="liveConsentTitle">Live API mode</h3>
      <p>This sends real requests to the Egg, Inc. API (auxbrain.com) using the values you provide.
         You are solely responsible for how you use it. The developers of EggIncognito accept no
         responsibility for any misuse or for any consequences of that use.</p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" @ref="_consentCancelRef" @onclick="@(() => _liveConsentOpen = false)">Cancel</button>
        <button type="button" class="btn-primary" @onclick="AcceptLiveConsent">I understand, enable Live API</button>
      </div>
    </div>
  </div>
}

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    string _listMode = "endpoints";
    RouteInfo? _selected;
    string? _selectedObject;

    List<FieldNode>? _fieldNodes;
    readonly Dictionary<string, SchemaMessage?> _schemaCache = new();
    List<EnvRow> _envRows = [];
    string _pathParam = "";
    bool _rawMode;
    string _rawJson = "{}";
    string? _rawError;

    string _target = "mock";
    bool _busy; // in-flight Build/Send guard; both buttons disable while a call is running
    BuildResponse? _lastBuild;
    List<TransportStage>? _buildStages;
    SendResponse? _response;
    string _saveOut = "";
    int _resultTab; // 0 = Pipeline, 1 = Response, 2 = Diagnose (mirrors Capture's remembered detail tab)
    DiagnoseDto? _diagnosis;

    bool _hasSalt;
    string _saltInput = "";
    bool _saltModalOpen;
    bool _liveConsentOpen;
    // Modal focus: move keyboard focus into a freshly opened modal so Escape works immediately.
    ElementReference _saltInputRef;
    ElementReference _consentCancelRef;
    bool _focusSaltModal;
    bool _focusConsentModal;
    string _customTarget = "";
    string[] _recentEids = [];
    RinfoDefaults _rinfo = new();

    bool _statusOpen;
    bool _statusLoading;
    string _statusOut = "";
    string _statusCounts = "";

    bool _liveDisabled;
    bool _canSaveDb;
    bool _hosted;

    // Sealed API proxy supporter perk: the toggle shows only when the perk is configured and this user
    // is a supporter. The server re-checks on /send, so this is purely the affordance.
    bool _sealedAvailable;
    bool _sealed;

    // The salt is read fresh from the browser only when needed (build, badge). It never lives in a
    // server field beyond a single build round-trip; this holds only the badge-state boolean.

    string _baseAddress = "";
    string? _cookie;
    IJSObjectReference? _store;

    protected override void OnInitialized()
    {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
        // Live API egress is login-gated when hosted; grey the toggle for anonymous hosted users. The
        // server /send is the real gate. Read IAppMode/ICurrentUser directly (server-side render).
        _hosted = AppMode.Mode == EggIncognito.Services.AppMode.Hosted;
        _liveDisabled = _hosted && !User.IsAuthenticated;
        // Save to DB needs contributor+. In Local with no auth, ICurrentUser is anonymous (viewer), so
        // mirror app.js's fail-open: show the button when auth is off (Local) or the user is contributor+.
        _canSaveDb = AppMode.Mode != EggIncognito.Services.AppMode.Hosted
            || User.IsAtLeast(UserRole.Contributor);
        // Show the sealed-proxy toggle only when configured + this user is a supporter. The /send gate
        // re-verifies live, so a stale claim here can never actually use the sealed egress.
        _sealedAvailable = SealedProxy.IsConfigured && User.IsSupporter;
        // Seed the env panel from the in-memory defaults so it renders on the first (pre-JS) pass; the
        // browser-stored overrides are merged in after the interop module loads (OnAfterRenderAsync).
        SeedEnvRows();
    }

    // Browser-memory reads need JS, so they run after the first interactive render. The ES module is
    // imported once; all browser-local state (salt, EIDs, proxy URL, rinfo defaults) flows through it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus a freshly opened modal (set by OpenSaltModal/RequestTarget) so Escape-to-close works
        // without a mouse click first.
        if (_focusSaltModal)
        {
            _focusSaltModal = false;
            try { await _saltInputRef.FocusAsync(); } catch { }
        }
        if (_focusConsentModal)
        {
            _focusConsentModal = false;
            try { await _consentCancelRef.FocusAsync(); } catch { }
        }
        if (!firstRender) return;
        try { _store = await JS.InvokeAsync<IJSObjectReference>("import", "./interop/inspectorStore.js"); }
        catch { return; } // JS unavailable (e.g. test prerender); the page stays usable with defaults.
        _rinfo = await InvokeOr("getRinfoDefaults", _rinfo);
        _hasSalt = !string.IsNullOrEmpty(await InvokeOr("getSalt", ""));
        _customTarget = await InvokeOr("getCustomTarget", "");
        _recentEids = await InvokeOr("recentEids", Array.Empty<string>());
        SeedEnvRows();
        StateHasChanged();
    }

    async Task<T> InvokeOr<T>(string fn, T fallback, params object?[] args)
    {
        if (_store is null) return fallback;
        try { return await _store.InvokeAsync<T>(fn, args); }
        catch { return fallback; }
    }

    async Task InvokeVoid(string fn, params object?[] args)
    {
        if (_store is null) return;
        try { await _store.InvokeVoidAsync(fn, args); } catch { }
    }

    void SetListMode(string m) => _listMode = m;

    async Task SelectEndpoint(RouteInfo e)
    {
        _selected = e;
        _lastBuild = null;
        _buildStages = null;
        _response = null;
        _rawMode = false;
        _rawJson = "{}";
        _rawError = null;
        _pathParam = "";
        if (e.PathParam) PrefillEid(v => _pathParam = v);
        await BuildFieldTree();
    }

    void SelectObject(string name)
    {
        _selectedObject = name;
    }

    // From the Object view's "used by" list: jump to the endpoint builder.
    async Task SelectFromObject(RouteInfo e)
    {
        _listMode = "endpoints";
        await SelectEndpoint(e);
    }

    static string ReqTypeLabel(RouteInfo e)
    {
        if (e.PathParamOnly) return "no request body - identity via URL path param";
        var t = e.Request ?? "no request type";
        return e.RequestWrapped ? $"{t}, signed (AuthenticatedMessage)" : t;
    }

    // schema + field tree (direct service reads, no API round-trip)
    SchemaMessage? Schema(string? typeName)
    {
        if (string.IsNullOrEmpty(typeName)) return null;
        if (!_schemaCache.TryGetValue(typeName, out var s))
        {
            s = Reflection.Schema(typeName);
            _schemaCache[typeName] = s;
        }
        return s;
    }

    Task BuildFieldTree()
    {
        _fieldNodes = null;
        if (_selected is null || _selected.PathParamOnly || _selected.Request is null) return Task.CompletedTask;
        var s = Schema(_selected.Request);
        if (s is null) return Task.CompletedTask;
        _fieldNodes = FieldTreeBuilder.Build(s, t => Schema(t));
        ApplyEnvLock();
        return Task.CompletedTask;
    }

    void SeedEnvRows()
    {
        _envRows =
        [
            new EnvRow { Key = "eiUserId", ValueType = "string", Editor = "eid", Hint = "EI...", Value = _rinfo.EiUserId },
            new EnvRow { Key = "clientVersion", ValueType = "number", Editor = "int", Hint = "int", Value = _rinfo.ClientVersion.ToString() },
            new EnvRow { Key = "version", ValueType = "string", Editor = "version", Hint = "1.35.8", Value = _rinfo.Version },
            new EnvRow { Key = "build", ValueType = "string", Editor = "int", Hint = "int", Value = _rinfo.Build },
            new EnvRow { Key = "platform", ValueType = "string", Editor = "select", Options = PlatformOptions, Value = _rinfo.Platform },
            new EnvRow { Key = "country", ValueType = "string", Editor = "code", Hint = "US", Value = _rinfo.Country },
            new EnvRow { Key = "language", ValueType = "string", Editor = "code", Hint = "en", Value = _rinfo.Language },
            new EnvRow { Key = "debug", ValueType = "boolean", Editor = "bool", Value = _rinfo.Debug ? "true" : "false" },
        ];
    }

    Task OnEnvBool(EnvRow row, ChangeEventArgs e) =>
        OnEnvInput(row, e.Value is bool b && b ? "true" : "false");

    async Task OnEnvInput(EnvRow row, string? value)
    {
        row.Value = value ?? "";
        SyncRinfoFromRow(row);
        ApplyEnvLock();
        // Env edits ARE the request defaults; persist them browser-side so they survive a reload.
        await InvokeVoid("setRinfoDefaults", _rinfo);
    }

    // Mirror a single edited env row back onto the persisted BasicRequestInfo defaults.
    void SyncRinfoFromRow(EnvRow row)
    {
        switch (row.Key)
        {
            case "eiUserId": _rinfo.EiUserId = row.Value; break;
            case "clientVersion": _rinfo.ClientVersion = int.TryParse(row.Value, out var cv) ? cv : _rinfo.ClientVersion; break;
            case "version": _rinfo.Version = row.Value; break;
            case "build": _rinfo.Build = row.Value; break;
            case "platform": _rinfo.Platform = row.Value; break;
            case "country": _rinfo.Country = row.Value; break;
            case "language": _rinfo.Language = row.Value; break;
            case "debug": _rinfo.Debug = row.Value == "true"; break;
        }
    }

    void ApplyEnvLock()
    {
        if (_fieldNodes is null) return;
        var env = EnvCollector.AsStrings(_envRows);
        FieldTreeBuilder.ApplyEnvLock(_fieldNodes, env);
        // Default top-level request fields (clientVersion, eiUserId, platform, ...) from the Environment
        // constants so the same values do not have to be retyped per request.
        FieldTreeBuilder.ApplyEnvDefaults(_fieldNodes, env);
    }

    void OnTreeChanged() { /* re-render; raw JSON is re-derived on toggle */ }

    void ToggleRaw(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on)
        {
            _rawError = null;
            _rawMode = true;
            if (_fieldNodes is not null)
                _rawJson = FieldTreeBuilder.Collect(_fieldNodes).ToJsonString(new JsonSerializerOptions { WriteIndented = true });
            return;
        }
        // Switching raw off: parse the raw edits back into the field tree so they are not silently
        // discarded. If the raw JSON does not parse, stay in raw mode and surface the error.
        if (_fieldNodes is not null)
        {
            try
            {
                var obj = JsonNode.Parse(string.IsNullOrWhiteSpace(_rawJson) ? "{}" : _rawJson) as JsonObject
                    ?? throw new FormatException("raw body must be a JSON object");
                FieldTreeBuilder.Apply(_fieldNodes, obj);
                ApplyEnvLock();
            }
            catch (Exception ex)
            {
                _rawError = "Raw JSON does not parse, so it was not applied to the tree. Fix it or switch back: " + ex.Message;
                _rawMode = true;
                return;
            }
        }
        _rawError = null;
        _rawMode = false;
    }

    // endpoint-status popover + salt
    async Task ToggleStatus()
    {
        _statusOpen = !_statusOpen;
        if (_statusOpen && string.IsNullOrEmpty(_statusCounts)) await RefreshStatus();
    }

    async Task RefreshStatus()
    {
        _statusLoading = true;
        _statusOut = "Loading...";
        try
        {
            var r = await Client().GetFromJsonAsync<StatusResult>("/api/tools/endpoint-status", JsonOpts);
            if (r is not null)
            {
                _statusCounts = $"(ok {r.Ok.Count} / empty {r.Empty.Count} / missing {r.Missing.Count})";
                var lines = new List<string>();
                if (r.Empty.Count > 0) { lines.Add("empty:"); lines.AddRange(r.Empty.Select(p => "  " + p)); }
                if (r.Missing.Count > 0) { lines.Add("missing:"); lines.AddRange(r.Missing.Select(p => "  " + p)); }
                _statusOut = lines.Count > 0 ? string.Join("\n", lines) : "All mapped routes have a fixture.";
            }
        }
        catch (Exception ex) { _statusOut = $"Request failed: {ex.Message}"; }
        finally { _statusLoading = false; }
    }

    void OpenSaltModal()
    {
        _saltInput = "";
        _saltModalOpen = true;
        _focusSaltModal = true;
    }

    // Escape closes whichever modal is open (the handler sits on each modal's overlay).
    void OnModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        _saltModalOpen = false;
        _liveConsentOpen = false;
    }

    async Task SaveSalt()
    {
        await InvokeVoid("setSalt", _saltInput);
        _hasSalt = !string.IsNullOrEmpty(_saltInput);
        _saltInput = "";
        _saltModalOpen = false;
    }

    void SelectTarget(string t)
    {
        _target = t;
    }

    // Live API sends real auxbrain requests; gate the first switch per browser behind consent.
    async Task RequestTarget(string t)
    {
        if (_liveDisabled) return;
        if (t == "real" && !await InvokeOr("getLiveConsent", false))
        {
            _liveConsentOpen = true;
            _focusConsentModal = true;
            return;
        }
        SelectTarget(t);
    }

    async Task AcceptLiveConsent()
    {
        await InvokeVoid("setLiveConsent");
        _liveConsentOpen = false;
        SelectTarget("real");
    }

    void OnCustomTargetInput(ChangeEventArgs e)
    {
        _customTarget = e.Value?.ToString() ?? "";
        _ = InvokeVoid("setCustomTarget", _customTarget);
    }

    void OnSealedToggle(ChangeEventArgs e) => _sealed = e.Value is bool b && b;

    // build + send. /build owns the salt+sign; /send owns egress+allowlist; /decode-response is pure.
    // Both entry points share the _busy in-flight guard so a double-click cannot fire concurrent
    // /build or /send calls (Send can be live-API egress).

    async Task Build()
    {
        if (_busy) return;
        _busy = true;
        try { await BuildCore(); }
        finally { _busy = false; }
    }

    async Task Send()
    {
        if (_busy) return;
        _busy = true;
        try { await SendCore(); }
        finally { _busy = false; }
    }

    async Task BuildCore()
    {
        var e = _selected;
        if (e is null) return;
        _response = null;
        _resultTab = 0; // surface the freshly-built pipeline

        if (e.PathParamOnly)
        {
            _lastBuild = new BuildResponse(null, "", "", false, null, null, null);
            _buildStages = null;
            return;
        }
        if (e.Request is null)
        {
            _buildStages = null;
            _response = new SendResponse(null, null, null, null,
                "no request type for this endpoint",
                _hosted
                    ? "An admin needs to map a `request:` type for this route before it can be built."
                    : "Add a `request:` type in routes.yaml before building.");
            return;
        }

        JsonNode? fields;
        try
        {
            fields = _rawMode
                ? JsonNode.Parse(string.IsNullOrWhiteSpace(_rawJson) ? "{}" : _rawJson)
                : FieldTreeBuilder.Collect(_fieldNodes ?? []);
        }
        catch (Exception ex)
        {
            _response = new SendResponse(null, null, null, null, "invalid raw JSON: " + ex.Message, null);
            return;
        }

        // Read the client-owned salt fresh from the browser for this one build call. It is sent only
        // here, never stored server-side.
        var salt = await InvokeOr<string?>("getSalt", null);

        var body = new
        {
            path = e.Path,
            requestType = e.Request,
            wrap = e.RequestWrapped,
            fields,
            env = EnvCollector.Collect(_envRows),
            salt,
        };

        try
        {
            var res = await Client().PostAsJsonAsync("/api/inspector/build", body, JsonOpts);
            var data = await res.Content.ReadFromJsonAsync<BuildResponse>(JsonOpts);
            if (data?.Error is not null)
            {
                _buildStages = null;
                _response = new SendResponse(null, null, null, null, data.Error, data.Resolution);
                _lastBuild = null;
                return;
            }
            _lastBuild = data;
            _buildStages = data?.Stages;
        }
        catch (Exception ex)
        {
            _response = new SendResponse(null, null, null, null, "build failed: " + ex.Message, null);
        }
    }

    async Task SendCore()
    {
        var e = _selected;
        if (_lastBuild is null || e is null) return;
        _resultTab = 1; // jump to the Response tab so the decoded result is visible

        if (_target == "custom")
        {
            await SendCustom(e);
            return;
        }

        var basis = _target == "mock"
            ? _baseAddress
            : (e.Path.StartsWith("ei_ctx") || e.Path.StartsWith("ei_srv")
                ? "https://ctx-dot-auxbrainhome.appspot.com"
                : "https://www.auxbrain.com");

        var url = $"{basis}/{e.Path}";
        if (e.PathParam)
        {
            var param = _pathParam.Trim();
            if (string.IsNullOrEmpty(param))
            {
                _response = new SendResponse(null, null, null, null,
                    "URL path parameter is required for this endpoint",
                    "Enter the EID (or other path value) in the field above the Build button.");
                return;
            }
            url += "/" + Uri.EscapeDataString(param);
        }

        await RememberEnteredEids();
        try
        {
            var res = await Client().PostAsJsonAsync("/api/inspector/send",
                new { url, formBody = _lastBuild.FinalFormBody, responseType = e.Response,
                      @sealed = _target == "real" && _sealed }, JsonOpts);
            _response = await res.Content.ReadFromJsonAsync<SendResponse>(JsonOpts);
            await MaybeDiagnose();
        }
        catch (Exception ex)
        {
            _response = new SendResponse(null, null, null, null, "send failed: " + ex.Message, null);
        }
    }

    // When a send decoded to an error but we still have the raw response bytes, run wire forensics and
    // surface the Diagnose tab so the failure is actionable instead of just an error string.
    async Task MaybeDiagnose()
    {
        _diagnosis = null;
        if (_response?.Error is null || string.IsNullOrEmpty(_response.RawBase64)) return;
        try
        {
            var res = await Client().PostAsJsonAsync("/api/tools/diagnose",
                new { Base64 = _response.RawBase64, RootType = _selected?.Response }, JsonOpts);
            _diagnosis = await res.Content.ReadFromJsonAsync<DiagnoseDto>(JsonOpts);
            _resultTab = 2; // focus the Diagnose tab on a decode failure
        }
        catch { /* leave _diagnosis null; the Response tab still shows the error */ }
    }

    // Custom: the browser POSTs the built form body straight to the user's proxy (this server bypassed),
    // then the egress-free /decode-response turns the bytes into JSON.
    async Task SendCustom(RouteInfo e)
    {
        if (string.IsNullOrEmpty(_customTarget))
        {
            _response = new SendResponse(null, null, null, null,
                "no custom proxy URL set", "Set your Custom proxy URL above first.");
            return;
        }
        var proxyUrl = _customTarget.TrimEnd('/') + "/" + e.Path;
        if (e.PathParam)
        {
            var param = _pathParam.Trim();
            if (string.IsNullOrEmpty(param))
            {
                _response = new SendResponse(null, null, null, null,
                    "URL path parameter is required", "Enter the EID above Build.");
                return;
            }
            proxyUrl += "/" + Uri.EscapeDataString(param);
        }
        await RememberEnteredEids();

        if (_store is null)
        {
            _response = new SendResponse(null, null, null, null,
                "custom send needs the browser interop", "Reload the page and try again.");
            return;
        }
        string raw;
        try
        {
            raw = await _store.InvokeAsync<string>("postForm", proxyUrl, _lastBuild!.FinalFormBody);
        }
        catch (Exception ex)
        {
            _response = new SendResponse(null, null, null, null,
                $"direct request to your proxy failed: {ex.Message}",
                "Your proxy must be reachable from this browser and allow this origin (CORS).");
            return;
        }
        try
        {
            var res = await Client().PostAsJsonAsync("/api/inspector/decode-response",
                new { rawBase64 = raw, responseType = e.Response }, JsonOpts);
            var dec = await res.Content.ReadFromJsonAsync<SendResponse>(JsonOpts);
            _response = new SendResponse(200, raw, dec?.Stages, dec?.Json, dec?.Error, null);
            await MaybeDiagnose();
        }
        catch (Exception ex)
        {
            _response = new SendResponse(null, null, null, null, "decode failed: " + ex.Message, null);
        }
    }

    async Task RememberEnteredEids()
    {
        var candidates = new List<string?> { _pathParam };
        candidates.AddRange(_envRows.Select(r => r.Value));
        var present = candidates.Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!).ToArray();
        if (present.Length == 0) return;
        // The interop expects a single array argument (rememberEids(values)).
        _recentEids = await InvokeOr("rememberEids", _recentEids, new object?[] { present });
    }

    async Task ForgetEids()
    {
        _recentEids = await InvokeOr("forgetEids", Array.Empty<string>());
        _pathParam = "";
    }

    void PrefillEid(Action<string> set)
    {
        var last = _recentEids.FirstOrDefault();
        if (!string.IsNullOrEmpty(last)) set(last);
    }

    async Task SaveToDb()
    {
        var e = _selected;
        if (e is null || _response?.Json is null)
        {
            _saveOut = "Build + send a request first.";
            return;
        }
        _saveOut = "Saving...";
        try
        {
            using var doc = JsonDocument.Parse(_response.Json);
            var res = await Client().PostAsJsonAsync("/api/db/endpoint", new
            {
                path = e.Path,
                eid = string.IsNullOrWhiteSpace(_pathParam) ? null : _pathParam,
                responseJson = doc.RootElement,
                responseType = e.Response,
            }, JsonOpts);
            if (res.IsSuccessStatusCode)
            {
                _saveOut = $"Saved {e.Path}{(string.IsNullOrWhiteSpace(_pathParam) ? "" : $" ({_pathParam})")} to the shared DB.";
                return;
            }
            _saveOut = res.StatusCode == System.Net.HttpStatusCode.Forbidden
                ? "Not authorized to write to the shared DB."
                : $"Save failed: HTTP {(int)res.StatusCode}";
        }
        catch (Exception ex) { _saveOut = $"Request failed: {ex.Message}"; }
    }

    // Self-call client forwarding the auth cookie so the controllers' gates see the request's auth.
    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    // Mutable holder for the seven BasicRequestInfo defaults. Field types mirror the JS interop shape
    // exactly (getRinfoDefaults returns clientVersion:int, debug:bool) so the JSON round-trips cleanly.
    sealed class RinfoDefaults
    {
        public string EiUserId { get; set; } = "";
        public int ClientVersion { get; set; } = 72;
        public string Version { get; set; } = "1.35.7";
        public string Build { get; set; } = "111343";
        public string Platform { get; set; } = "DROID";
        public string Country { get; set; } = "US";
        public string Language { get; set; } = "en";
        public bool Debug { get; set; }
    }

    // Platform is a string field on BasicRequestInfo, but the only valid values are the proto Platform
    // enum names (e.g. DROID, IOS). Source the dropdown from the enum's original proto names (the
    // [OriginalName] attribute), not the PascalCase C# members, so the value on the wire matches what the
    // real client sends and can never drift from the proto.
    static readonly string[] PlatformOptions = typeof(Ei.Platform).GetFields()
        .Where(f => f.IsLiteral)
        .Select(f => f.GetCustomAttribute<Google.Protobuf.Reflection.OriginalNameAttribute>()?.Name ?? f.Name)
        .ToArray();

    record StatusResult(List<string> Ok, List<string> Empty, List<string> Missing);

    public async ValueTask DisposeAsync()
    {
        if (_store is not null)
        {
            try { await _store.DisposeAsync(); } catch { }
        }
    }
}
