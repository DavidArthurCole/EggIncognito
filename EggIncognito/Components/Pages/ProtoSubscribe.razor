@page "/protos/subscribe"
@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>EggIncognito - Subscribe to proto updates</PageTitle>
<main class="px-4 sm:px-8 pt-6 pb-8 max-w-2xl">
  <a href="/protos" class="text-muted text-sm">&larr; All versions</a>
  <h1 class="text-[1.3rem] mt-2 mb-1">Subscribe to proto updates</h1>
  <p class="text-muted mb-4">
    Get a Discord notification when the registry sees a new game build. Paste a channel webhook URL,
    pick what you want, and we send a test message on save.
  </p>

  @if (_done is not null)
  {
    <section class="panel">
      <h2 class="text-base mt-0 mb-2">Subscribed</h2>
      <p class="text-muted mb-3">A test message was sent to your channel. You will be notified on:</p>
      <div class="sub-confirm">
        <div class="sub-confirm-row">
          <span class="sub-confirm-label">Platforms</span>
          <span class="code-chip">@_done.Platforms</span>
        </div>
        <div class="sub-confirm-row">
          <span class="sub-confirm-label">Trigger</span>
          <span class="code-chip">@_done.Trigger</span>
        </div>
      </div>
      <button type="button" class="btn-primary mt-4" @onclick="Reset">Add another</button>
    </section>
  }
  else
  {
    <section class="panel">
      <div class="sub-section">
        <label class="block">
          <span class="block text-muted text-sm mb-1">Discord webhook URL</span>
          <input class="field-input w-full" placeholder="https://discord.com/api/webhooks/..."
                 @bind="_url" @bind:event="oninput" />
        </label>
      </div>

      <hr class="settings-divider" />

      <fieldset class="sub-section border-0 p-0 m-0">
        <legend class="text-muted text-sm mb-1 p-0">Platforms</legend>
        <label class="settings-check mb-1"><input type="checkbox" @bind="_android" /> Android</label>
        <label class="settings-check"><input type="checkbox" @bind="_ios" /> iOS</label>
      </fieldset>

      <hr class="settings-divider" />

      <fieldset class="sub-section border-0 p-0 m-0">
        <legend class="text-muted text-sm mb-1 p-0">Notify on</legend>
        <label class="settings-check mb-1">
          <input type="radio" name="trigger" checked="@(_trigger == "proto_changed")"
                 @onchange="@(() => _trigger = "proto_changed")" />
          Proto changed (the high-value signal)
        </label>
        <label class="settings-check">
          <input type="radio" name="trigger" checked="@(_trigger == "new_version")"
                 @onchange="@(() => _trigger = "new_version")" />
          Any new version
        </label>
      </fieldset>

      <hr class="settings-divider" />

      <button type="button" class="btn-primary" disabled="@_busy" @onclick="Submit">
        @(_busy ? "Sending test..." : "Subscribe")
      </button>

      @if (_error is not null)
      {
        <p class="mt-3 text-err">@_error</p>
      }
    </section>
  }
</main>

@code {
    static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new(System.Text.Json.JsonSerializerDefaults.Web);

    string _url = "";
    bool _android = true;
    bool _ios = true;
    string _trigger = "proto_changed";
    bool _busy;
    string? _error;
    Confirmation? _done;

    string _baseAddress = "";
    string? _cookie;

    protected override void OnInitialized()
    {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
    }

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    void Reset()
    {
        _done = null;
        _error = null;
        _url = "";
        _android = true;
        _ios = true;
        _trigger = "proto_changed";
    }

    async Task Submit()
    {
        _busy = true;
        _error = null;
        try
        {
            var platforms = new List<string>();
            if (_android) platforms.Add("android");
            if (_ios) platforms.Add("ios");
            var body = new { webhookUrl = _url, platforms = platforms.ToArray(), trigger = _trigger, label = (string?)null };
            var res = await Client().PostAsJsonAsync("/api/protos/feed", body, JsonOpts);
            if (res.IsSuccessStatusCode)
            {
                var label = platforms.Count == 0 ? "none" : string.Join(", ", platforms);
                _done = new Confirmation(label, TriggerLabel(_trigger));
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ErrorBody>(JsonOpts);
                _error = err?.Error ?? $"Subscription failed ({(int)res.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _error = $"Subscription failed: {ex.Message}";
        }
        _busy = false;
    }

    static string TriggerLabel(string t) => t == "new_version" ? "any new version" : "proto changed";

    record Confirmation(string Platforms, string Trigger);
    record ErrorBody(string? Error);
}
