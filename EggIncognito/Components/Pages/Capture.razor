@page "/capture"
@page "/capture/device/{DeviceId}"
@rendermode @(RenderMode.InteractiveServer)
@using System.Threading.Channels
@using EggIncognito.Capture
@using EggIncognito.Components.Capture
@using EggIncognito.Services.Devices
@using static Components.Capture.CaptureNoticesPanel
@implements IAsyncDisposable
@inherits SelfCallComponentBase
@inject CaptureSessionManager Manager
@inject IServiceProvider Services
@inject IAppMode AppMode
@inject ICurrentUser User
@inject HostedCaptureOptions HostedOptions
@inject IConfiguration Config
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<Capture> Logger

<PageTitle>EggIncognito - Live Capture</PageTitle>

@if (_hub is not null) {
    @if (_session is not null && _hosted && (!_connected || !_running)) {
        <div class="px-3 pt-3 setup-collapsible @(_connected ? "setup-hidden" : "")">
            <HostedSetupCard Port="HostedOptions.FrontDoorPort"
                             ClientFactory="Client" InviteUrl="@Config["Discord:InviteUrl"]"
                             HostOverride="@_rotatedHost"/>
        </div>
    }

    <main class="capture-main flex flex-col gap-3 p-3 min-h-0">
        <section class="panel capture-topbar">
            <div class="capture-topbar-btns">
                <CaptureControlsPanel Running="_running" ToggleBusy="_toggleBusy" View="_view"
                                      OnToggleCapture="ToggleCapture" OnClear="Clear" OnViewChanged="OnViewChanged"
                                      Hosted="_hosted" ClientFactory="Client" ReadOnly="_readOnly"
                                      OnAddressRotated="@(h => {
                                                            _rotatedHost = h;
                                                            StateHasChanged();
                                                        })"/>
                <CaptureNoticesPanel Notices="_notices" Unread="_unread"
                                     OnDismissNotice="DismissNotice" OnClearNotices="ClearNotices" OnNoticesRead="MarkNoticesRead"/>
            </div>
            @if (_readOnly) {
                <div class="capture-device">
                    <span class="capture-device-tag">READ-ONLY</span>
                    @if (!string.IsNullOrEmpty(_deviceLabel)) {
                        <span class="capture-device-name">@_deviceLabel</span>
                    }
                </div>
            }
            <div class="capture-topbar-spacer"></div>
            <StatsPanel Stats="_stats" FlowCount="_flows.Count" Running="_running" Port="_port"/>
        </section>

        <div class="capture-body grid gap-3 min-h-0">
            <FlowList Flows="_flows" SelectedId="_selectedId" Connected="_connected" View="_view" OnSelect="SelectFlow"/>

            <section id="detailPanel" class="panel">
                <h2>Detail</h2>
                <DetailPane Flow="_selectedFlow" View="_view" ClientFactory="Client"/>
            </section>
        </div>
    </main>

    <div class="toast-container">
        @foreach (var t in _toasts) {
            <div class="toast toast-@t.Severity show" @onclick="@(() => RemoveToast(t.Id))">
                <div class="toast-msg">@t.Message</div>
                @if (!string.IsNullOrEmpty(t.Timestamp)) {
                    <div class="toast-time">@t.Timestamp</div>
                }
            </div>
        }
    </div>
} else if (!string.IsNullOrEmpty(DeviceId)) {
    <main class="px-8 pt-6 pb-8 max-w-[760px]">
        <h1 class="text-[1.3rem] mt-0 mb-2">Device capture</h1>
        <div class="panel">
            <p class="text-muted text-sm my-0">
                This device live-view is admin-only, and only available for a declared device whose capture is
                running on this host. No live session for <code class="code-chip">@DeviceId</code>.
            </p>
            <a class="btn-secondary text-xs mt-3 w-fit no-underline" href="/admin">Back to Admin</a>
        </div>
    </main>
} else if (AppMode.HostedCaptureEnabled) {
    <main class="px-8 pt-6 pb-8 max-w-[760px]">
        <h1 class="text-[1.3rem] mt-0 mb-2">Capture</h1>
        @if (!_isAuthenticated) {
            <div class="panel" id="hostedLogin">
                <p class="text-muted text-sm mt-0 mb-3">Log in to start a hosted capture session.</p>
                <LoginButton Label="Log in"/>
            </div>
        } else if (!_isSupporter) {
            <div class="panel mb-4" id="hostedPitch">
                <p class="text-muted text-sm mt-0 mb-3">Hosted capture is a supporter perk.</p>
                <a class="btn-primary inline-block w-fit no-underline" href="/support">Become a supporter</a>
            </div>
            <LocalCaptureGuide/>
        } else {
            <div class="panel" id="hostedCapacity">
                <p class="text-muted text-sm my-0">
                    All capture slots are in use right now. Try again in a few
                    minutes.
                </p>
            </div>
        }
    </main>
} else {
    <main class="px-8 pt-6 pb-8 max-w-[760px]">
        <h1 class="text-[1.3rem] mt-0 mb-2">Capture</h1>
        <p class="text-muted leading-relaxed mb-5">Capture runs a local proxy + CA and writes to disk, so it cannot run on this hosted instance.</p>
        <LocalCaptureGuide/>
    </main>
}

@code {


    readonly List<DashboardFlow> _flows = [];
    readonly Dictionary<long, int> _flowIndex = new();
    long? _selectedId;
    DashboardFlow? _selectedFlow;

    CaptureStats? _stats;
    bool _running;
    int _port;
    bool _connected;
    bool _toggleBusy;

    readonly CaptureViewState _view = new();

    readonly List<NoticeItem> _notices = [];
    readonly List<ToastItem> _toasts = [];
    int _unread;
    int _nextNoticeId = 1;
    int _nextToastId = 1;

    IDisposable? _subscription;
    CancellationTokenSource? _loopCts;
    Task? _loopTask;

    IJSObjectReference? _store;


    CaptureSession? _session;
    CaptureHub? _hub;
    bool _readOnly;
    string? _deviceLabel;
    [Parameter] public string? DeviceId { get; set; }
    bool _hosted;
    string? _rotatedHost;
    bool _isAuthenticated;
    bool _isSupporter;
    string? _userId;

    protected override void OnInitialized() {
        base.OnInitialized();

        _isAuthenticated = User.IsAuthenticated;
        _isSupporter = User.IsSupporter;
        _userId = User.DiscordId;

        if (!string.IsNullOrEmpty(DeviceId))
            ResolveDeviceSession();
        else
            ResolveSession();
        if (_hub is null) return;


        foreach (var f in _hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(_hub.StatsSnapshot());


        foreach (var k in CaptureController_SensitiveKeys()) _view.SensitiveKeys.Add(k);
    }


    void ResolveSession() {
        if (AppMode.CanCapture) {
            _session = Manager.GetOrCreate(CaptureSessionManager.LocalKey);
            _hub = _session.Hub;
            return;
        }

        if (!AppMode.HostedCaptureEnabled || !_isAuthenticated || !_isSupporter || string.IsNullOrEmpty(_userId))
            return;
        _hosted = true;
        try {
            _session = Manager.GetOrCreate(_userId);
            _hub = _session.Hub;
        }
        catch (CaptureCapacityException) {
            /* capacity panel renders */
        }
    }


    void ResolveDeviceSession() {
        if (!User.IsAtLeast(UserRole.Admin)) return;
        var dcm = Services.GetService(typeof(DeviceCaptureManager)) as DeviceCaptureManager;
        var hub = dcm?.HubFor(DeviceId!);
        if (hub is null) return;
        _hub = hub;
        _readOnly = true;
        var cfg = Services.GetService(typeof(DeviceConfig)) as DeviceConfig;
        _deviceLabel = cfg?.Devices.FirstOrDefault(d => d.Id == DeviceId)?.Label ?? DeviceId;
    }


    static IEnumerable<string> CaptureController_SensitiveKeys() {
        return Redactor.SensitiveFieldNames.Concat(["eiUserId", "userId"]).Distinct();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || _hub is null) return;


        try {
            _store = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/captureStore.js"));
            _view.RedactionMode = await InvokeOr("getRedactionMode", _view.RedactionMode);
            _view.ShowHeaders = await InvokeOr("getShowHeaders", _view.ShowHeaders);
            _view.AutoScroll = await InvokeOr("getAutoScroll", _view.AutoScroll);
            _view.CompareToKnown = await InvokeOr("getCompareToKnown", _view.CompareToKnown);
            _view.DefaultFormat = await InvokeOr("getDefaultFormat", _view.DefaultFormat);
        }
        catch {
            /* JS unavailable (test prerender); defaults stand. */
        }

        StartSubscription();
        StateHasChanged();
    }


    void StartSubscription() {
        if (_hub is null) return;
        var (reader, subscription) = _hub.Subscribe();
        _subscription = subscription;


        foreach (var f in _hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(_hub.StatsSnapshot());
        _loopCts = new CancellationTokenSource();
        var ct = _loopCts.Token;
        _loopTask = Task.Run(async () => {
            try {
                await foreach (var env in reader.ReadAllAsync(ct)) {
                    await InvokeAsync(() => ApplyEnvelope(env));
                }
            }
            catch (OperationCanceledException) {
                /* disposed */
            }
            catch (ChannelClosedException) {
                /* hub unsubscribed */
            }
        }, ct);
    }


    void ApplyEnvelope(CaptureEnvelope env) {
        switch (env.Kind) {
            case "flow" when env.Flow is not null:
                AddOrUpdateFlow(env.Flow);
                break;
            case "stats" when env.Stats is not null:
                ApplyStats(env.Stats);
                break;
            case "notice" when env.Event is not null:
                PushNotice(env.Event);
                break;
        }

        StateHasChanged();
    }

    void AddOrUpdateFlow(DashboardFlow flow) {
        if (_flowIndex.TryGetValue(flow.Id, out var idx)) {
            _flows[idx] = flow;
            if (_selectedId == flow.Id) _selectedFlow = flow;
            return;
        }

        _flowIndex[flow.Id] = _flows.Count;
        _flows.Add(flow);
    }

    void ApplyStats(CaptureStats stats) {
        _stats = stats;
        _running = stats.Running;
        _port = stats.Port;
        _connected = stats.ActiveConnections > 0 || stats.DeviceCount > 0;
    }

    void SelectFlow(long id) {
        _selectedId = id;
        _selectedFlow = _flowIndex.TryGetValue(id, out var idx) ? _flows[idx] : null;
    }


    async Task ToggleCapture() {
        _toggleBusy = true;
        try {
            var url = _running ? "/api/capture/stop" : "/api/capture/start";
            await Client().PostAsync(url, null);
        }
        catch {
            /* surfaced via the next stats broadcast; nothing to do here */
        }


        finally {
            _toggleBusy = false;
            StateHasChanged();
        }
    }

    async Task Clear() {
        try {
            var res = await Client().PostAsync("/api/capture/clear", null);
            if (res.IsSuccessStatusCode) {
                _flows.Clear();
                _flowIndex.Clear();
                _selectedId = null;
                _selectedFlow = null;
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "clearing the capture buffer failed");
        }
    }

    async Task OnViewChanged() {
        await InvokeVoid("setRedactionMode", _view.RedactionMode);
        await InvokeVoid("setShowHeaders", _view.ShowHeaders);
        await InvokeVoid("setAutoScroll", _view.AutoScroll);
        await InvokeVoid("setCompareToKnown", _view.CompareToKnown);
        await InvokeVoid("setDefaultFormat", _view.DefaultFormat);
        StateHasChanged();
    }

    void PushNotice(CaptureEvent ev) {
        var severity = NoticeSeverity(ev.Kind);
        _notices.Insert(0, new NoticeItem(_nextNoticeId++, severity, ev.Message, ev.Timestamp));
        if (_notices.Count > 200) _notices.RemoveRange(200, _notices.Count - 200);
        _unread++;

        var toast = new ToastItem(_nextToastId++, severity, ev.Message, ev.Timestamp);
        _toasts.Add(toast);
        _ = AutoDismissToast(toast.Id, _loopCts?.Token ?? CancellationToken.None);
    }

    static string NoticeSeverity(string kind) {
        return kind switch {
            "decryptError" => "error",
            "certTrusted" => "ok",
            _ => "info"
        };
    }

    async Task AutoDismissToast(int id, CancellationToken ct) {
        try {
            await Task.Delay(5000, ct);
        }
        catch (OperationCanceledException) {
            return;
        }

        await InvokeAsync(() => {
            RemoveToast(id);
            StateHasChanged();
        });
    }

    void RemoveToast(int id) {
        _toasts.RemoveAll(t => t.Id == id);
    }

    void DismissNotice(int id) {
        _notices.RemoveAll(n => n.Id == id);
    }

    void ClearNotices() {
        _notices.Clear();
        _unread = 0;
    }

    void MarkNoticesRead() {
        _unread = 0;
    }

    async Task<T> InvokeOr<T>(string fn, T fallback) {
        if (_store is null) return fallback;
        try {
            return await _store.InvokeAsync<T>(fn);
        }
        catch {
            return fallback;
        }
    }

    async Task InvokeVoid(string fn, params object?[] args) {
        if (_store is null) return;
        try {
            await _store.InvokeVoidAsync(fn, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "capture store call {Function} failed", fn);
        }
    }


    public async ValueTask DisposeAsync() {
        _loopCts?.Cancel();
        _subscription?.Dispose();
        if (_loopTask is not null) {
            try {
                await _loopTask;
            }
            catch (Exception ex) {
                Logger.LogDebug(ex, "capture event loop ended with an exception");
            }
        }

        _loopCts?.Dispose();
        await _store.DisposeModuleQuietAsync(logger: Logger);
    }

    sealed record ToastItem(int Id, string Severity, string Message, string Timestamp);

}
