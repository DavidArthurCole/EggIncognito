@page "/account"
@rendermode @(RenderMode.InteractiveServer)
@inject AuthState Auth
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@using EggIncognito.Components.Shared
@using SyncKit.Identity.AdminUi

<PageTitle>Account - EggIncognito</PageTitle>
<main class="px-8 pt-6 pb-16 max-w-[860px]">
  <h1 class="text-[1.3rem] mt-0 mb-4">Account</h1>
  @if (_linkMessage is not null) {
    <div class="panel mb-4 @(_linkOk ? "text-ok" : "text-err")">@_linkMessage</div>
  }
  @if (!Auth.WidgetEnabled || string.IsNullOrEmpty(_sessionToken)) {
    <div class="panel">Log in to manage your linked logins and avatar. <LoginButton CssClass="auth-btn" Label="Log in" /></div>
  } else {
    <section class="panel">
      <h2 class="text-base mt-0 mb-3">Linked logins & avatar</h2>
      <ProfilePanel SessionToken="@_sessionToken" ReturnUrl="@_returnUrl" />
    </section>
  }
</main>

@code {
    string _sessionToken = "";
    string _returnUrl = "";
    string? _linkMessage;
    bool _linkOk;
    bool _stripQuery;

    protected override void OnInitialized() {
        _sessionToken = HttpContextAccessor.HttpContext?.Request.Cookies[Auth.SessionCookieName] ?? "";
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _returnUrl = uri.GetLeftPart(UriPartial.Path);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.ContainsKey("linked")) {
            _linkMessage = "Login linked.";
            _linkOk = true;
        } else if (query.ContainsKey("linkConflict")) {
            _linkMessage = "That login already belongs to a different account, so it was not linked. Account merges go through an admin.";
        } else if (query.ContainsKey("linkError")) {
            _linkMessage = "Linking failed. Try again.";
        }
        _stripQuery = _linkMessage is not null;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender && _stripQuery) {
            _stripQuery = false;
            Nav.NavigateTo(_returnUrl, replace: true);
        }
    }
}
