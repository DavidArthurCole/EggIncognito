@using EggIncognito.Models.Registry
@* Inline metadata editor for one registry release (contributor+). A release is one or more platform rows;
   the dialog shows an editable section per platform member and PATCHes each. *@

@if (Targets is { Count: > 0 }) {
    <div class="panel mb-3">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm m-0">Edit <span class="font-mono">@_appVersion</span></h3>
            <button type="button" class="btn-mini" @onclick="@(() => OnClose.InvokeAsync())">Close</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2">
            <label class="text-xs text-muted block">
                App version
                <input class="protos-filter w-full" @bind="_appVersion"/>
            </label>
            @if (CanOrder && !string.IsNullOrEmpty(ProtoSha)) {
                <label class="text-xs text-muted block">
                    Sort order (proto sha @Short(ProtoSha), higher sorts newer)
                    <input class="protos-filter w-full" type="number" @bind="_order"/>
                </label>
            }
        </div>

        @foreach (var f in _fields) {
            <div class="border-t border-border pt-2 mb-2">
                <div class="text-xs font-semibold mb-1 flex items-center gap-1.5">
                    <span class="code-chip">@f.Platform</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <label class="text-xs text-muted">
                        Build (row key)
                        <input class="protos-filter w-full" @bind="f.Build"/>
                    </label>
                    <label class="text-xs text-muted">
                        Client version
                        <input class="protos-filter w-full" @bind="f.ClientVersion"/>
                    </label>
                    <label class="text-xs text-muted">
                        Source
                        <input class="protos-filter w-full" @bind="f.Source"/>
                    </label>
                </div>
                <div class="mt-2">
                    @if (!f.ProtoOpen) {
                        <button type="button" class="btn-mini" disabled="@f.ProtoBusy" @onclick="@(() => OpenProto(f))">Edit proto</button>
                    } else {
                        <label class="text-xs text-muted block">
                            Proto
                            <textarea class="protos-filter w-full font-mono text-xs" rows="8" @bind="f.Proto"></textarea>
                        </label>
                        <div class="flex items-center gap-2 mt-1">
                            <button type="button" class="btn-primary" disabled="@f.ProtoBusy" @onclick="@(() => SaveProto(f))">@(f.ProtoBusy ? "Saving..." : "Save proto")</button>
                            <button type="button" class="btn-mini" @onclick="@(() => f.ProtoOpen = false)">Cancel</button>
                            <span class="text-xs @(f.ProtoMsg == "saved" ? "text-accent" : "text-muted")">@f.ProtoMsg</span>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="flex items-center gap-2">
            <button type="button" class="btn-primary" disabled="@_busy" @onclick="Save">@(_busy ? "Saving..." : "Save")</button>
            <span class="text-xs @(_msg == "saved" ? "text-accent" : "text-muted")">@_msg</span>
        </div>
    </div>
}

@code {

    [Parameter] public IReadOnlyList<ReleaseEditRow>? Targets { get; set; }
    [Parameter] public string? ProtoSha { get; set; }
    [Parameter] public int ShaOrder { get; set; }
    [Parameter] public bool CanOrder { get; set; }
    [Parameter] public Func<string, object, Task<bool>> Patch { get; set; } = (_, _) => Task.FromResult(false);
    [Parameter] public Func<string, object, Task<bool>> Post { get; set; } = (_, _) => Task.FromResult(false);
    [Parameter] public Func<string, Task<string?>> FetchText { get; set; } = _ => Task.FromResult<string?>("");
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    bool _busy;
    string _msg = "";
    string _appVersion = "";
    int _order;
    List<MemberField> _fields = [];

    static string Short(string? sha) {
        return string.IsNullOrEmpty(sha) ? "" : sha.Length <= 12 ? sha : sha[..12];
    }

    protected override void OnParametersSet() {
        if (Targets is not { Count: > 0 }) return;
        _appVersion = Targets[0].AppVersion;
        _order = ShaOrder;
        _fields = Targets.Select(t => new MemberField {
            Platform = t.Platform,
            OriginalBuild = t.Build,
            Build = t.Build,
            ClientVersion = t.ClientVersion ?? "",
            Source = t.Source
        }).ToList();
        _msg = "";
    }

    async Task Save() {
        if (_fields.Count == 0) return;
        _busy = true;
        _msg = "";
        var allOk = true;
        foreach (var f in _fields) {
            var newBuild = string.IsNullOrWhiteSpace(f.Build) || f.Build == f.OriginalBuild ? null : f.Build.Trim();
            var body = new {
                appVersion = _appVersion,
                clientVersion = string.IsNullOrWhiteSpace(f.ClientVersion) ? null : f.ClientVersion,
                source = f.Source,
                build = newBuild
            };

            var ok = await Patch($"/api/protos/versions/{f.Platform}/{Uri.EscapeDataString(f.OriginalBuild)}", body);
            if (ok) f.OriginalBuild = f.Build;
            allOk &= ok;
        }

        if (CanOrder && !string.IsNullOrEmpty(ProtoSha) && _order != ShaOrder)
            allOk &= await Post("/api/protos/versions/sha-order", new { protoSha = ProtoSha, order = _order });

        _msg = allOk ? "saved" : "failed (build taken? contributor+?)";
        _busy = false;
        if (allOk) await OnChanged.InvokeAsync();
    }

    async Task OpenProto(MemberField f) {
        f.ProtoBusy = true;
        f.ProtoMsg = "";
        f.Proto = await FetchText($"/api/protos/versions/{f.Platform}/{Uri.EscapeDataString(f.OriginalBuild)}/proto") ?? "";
        f.ProtoOpen = true;
        f.ProtoBusy = false;
    }

    async Task SaveProto(MemberField f) {
        if (string.IsNullOrWhiteSpace(f.Proto)) {
            f.ProtoMsg = "proto required";
            return;
        }

        f.ProtoBusy = true;
        f.ProtoMsg = "";
        var ok = await Post($"/api/protos/versions/{f.Platform}/{Uri.EscapeDataString(f.OriginalBuild)}/proto",
            new { proto = f.Proto });
        f.ProtoMsg = ok ? "saved" : "failed (contributor+?)";
        f.ProtoBusy = false;
        if (ok) await OnChanged.InvokeAsync();
    }

}
