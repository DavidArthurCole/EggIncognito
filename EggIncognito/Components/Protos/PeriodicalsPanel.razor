@implements IAsyncDisposable
@using System.Globalization
@using System.Text
@using System.Text.Json
@using EggIncognito.Models.Periodicals
@using EggIncognito.Services.Assets
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<PeriodicalsPanel> Logger

<div class="pd-widgets">
    <div class="pd-wcol">
        <DeviceStatusPanel Class="pd-w-devices" OnManage="OnManageDevices"/>
        <WorkbenchesPanel Summary="_summary" OnOpenNotifications="OnOpenNotifications"
                          OnOpenApiWorkbench="OnOpenApiWorkbench"/>

        @if (_summary?.Colleggtibles is { } c) {
            <section class="panel pd-w-cegg">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold m-0">Colleggtibles</h3>
                    <a class="reg-edit-btn" href="/api/v1/data/periodical/get_periodicals/colleggtibles" download="colleggtibles.json" aria-label="Download JSON">
                        <Icon Name="download"/>
                    </a>
                </div>
                <table class="data-table cegg-table">
                    <thead>
                    <tr>
                        <th class="w-8"></th><th>Name</th><th>Dimension</th><th>Tier values</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var e in c.Eggs) {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(e.Icon)) {
                                    <img class="w-[1.875rem] h-[1.875rem] object-contain" src="@e.Icon" alt="@e.Identifier"
                                         loading="lazy" data-fallback/>
                                    <span class="text-muted text-xs" data-fallback-for style="display:none">-</span>
                                } else {
                                    <span class="text-muted text-xs">-</span>
                                }
                            </td>
                            <td class="text-accent">@EggName(e)</td>
                            <td class="text-muted text-xs">@TitleCase(e.Dimension)</td>
                            <td class="mono text-xs cegg-tier">@string.Join(", ", e.TierValues.Select(TierLabel))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </section>
        }
    </div>

    <div class="pd-wcol">
        @if (_events is { Count: > 0 }) {
            <section class="panel pd-w-events">
                <h3 class="text-sm font-semibold mt-0 mb-3">Current events</h3>
                <div class="evt-list">
                    @foreach (var e in _events) {
                        <div class="evt-row @(RemainingSeconds(e) <= 0 ? "ended" : "")">
                            @if (!string.IsNullOrEmpty(e.Icon)) {
                                <span class="evt-icon" style="@IconStyle(e)">
                                    <img src="@e.Icon" alt="" loading="lazy"/>
                                </span>
                            }
                            <span class="evt-name">@(string.IsNullOrEmpty(e.Subtitle) ? Pretty(e.Type) : e.Subtitle)</span>
                            <span class="evt-timer" data-countdown="@FormattableString.Invariant($"{e.EndTime ?? 0:0}")">@RemainingLabel(e)</span>
                        </div>
                    }
                </div>
            </section>
        }

        @if (_seasons is { Count: > 0 } seasonList) {
            var season = seasonList[Math.Clamp(_seasonIx, 0, seasonList.Count - 1)];
            var grades = season.GradeGoals.Where(g => g.Goals.Count > 0).ToList();
            <section class="panel pd-w-season">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold m-0">Seasons</h3>
                    <div class="flex items-center gap-1">
                        <button type="button" class="reg-edit-btn disabled:opacity-40 disabled:cursor-default disabled:hover:border-border"
                                disabled="@(_seasonIx >= seasonList.Count - 1)"
                                aria-label="Older season" @onclick="() => MoveSeason(1)">
                            <Icon Name="chevronLeft"/>
                        </button>
                        <button type="button" class="reg-edit-btn disabled:opacity-40 disabled:cursor-default disabled:hover:border-border"
                                disabled="@(_seasonIx <= 0)"
                                aria-label="Newer season" @onclick="() => MoveSeason(-1)">
                            <Icon Name="chevronRight"/>
                        </button>
                    </div>
                </div>
                <div class="season-head">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="bg-bg border border-border rounded overflow-hidden text-center w-14 shrink-0">
                            <div class="bg-accent text-bg text-[0.625rem] font-semibold uppercase py-0.5">@StartDate(season).ToString("MMM")</div>
                            <div class="text-lg font-semibold py-1">@StartDate(season).Day</div>
                        </div>
                        <div class="min-w-0">
                            <div class="text-sm font-semibold">@season.Name</div>
                            @if (IsActive(season)) {
                                <div class="text-muted text-xs">Next season ~@NextStartLabel(season)</div>
                                <div class="text-muted text-xs">@ContractsLeftLabel(season)</div>
                            } else {
                                <div class="text-muted text-xs">@StartLabel(season)</div>
                            }
                        </div>
                    </div>
                    @if (season.Colleggtibles is { Count: > 0 } ceggs) {
                        <div class="min-w-0">
                            <div class="text-xs font-semibold mb-1">@(ceggs.Count == 1 ? "Season Colleggtible" : "Season Colleggtibles")</div>
                            <div class="flex flex-col gap-1.5">
                                @foreach (var egg in ceggs) {
                                    <div class="flex items-center gap-2">
                                        @if (egg.Icon is not null) {
                                            <img class="season-cegg-icon" src="@egg.Icon" alt="@egg.Id" loading="lazy" data-fallback/>
                                        }
                                        <div class="min-w-0">
                                            <div class="text-xs font-medium">@TitleCase(egg.Id)</div>
                                            @if (egg.Contracts is { Count: > 0 } cnames) {
                                                <div class="text-muted text-[0.6875rem]">@string.Join(", ", cnames)</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (grades.Count > 0) {
                    var goalCount = grades.Max(g => g.Goals.Count);
                    <table class="data-table season-table" @key="season.Id">
                        <thead>
                        <tr>
                            <th class="w-12">Goal</th>
                            @foreach (var g in grades) {
                                <th>
                                    @if (!string.IsNullOrEmpty(g.GradeIcon)) {
                                        <img class="season-grade-icon" src="@g.GradeIcon" alt="@GradeLabel(g.Grade)" loading="lazy" data-fallback/>
                                        <span data-fallback-for style="display:none">@GradeLabel(g.Grade)</span>
                                    } else {
                                        @GradeLabel(g.Grade)
                                    }
                                </th>
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @for (var ix = 0; ix < goalCount; ix++) {
                            var goalIx = ix;
                            <tr>
                                <td class="mono text-xs text-muted">@(goalIx + 1)</td>
                                @foreach (var g in grades) {
                                    <td class="text-xs">
                                        @if (goalIx < g.Goals.Count) {
                                            var goal = g.Goals[goalIx];
                                            <Tooltip>
                                                <ChildContent>
                                                    <span class="season-goal">
                                                        @if (!string.IsNullOrEmpty(goal.Icon)) {
                                                            <span class="season-goal-icon">
                                                                <img src="@goal.Icon" alt="" loading="lazy" data-fallback/>
                                                            </span>
                                                        }
                                                        <span class="season-goal-text">
                                                            <span class="season-goal-cs">@FormatAmount(goal.Cxp) CS</span>
                                                            <span>@RewardLabel(goal)</span>
                                                        </span>
                                                    </span>
                                                </ChildContent>
                                                <Tip>
                                                    <span class="tt-title">@RewardFullName(goal)</span>
                                                    <span class="tt-line">@goal.RewardAmount.ToString("N0") @RewardFullNoun(goal)</span>
                                                    @if (BoostInfo(goal) is { } bi) {
                                                        @if (bi.Duration is { } bd) {
                                                            <span class="tt-line">Lasts @bd</span>
                                                        }

                                                        @if (bi.Effect is { } be) {
                                                            <span class="tt-line">@be</span>
                                                        }
                                                    }
                                                </Tip>
                                            </Tooltip>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                } else {
                    <div class="text-muted text-sm">No reward data captured for this season.</div>
                }
            </section>
        }

        @if (!_loaded) {
            <section class="panel pd-w-note text-muted text-sm">Loading…</section>
        } else if (_events is not { Count: > 0 } && _seasons is not { Count: > 0 }) {
            <section class="panel pd-w-note text-muted text-sm">No event or season data right now.</section>
        }
    </div>
</div>

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    bool _loaded;
    PeriodicalsSummary? _summary;
    List<Season>? _seasons;
    int _seasonIx;
    List<EventRow>? _events;
    IJSObjectReference? _countdown;
    IJSObjectReference? _images;

    [Parameter] public EventCallback<string?> OnManageDevices { get; set; }

    [Parameter] public EventCallback OnOpenNotifications { get; set; }

    [Parameter] public EventCallback OnOpenApiWorkbench { get; set; }

    protected override async Task OnInitializedAsync() {
        try {
            var fetched = await Client().GetFromJsonAsync<PeriodicalsSummary>("/api/periodicals/summary", JsonOpts);
            if (fetched is not null) {
                _summary = fetched;
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "the periodicals summary could not be loaded");
        }

        try {
            var cur = await Client().GetFromJsonAsync<EventsResponse>("/api/periodicals/current", JsonOpts);
            if (cur is not null) {
                _events = cur.Events;
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "the current periodicals events could not be loaded");
        }

        try {
            var seasonsRes = await Client().GetFromJsonAsync<SeasonsResponse>("/api/periodicals/seasons", JsonOpts);
            if (seasonsRes?.Seasons is { Count: > 0 } ls) {
                _seasons = ls;
                var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                var ix = ls.FindIndex(s => s.StartTime <= now);
                _seasonIx = ix < 0 ? 0 : ix;
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "the periodicals season list could not be loaded");
        }

        await LoadBoostCatalog();
        _loaded = true;
    }

    void MoveSeason(int delta) {
        if (_seasons is null) return;
        _seasonIx = Math.Clamp(_seasonIx + delta, 0, _seasons.Count - 1);
    }

    static DateTimeOffset StartDate(Season s) {
        return DateTimeOffset.FromUnixTimeSeconds((long)s.StartTime);
    }

    static string StartLabel(Season s) {
        var d = StartDate(s);
        var verb = d <= DateTimeOffset.UtcNow ? "Started" : "Starts";
        var derived = s.StartDerived ? " (derived)" : "";
        return $"{verb} {d.ToString("MMMM d, yyyy")}{derived}";
    }

    static bool IsActive(Season s) {
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        return s.StartTime <= now && now < s.NextStartTime;
    }

    static string NextStartLabel(Season s) {
        return DateTimeOffset.FromUnixTimeSeconds((long)s.NextStartTime).ToLocalTime().ToString("MMMM d");
    }

    static string ContractsLeftLabel(Season s) {
        var nextLocal = DateTimeOffset.FromUnixTimeSeconds((long)s.NextStartTime).ToLocalTime();
        var mondays = MondaysBetween(DateTimeOffset.UtcNow.ToLocalTime(), nextLocal);
        return $"{mondays} {(mondays == 1 ? "contract" : "contracts")} left";
    }

    static int MondaysBetween(DateTimeOffset nowLocal, DateTimeOffset endLocal) {
        var count = 0;
        for (var d = nowLocal.Date.AddDays(1); d < endLocal.Date; d = d.AddDays(1)) {
            if (d.DayOfWeek == DayOfWeek.Monday) count++;
        }

        return count;
    }

    static string GradeLabel(string grade) {
        if (grade.StartsWith("GRADE_", StringComparison.Ordinal)) return grade["GRADE_".Length..];
        if (grade.StartsWith("Grade", StringComparison.Ordinal)) return grade["Grade".Length..].ToUpperInvariant();
        return grade;
    }

    static string FormatAmount(double n) {
        if (n >= 1e9) return (n / 1e9).ToString("0.##") + "B";
        if (n >= 1e6) return (n / 1e6).ToString("0.##") + "M";
        if (n >= 1e3) return (n / 1e3).ToString("0.##") + "K";
        return n.ToString("N0");
    }

    static string RewardName(string rewardType, string? subType, bool plural) {
        return rewardType switch {
            "Gold" => "GE",
            "SoulEggs" => plural ? "Soul Eggs" : "Soul Egg",
            "EggsOfProphecy" => "PE",
            "ShellScript" => "Tickets",
            "PiggyMultiplier" => plural ? "Piggy Multipliers" : "Piggy Multiplier",
            "PiggyLevelBump" => plural ? "Piggy Level Bumps" : "Piggy Level Bump",
            "Boost" => Pretty(subType ?? ""),
            "EpicResearchItem" => Pretty(subType ?? ""),
            "BoostToken" => plural ? "Boost Tokens" : "Boost Token",
            "Artifact" => plural ? "Artifacts" : "Artifact",
            "ArtifactCase" => "Artifacts",
            "Chicken" => plural ? "Chicken Boxes" : "Chicken Box",
            "VirtueGem" => plural ? "Virtue Gems" : "Virtue Gem",
            "Cash" => "Cash",
            _ => Pretty(rewardType)
        };
    }

    readonly Dictionary<string, BoostMeta> _boosts = new(StringComparer.Ordinal);

    BoostMeta? BoostInfo(GoalRow g) {
        if (g.RewardType != "Boost" || string.IsNullOrEmpty(g.RewardSubType)) return null;
        if (_boosts.TryGetValue(g.RewardSubType, out var meta)) return meta;
        var bare = g.RewardSubType.EndsWith("_v2", StringComparison.Ordinal)
            ? g.RewardSubType[..^3]
            : g.RewardSubType;
        return _boosts.GetValueOrDefault(bare);
    }

    static string FormatDuration(double seconds) {
        if (seconds >= 3600) return $"{seconds / 3600:0.#}h";
        if (seconds >= 60) return $"{seconds / 60:0.#}m";
        return $"{seconds:0}s";
    }

    async Task LoadBoostCatalog() {
        try {
            var res = await Client().GetAsync("/api/v1/data/gamedata/boost-catalog");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (!doc.RootElement.TryGetProperty("boosts", out var arr)) return;
            foreach (var b in arr.EnumerateArray()) {
                var id = b.TryGetProperty("id", out var idEl) ? idEl.GetString() : null;
                if (string.IsNullOrEmpty(id)) continue;
                var dn = b.TryGetProperty("displayName", out var dnEl) ? dnEl.GetString() : null;
                var dur = b.TryGetProperty("durationSeconds", out var duEl)
                          && duEl.TryGetDouble(out var ds) && ds > 0
                    ? FormatDuration(ds)
                    : null;
                string? eff = null;
                if (b.TryGetProperty("magnitude", out var mgEl) && mgEl.TryGetDouble(out var mg) && mg > 0) {
                    var tgt = b.TryGetProperty("target", out var tEl) ? tEl.GetString() ?? "" : "";
                    eff = tgt.Length > 0
                        ? $"{FormatAmount(mg)}x {Pretty(tgt.StartsWith("bd-", StringComparison.Ordinal) ? tgt[3..] : tgt)}"
                        : $"{FormatAmount(mg)}x";
                }

                _boosts[id] = new BoostMeta(string.IsNullOrEmpty(dn) ? TitleCase(id) : dn, dur, eff);
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "the boost catalog could not be loaded");
        }
    }

    string RewardFullName(GoalRow g) {
        return g.RewardType switch {
            "Gold" => "Golden Eggs",
            "EggsOfProphecy" => "Eggs of Prophecy",
            "ShellScript" => "Shell Tickets",
            "PiggyFill" => "Piggy Fill",
            "ArtifactCase" => "Artifacts",
            "Boost" => TitleCase(BoostInfo(g)?.DisplayName ?? Pretty(g.RewardSubType)),
            "EpicResearchItem" => Pretty(g.RewardSubType),
            _ => RewardName(g.RewardType, g.RewardSubType, true)
        };
    }

    static string RewardFullNoun(GoalRow g) {
        var one = g.RewardAmount == 1;
        return g.RewardType switch {
            "Gold" => one ? "golden egg" : "golden eggs",
            "EggsOfProphecy" => one ? "egg of prophecy" : "eggs of prophecy",
            "ShellScript" => one ? "shell ticket" : "shell tickets",
            "PiggyFill" => "added to the piggy bank",
            "ArtifactCase" => one ? "artifact" : "artifacts",
            "Boost" => one ? "boost" : "boosts",
            "EpicResearchItem" => one ? "level" : "levels",
            "BoostToken" => one ? "boost token" : "boost tokens",
            "SoulEggs" => one ? "soul egg" : "soul eggs",
            "VirtueGem" => one ? "virtue gem" : "virtue gems",
            "Chicken" => one ? "chicken box" : "chicken boxes",
            _ => ""
        };
    }

    static string RewardLabel(GoalRow g) {
        if (g.RewardType == "PiggyFill") return $"+{FormatAmount(g.RewardAmount)} Piggy";
        return $"{FormatAmount(g.RewardAmount)} {RewardName(g.RewardType, g.RewardSubType, g.RewardAmount != 1)}";
    }

    static string TitleCase(string raw) {
        return string.Join(' ', raw.Split([' ', '_', '-'], StringSplitOptions.RemoveEmptyEntries)
            .Select(w => char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant()));
    }

    static string EggName(EggRow e) {
        return string.IsNullOrWhiteSpace(e.Name) ? TitleCase(e.Identifier) : e.Name;
    }

    static string TierLabel(double value) {
        var magnitude = Math.Abs(value - 1) * 100;
        var digits = magnitude >= 10 ? "0.#" : "0.##";
        return $"{(value < 1 ? "-" : "+")}{magnitude.ToString(digits, CultureInfo.InvariantCulture)}%";
    }

    static string Pretty(string raw) {
        var words = raw.Replace('-', '_').Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length > 1 || raw.Contains('_')) {
            return string.Join(' ', words.Select(w => w.Length > 0 ? char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant() : w));
        }

        var sb = new StringBuilder();
        foreach (var ch in raw) {
            if (char.IsUpper(ch) && sb.Length > 0) sb.Append(' ');
            sb.Append(ch);
        }

        return sb.ToString();
    }

    static string IconStyle(EventRow e) {
        if (e.CcOnly) {
            return $"background:linear-gradient(90deg,{EventPalette.CcGradientFrom},{EventPalette.CcGradientTo})";
        }

        return $"background:{EventPalette.ColorFor(e.Type)}";
    }

    static double RemainingSeconds(EventRow e) {
        if (e.EndTime is not { } end || end <= 0) return 0;
        return end - DateTimeOffset.UtcNow.ToUnixTimeSeconds();
    }

    static string RemainingLabel(EventRow e) {
        var s = RemainingSeconds(e);
        if (s <= 0) return "Ended";
        var t = TimeSpan.FromSeconds(s);
        return $"{(int)t.TotalHours:00}:{t.Minutes:00}:{t.Seconds:00}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender && _images is null) {
            _images = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/imgFallback.js"));
            await _images.InvokeVoidAsync("wire");
        }

        if (_countdown is not null || _events is not { Count: > 0 }) return;
        _countdown = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/countdown.js"));
        await _countdown.InvokeVoidAsync("start");
    }

    public async ValueTask DisposeAsync() {
        await _countdown.DisposeModuleAsync("stop", Logger);
        await _images.DisposeModuleAsync("unwire", Logger);
    }

}
