@using System.Text
@using System.Text.Json
@using EggIncognito.Components.Capture
@implements IAsyncDisposable
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS

@if (!_loaded) {
    <div class="panel text-muted text-sm">Loading…</div>
} else if (_summary is null && _catalog is null) {
    <div class="panel text-muted text-sm">No data available right now.</div>
} else {
    <div class="flex flex-col gap-6">
        @if (_events is { Count: > 0 }) {
            <section class="panel">
                <h3 class="text-sm font-semibold mt-0 mb-3">Current events</h3>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var e in _events) {
                        <span class="event-pill @(RemainingSeconds(e) <= 0 ? "ended" : "")">
                            @if (!string.IsNullOrEmpty(e.Icon)) {
                                <span class="event-icon" style="@IconStyle(e)">
                                    <img src="@e.Icon" alt="" loading="lazy"/>
                                </span>
                            }
                            <span class="event-name">@(string.IsNullOrEmpty(e.Subtitle) ? Pretty(e.Type) : e.Subtitle)</span>
                            <span class="event-timer" data-countdown="@FormattableString.Invariant($"{e.EndTime ?? 0:0}")">@RemainingLabel(e)</span>
                        </span>
                    }
                </div>
            </section>
        }

        @if (_catalog is not null) {
            <section class="panel">
                <h3 class="text-sm font-semibold mt-0 mb-3">Data</h3>
                <div class="ds-groups">
                    @foreach (var grp in Groups) {
                        var rows = _catalog.Sources.Where(s => s.Group == grp.Key).ToList();
                        if (rows.Count == 0) {
                            continue;
                        }

                        <div>
                            <div class="ds-section-label">@grp.Label</div>
                            <div class="ds-list">
                                @foreach (var s in rows) {
                                    <div class="ds-item">
                                        <PeriodicalDataset Title="@s.DisplayName" Endpoint="@s.Url"
                                                           DownloadName="@($"{s.Id}.json")" Fetch="Fetch" View="_view" FormatChoice="_fc">
                                            <Badges>
                                                @if (s.Bytes is { } b) {
                                                    <span class="mono text-muted text-xs">@Kb(b)</span>
                                                }
                                                @if (s.Meta is { } m && !string.IsNullOrEmpty(m.BinaryVersion)) {
                                                    <span class="ds-meta-chip">v@(m.BinaryVersion)</span>
                                                } else if (s.Meta?.Provenance is not null) {
                                                    <span class="ds-meta-chip">prov</span>
                                                }
                                            </Badges>
                                        </PeriodicalDataset>
                                        @if (s.Children is { Count: > 0 }) {
                                            <SubDatasetChips Items="ChipsOf(s)" Fetch="Fetch" View="_view" FormatChoice="_fc"/>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        @if (_seasons is { Count: > 0 } seasonList) {
            var season = seasonList[Math.Clamp(_seasonIx, 0, seasonList.Count - 1)];
            var grades = season.GradeGoals.Where(g => g.Goals.Count > 0).ToList();
            <section class="panel panel-hcards">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold m-0">Seasons</h3>
                    <div class="flex items-center gap-1">
                        <button type="button" class="reg-edit-btn disabled:opacity-40 disabled:cursor-default disabled:hover:border-border"
                                disabled="@(_seasonIx >= seasonList.Count - 1)"
                                title="Older season" aria-label="Older season" @onclick="() => MoveSeason(1)">
                            <Icon Name="chevronLeft"/>
                        </button>
                        <button type="button" class="reg-edit-btn disabled:opacity-40 disabled:cursor-default disabled:hover:border-border"
                                disabled="@(_seasonIx <= 0)"
                                title="Newer season" aria-label="Newer season" @onclick="() => MoveSeason(-1)">
                            <Icon Name="chevronRight"/>
                        </button>
                    </div>
                </div>
                <div class="flex items-start gap-10 mb-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="bg-bg border border-border rounded overflow-hidden text-center w-14 shrink-0">
                            <div class="bg-accent text-bg text-[10px] font-semibold uppercase py-0.5">@StartDate(season).ToString("MMM")</div>
                            <div class="text-lg font-semibold py-1">@StartDate(season).Day</div>
                        </div>
                        <div class="min-w-0">
                            <div class="text-sm font-semibold">@season.Name</div>
                            @if (IsActive(season)) {
                                <div class="text-muted text-xs">Next season ~@NextStartLabel(season)</div>
                                <div class="text-muted text-xs">@ContractsLeftLabel(season)</div>
                            } else {
                                <div class="text-muted text-xs">@StartLabel(season)</div>
                            }
                        </div>
                    </div>
                    @if (season.Colleggtibles is { Count: > 0 } ceggs) {
                        <div class="shrink-0">
                            <div class="text-xs font-semibold mb-1">@(ceggs.Count == 1 ? "Season Colleggtible" : "Season Colleggtibles")</div>
                            <div class="flex flex-col gap-1.5">
                                @foreach (var egg in ceggs) {
                                    <div class="flex items-center gap-2">
                                        @if (egg.Icon is not null) {
                                            <img src="@egg.Icon" alt="@egg.Id" loading="lazy" style="width:40px;height:40px;object-fit:contain"/>
                                        }
                                        <div class="min-w-0">
                                            <div class="text-xs font-medium">@TitleCase(egg.Id)</div>
                                            @if (egg.Contracts is { Count: > 0 } cnames) {
                                                <div class="text-muted text-[11px]">@string.Join(", ", cnames)</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (grades.Count > 0) {
                    var goalCount = grades.Max(g => g.Goals.Count);
                    <table class="data-table season-table" @key="season.Id">
                        <thead>
                        <tr>
                            <th class="w-12">Goal</th>
                            @foreach (var g in grades) {
                                <th>
                                    @if (!string.IsNullOrEmpty(g.GradeIcon)) {
                                        <img src="@g.GradeIcon" alt="@GradeLabel(g.Grade)" style="width:28px;height:28px;object-fit:contain" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"/>
                                        <span style="display:none">@GradeLabel(g.Grade)</span>
                                    } else {
                                        @GradeLabel(g.Grade)
                                    }
                                </th>
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @for (var ix = 0; ix < goalCount; ix++) {
                            var goalIx = ix;
                            <tr>
                                <td class="mono text-xs text-muted">@(goalIx + 1)</td>
                                @foreach (var g in grades) {
                                    <td class="text-xs">
                                        @if (goalIx < g.Goals.Count) {
                                            var goal = g.Goals[goalIx];
                                            <div class="mono text-muted text-center">@FormatAmount(goal.Cxp) CS</div>
                                            <span class="hcard-wrap">
                                                <span class="flex items-center gap-1.5">
                                                    @if (!string.IsNullOrEmpty(goal.Icon)) {
                                                        <img src="@goal.Icon" alt="" style="width:18px;height:18px;object-fit:contain" loading="lazy" onerror="this.style.display='none'"/>
                                                    }
                                                    @RewardLabel(goal)
                                                </span>
                                                <span class="hcard">
                                                    <span class="hcard-title">@RewardFullName(goal)</span>
                                                    <span class="hcard-line">@goal.RewardAmount.ToString("N0") @RewardFullNoun(goal)</span>
                                                    @if (BoostInfo(goal) is { } bi) {
                                                        @if (bi.Duration is { } bd) {
                                                            <span class="hcard-line">Lasts @bd</span>
                                                        }

                                                        @if (bi.Effect is { } be) {
                                                            <span class="hcard-line">@be</span>
                                                        }
                                                    }
                                                </span>
                                            </span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                } else {
                    <div class="text-muted text-sm">No reward data captured for this season.</div>
                }
            </section>
        }

        @if (_summary?.Colleggtibles is { } c) {
            <section class="panel">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold m-0">Colleggtibles</h3>
                    <a class="reg-edit-btn" href="/api/v1/data/periodical/get_periodicals/colleggtibles" download="colleggtibles.json" title="Download JSON" aria-label="Download JSON">
                        <Icon Name="download"/>
                    </a>
                </div>
                <table class="data-table">
                    <thead>
                    <tr>
                        <th class="w-8"></th><th>Identifier</th><th>Dimension</th><th>Tier values</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var e in c.Eggs) {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(e.Icon)) {
                                    <img class="w-[1.875rem] h-[1.875rem] object-contain" src="@e.Icon" alt="" loading="lazy"/>
                                }
                            </td>
                            <td class="font-mono text-accent">@e.Identifier</td>
                            <td class="mono text-muted text-xs">@e.Dimension</td>
                            <td class="mono text-xs">@string.Join(", ", e.TierValues)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </section>
        }

        @if (_catalogError is not null) {
            <div class="panel text-err text-sm">Could not load the source catalog: @_catalogError</div>
        }
    </div>
}

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    bool _loaded;
    Summary? _summary;
    DataResponse? _catalog;
    string? _catalogError;
    List<Season>? _seasons;
    int _seasonIx;
    List<EventRow>? _events;
    IJSObjectReference? _countdown;
    readonly CaptureViewState _view = new();
    readonly Dictionary<string, string> _fc = new();
    string _baseAddress = "";
    string? _cookie;

    static readonly (string Key, string Label)[] Groups = [
        ("periodical", "Periodical"),
        ("gamedata", "Game data")
    ];

    protected override async Task OnInitializedAsync() {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null) {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }

        try {
            var fetched = await Client().GetFromJsonAsync<Summary>("/api/periodicals/summary", JsonOpts);
            if (fetched is not null) {
                _summary = fetched;
            }
        }
        catch {
        }

        try {
            var cur = await Client().GetFromJsonAsync<EventsResponse>("/api/periodicals/current", JsonOpts);
            if (cur is not null) {
                _events = cur.Events;
            }
        }
        catch {
        }

        try {
            var seasonsRes = await Client().GetFromJsonAsync<SeasonsResponse>("/api/periodicals/seasons", JsonOpts);
            if (seasonsRes?.Seasons is { Count: > 0 } ls) {
                _seasons = ls;
                var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                var ix = ls.FindIndex(s => s.StartTime <= now);
                _seasonIx = ix < 0 ? 0 : ix;
            }
        }
        catch {
        }

        await LoadBoostCatalog();

        try {
            var res = await Client().GetAsync("/api/v1/data");
            if (res.IsSuccessStatusCode) {
                var cat = await res.Content.ReadFromJsonAsync<DataResponse>(JsonOpts);
                if (cat is not null) {
                    _catalog = cat;
                    _catalogError = null;
                }
            } else {
                _catalogError = $"HTTP {(int)res.StatusCode}";
            }
        }
        catch (Exception ex) {
            _catalogError = ex.Message;
        }
        finally {
            _loaded = true;
        }
    }

    HttpClient Client() {
        return SelfCallClient.Create(HttpFactory, _baseAddress, _cookie);
    }

    async Task<string> Fetch(string route) {
        try {
            var res = await Client().GetAsync(route);
            var body = await res.Content.ReadAsStringAsync();
            if (res.IsSuccessStatusCode) return body;
            var isJson = res.Content.Headers.ContentType?.MediaType?.Contains("json", StringComparison.OrdinalIgnoreCase) == true;
            return isJson && !string.IsNullOrWhiteSpace(body) ? body : $"HTTP {(int)res.StatusCode}: {body}";
        }
        catch (Exception ex) {
            return ex.Message;
        }
    }

    static string Kb(long bytes) {
        if (bytes < 1024) return $"{bytes}B";
        var kb = bytes / 1024;
        return kb >= 1000 ? $"{kb / 1000}MB" : $"{kb}KB";
    }

    static List<SubDatasetChips.SubDataset> ChipsOf(Source s) {
        return (s.Children ?? []).Select(k => new SubDatasetChips.SubDataset(k.DisplayName, k.Url, $"{k.Id}.json", k.Bytes, VersionOf(k))).ToList();
    }

    static string? VersionOf(Source k) {
        return k.Meta is { } m && !string.IsNullOrEmpty(m.BinaryVersion) ? m.BinaryVersion : null;
    }

    void MoveSeason(int delta) {
        if (_seasons is null) return;
        _seasonIx = Math.Clamp(_seasonIx + delta, 0, _seasons.Count - 1);
    }

    static DateTimeOffset StartDate(Season s) {
        return DateTimeOffset.FromUnixTimeSeconds((long)s.StartTime);
    }

    static string StartLabel(Season s) {
        var d = StartDate(s);
        var verb = d <= DateTimeOffset.UtcNow ? "Started" : "Starts";
        var derived = s.StartDerived ? " (derived)" : "";
        return $"{verb} {d.ToString("MMMM d, yyyy")}{derived}";
    }

    static bool IsActive(Season s) {
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        return s.StartTime <= now && now < s.NextStartTime;
    }

    static string NextStartLabel(Season s) {
        return DateTimeOffset.FromUnixTimeSeconds((long)s.NextStartTime).ToLocalTime().ToString("MMMM d");
    }

    static string ContractsLeftLabel(Season s) {
        var nextLocal = DateTimeOffset.FromUnixTimeSeconds((long)s.NextStartTime).ToLocalTime();
        var mondays = MondaysBetween(DateTimeOffset.UtcNow.ToLocalTime(), nextLocal);
        return $"{mondays} {(mondays == 1 ? "contract" : "contracts")} left";
    }

    static int MondaysBetween(DateTimeOffset nowLocal, DateTimeOffset endLocal) {
        var count = 0;
        for (var d = nowLocal.Date.AddDays(1); d < endLocal.Date; d = d.AddDays(1)) {
            if (d.DayOfWeek == DayOfWeek.Monday) count++;
        }

        return count;
    }

    static string GradeLabel(string grade) {
        if (grade.StartsWith("GRADE_", StringComparison.Ordinal)) return grade["GRADE_".Length..];
        if (grade.StartsWith("Grade", StringComparison.Ordinal)) return grade["Grade".Length..].ToUpperInvariant();
        return grade;
    }

    static string FormatAmount(double n) {
        if (n >= 1e9) return (n / 1e9).ToString("0.##") + "B";
        if (n >= 1e6) return (n / 1e6).ToString("0.##") + "M";
        if (n >= 1e3) return (n / 1e3).ToString("0.##") + "K";
        return n.ToString("N0");
    }

    static string RewardName(string rewardType, string? subType, bool plural) {
        return rewardType switch {
            "Gold" => "GE",
            "SoulEggs" => plural ? "Soul Eggs" : "Soul Egg",
            "EggsOfProphecy" => "PE",
            "ShellScript" => "Tickets",
            "PiggyMultiplier" => plural ? "Piggy Multipliers" : "Piggy Multiplier",
            "PiggyLevelBump" => plural ? "Piggy Level Bumps" : "Piggy Level Bump",
            "Boost" => Pretty(subType ?? ""),
            "EpicResearchItem" => Pretty(subType ?? ""),
            "BoostToken" => plural ? "Boost Tokens" : "Boost Token",
            "Artifact" => plural ? "Artifacts" : "Artifact",
            "ArtifactCase" => "Artifacts",
            "Chicken" => plural ? "Chicken Boxes" : "Chicken Box",
            "VirtueGem" => plural ? "Virtue Gems" : "Virtue Gem",
            "Cash" => "Cash",
            _ => Pretty(rewardType)
        };
    }

    sealed record BoostMeta(string DisplayName, string? Duration, string? Effect);

    readonly Dictionary<string, BoostMeta> _boosts = new(StringComparer.Ordinal);

    BoostMeta? BoostInfo(GoalRow g) {
        if (g.RewardType != "Boost" || string.IsNullOrEmpty(g.RewardSubType)) return null;
        if (_boosts.TryGetValue(g.RewardSubType, out var meta)) return meta;
        var bare = g.RewardSubType.EndsWith("_v2", StringComparison.Ordinal)
            ? g.RewardSubType[..^3]
            : g.RewardSubType;
        return _boosts.GetValueOrDefault(bare);
    }

    static string FormatDuration(double seconds) {
        if (seconds >= 3600) return $"{seconds / 3600:0.#}h";
        if (seconds >= 60) return $"{seconds / 60:0.#}m";
        return $"{seconds:0}s";
    }

    async Task LoadBoostCatalog() {
        try {
            var res = await Client().GetAsync("/api/v1/data/gamedata/boost-catalog");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (!doc.RootElement.TryGetProperty("boosts", out var arr)) return;
            foreach (var b in arr.EnumerateArray()) {
                var id = b.TryGetProperty("id", out var idEl) ? idEl.GetString() : null;
                if (string.IsNullOrEmpty(id)) continue;
                var dn = b.TryGetProperty("displayName", out var dnEl) ? dnEl.GetString() : null;
                var dur = b.TryGetProperty("durationSeconds", out var duEl)
                          && duEl.TryGetDouble(out var ds) && ds > 0
                    ? FormatDuration(ds)
                    : null;
                string? eff = null;
                if (b.TryGetProperty("magnitude", out var mgEl) && mgEl.TryGetDouble(out var mg) && mg > 0) {
                    var tgt = b.TryGetProperty("target", out var tEl) ? tEl.GetString() ?? "" : "";
                    eff = tgt.Length > 0
                        ? $"{FormatAmount(mg)}x {Pretty(tgt.StartsWith("bd-", StringComparison.Ordinal) ? tgt[3..] : tgt)}"
                        : $"{FormatAmount(mg)}x";
                }

                _boosts[id] = new BoostMeta(string.IsNullOrEmpty(dn) ? TitleCase(id) : dn, dur, eff);
            }
        }
        catch {
        }
    }

    string RewardFullName(GoalRow g) {
        return g.RewardType switch {
            "Gold" => "Golden Eggs",
            "EggsOfProphecy" => "Eggs of Prophecy",
            "ShellScript" => "Shell Tickets",
            "PiggyFill" => "Piggy Fill",
            "ArtifactCase" => "Artifact Case",
            "Boost" => BoostInfo(g)?.DisplayName ?? Pretty(g.RewardSubType),
            "EpicResearchItem" => Pretty(g.RewardSubType),
            _ => RewardName(g.RewardType, g.RewardSubType, true)
        };
    }

    static string RewardFullNoun(GoalRow g) {
        var one = g.RewardAmount == 1;
        return g.RewardType switch {
            "Gold" => one ? "golden egg" : "golden eggs",
            "EggsOfProphecy" => one ? "egg of prophecy" : "eggs of prophecy",
            "ShellScript" => one ? "shell ticket" : "shell tickets",
            "PiggyFill" => "added to the piggy bank",
            "ArtifactCase" => one ? "artifact case" : "artifact cases",
            "Boost" => one ? "boost" : "boosts",
            "EpicResearchItem" => one ? "level" : "levels",
            "BoostToken" => one ? "boost token" : "boost tokens",
            "SoulEggs" => one ? "soul egg" : "soul eggs",
            "VirtueGem" => one ? "virtue gem" : "virtue gems",
            "Chicken" => one ? "chicken box" : "chicken boxes",
            _ => ""
        };
    }

    static string RewardLabel(GoalRow g) {
        if (g.RewardType == "PiggyFill") return $"+{FormatAmount(g.RewardAmount)} Piggy";
        return $"{FormatAmount(g.RewardAmount)} {RewardName(g.RewardType, g.RewardSubType, g.RewardAmount != 1)}";
    }

    static string TitleCase(string raw) {
        return string.Join(' ', raw.Split([' ', '_', '-'], StringSplitOptions.RemoveEmptyEntries)
            .Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
    }

    static string Pretty(string raw) {
        var words = raw.Replace('-', '_').Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length > 1 || raw.Contains('_')) {
            return string.Join(' ', words.Select(w => w.Length > 0 ? char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant() : w));
        }

        var sb = new StringBuilder();
        foreach (var ch in raw) {
            if (char.IsUpper(ch) && sb.Length > 0) sb.Append(' ');
            sb.Append(ch);
        }

        return sb.ToString();
    }

    static readonly Dictionary<string, string> EventColors = new(StringComparer.OrdinalIgnoreCase) {
        ["epic-research-sale"] = "#ef4444",
        ["piggy-boost"] = "#f97316",
        ["piggy-cap-boost"] = "#f59e0b",
        ["prestige-boost"] = "#f59e0b",
        ["earnings-boost"] = "#84cc16",
        ["gift-boost"] = "#10b981",
        ["drone-boost"] = "#10b981",
        ["research-sale"] = "#14b8a6",
        ["hab-sale"] = "#06b6d4",
        ["vehicle-sale"] = "#0ea5e9",
        ["boost-sale"] = "#3b82f6",
        ["boost-duration"] = "#6366f1",
        ["crafting-sale"] = "#8b5cf6",
        ["mission-fuel"] = "#8b5cf6",
        ["mission-capacity"] = "#d946ef",
        ["mission-duration"] = "#ec4899",
        ["shell-sale"] = "#f43f5e"
    };

    static string IconStyle(EventRow e) {
        if (e.CcOnly) return "background:linear-gradient(90deg,#f5a709,#900fb1)";
        return $"background:{EventColors.GetValueOrDefault(e.Type, "#9ca3af")}";
    }

    static double RemainingSeconds(EventRow e) {
        if (e.EndTime is not { } end || end <= 0) return 0;
        return end - DateTimeOffset.UtcNow.ToUnixTimeSeconds();
    }

    static string RemainingLabel(EventRow e) {
        var s = RemainingSeconds(e);
        if (s <= 0) return "Ended";
        var t = TimeSpan.FromSeconds(s);
        return $"{(int)t.TotalHours:00}:{t.Minutes:00}:{t.Seconds:00}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_countdown is not null || _events is not { Count: > 0 }) return;
        _countdown = await JS.InvokeAsync<IJSObjectReference>("import", "./interop/countdown.js");
        await _countdown.InvokeVoidAsync("start");
    }

    public async ValueTask DisposeAsync() {
        if (_countdown is not null) {
            try {
                await _countdown.InvokeVoidAsync("stop");
                await _countdown.DisposeAsync();
            }
            catch (JSDisconnectedException) {
            }
        }
    }

    record Summary(List<ExtractedRow> Extracted, ColleggtiblesInfo? Colleggtibles, ConfigInfo Config, List<FeedInfo> Feeds);

    record ExtractedRow(string Key, int Count, string Provenance);

    record ColleggtiblesInfo(int Count, string Provenance, List<EggRow> Eggs);

    record EggRow(string Identifier, string Dimension, List<double> TierValues, string? Icon);

    record ConfigInfo(bool Enabled, List<PlatformRow> Platforms);

    record PlatformRow(string Platform, DateTimeOffset SavedAt, long Bytes);

    record FeedInfo(string Name, string Path, bool Present, long Bytes);

    record SeasonsResponse(List<Season> Seasons);

    record Season(string Id, string Name, double StartTime, double NextStartTime, bool StartDerived, List<GradeGoalsRow> GradeGoals, List<SeasonEgg>? Colleggtibles);

    record SeasonEgg(string Id, string? Icon, List<string>? Contracts);

    record GradeGoalsRow(string Grade, List<GoalRow> Goals, string? GradeIcon);

    record GoalRow(double Cxp, string RewardType, string RewardSubType, double RewardAmount, string? Icon);

    record EventsResponse(DateTimeOffset? CapturedAt, double? ServerTime, List<EventRow> Events);

    record EventRow(
        string Identifier,
        string Type,
        string Subtitle,
        double Multiplier,
        double StartTime,
        double Duration,
        double? EndTime,
        bool CcOnly,
        string? Icon);

    record DataResponse(int Count, List<Source> Sources);

    record Source(
        string Id,
        string Group,
        string Url,
        string DisplayName,
        string? Description,
        string Provenance,
        string Access,
        string? Feed,
        bool AcceptsName,
        long? Bytes,
        MetaRow? Meta,
        List<Source>? Children);

    record MetaRow(string? BinaryVersion, JsonElement? Provenance);

}
