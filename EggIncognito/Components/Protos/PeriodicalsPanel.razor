@using System.Text
@using System.Text.Json
@using EggIncognito.Components.Capture
@implements IAsyncDisposable
@inject ICurrentUser User
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS

@if (!_isAdmin) {
    <div class="panel">Admin access required. <LoginButton CssClass="auth-btn" Label="Log in" Placement="LoginMenuPlacement.BottomLeft"/></div>
} else if (_summary is null && _catalog is null) {
    <div class="panel text-muted text-sm">Loading…</div>
} else {
    <div class="flex flex-col gap-6">
        @if (_events is { Count: > 0 }) {
            <section class="panel">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold m-0">Current events</h3>
                    @if (_eventsCapturedAt is { } cap) {
                        <span class="text-muted text-xs">captured @cap.ToLocalTime().ToString("MMM d, HH:mm")</span>
                    }
                </div>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var e in _events) {
                        <span class="event-pill @(RemainingSeconds(e) <= 0 ? "ended" : "")" title="@e.Type">
                            @if (!string.IsNullOrEmpty(e.Icon)) {
                                <img src="@e.Icon" alt="" loading="lazy"/>
                            }
                            <span class="event-name">@(string.IsNullOrEmpty(e.Subtitle) ? Pretty(e.Type) : e.Subtitle)</span>
                            @if (e.Multiplier > 0 && Math.Abs(e.Multiplier - 1) > 0.0001) {
                                <span class="event-mult">@MultLabel(e.Multiplier)</span>
                            }
                            <span class="event-timer" data-countdown="@FormattableString.Invariant($"{e.EndTime ?? 0:0}")">@RemainingLabel(e)</span>
                        </span>
                    }
                </div>
            </section>
        }

        @if (_catalog is not null) {
            var ix = 0;
            var firstGroup = true;
            <section class="panel">
                <h3 class="text-sm font-semibold mt-0 mb-3">Data</h3>
                <div class="flex flex-col gap-0.5">
                    @foreach (var grp in Groups) {
                        var rows = _catalog.Sources.Where(s => s.Group == grp.Key && s.Extends is null).ToList();
                        if (rows.Count == 0) {
                            continue;
                        }

                        if (!firstGroup) {
                            <hr class="my-2 border-0 border-t border-border"/>
                        }

                        firstGroup = false;
                        @foreach (var s in rows) {
                            var kids = _catalog.Sources.Where(k => k.Group == grp.Key && k.Extends == s.Id).ToList();
                            <div>
                                <PeriodicalDataset Title="@s.DisplayName" Endpoint="@s.Url"
                                                   DownloadName="@($"{s.Id}.json")" Fetch="Fetch" View="_view" FormatChoice="_fc"
                                                   RowClass="@Stripe(ix++)">
                                    <Badges>
                                        @if (s.Bytes is { } b) {
                                            <span class="mono text-muted text-xs">@Kb(b)</span>
                                        }
                                    </Badges>
                                </PeriodicalDataset>
                                @if (kids.Count > 0) {
                                    <div class="ds-children">
                                        @foreach (var k in kids) {
                                            <PeriodicalDataset Title="@k.DisplayName" Endpoint="@k.Url" Nested="true"
                                                               DownloadName="@($"{k.Id}.json")" Fetch="Fetch" View="_view" FormatChoice="_fc"
                                                               RowClass="@Stripe(ix++)">
                                                <Badges>
                                                    @if (k.Bytes is { } kb) {
                                                        <span class="mono text-muted text-xs">@Kb(kb)</span>
                                                    }
                                                </Badges>
                                            </PeriodicalDataset>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </section>
        }

        @if (_seasons is { Count: > 0 } seasonList) {
            var season = seasonList[Math.Clamp(_seasonIx, 0, seasonList.Count - 1)];
            var grades = season.GradeGoals.Where(g => g.Goals.Count > 0).ToList();
            <section class="panel">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold m-0">Seasons</h3>
                    <div class="flex items-center gap-1">
                        <button type="button" class="reg-edit-btn disabled:opacity-40 disabled:cursor-default disabled:hover:border-border"
                                disabled="@(_seasonIx >= seasonList.Count - 1)"
                                title="Older season" aria-label="Older season" @onclick="() => MoveSeason(1)">
                            <Icon Name="chevronLeft"/>
                        </button>
                        <button type="button" class="reg-edit-btn disabled:opacity-40 disabled:cursor-default disabled:hover:border-border"
                                disabled="@(_seasonIx <= 0)"
                                title="Newer season" aria-label="Newer season" @onclick="() => MoveSeason(-1)">
                            <Icon Name="chevronRight"/>
                        </button>
                    </div>
                </div>
                <div class="flex items-center gap-3 mb-3">
                    <div class="bg-bg border border-border rounded overflow-hidden text-center w-14 shrink-0">
                        <div class="bg-accent text-bg text-[10px] font-semibold uppercase py-0.5">@StartDate(season).ToString("MMM")</div>
                        <div class="text-lg font-semibold py-1">@StartDate(season).Day</div>
                    </div>
                    <div>
                        <div class="text-sm font-semibold">@season.Name</div>
                        <div class="text-muted text-xs">@StartLabel(season)</div>
                    </div>
                </div>
                @if (grades.Count > 0) {
                    var sel = grades.FirstOrDefault(g => g.Grade == _grade) ?? grades[^1];
                    <div class="settings-seg mb-2 max-w-xs" role="radiogroup" aria-label="Grade">
                        @foreach (var g in grades) {
                            var grade = g.Grade;
                            <button type="button" class="seg-btn @(sel.Grade == grade ? "active" : "")"
                                    @onclick="() => _grade = grade">
                                @GradeLabel(grade)
                            </button>
                        }
                    </div>
                    <table class="reg-table">
                        <thead>
                        <tr>
                            <th>CXP</th><th>Reward</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var goal in sel.Goals) {
                            <tr>
                                <td class="mono text-xs">@goal.Cxp.ToString("N0")</td>
                                <td class="text-xs">@RewardLabel(goal)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                } else {
                    <div class="text-muted text-sm">No reward data captured for this season.</div>
                }
            </section>
        }

        @if (_summary?.Colleggtibles is { } c) {
            <section class="panel">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold m-0">Colleggtibles</h3>
                    <a class="reg-edit-btn" href="/api/v1/data/periodical/get_periodicals/colleggtibles" download="colleggtibles.json" title="Download JSON" aria-label="Download JSON">
                        <Icon Name="download"/>
                    </a>
                </div>
                <table class="reg-table">
                    <thead>
                    <tr>
                        <th class="w-8"></th><th>Identifier</th><th>Dimension</th><th>Tier values</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var e in c.Eggs) {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(e.Icon)) {
                                    <img class="w-[1.875rem] h-[1.875rem] object-contain" src="@e.Icon" alt="" loading="lazy"/>
                                }
                            </td>
                            <td class="font-mono text-accent">@e.Identifier</td>
                            <td class="mono text-muted text-xs">@e.Dimension</td>
                            <td class="mono text-xs">@string.Join(", ", e.TierValues)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </section>
        }

        @if (_catalogError is not null) {
            <div class="panel text-err text-sm">Could not load the source catalog: @_catalogError</div>
        }
    </div>
}

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    bool _isAdmin;
    Summary? _summary;
    DataResponse? _catalog;
    string? _catalogError;
    List<Season>? _seasons;
    int _seasonIx;
    string _grade = "GradeAaa";
    List<EventRow>? _events;
    DateTimeOffset? _eventsCapturedAt;
    IJSObjectReference? _countdown;
    readonly CaptureViewState _view = new();
    readonly Dictionary<string, string> _fc = new();
    string _baseAddress = "";
    string? _cookie;

    static readonly (string Key, string Label)[] Groups = [
        ("periodical", "Periodical"),
        ("gamedata", "Game data")
    ];

    protected override async Task OnInitializedAsync() {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null) {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }

        if (!_isAdmin) return;

        try {
            var fetched = await Client().GetFromJsonAsync<Summary>("/api/periodicals/summary", JsonOpts);
            if (fetched is not null) {
                _summary = fetched;
            }
        }
        catch {
        }

        try {
            var cur = await Client().GetFromJsonAsync<EventsResponse>("/api/periodicals/current", JsonOpts);
            if (cur is not null) {
                _events = cur.Events;
                _eventsCapturedAt = cur.CapturedAt;
            }
        }
        catch {
        }

        try {
            var seasonsRes = await Client().GetFromJsonAsync<SeasonsResponse>("/api/periodicals/seasons", JsonOpts);
            if (seasonsRes?.Seasons is { Count: > 0 } ls) {
                _seasons = ls;
                var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                var ix = ls.FindIndex(s => s.StartTime <= now);
                _seasonIx = ix < 0 ? 0 : ix;
            }
        }
        catch {
        }

        try {
            var res = await Client().GetAsync("/api/v1/data");
            if (res.IsSuccessStatusCode) {
                var cat = await res.Content.ReadFromJsonAsync<DataResponse>(JsonOpts);
                if (cat is not null) {
                    _catalog = cat;
                    _catalogError = null;
                }
            } else {
                _catalogError = $"HTTP {(int)res.StatusCode}";
            }
        }
        catch (Exception ex) {
            _catalogError = ex.Message;
        }
    }

    HttpClient Client() {
        return SelfCallClient.Create(HttpFactory, _baseAddress, _cookie);
    }

    async Task<string> Fetch(string route) {
        try {
            var res = await Client().GetAsync(route);
            var body = await res.Content.ReadAsStringAsync();
            if (res.IsSuccessStatusCode) return body;
            var isJson = res.Content.Headers.ContentType?.MediaType?.Contains("json", StringComparison.OrdinalIgnoreCase) == true;
            return isJson && !string.IsNullOrWhiteSpace(body) ? body : $"HTTP {(int)res.StatusCode}: {body}";
        }
        catch (Exception ex) {
            return ex.Message;
        }
    }

    static string Kb(long bytes) {
        if (bytes < 1024) return $"{bytes}B";
        var kb = bytes / 1024;
        return kb >= 1000 ? $"{kb / 1000}MB" : $"{kb}KB";
    }

    static string Stripe(int ix) {
        return "ds-cell" + (ix % 2 == 1 ? " ds-stripe" : "");
    }

    void MoveSeason(int delta) {
        if (_seasons is null) return;
        _seasonIx = Math.Clamp(_seasonIx + delta, 0, _seasons.Count - 1);
    }

    static DateTimeOffset StartDate(Season s) {
        return DateTimeOffset.FromUnixTimeSeconds((long)s.StartTime);
    }

    static string StartLabel(Season s) {
        var d = StartDate(s);
        var verb = d <= DateTimeOffset.UtcNow ? "Started" : "Starts";
        var derived = s.StartDerived ? " (derived)" : "";
        return $"{verb} {d.ToString("MMMM d, yyyy")}{derived}";
    }

    static string GradeLabel(string grade) {
        if (grade.StartsWith("GRADE_", StringComparison.Ordinal)) return grade["GRADE_".Length..];
        if (grade.StartsWith("Grade", StringComparison.Ordinal)) return grade["Grade".Length..].ToUpperInvariant();
        return grade;
    }

    static string RewardLabel(GoalRow g) {
        var label = Pretty(g.RewardType);
        if (!string.IsNullOrEmpty(g.RewardSubType)) {
            label += $" ({Pretty(g.RewardSubType)})";
        }

        return $"{g.RewardAmount.ToString("N0")} × {label}";
    }

    static string Pretty(string raw) {
        var words = raw.Replace('-', '_').Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length > 1 || raw.Contains('_')) {
            return string.Join(' ', words.Select(w => w.Length > 0 ? char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant() : w));
        }

        var sb = new StringBuilder();
        foreach (var ch in raw) {
            if (char.IsUpper(ch) && sb.Length > 0) sb.Append(' ');
            sb.Append(ch);
        }

        return sb.ToString();
    }

    static string MultLabel(double m) {
        return $"{m.ToString(m == Math.Floor(m) ? "0" : "0.##")}x";
    }

    static double RemainingSeconds(EventRow e) {
        if (e.EndTime is not { } end || end <= 0) return 0;
        return end - DateTimeOffset.UtcNow.ToUnixTimeSeconds();
    }

    static string RemainingLabel(EventRow e) {
        var s = RemainingSeconds(e);
        if (s <= 0) return "Ended";
        var t = TimeSpan.FromSeconds(s);
        var core = $"{t.Hours:00}:{t.Minutes:00}:{t.Seconds:00}";
        return t.Days > 0 ? $"{t.Days}d {core}" : core;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || _events is not { Count: > 0 }) return;
        _countdown = await JS.InvokeAsync<IJSObjectReference>("import", "./interop/countdown.js");
        await _countdown.InvokeVoidAsync("start");
    }

    public async ValueTask DisposeAsync() {
        if (_countdown is not null) {
            try {
                await _countdown.InvokeVoidAsync("stop");
                await _countdown.DisposeAsync();
            }
            catch (JSDisconnectedException) {
            }
        }
    }

    record Summary(List<ExtractedRow> Extracted, ColleggtiblesInfo? Colleggtibles, ConfigInfo Config, List<FeedInfo> Feeds);

    record ExtractedRow(string Key, int Count, string Provenance);

    record ColleggtiblesInfo(int Count, string Provenance, List<EggRow> Eggs);

    record EggRow(string Identifier, string Dimension, List<double> TierValues, string? Icon);

    record ConfigInfo(bool Enabled, List<PlatformRow> Platforms);

    record PlatformRow(string Platform, DateTimeOffset SavedAt, long Bytes);

    record FeedInfo(string Name, string Path, bool Present, long Bytes);

    record SeasonsResponse(List<Season> Seasons);

    record Season(string Id, string Name, double StartTime, bool StartDerived, List<GradeGoalsRow> GradeGoals);

    record GradeGoalsRow(string Grade, List<GoalRow> Goals);

    record GoalRow(double Cxp, string RewardType, string RewardSubType, double RewardAmount);

    record EventsResponse(DateTimeOffset? CapturedAt, double? ServerTime, List<EventRow> Events);

    record EventRow(
        string Identifier,
        string Type,
        string Subtitle,
        double Multiplier,
        double StartTime,
        double Duration,
        double? EndTime,
        string? Icon);

    record DataResponse(int Count, List<Source> Sources);

    record Source(
        string Id,
        string Group,
        string Url,
        string DisplayName,
        string? Description,
        string Provenance,
        string Access,
        string? Feed,
        string? Extends,
        bool AcceptsName,
        long? Bytes);

}
