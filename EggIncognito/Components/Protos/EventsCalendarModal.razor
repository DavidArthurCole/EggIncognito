@using System.Globalization
@using System.Text.Json
@using EggIncognito.Models.Events
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Events
@inherits SelfCallComponentBase
@inject ILogger<EventsCalendarModal> Logger

@if (_open) {
    <ModalShell Title="Events" TitleId="eventsCalendarTitle" Width="ModalWidth.Large"
                CardClass="evcal-card" OnClose="Close">
        <HeadTools>
            <div class="evcal-controls">
                <div class="settings-seg evcal-zoom" role="radiogroup" aria-label="Zoom">
                    <button type="button" class="seg-btn @(_zoom == EventCalendarZoom.Week ? "active" : "")"
                            @onclick="@(() => SetZoom(EventCalendarZoom.Week))">
                        Week
                    </button>
                    <button type="button" class="seg-btn @(_zoom == EventCalendarZoom.Month ? "active" : "")"
                            @onclick="@(() => SetZoom(EventCalendarZoom.Month))">
                        Month
                    </button>
                </div>
                <button type="button" class="reg-edit-btn" aria-label="Earlier" @onclick="@(() => Pan(-1))">
                    <Icon Name="chevronLeft" Class="icon-sm"/>
                </button>
                <span class="evcal-range">@RangeLabel</span>
                <button type="button" class="reg-edit-btn" aria-label="Later" @onclick="@(() => Pan(1))">
                    <Icon Name="chevronRight" Class="icon-sm"/>
                </button>
                <button type="button" class="btn-mini" @onclick="Today">Today</button>
                <input type="date" class="evcal-date" aria-label="Jump to date" value="@CenterDate" @onchange="JumpToDate"/>
            </div>
        </HeadTools>
        <ChildContent>
            <div class="modal-body evcal-body">
                <div class="evcal-filters">
                    <details class="evcal-filter-disclosure">
                        <summary class="evcal-filter-summary">
                            Filters
                            @if (Filtering) {
                                <span class="evcal-filter-active">active</span>
                            }
                        </summary>
                        <div class="evcal-filter-panel">
                            <div class="evcal-filter-actions">
                                <button type="button" class="btn-mini" @onclick="SelectAllFilters">Select all</button>
                                <button type="button" class="btn-mini" @onclick="DeselectAllFilters">Deselect all</button>
                            </div>
                            <div class="evcal-filter-group">
                                <span class="evcal-filter-group-label">Tier</span>
                                <label class="evcal-check">
                                    <input type="checkbox" checked="@_showStandard"
                                           @onchange="@(e => SetTier(false, e))"/>
                                    <span>Standard</span>
                                </label>
                                <label class="evcal-check">
                                    <input type="checkbox" checked="@_showUltra"
                                           @onchange="@(e => SetTier(true, e))"/>
                                    <span>Ultra</span>
                                </label>
                            </div>
                            <div class="evcal-filter-group">
                                <span class="evcal-filter-group-label">Type</span>
                                @foreach (var type in TypesPresent) {
                                    <label class="evcal-check">
                                        <input type="checkbox" checked="@TypeSelected(type)"
                                               @onchange="@(e => ToggleType(type, e))"/>
                                        <span>@Pretty(type)</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </details>
                    <span class="evcal-count">@VisibleCount of @_events.Count</span>
                </div>
                @if (Note is { Length: > 0 } note) {
                    <div class="evcal-note">@note</div>
                }
                <div class="evcal-shell evcal-view-@ZoomClass" style="@ShellStyle">
                    <div class="evcal-scale">
                        @for (var i = 0; i < WeekdayNames.Length; i++) {
                            <span class="evcal-scale-label" style="@TickStyle((i + 0.5) / 7 * 100)">@WeekdayNames[i]</span>
                        }
                    </div>
                    <div class="evcal-canvas">
                        @for (var r = 0; r < _rows.Count; r++) {
                            var rowIx = r;
                            var row = _rows[rowIx];
                            <div class="evcal-row" style="@RowStyle(row)">
                                @foreach (var cell in row.Cells) {
                                    if (cell.LeftPercent > 0) {
                                        <div class="evcal-grid" style="@TickStyle(cell.LeftPercent)"></div>
                                    }

                                    <span class="@CellCss(cell)" style="@TickStyle(cell.LeftPercent)">@CellLabel(cell)</span>
                                }
                                @if (row.NowPercent is { } nowPercent) {
                                    <div class="evcal-now" style="@TickStyle(nowPercent)"></div>
                                }
                                <div class="evcal-lanes">
                                    @foreach (var lane in row.Lanes) {
                                        <div class="evcal-lane">
                                            @foreach (var bar in lane) {
                                                <button type="button" class="@BarCss(bar)" style="@BarStyle(bar)"
                                                        @onclick="@(() => Select(rowIx, bar))">
                                                    @if (EventPalette.IconUrl(bar.Event.Type, bar.Event.Ultra) is { } iconUrl) {
                                                        <img class="evcal-bar-icon" src="@iconUrl" alt="" loading="lazy"
                                                             data-fallback/>
                                                    }

                                                    <span class="evcal-bar-label">@Label(bar.Event)</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (Picked(rowIx, row) is { } picked) {
                                    <div class="@PopCss(rowIx)"
                                         style="@TickStyle(picked.LeftPercent + picked.WidthPercent / 2)">
                                        <div class="evcal-pop-head">
                                            <span class="evcal-pop-title">@Label(picked.Event)</span>
                                            <button type="button" class="reg-edit-btn" aria-label="Close details"
                                                    @onclick="ClearSelection">
                                                <Icon Name="x"/>
                                            </button>
                                        </div>
                                        <div class="evcal-pop-row">
                                            <span class="evcal-pop-k">Type</span>
                                            <span class="evcal-pop-v">@picked.Event.Type</span>
                                        </div>
                                        <div class="evcal-pop-row">
                                            <span class="evcal-pop-k">Multiplier</span>
                                            <span class="evcal-pop-v">@Multiplier(picked.Event)</span>
                                        </div>
                                        <div class="evcal-pop-row">
                                            <span class="evcal-pop-k">Ultra</span>
                                            <span class="evcal-pop-v">@(picked.Event.Ultra ? "yes" : "no")</span>
                                        </div>
                                        <div class="evcal-pop-row">
                                            <span class="evcal-pop-k">Timing</span>
                                            <span class="evcal-pop-v">@Countdown(picked.Event)</span>
                                        </div>
                                        <div class="evcal-pop-row">
                                            <span class="evcal-pop-k">Source</span>
                                            <span class="evcal-pop-v">@picked.Event.Source</span>
                                        </div>
                                        <div class="evcal-pop-row">
                                            <span class="evcal-pop-k">Start</span>
                                            <span class="evcal-pop-v">@Absolute(picked.Event.StartTimestamp)</span>
                                        </div>
                                        <div class="evcal-pop-row">
                                            <span class="evcal-pop-k">End</span>
                                            <span class="evcal-pop-v">@Absolute(picked.Event.EndTimestamp)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </ChildContent>
    </ModalShell>
}

@code {
    const int FetchLimit = 1000;
    const double OverlapLookbackSeconds = 7 * 24 * 60 * 60;

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);
    static readonly string[] WeekdayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    readonly Dictionary<string, GameEventDto> _events = new(StringComparer.Ordinal);

    bool _open;
    bool _loading;
    string _error = "";
    EventCalendarZoom _zoom = EventCalendarZoom.Month;
    DateTimeOffset _center = DateTimeOffset.UtcNow;
    DateTimeOffset _visibleStart;
    DateTimeOffset _visibleEnd;
    IReadOnlyList<EventCalendarRow> _rows = [];
    double _coveredStart;
    double _coveredEnd;
    bool _covered;
    int _pickedRow = -1;
    string? _pickedId;
    HashSet<string>? _typeFilter;
    bool _showStandard = true;
    bool _showUltra = true;

    bool Filtering => _typeFilter is not null || !_showStandard || !_showUltra;

    int VisibleCount => _events.Values.Count(Match);

    IEnumerable<string> TypesPresent =>
        _events.Values
            .Select(e => e.Type)
            .Where(t => !string.IsNullOrEmpty(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.Ordinal);

    bool Match(GameEventDto e) {
        if (e.Ultra ? !_showUltra : !_showStandard) return false;
        return _typeFilter is null || _typeFilter.Contains(e.Type);
    }

    bool TypeSelected(string type) => _typeFilter is null || _typeFilter.Contains(type);

    void ToggleType(string type, ChangeEventArgs e) {
        var set = _typeFilter is null
            ? new HashSet<string>(TypesPresent, StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(_typeFilter, StringComparer.OrdinalIgnoreCase);
        if (e.Value is true) set.Add(type); else set.Remove(type);
        _typeFilter = set;
        ApplyFilters();
    }

    void SetTier(bool ultra, ChangeEventArgs e) {
        var on = e.Value is true;
        if (ultra) _showUltra = on; else _showStandard = on;
        ApplyFilters();
    }

    void SelectAllFilters() {
        _typeFilter = null;
        _showStandard = true;
        _showUltra = true;
        ApplyFilters();
    }

    void DeselectAllFilters() {
        _typeFilter = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _showStandard = false;
        _showUltra = false;
        ApplyFilters();
    }

    void ApplyFilters() {
        ClearSelection();
        Relayout();
    }

    void Relayout() {
        _rows = EventCalendarLayout.Rows(
            [.. _events.Values.Where(Match)], _visibleStart, _visibleEnd, _zoom, DateTimeOffset.UtcNow);
    }

    public async Task Open() {
        _open = true;
        _loading = true;
        _center = DateTimeOffset.UtcNow;
        (_visibleStart, _visibleEnd) = EventCalendarLayout.Window(_center, _zoom);
        ClearSelection();
        StateHasChanged();
        await Refresh();
        StateHasChanged();
    }

    void Close() {
        _open = false;
        ClearSelection();
    }

    void ClearSelection() {
        _pickedRow = -1;
        _pickedId = null;
    }

    void Select(int rowIx, EventCalendarBar bar) {
        var same = _pickedRow == rowIx && _pickedId == OccurrenceKey(bar.Event);
        _pickedRow = same ? -1 : rowIx;
        _pickedId = same ? null : OccurrenceKey(bar.Event);
    }

    EventCalendarBar? Picked(int rowIx, EventCalendarRow row) {
        if (_pickedId is null || _pickedRow != rowIx) return null;
        return row.Lanes.SelectMany(lane => lane).FirstOrDefault(b => OccurrenceKey(b.Event) == _pickedId);
    }

    string Note {
        get {
            if (_loading) return "Loading events...";
            if (_error.Length > 0) return _error;
            if (_rows.Any(r => r.Lanes.Count > 0)) return "";
            return Filtering ? "No events match these filters." : "No events in this range.";
        }
    }

    async Task Refresh() {
        (_visibleStart, _visibleEnd) = EventCalendarLayout.Window(_center, _zoom);
        _center = _visibleStart + (_visibleEnd - _visibleStart) / 2;
        await EnsureFetched();
        _loading = false;
        Relayout();
    }

    async Task EnsureFetched() {
        var period = _visibleEnd - _visibleStart;
        var needStart = UnixSeconds.FromTime(_visibleStart - period);
        var needEnd = UnixSeconds.FromTime(_visibleEnd + period);
        if (_covered && needStart >= _coveredStart && needEnd <= _coveredEnd) return;
        var url = FormattableString.Invariant(
            $"/api/v1/events?after={needStart - OverlapLookbackSeconds:0}&before={needEnd:0}&limit={FetchLimit}");
        _error = await LoadWindow(url, needStart, needEnd);
    }

    async Task<string> LoadWindow(string url, double needStart, double needEnd) {
        try {
            var res = await Client().GetAsync(url);
            if ((int)res.StatusCode == 503) return "Event history needs a database. This instance has none.";
            if (!res.IsSuccessStatusCode) return "Events could not be loaded.";
            var body = await res.Content.ReadFromJsonAsync<GameEventListResponse>(JsonOpts);
            if (body is null) return "Events could not be loaded.";
            foreach (var e in body.Events) _events[OccurrenceKey(e)] = e;
            if (body.Total <= body.Events.Count) Cover(needStart, needEnd);
            return body.Total > body.Events.Count ? "Showing the newest 1000 events in this range." : "";
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "the event calendar window could not be loaded");
            return "Events could not be loaded.";
        }
    }

    void Cover(double start, double end) {
        if (_covered && start <= _coveredEnd && end >= _coveredStart) {
            _coveredStart = Math.Min(_coveredStart, start);
            _coveredEnd = Math.Max(_coveredEnd, end);
            return;
        }

        _coveredStart = start;
        _coveredEnd = end;
        _covered = true;
    }

    Task SetZoom(EventCalendarZoom zoom) {
        if (_zoom == zoom) return Task.CompletedTask;
        _zoom = zoom;
        ClearSelection();
        return Refresh();
    }

    Task Pan(int direction) {
        _center += (_visibleEnd - _visibleStart) * direction;
        ClearSelection();
        return Refresh();
    }

    Task Today() {
        _center = DateTimeOffset.UtcNow;
        ClearSelection();
        return Refresh();
    }

    Task JumpToDate(ChangeEventArgs e) {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var picked)) return Task.CompletedTask;
        _center = EventCalendarLayout.ToOffset(picked.ToDateTime(new TimeOnly(12, 0)));
        ClearSelection();
        return Refresh();
    }

    string ZoomClass => _zoom == EventCalendarZoom.Week ? "week" : "month";

    static string ShellStyle => FormattableString.Invariant(
        $"--evcal-gap:{100.0 / 7 * EventCalendarLayout.DayGapFraction:0.###}%;");

    string CenterDate => _center.ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    string RangeLabel {
        get {
            var start = _visibleStart.ToLocalTime();
            if (_zoom == EventCalendarZoom.Month) return start.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
            var end = _visibleEnd.ToLocalTime().AddSeconds(-1);
            return start.ToString("MMM d", CultureInfo.InvariantCulture)
                   + " - " + end.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
        }
    }

    string CellLabel(EventCalendarCell cell) {
        return _zoom == EventCalendarZoom.Month
            ? cell.LocalDate.Day.ToString(CultureInfo.InvariantCulture)
            : cell.LocalDate.ToString("M/d", CultureInfo.InvariantCulture);
    }

    static string CellCss(EventCalendarCell cell) {
        return cell.Muted ? "evcal-cell evcal-cell-muted" : "evcal-cell";
    }

    string PopCss(int rowIx) {
        return _rows.Count > 1 && rowIx == _rows.Count - 1
            ? "popover open evcal-pop evcal-pop-up"
            : "popover open evcal-pop";
    }

    static string BarCss(EventCalendarBar bar) {
        var css = bar.Active ? "evcal-bar evcal-bar-active" : bar.Past ? "evcal-bar evcal-bar-past" : "evcal-bar";
        if (bar.ContinuesLeft) css += " evcal-bar-cut-l";
        if (bar.ContinuesRight) css += " evcal-bar-cut-r";
        return css;
    }

    static string BarStyle(EventCalendarBar bar) {
        return FormattableString.Invariant($"--bar-start:{bar.LeftPercent:0.###};--bar-size:{bar.WidthPercent:0.###};")
               + EventPalette.BarStyle(bar.Event.Type, bar.Event.Ultra);
    }

    static string TickStyle(double leftPercent) {
        return FormattableString.Invariant($"--tick-pos:{leftPercent:0.###};");
    }

    static string RowStyle(EventCalendarRow row) {
        return FormattableString.Invariant($"--row-weight:{Math.Max(1, row.Lanes.Count)};");
    }

    static string OccurrenceKey(GameEventDto e) {
        return FormattableString.Invariant($"{e.Id}@{e.StartTimestamp:0}");
    }

    static string Absolute(double unixSeconds) {
        return UnixSeconds.ToTime(unixSeconds).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    static string Countdown(GameEventDto e) {
        return EventCountdown.Describe(e.StartTimestamp, e.EndTimestamp, DateTimeOffset.UtcNow);
    }

    static string Multiplier(GameEventDto e) {
        return EventMagnitude.Describe(e);
    }

    static string Label(GameEventDto e) {
        return string.IsNullOrWhiteSpace(e.Message) ? Pretty(e.Type) : e.Message;
    }

    static string Pretty(string raw) {
        var words = raw.Replace('-', ' ').Replace('_', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant()));
    }

}
