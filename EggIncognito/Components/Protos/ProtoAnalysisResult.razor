@* Ephemeral result of a drop-zone extraction: stats, proto viewer, download, diff vs a registry
   version, and offer-to-registry when the extracted combination is unknown. Reads are public;
   the offer call is server-ACL gated. *@
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable

@if (Result is { Ok: true }) {
    <div class="panel">
        <h2 class="text-[1.05rem] m-0">Analysis</h2>

        <div class="font-mono text-xs break-all mt-2">@Result.FileName</div>

        <div class="flex flex-col gap-1 text-xs mt-2 mb-3">
            <div class="flex gap-2">
                <span class="text-muted w-28 shrink-0">App version</span>
                <span class="font-mono">@(string.IsNullOrWhiteSpace(Result.AppVersion) ? "-" : Result.AppVersion)</span>
            </div>
            <div class="flex gap-2">
                <span class="text-muted w-28 shrink-0">Build</span>
                <span class="font-mono">@(string.IsNullOrWhiteSpace(Result.Build) ? "-" : Result.Build)</span>
            </div>
            <div class="flex gap-2">
                <span class="text-muted w-28 shrink-0">Client version</span>
                <span class="font-mono">@(Result.ClientVersion?.ToString() ?? "-")</span>
            </div>
            <div class="flex gap-2">
                <span class="text-muted w-28 shrink-0">Messages</span>
                <span class="font-mono">@Result.Messages.Count</span>
            </div>
            <div class="flex gap-2">
                <span class="text-muted w-28 shrink-0">Size</span>
                <span class="font-mono">@SizeText()</span>
            </div>
            @if (Result.UploadedSize is { } up) {
                <div class="flex gap-2">
                    <span class="text-muted w-28 shrink-0">Uploaded</span>
                    <span class="font-mono">@UploadText(up)</span>
                </div>
            }
            <div class="flex gap-2">
                <span class="text-muted w-28 shrink-0">Registry</span>
                <span>
                    @if (_checking) {
                        <span class="text-muted">checking...</span>
                    } else if (_known) {
                        <span class="text-accent">already in registry</span>
                    } else if (_pending || _offered) {
                        <span class="text-muted">offered, pending review</span>
                    } else if (_offerable) {
                        <button type="button" class="btn-primary" disabled="@(_offerBusy || _offered)" @onclick="Offer">Offer to registry</button>
                    } else {
                        <span class="text-muted">-</span>
                    }
                </span>
            </div>
        </div>

        @if (_compareMsg is not null) {
            <div class="panel mb-3 text-xs">
                <div class="text-muted mb-1">@_compareMsg</div>
                @if (_added.Count > 0) {
                    <div class="mb-1">
                        <span class="text-accent">+ added (@_added.Count):</span> <span class="font-mono">@string.Join(", ", _added)</span>
                    </div>
                }
                @if (_removed.Count > 0) {
                    <div>
                        <span class="text-muted">- removed (@_removed.Count):</span> <span class="font-mono">@string.Join(", ", _removed)</span>
                    </div>
                }
                @if (_added.Count == 0 && _removed.Count == 0) {
                    <div class="text-accent">No message-level differences vs latest.</div>
                }
            </div>
        }

        <CodeTextView Text="@Result.Proto" MaxHeight="420px">
            <Tools>
                <button type="button" class="btn-mini" title="Compare to latest" disabled="@_comparing" @onclick="CompareToLatest">
                    <Icon Name="swap" Class="icon-sm"/>
                </button>
                <button type="button" class="btn-mini" title="Download .proto" @onclick="Download">
                    <Icon Name="download" Class="icon-sm"/>
                </button>
            </Tools>
        </CodeTextView>
    </div>
}

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    [Parameter] public ProtoDropZone.ExtractResult? Result { get; set; }

    string _baseAddress = "";
    string? _cookie;
    IJSObjectReference? _download;

    string _platform = "ios", _appVersion = "", _build = "", _clientVersion = "";

    bool _comparing;
    string? _compareMsg;
    readonly List<string> _added = [];
    readonly List<string> _removed = [];

    ProtoDropZone.ExtractResult? _seededFor;

    protected override void OnInitialized() {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null) {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
    }


    protected override async Task OnParametersSetAsync() {
        if (Result is null || ReferenceEquals(Result, _seededFor)) return;
        _seededFor = Result;
        _platform = PlatformFor(Result.FileName);
        _appVersion = Result.AppVersion ?? "";
        _build = Result.Build ?? "";
        _clientVersion = Result.ClientVersion?.ToString() ?? "";
        _known = _pending = _offerable = _offered = _offerBusy = false;
        await BackfillBuildAndClientVersion();
        await CheckOfferable();
    }


    bool _checking, _known, _pending, _offerable, _offered, _offerBusy;

    async Task CheckOfferable() {
        if (Result?.ProtoSha is not { Length: > 0 } sha) {
            _known = _pending = _offerable = false;
            return;
        }

        _checking = true;
        try {
            var r = await Client().GetFromJsonAsync<CheckResp>(
                $"/api/protos/staged/check?platform={Uri.EscapeDataString(_platform)}&appVersion={Uri.EscapeDataString(_appVersion)}&build={Uri.EscapeDataString(_build)}&clientVersion={Uri.EscapeDataString(_clientVersion)}&protoSha={Uri.EscapeDataString(sha)}",
                JsonOpts);
            if (r is null) {
                _known = _pending = _offerable = false;
            } else {
                _known = r.KnownCombination;
                _pending = r.Pending;
                _offerable = !r.KnownCombination && !r.Pending;
            }
        }
        catch {
            _known = _pending = _offerable = false;
        }
        finally {
            _checking = false;
        }
    }

    async Task Offer() {
        if (Result?.Proto is null || Result.ProtoSha is null) return;
        _offerBusy = true;
        try {
            var body = new {
                platform = _platform,
                appVersion = string.IsNullOrWhiteSpace(_appVersion) ? null : _appVersion,
                build = string.IsNullOrWhiteSpace(_build) ? null : _build,
                clientVersion = string.IsNullOrWhiteSpace(_clientVersion) ? null : _clientVersion,
                package = (string?)null,
                protoSha = Result.ProtoSha,
                protoText = Result.Proto,
                messageIndex = (string?)null
            };
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/offer", body, JsonOpts);
            _offered = resp.IsSuccessStatusCode;
            if (_offered) _offerable = false;
        }
        catch {
        }
        finally {
            _offerBusy = false;
        }
    }

    sealed record CheckResp(bool InRegistry, bool Pending, bool KnownCombination);


    async Task BackfillBuildAndClientVersion() {
        try {
            var live = await Client().GetFromJsonAsync<LiveVersionDto>(
                $"/api/tools/live-version?platform={_platform}", JsonOpts);
            if (live is { Found: true }) {
                if (string.IsNullOrWhiteSpace(_build) && !string.IsNullOrWhiteSpace(live.Build)) _build = live.Build!;
                if (string.IsNullOrWhiteSpace(_clientVersion) && live.ClientVersion is int cv) _clientVersion = cv.ToString();
            }
        }
        catch {
            /* live store is best-effort; fall through to registry */
        }

        if ((string.IsNullOrWhiteSpace(_build) || string.IsNullOrWhiteSpace(_clientVersion))
            && !string.IsNullOrWhiteSpace(_appVersion)) {
            try {
                var all = await Client().GetFromJsonAsync<List<RegRowDto>>("/api/protos/versions", JsonOpts) ?? [];
                var sameApp = all.Where(r => string.Equals(r.AppVersion, _appVersion, StringComparison.OrdinalIgnoreCase)).ToList();

                if (string.IsNullOrWhiteSpace(_clientVersion)) {
                    var cv = sameApp.Select(r => r.ClientVersion).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c));
                    if (!string.IsNullOrWhiteSpace(cv)) _clientVersion = cv;
                }

                if (string.IsNullOrWhiteSpace(_build)) {
                    var b = sameApp.Where(r => string.Equals(r.Platform, _platform, StringComparison.OrdinalIgnoreCase))
                        .Select(r => r.Build).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
                    if (!string.IsNullOrWhiteSpace(b)) _build = b;
                }
            }
            catch {
                /* registry optional / no DB; leave blank for manual entry */
            }
        }
    }

    static string PlatformFor(string? fileName) {
        var n = fileName ?? "";
        var android = n.EndsWith(".apk", StringComparison.OrdinalIgnoreCase)
                      || n.EndsWith(".apkm", StringComparison.OrdinalIgnoreCase)
                      || n.EndsWith(".xapk", StringComparison.OrdinalIgnoreCase);
        return android ? "android" : "ios";
    }

    HttpClient Client() {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    async Task Download() {
        if (Result?.Proto is null) return;
        _download ??= await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/download.js"));
        await _download.InvokeVoidAsync("text", "ei.proto", Result.Proto);
    }

    async Task CompareToLatest() {
        _comparing = true;
        _compareMsg = null;
        _added.Clear();
        _removed.Clear();
        try {
            var platform = PlatformFor(Result?.FileName);
            var latest = await Client().GetFromJsonAsync<LatestDto>($"/api/protos/latest?platform={platform}", JsonOpts);
            if (latest is null) {
                _compareMsg = $"No stored {platform} version to compare against.";
                return;
            }

            var stored = await Client().GetFromJsonAsync<VersionDto>(
                $"/api/protos/versions/{platform}/{Uri.EscapeDataString(latest.Build)}", JsonOpts);
            var storedNames = stored?.Messages is { } mi
                ? JsonSerializer.Deserialize<List<string>>(mi) ?? []
                : [];
            var uploaded = Result?.Messages ?? [];
            _added.AddRange(uploaded.Where(m => !storedNames.Contains(m)).OrderBy(m => m));
            _removed.AddRange(storedNames.Where(m => !uploaded.Contains(m)).OrderBy(m => m));
            _compareMsg = $"vs latest {platform} {latest.AppVersion} (build {latest.Build})";
        }
        catch (Exception ex) {
            _compareMsg = $"compare failed: {ex.Message}";
        }
        finally {
            _comparing = false;
        }
    }

    sealed record LatestDto(string Platform, string AppVersion, string Build);

    sealed record VersionDto(string? Messages);

    sealed record LiveVersionDto(bool Found, string? Platform, string? Version, string? Build, int? ClientVersion);

    sealed record RegRowDto(string Platform, string AppVersion, string Build, string? ClientVersion);

    string SizeText() {
        if (Result?.FileSize is not { } fs) return "-";
        if (Result.StrippedSize is { } ss && ss != fs) return $"{Mb(fs)} ({Mb(ss)} stripped)";
        return Mb(fs);
    }

    static string Mb(long? bytes) {
        return bytes is { } b ? (b / 1048576.0).ToString("0.0", CultureInfo.InvariantCulture) + " MB" : "-";
    }

    static string UploadText(long bytes) {
        if (bytes >= 1048576) return (bytes / 1048576.0).ToString("0.0", CultureInfo.InvariantCulture) + " MB";
        return (bytes / 1024.0).ToString("0.0", CultureInfo.InvariantCulture) + " KB";
    }

    public async ValueTask DisposeAsync() {
        if (_download is not null)
            try {
                await _download.DisposeAsync();
            }
            catch {
            }
    }

}
