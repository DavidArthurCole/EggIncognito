@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@using System.Text.Json
@implements IAsyncDisposable

<div class="panel">
    <div class="flex items-stretch gap-3">
        <label id="protoDropZone" class="dropzone flex-1 @(_dragging ? "dragging" : "")"
               @ondragenter="() => _dragging = true"
               @ondragleave="() => _dragging = false"
               @ondragover:preventDefault="true"
               @ondrop="() => _dragging = false">
            <InputFile id="protoFile" accept=".ipa,.apk,.apkm,.xapk" multiple="@CanBatch" hidden="hidden" OnChange="OnFilesSelected"/>
            <div class="text-accent" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <path d="M12 16V4"/><path d="M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>
                </svg>
            </div>
            <div class="text-[0.95rem]">
                <strong class="text-fg font-semibold">Drop @(CanBatch ? "one or more .ipa, .apk, or bundle files" : "an .ipa, .apk, or bundle") here</strong> or click to browse
            </div>
            <div class="font-mono text-xs @(_files.Count == 0 ? "text-muted muted" : "")">@SelectionLabel</div>
        </label>
        <button class="btn-primary px-6 shrink-0" disabled="@(_files.Count == 0 || _busy)" @onclick="Submit">@ButtonLabel</button>
    </div>

    @if (!string.IsNullOrEmpty(_error)) {
        <pre class="result-pre">@_error</pre>
    }

    @if (_batchId is { } id) {
        <div class="mt-3">
            <div class="text-sm">Batch #@id: @_processed / @_total (@_status)</div>
            @if (_items.Count > 0) {
                <table class="data-table mt-2">
                    <thead>
                    <tr>
                        <th>File</th><th>Status</th><th>Version</th><th>Client</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var it in _items) {
                        <tr>
                            <td class="mono text-xs">@it.FileName</td>
                            <td class="text-xs">@it.Status</td>
                            <td class="mono text-xs">@it.AppVersion</td>
                            <td class="mono text-xs">@it.ClientVersion</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

@code {

    const int MaxBatchFiles = 50;
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    [Parameter] public EventCallback<ExtractResult> OnResult { get; set; }
    [Parameter] public bool CanBatch { get; set; }
    [Parameter] public EventCallback OnBatchCompleted { get; set; }

    bool _dragging;
    bool _busy;
    string _error = "";
    readonly List<IBrowserFile> _files = [];

    int? _batchId;
    int _total;
    int _processed;
    string _status = "";
    readonly List<ItemView> _items = [];

    IJSObjectReference? _strip;
    string _baseAddress = "";
    string? _cookie;

    bool BatchMode => _files.Count > 1;

    string SelectionLabel => _files.Count switch {
        0 => "No file selected.",
        1 => _files[0].Name,
        var n => $"{n} files selected."
    };

    string ButtonLabel {
        get {
            if (_busy) return BatchMode ? "Uploading..." : "Analyzing...";
            return BatchMode ? $"Upload batch ({_files.Count})" : "Analyze";
        }
    }

    protected override void OnInitialized() {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null) {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
    }

    void OnFilesSelected(InputFileChangeEventArgs e) {
        _files.Clear();
        _files.AddRange(e.GetMultipleFiles(500));
        _error = "";
        _batchId = null;
        _items.Clear();
    }

    async Task<IJSObjectReference> StripModule() {
        return _strip ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/protoStrip.js");
    }

    HttpClient Client() {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        c.Timeout = TimeSpan.FromMinutes(10);
        return c;
    }

    Task Submit() {
        return BatchMode ? UploadBatch() : Analyze();
    }

    async Task Analyze() {
        if (_files.Count == 0) return;
        var file = _files[0];
        _busy = true;
        _error = "";
        try {
            var mod = await StripModule();
            var data = await mod.InvokeAsync<ExtractResult>("analyze", "protoFile", "/api/tools/extract-proto");
            if (data is null) {
                _error = "no response";
                return;
            }

            data = data with { FileName = file.Name };
            if (!data.Ok) _error = data.Diagnostics ?? "extraction failed";
            await OnResult.InvokeAsync(data);
        }
        catch (Exception ex) {
            _error = $"Request failed: {ex.Message}";
        }
        finally {
            _busy = false;
        }
    }

    async Task UploadBatch() {
        if (_files.Count == 0) return;
        if (_files.Count > MaxBatchFiles) {
            _error = $"max {MaxBatchFiles} files per batch";
            return;
        }

        _busy = true;
        _error = "";
        try {
            var mod = await StripModule();
            var res = await mod.InvokeAsync<BatchUploadResult>("uploadBatch", "protoFile", "/api/protos/batch");
            if (res?.BatchId is not { } id) {
                _error = res?.Error ?? "upload failed";
                return;
            }

            _batchId = id;
            _total = res.ItemCount ?? _files.Count;
            _processed = 0;
            _status = "pending";
            _items.Clear();
            _ = PollAsync(id);
        }
        catch (Exception ex) {
            _error = $"Request failed: {ex.Message}";
        }
        finally {
            _busy = false;
        }
    }

    async Task PollAsync(int id) {
        while (true) {
            await Task.Delay(1500);
            try {
                var view = await Client().GetFromJsonAsync<BatchResponse>($"/api/protos/batch/{id}", JsonOpts);
                if (view is null) continue;
                _status = view.Status;
                _total = view.Total;
                _processed = view.Processed;
                _items.Clear();
                _items.AddRange(view.Items);
                await InvokeAsync(StateHasChanged);
                if (view.Status == "done") {
                    await OnBatchCompleted.InvokeAsync();
                    break;
                }
            }
            catch {
                break;
            }
        }
    }

    public async ValueTask DisposeAsync() {
        if (_strip is not null) {
            try {
                await _strip.DisposeAsync();
            }
            catch (JSDisconnectedException) {
            }
        }
    }

    public sealed record ExtractResult {
        public bool Ok { get; init; }
        public string? Proto { get; init; }
        public string? Diagnostics { get; init; }
        public string? ProtoSha { get; init; }
        public IReadOnlyList<string> Messages { get; init; } = [];
        public string? AppVersion { get; init; }
        public string? Build { get; init; }
        public int? ClientVersion { get; init; }
        public string? FileName { get; init; }
    }

    sealed record BatchUploadResult(int? BatchId, int? ItemCount, string? Error);

    sealed record BatchResponse(int Id, string Status, int Total, int Processed, IReadOnlyList<ItemView> Items);

    sealed record ItemView(
        int Id,
        string FileName,
        string Status,
        string? Platform,
        string? ProtoSha,
        string? AppVersion,
        string? Build,
        string? ClientVersion,
        string? Diagnostics);

}
