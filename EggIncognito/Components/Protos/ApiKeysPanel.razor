@using System.Net
@using System.Text.Json
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

<div class="flex flex-col gap-4">
    <div class="apidoc">
        <div class="apidoc-body">
            <p class="m-0">Authenticate with the <span class="code-chip">X-Api-Key</span> header.</p>
            <pre class="apidoc-example">curl -H "X-Api-Key: &lt;your-key&gt;" @($"{_origin}/api/v1/data")</pre>
        </div>
    </div>
    @if (_noDb) {
        <p class="text-muted text-sm m-0">API keys need a database and are not available on this instance.</p>
    } else {
        @if (_minted is not null) {
            <div>
                <p class="text-sm mt-0 mb-1 font-semibold">Copy it now - it will not be shown again.</p>
                <pre class="result-pre">@_minted.Key</pre>
                <div class="flex items-center gap-3 mt-2">
                    <button type="button" class="btn-primary" @onclick="() => Copy(_minted.Key)">Copy key</button>
                    <button type="button" class="btn-mini" @onclick="Dismiss">Done</button>
                    @if (_copied) {
                        <span class="text-green-400 text-sm">Copied.</span>
                    }
                </div>
            </div>
        } else {
            <div>
                @if (_keys is not null) {
                    <p class="text-muted text-xs mt-0 mb-2">@(_cap is { } c ? $"{ActiveCount}/{c} keys used" : "No key limit for your account.")</p>
                }
                <div class="flex items-end gap-3">
                    <label class="sub-field w-full max-w-xs">
                        <span class="sub-field-label">Name</span>
                        <input class="field-input w-full" placeholder="my integration" disabled="@AtCap" @bind="_name" @bind:event="oninput"/>
                    </label>
                    <button type="button" class="btn-primary shrink-0" disabled="@(_busy || AtCap || string.IsNullOrWhiteSpace(_name))" @onclick="Create">
                        @(_busy ? "Creating..." : "Create key")
                    </button>
                </div>
                @if (AtCap) {
                    <p class="text-muted text-sm mt-2 mb-0">Key limit reached - revoke a key to mint a new one.</p>
                } else if (_error is not null) {
                    <p class="text-err text-sm mt-2 mb-0">@_error</p>
                }
            </div>
        }

        @if (_keys is null) {
            <p class="text-muted text-sm m-0">Loading...</p>
        } else if (_keys.Count == 0) {
            <div class="reg-empty">
                <div>No API keys yet.</div>
                <div class="reg-empty-hint">Create one above to use the data API.</div>
            </div>
        } else {
            <div class="reg-wrap">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Prefix</th><th>Name</th><th>Last used</th><th>Requests</th><th>Status</th><th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var k in _keys) {
                        <tr class="@(k.Revoked ? "text-muted" : null)">
                            <td class="mono text-xs">@($"{k.Prefix}…")</td>
                            <td class="font-medium">@k.Name</td>
                            <td class="text-muted text-xs">@(k.LastUsedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "never")</td>
                            <td class="mono text-xs">@k.RequestCount</td>
                            <td>
                                <span class="@(k.Revoked ? "text-muted" : "text-green-400") inline-flex items-center gap-1.5">
                                    <span style="width:8px;height:8px;border-radius:9999px;background:currentColor;display:inline-block"></span>
                                    @(k.Revoked ? "revoked" : "active")
                                </span>
                            </td>
                            <td>
                                @if (!k.Revoked) {
                                    <button type="button" class="btn-mini btn-danger" disabled="@_busyRow" @onclick="() => Revoke(k.Id)">Revoke</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    string _baseAddress = "";
    string? _cookie;
    string _origin = "https://eggincognito.davidarthurcole.me";

    bool _noDb;
    List<KeyRow>? _keys;
    int? _cap;
    string _name = "";
    bool _busy;
    private bool _busyRow { get; set; }

    string? _error;
    Minted? _minted;
    bool _copied;
    IJSObjectReference? _copy;

    int ActiveCount => _keys?.Count(k => !k.Revoked) ?? 0;

    bool AtCap => _cap is { } c && ActiveCount >= c;

    protected override async Task OnInitializedAsync() {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null) {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _origin = _baseAddress;
            _cookie = req.Headers.Cookie;
        }

        await LoadKeys();
    }

    HttpClient Client() {
        return SelfCallClient.Create(HttpFactory, _baseAddress, _cookie);
    }

    async Task LoadKeys() {
        try {
            var res = await Client().GetAsync("/api/v1/keys");
            if (res.StatusCode == HttpStatusCode.ServiceUnavailable) {
                _noDb = true;
                return;
            }

            if (res.IsSuccessStatusCode) {
                var body = await res.Content.ReadFromJsonAsync<KeysResponse>(JsonOpts);
                _keys = body?.Keys ?? [];
                _cap = body?.Cap;
            } else {
                _keys ??= [];
            }
        }
        catch {
            _keys ??= [];
        }
    }

    async Task Create() {
        _busy = true;
        _error = null;
        _copied = false;
        try {
            var res = await Client().PostAsJsonAsync("/api/v1/keys", new { name = _name }, JsonOpts);
            if (res.IsSuccessStatusCode) {
                _minted = await res.Content.ReadFromJsonAsync<Minted>(JsonOpts);
                _name = "";
                await LoadKeys();
            } else if (res.StatusCode == HttpStatusCode.ServiceUnavailable) {
                _noDb = true;
            } else if (res.StatusCode == HttpStatusCode.Conflict) {
                string? msg = null;
                try {
                    msg = (await res.Content.ReadFromJsonAsync<ErrorBody>(JsonOpts))?.Error;
                }
                catch {
                }

                _error = string.IsNullOrWhiteSpace(msg) ? "Key limit reached." : msg;
            } else {
                _error = $"Create failed ({(int)res.StatusCode}).";
            }
        }
        catch (Exception ex) {
            _error = $"Create failed: {ex.Message}";
        }

        _busy = false;
    }

    async Task Revoke(long id) {
        _busyRow = true;
        try {
            var res = await Client().DeleteAsync($"/api/v1/keys/{id}");
            if (res.IsSuccessStatusCode) await LoadKeys();
        }
        catch {
        }

        _busyRow = false;
    }

    async Task Copy(string text) {
        try {
            _copy ??= await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/copy.js"));
            await _copy.InvokeAsync<bool>("writeText", text);
            _copied = true;
        }
        catch {
        }
    }

    void Dismiss() {
        _minted = null;
        _copied = false;
    }

    record KeysResponse(List<KeyRow> Keys, int? Cap);

    record KeyRow(long Id, string Name, string Prefix, DateTimeOffset CreatedAt, DateTimeOffset? LastUsedAt, long RequestCount, bool Revoked);

    record Minted(long Id, string Name, string Prefix, string Key);

    record ErrorBody(string? Error);

}
