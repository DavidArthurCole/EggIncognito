@inject IAppMode AppMode
@inject ICurrentUser User

<section class="panel pd-w-support">
    <div class="flex items-center justify-between gap-2">
        <h3 class="text-sm font-semibold m-0">Support</h3>
        <button type="button" class="dropzone-open" aria-label="Support the project"
                @onclick="@(() => OnOpenSupport.InvokeAsync())">
            <Icon Name="chevron-right" Class="icon-sm"/>
        </button>
    </div>
    <p class="text-muted text-xs m-0">
        EggIncognito, EggIdentity, and EggLedger are free open-source tools; the hosting runs at a monthly deficit.
    </p>
    @if (_canCapture) {
        <button type="button" class="btn-primary w-fit" @onclick="@(() => OnOpenCapture.InvokeAsync())">Open capture</button>
    }
</section>

@code {
    [Parameter] public EventCallback OnOpenCapture { get; set; }

    [Parameter] public EventCallback OnOpenSupport { get; set; }

    bool _canCapture;

    protected override void OnInitialized() {
        _canCapture = AppMode.CanCapture || User.IsSupporter || User.IsAtLeast(UserRole.Admin);
    }

}
