@* Admin-only backfill status report, rendered below the registry table on /protos. Three source rows
   (GitHub / Android / Apple) showing the latest job status, plus the known_versions discovery list
   with per-row "Extract proto" actions. Page-level controls (triggers, force re-sync) live in the
   nav Backfill popover; this panel is status-only and auto-polls
   GET /api/protos/backfill/status every ~3s. Server ACL is the real gate; the parent only renders
   this for admins. *@
@rendermode @(RenderMode.InteractiveServer)
@implements IDisposable
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor

<section class="admin-panel" id="backfillPanel">
  <div class="admin-panel-head">
    <h2 class="admin-panel-title">Backfill</h2>
    <span class="text-muted text-xs">Controls live in the nav Backfill menu. Status auto-refreshes.</span>
  </div>

  <div class="backfill-sources">
    @foreach (var s in Sources)
    {
      var job = JobFor(s.JobSource);
      <div class="backfill-row">
        <div class="backfill-row-main">
          <div class="backfill-name">@s.Label</div>
          <div class="backfill-sub">@s.Hint</div>
        </div>
        <div class="backfill-status">
          @if (job is null)
          {
            <span class="pill">never run</span>
          }
          else
          {
            <span class="pill @StatusPill(job.Status)">@StatusText(job)</span>
            @if (!string.IsNullOrEmpty(job.Note))
            {
              <span class="backfill-note" title="@job.Note">@Truncate(job.Note)</span>
            }
          }
        </div>
      </div>
    }
  </div>

  @if (!string.IsNullOrEmpty(_message))
  {
    <p class="backfill-message">@_message</p>
  }

  <div class="admin-panel-head admin-panel-sub">
    <h3 class="admin-panel-title">Missing versions</h3>
    <span class="text-muted text-xs">@MissingKnown.Count of @_known.Count have no stored proto</span>
  </div>
  <p class="text-muted text-xs">Discovered versions not yet in the registry. Android extract pulls the APK
    from APKPure by version and runs the toolchain (needs the extract host; 501 otherwise). iOS has no
    free binary source - drop the .ipa above to analyze, or use the device farm.</p>

  @if (MissingKnown.Count == 0)
  {
    <div class="backfill-empty">
      @(_known.Count == 0 ? "No discovered versions. Run a list import above." : "Every discovered version already has a stored proto.")
    </div>
  }
  else
  {
    <div class="known-wrap">
      <table class="reg-table known-table">
        <thead>
          <tr>
            <th>Platform</th>
            <th>App Version</th>
            <th>Source</th>
            <th>Release</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var k in MissingKnown)
          {
            var ej = ExtractFor(k.Platform, k.AppVersion);
            <tr>
              <td><span class="code-chip">@k.Platform</span></td>
              <td class="mono">@k.AppVersion</td>
              <td class="text-muted">@k.Source</td>
              <td class="text-muted">@(k.ReleaseDate?.ToString("yyyy-MM-dd") ?? "")</td>
              <td>
                @if (IsIos(k.Platform))
                {
                  <span class="text-muted text-xs" title="No free App Store binary source. Drop the .ipa in the analyzer above, or use the device farm.">drop .ipa to extract</span>
                }
                else if (ej is { Status: "running" or "queued" })
                {
                  <span class="pill running known-pill">Extracting...</span>
                }
                else if (ej is { Status: "done" })
                {
                  <span class="pill done known-pill" title="@ej.Note">Done</span>
                }
                else if (ej is { Status: "failed" })
                {
                  <span class="pill failed known-pill" title="@ej.Note">Failed</span>
                  <button type="button" class="btn-mini" disabled="@_busy"
                          @onclick="@(() => Extract(k.Platform, k.AppVersion))">Retry</button>
                }
                else
                {
                  <button type="button" class="btn-mini" disabled="@_busy"
                          @onclick="@(() => Extract(k.Platform, k.AppVersion))">Extract proto</button>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>

@code {
    static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new(System.Text.Json.JsonSerializerDefaults.Web);

    // GitHub -> elgranjero; Android -> fandom list; Apple -> itunes / archive lists. The job source key
    // matches what the importer writes (source.Name: elgranjero / fandom / itunes / archive).
    static readonly SourceRow[] Sources =
    [
        new("GitHub", "elgranjero / EggIncProtos, full history with proto text", "github", "elgranjero"),
        new("Android", "Fandom wiki version history (with changelogs)", "android", "fandom"),
        new("Apple", "iTunes lookup, current iOS version metadata", "apple", "itunes"),
        new("Apple (Archive history)", "Internet Archive, older iOS versions", "archive", "archive"),
    ];

    List<JobRow> _jobs = [];
    List<KnownRow> _known = [];
    List<ExtractRow> _extractJobs = [];
    // (platform, appVersion) pairs already in the registry, so the discovery list can hide them.
    HashSet<(string Platform, string AppVersion)> _stored = [];
    bool _busy;
    string? _message;

    // Discovered versions with no stored proto yet - the actionable gap. Hides the noise of versions the
    // registry already has (most of the fandom history is already covered).
    List<KnownRow> MissingKnown =>
        _known.Where(k => !_stored.Contains((k.Platform, k.AppVersion))).ToList();

    string _baseAddress = "";
    string? _cookie;

    System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Prune keyless/stub rows once on admin load, then load fresh status.
        try { await Client().PostAsync("/api/protos/backfill/prune", null); } catch { }
        await Load();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Poll every 3s so jobs triggered from the nav popover show up here.
            _timer = new System.Threading.Timer(async _ => await Tick(), null,
                TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
    }

    // Triggers now fire from the nav popover, so always reload: a job started elsewhere must show up
    // here without a manual refresh.
    async Task Tick() => await InvokeAsync(async () => { await Load(); StateHasChanged(); });

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    async Task Load()
    {
        try
        {
            var res = await Client().GetFromJsonAsync<StatusResponse>("/api/protos/backfill/status", JsonOpts);
            _jobs = res?.Jobs ?? [];
            _known = res?.Known ?? [];
            _extractJobs = res?.ExtractJobs ?? [];

            // Cross-reference the registry so the discovery list can hide versions already stored.
            var versions = await Client().GetFromJsonAsync<List<RegRow>>("/api/protos/versions", JsonOpts);
            _stored = versions is null
                ? []
                : versions.Select(v => (v.Platform, v.AppVersion)).ToHashSet();
        }
        catch { _jobs = []; _known = []; _extractJobs = []; _stored = []; }
    }

    JobRow? JobFor(string source) => _jobs.FirstOrDefault(j => j.Source == source);

    ExtractRow? ExtractFor(string platform, string appVersion) =>
        _extractJobs.FirstOrDefault(e => e.Platform == platform && e.AppVersion == appVersion);

    static bool IsIos(string platform) => string.Equals(platform, "ios", StringComparison.OrdinalIgnoreCase);

    async Task Extract(string platform, string appVersion)
    {
        _busy = true;
        _message = null;
        // Optimistic: flip the row to running locally so the UI reacts before the poll catches up.
        _extractJobs = _extractJobs
            .Where(e => !(e.Platform == platform && e.AppVersion == appVersion))
            .Append(new ExtractRow(platform, appVersion, "running", null, null))
            .ToList();
        try
        {
            var res = await Client().PostAsJsonAsync("/api/protos/backfill/apk-extract",
                new { appVersion }, JsonOpts);
            if ((int)res.StatusCode == 501)
            {
                _message = "Proto extraction is not configured on this host. It needs a host with the "
                    + "extract toolchain (java + python); most hosts return 501.";
            }
            else
            {
                _message = res.IsSuccessStatusCode
                    ? $"Extract started for {appVersion}."
                    : $"Extract failed ({(int)res.StatusCode}).";
            }
        }
        catch (Exception ex) { _message = $"Extract failed: {ex.Message}"; }
        _busy = false;
        await Load();
    }

    static string StatusPill(string status) => status switch
    {
        "running" => "running",
        "failed" => "failed",
        _ => "done",
    };

    static string StatusText(JobRow j) => j.Status switch
    {
        "running" => $"running ({j.Imported})",
        "done" => $"done ({j.Imported})",
        "failed" => "failed",
        _ => j.Status,
    };

    static string Truncate(string s) => s.Length <= 60 ? s : s[..60] + "...";

    public void Dispose() => _timer?.Dispose();

    sealed record SourceRow(string Label, string Hint, string Trigger, string JobSource);
    sealed record StatusResponse(List<JobRow> Jobs, List<KnownRow> Known, List<ExtractRow> ExtractJobs);
    sealed record JobRow(string Source, string Status, DateTimeOffset StartedAt,
        DateTimeOffset? FinishedAt, int Imported, int? Total, string? Note);
    sealed record KnownRow(string Platform, string AppVersion, DateTimeOffset? ReleaseDate,
        string? Changelog, string Source);
    sealed record ExtractRow(string Platform, string AppVersion, string Status,
        DateTimeOffset? FinishedAt, string? Note);
    sealed record RegRow(string Platform, string AppVersion);
}
