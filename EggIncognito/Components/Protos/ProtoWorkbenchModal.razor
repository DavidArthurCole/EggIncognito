    public void OpenAt(ProtoRef a, ProtoRef? b, string? mode) {
        State.A = a;
        State.B = b;
        State.Mode = ModeOrDefault(mode, b);
        State.Cached = null;
        State.CachedKey = null;
        _hunk = 0;
        _notice = null;
        Open();
        _ = ResolvePair();
    }

    static string ModeOrDefault(string? mode, ProtoRef? b) {
        if (mode is { Length: > 0 }
            && ProtoRefParser.Modes.FirstOrDefault(m => m.Equals(mode, StringComparison.OrdinalIgnoreCase)) is { } known) {
            return known;
        }

        return b is null ? "text" : "split";
    }

    public void Close() {
        var was = _open;
        _open = false;
        _settingsOpen = false;
        _dlOpen = false;
        if (!was) return;
        StateHasChanged();
        if (OnClosed.HasDelegate) _ = OnClosed.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            await LoadPrefs();
