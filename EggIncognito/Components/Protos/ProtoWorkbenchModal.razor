@rendermode @(RenderMode.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ICurrentUser User
@inject NavigationManager Nav
@inject ProtoWorkbenchState State
@inject ILogger<ProtoWorkbenchModal> Logger
@using System.Globalization
@using System.Text
@using System.Text.Json
@using EggIncognito.Core
@using EggIncognito.Services.ProtoExtract
@using EggIncognito.Services.Protos
@using Microsoft.AspNetCore.Components.Web.Virtualization
@implements IAsyncDisposable

<InputFile id="wbFile" accept=".ipa,.apk,.apkm,.xapk" multiple hidden OnChange="OnFilesSelected"/>

@if (_open) {
    var groups = Groups();
    var offerAllCount = groups.Count(CanOffer);
    var counterparts = CounterpartLinks();
    <ModalShell Title="Proto workbench" CardClass="pwb-card" OnClose="Close">
    <HeadTools>
        <div class="wb-head-tools">
            <label for="wbFile" class="btn-mini cursor-pointer m-0">Add files</label>
            @if (offerAllCount > 0) {
                <button type="button" class="btn-mini" disabled="@_offerBusy" @onclick="@(() => OfferAll(groups))">
                    <Icon Name="arrow-up" Class="icon-sm"/> Offer all (@offerAllCount)
                </button>
            }
            @if (State.B is not null) {
                <button type="button" class="btn-mini" title="Swap A and B" aria-label="Swap A and B" @onclick="SwapRefs">
                    <Icon Name="swap" Class="icon-sm"/>
                </button>
                <button type="button" class="btn-mini" title="Clear B" aria-label="Clear B" @onclick="ClearB">Clear B</button>
            }
            <button type="button" class="btn-mini" title="Settings" aria-label="Settings"
                    @onclick="@(() => _settingsOpen = !_settingsOpen)">
                <Icon Name="gear" Class="icon-sm"/>
            </button>
            @if (_settingsOpen) {
                <div class="popover-backdrop" @onclick="@(() => _settingsOpen = false)" @onclick:stopPropagation="true"></div>
                <div class="wb-settings" @onclick:stopPropagation="true">
                    <label class="wb-settings-row">
                        <span>Name length</span>
                        <input type="number" class="flow-filter-input" min="8" max="96" @key="_truncInputKey"
                               value="@_truncLen" @onchange="OnTruncLenChanged"/>
                    </label>
                    <label class="wb-settings-row">
                        <span>Truncate</span>
                        <select class="flow-filter-select" value="@_truncMode" @onchange="OnTruncModeChanged">
                            <option value="off">off</option>
                            <option value="card">card only</option>
                            <option value="everywhere">everywhere</option>
                        </select>
                    </label>
                </div>
            }
            <button type="button" class="reg-edit-btn" title="Close" aria-label="Close" @onclick="Close">
                <Icon Name="x"/>
            </button>
        </div>
    </HeadTools>
    <ChildContent>
    <div class="wb-body" id="wbDrop">
    <aside class="wb-rail">
        <section class="pwb-rail-sec">
            <button type="button" class="pwb-sec-head" @onclick="@(() => _registryOpen = !_registryOpen)">
                <Icon Name="@(_registryOpen ? "chevronDown" : "chevronRight")" Class="icon-sm"/>
                <span>Registry</span>
                <span class="pwb-sec-count">@State.Registry.Count</span>
            </button>
            @if (_registryOpen) {
                var items = RegistryItems();
                <div class="pwb-sec-body">
                    <div class="pwb-chips">
                        <button type="button" class="pwb-chip @(_regPlatform.Length == 0 ? "pwb-chip-on" : "")"
                                @onclick="@(() => SetRegPlatform(""))">
                            all
                        </button>
                        <button type="button" class="pwb-chip @(_regPlatform == "android" ? "pwb-chip-on" : "")"
                                @onclick="@(() => SetRegPlatform("android"))">
                            android
                        </button>
                        <button type="button" class="pwb-chip @(_regPlatform == "ios" ? "pwb-chip-on" : "")"
                                @onclick="@(() => SetRegPlatform("ios"))">
                            ios
                        </button>
                    </div>
                    <input class="pwb-filter" placeholder="version, build, client, sha"
                           value="@_regFilter" @oninput="OnRegFilterChanged"/>
                    @if (items.Count == 0) {
                        <div class="pwb-reg-empty text-muted text-xs">
                            @(State.Registry.Count == 0 ? "No stored versions yet." : "No versions match this filter.")
                        </div>
                    } else {
                        <div class="pwb-reg-list">
                            <Virtualize Items="items" Context="item" ItemSize="44">
                                @if (item.Row is { } row) {
                                    <div class="pwb-reg-row @RowClass(row)" @onclick="@(args => RegistryRowClick(row, args))">
                                        <div class="pwb-reg-main">
                                            @Ver(Segments(row.AppVersion, row.Build, row.ClientVersion))
                                            @if (RefMark(RegistryRef(row)) is { Length: > 0 } mark) {
                                                <span class="pwb-ab @(mark == "A" ? "pwb-ab-a" : "pwb-ab-b")">@mark</span>
                                            }
                                        </div>
                                        <div class="pwb-reg-meta">
                                            <span class="pwb-reg-sha">@Sha12(row.ProtoSha)</span>
                                            @if (!string.IsNullOrWhiteSpace(row.Source)) {
                                                <span class="pwb-reg-src">@row.Source</span>
                                            }
                                            @if (!HasText(row)) {
                                                <span class="pwb-notext">no text</span>
                                            }
                                            <button type="button" class="pwb-pin" title="Set as B" aria-label="Set as B"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="@(() => SetB(RegistryRef(row)))">
                                                B
                                            </button>
                                        </div>
                                    </div>
                                } else {
                                    <div class="pwb-reg-group">@item.Header</div>
                                }
                            </Virtualize>
                        </div>
                    }
                </div>
            }
        </section>
        <section class="pwb-rail-sec">
            <button type="button" class="pwb-sec-head" @onclick="@(() => _sessionOpen = !_sessionOpen)">
                <Icon Name="@(_sessionOpen ? "chevronDown" : "chevronRight")" Class="icon-sm"/>
                <span>Session</span>
                <span class="pwb-sec-count">@State.Entries.Count</span>
            </button>
            @if (_sessionOpen) {
                <div class="pwb-sec-body">
                    @if (State.Entries.Count == 0) {
                        <div class="wb-rail-empty">
                            <div class="text-muted text-xs">Drop .ipa, .apk, or bundle files anywhere in this window, or use Add files.</div>
                        </div>
                    }
                    @foreach (var e in State.Entries.Where(x => !x.IsAnalyzed)) {
                        @Card(e, null, false)
                    }
                    @foreach (var g in groups) {
                        @if (g.Members.Count > 1) {
                            <div class="wb-group @(g.Conflict ? "conflict" : "")">
                                <div class="wb-group-head">
                                    @Ver(g.Segs)
                                    @if (g is { Conflict: false, Status.Offerable: true }) {
                                        <span title="offerable">
                                            <Icon Name="arrow-up" Class="icon-sm wb-st-offer"/>
                                        </span>
                                    } else {
                                        <span class="wb-badge @BadgeClass(g)">@BadgeText(g)</span>
                                    }
                                    @if (g.Status is { Failed: true }) {
                                        <button type="button" class="btn-mini ml-auto" title="Retry check" aria-label="Retry check"
                                                @onclick="@(() => RetryCheck(g))">
                                            <Icon Name="refresh" Class="icon-sm"/> Retry
                                        </button>
                                    }
                                </div>
                                <div class="wb-group-body">
                                    @foreach (var e in g.Members) {
                                        @Card(e, g, true)
                                    }
                                </div>
                            </div>
                        } else {
                            @Card(g.Members[0], g, false)
                        }
                    }
                </div>
            }
        </section>
    </aside>
    <section class="wb-main">
        <div class="pwb-bar">
            <span class="pwb-bar-slot">
                <span class="pwb-ab pwb-ab-a">A</span>
                <span class="pwb-bar-val">@RefLabel(State.A)</span>
                @if (State.A is { } refA) {
                    if (!HasTextFor(refA)) {
                        <span class="pwb-notext">no text</span>
                    }

                    if (IsLegacySha(refA)) {
                        <span class="pwb-legacy" title="The stored sha does not match the canonical form of the stored text">legacy sha</span>
                    }
                }
            </span>
            <span class="pwb-bar-slot">
                <span class="pwb-ab pwb-ab-b">B</span>
                <span class="pwb-bar-val">@RefLabel(State.B)</span>
                @if (State.B is { } refB) {
                    if (!HasTextFor(refB)) {
                        <span class="pwb-notext">no text</span>
                    }

                    if (IsLegacySha(refB)) {
                        <span class="pwb-legacy" title="The stored sha does not match the canonical form of the stored text">legacy sha</span>
                    }
                }
                @if (TierOf(counterparts, State.B) is { } tier) {
                    <span class="pwb-tier @(tier.Weak ? "pwb-tier-weak" : "")" title="@TierTitle(tier)">@tier.Reason</span>
                }
            </span>
        </div>
        @if (_notice is { Length: > 0 } notice) {
            <div class="pwb-toast">
                <span>@notice</span>
                <button type="button" class="wb-x" title="Dismiss" aria-label="Dismiss" @onclick="@(() => _notice = null)">
                    <Icon Name="x" Class="icon-sm"/>
                </button>
            </div>
        }
        @{
            var selGroup = Selected is { } current
                ? groups.FirstOrDefault(x => x.Members.Any(m => m.Id == current.Id))
                : null;
        }
        @if (Selected is { } sel && ShowStatus(sel)) {
            <div class="pwb-status">
                <span class="font-mono text-xs break-all">@DetailName(sel.FileName)</span>
                @if (sel.Status == "error") {
                    <span class="wb-badge wb-badge-failed">@(sel.Error ?? "failed")</span>
                } else if (!sel.IsDone) {
                    <span class="text-muted text-xs">@sel.Status@(sel.Step is { Length: > 0 } ? $": {sel.Step}" : "")...</span>
                } else if (sel.Result is { } r) {
                    <span class="font-mono text-muted text-xs">@(r.Messages.Count) - @Sha12(r.ProtoSha)</span>
                    @if (SizeFlow(r) is { Count: > 0 } sizes) {
                        <span class="font-mono text-muted text-xs">
                            @for (var i = 0; i < sizes.Count; i++) {
                                if (i > 0) {
                                    <span class="wb-arrow">&rarr;</span>
                                }

                                @sizes[i]
                            }
                        </span>
                    }

                    @if (selGroup is { Conflict: true }) {
                        <span class="wb-badge wb-badge-conflict">conflict</span>
                        <span class="text-muted text-xs">Pick the file to offer in the rail.</span>
                    } else if (selGroup?.Status is { Known: true }) {
                        <span class="wb-badge wb-badge-known">in registry</span>
                    } else if (selGroup?.Status is { InRegistry: true }) {
                        <span class="wb-badge wb-badge-known">sha in registry</span>
                        <span class="text-muted text-xs">This proto text is already stored under different version metadata.</span>
                    } else if (selGroup?.Status is { Failed: true }) {
                        <span class="wb-badge wb-badge-failed">check failed</span>
                        <button type="button" class="btn-mini" title="Retry check" aria-label="Retry check"
                                @onclick="@(() => RetryCheck(selGroup))">
                            <Icon Name="refresh" Class="icon-sm"/> Retry
                        </button>
                    } else if (selGroup?.Status is { Pending: true } or { Offered: true }) {
                        <span class="wb-badge wb-badge-pending">pending review</span>
                    } else if (selGroup?.Status is { Offerable: true }) {
                        @if (User.IsAuthenticated) {
                            <span class="wb-badge wb-badge-open">offerable</span>
                        } else {
                            <span class="text-muted text-xs">Log in to offer this version to the registry.</span>
                        }
                    }

                    @if (selGroup is { } sg && CanOffer(sg)) {
                        <button type="button" class="btn-mini" title="Offer to registry" disabled="@_offerBusy"
                                @onclick="@(() => Offer(sg))">
                            <Icon Name="arrow-up" Class="icon-sm"/> Offer
                        </button>
                    }
                }
            </div>
        }
        <div class="pwb-modes" role="group" aria-label="View mode">
            @foreach (var m in ProtoRefParser.Modes) {
                <button type="button" class="pwb-mode @(State.Mode == m ? "pwb-mode-on" : "")"
                        disabled="@ModeDisabled(m)" title="@ModeTitle(m)" @onclick="@(() => SetMode(m))">
                    @m
                </button>
            }
        </div>
        <div class="pwb-tools">
            <select class="flow-filter-select" value="@CompareValue()" @onchange="OnCompareToChanged">
                <option value="">no B</option>
                @if (LatestRef() is not null) {
                    <option value="latest">latest registry</option>
                }
                @if (StepRef(1) is not null) {
                    <option value="prev">previous version</option>
                }
                @foreach (var e in State.Entries.Where(x => x.IsAnalyzed)) {
                    @if (SessionRef(e) is { } sr && !SameRef(State.A, sr)) {
                        <option value="@sr.Format()">@OptionLabel(e)</option>
                    }
                }
                @foreach (var row in RegistryOptions()) {
                    <option value="@RegistryRef(row).Format()">@row.Platform @(string.Join(" | ", Segments(row.AppVersion, row.Build, row.ClientVersion)))</option>
                }
            </select>
            <button type="button" class="btn-mini" title="Older version" aria-label="Older version"
                    disabled="@(StepRef(1) is null)" @onclick="@(() => SetA(StepRef(1)))">
                <Icon Name="chevronLeft" Class="icon-sm"/>
            </button>
            <button type="button" class="btn-mini" title="Newer version" aria-label="Newer version"
                    disabled="@(StepRef(-1) is null)" @onclick="@(() => SetA(StepRef(-1)))">
                <Icon Name="chevronRight" Class="icon-sm"/>
            </button>
            <button type="button" class="btn-mini" title="Compare against the previous version"
                    disabled="@(StepRef(1) is null)" @onclick="@(() => SetB(StepRef(1)))">
                vs previous
            </button>
            <button type="button" class="btn-mini" title="Compare against the latest stored version"
                    disabled="@(LatestRef() is null)" @onclick="@(() => SetB(LatestRef()))">
                vs latest
            </button>
            @foreach (var target in CounterpartTargets()) {
                var link = counterparts.FirstOrDefault(l => l.Platform == target);
                <button type="button" class="btn-mini @(link is { Found: false } ? "pwb-dim" : "")"
                        disabled="@(link is null)" title="@CounterpartTitle(target, link)"
                        @onclick="@(() => SetCounterpart(link))">
                    vs @target
                </button>
            }
            @if (IsLineMode()) {
                <input type="search" class="pwb-tool-filter" placeholder="Filter lines..." autocomplete="off"
                       value="@_filter" @oninput="OnLineFilterChanged"/>
                <button type="button" class="btn-mini @(_wrap ? "active" : "")" title="Toggle word wrap"
                        @onclick="@(() => _wrap = !_wrap)">
                    wrap
                </button>
                <button type="button" class="btn-mini @(_context == FullContext ? "active" : "")"
                        title="Toggle full file context" @onclick="ToggleContext">
                    @(_context == FullContext ? "all" : "3") ctx
                </button>
                @if (HunkCount() > 0) {
                    <span class="pwb-hunk">
                        <button type="button" class="btn-mini" title="Previous hunk" aria-label="Previous hunk"
                                @onclick="@(() => StepHunk(-1))">
                            &uarr;
                        </button>
                        <span class="pwb-hunk-at">@(_hunk + 1)/@HunkCount()</span>
                        <button type="button" class="btn-mini" title="Next hunk" aria-label="Next hunk"
                                @onclick="@(() => StepHunk(1))">
                            &darr;
                        </button>
                    </span>
                }
            }
            <CopyButton GetText="ViewText" ButtonClass="btn-mini" IconClass="icon-sm" Label="Copy" CopiedLabel="Copied"/>
            <CopyButton GetText="Permalink" ButtonClass="btn-mini" IconClass="icon-sm" Label="Link" CopiedLabel="Copied"
                        Title="Copy a link to this view"/>
            <button type="button" class="btn-mini" title="Download" aria-label="Download"
                    @onclick="@(() => _dlOpen = !_dlOpen)">
                <Icon Name="download" Class="icon-sm"/>
            </button>
            @if (_dlOpen) {
                <div class="popover-backdrop" @onclick="@(() => _dlOpen = false)" @onclick:stopPropagation="true"></div>
                <div class="pwb-dl" @onclick:stopPropagation="true">
                    @if (State.A is { } dlA) {
                        @DownloadItem(dlA, "A")
                    }
                    @if (State.B is { } dlB) {
                        @DownloadItem(dlB, "B")
                    }
                    @if (State.Cached is { } dlBundle) {
                        @if (ApiPair() is { Length: > 0 } api) {
                            <a class="pwb-dl-item" href="@($"/api/protos/diff?{api}&format=unified&download=1")"
                               target="_blank" rel="noopener">
                                unified .diff
                            </a>
                            <a class="pwb-dl-item" href="@($"/api/protos/diff?{api}&format=json&download=1")"
                               target="_blank" rel="noopener">
                                structural .json
                            </a>
                        } else {
                            <button type="button" class="pwb-dl-item" @onclick="@(() => DownloadUnified(dlBundle))">unified .diff</button>
                            <button type="button" class="pwb-dl-item" @onclick="@(() => DownloadJson(dlBundle))">structural .json</button>
                        }
                    }
                </div>
            }
        </div>
        @if (IsDiffMode() && State.Cached is { } sumBundle) {
            <div class="pwb-sum">
                <span class="pwb-sum-add">+@sumBundle.Summary.LinesAdded</span>
                <span class="pwb-sum-rem">-@sumBundle.Summary.LinesRemoved</span>
                @foreach (var part in SummaryParts(sumBundle.Summary)) {
                    <span class="pwb-sum-k">@part</span>
                }
            </div>
        }
        <div class="pwb-view" id="pwbView">
            @if (State.A is not { } viewA) {
                <div class="text-muted text-sm">Pick a stored version in the rail, or add files. Archives are unpacked in the browser; the app binary is uploaded and parsed server-side.</div>
            } else if (State.Mode == "meta") {
                <table class="data-table">
                    <thead>
                    <tr>
                        <th></th><th>@RefLabel(State.A)</th><th>@RefLabel(State.B)</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in MetaRows()) {
                        <tr class="@(row.Same ? "" : "pwb-meta-diff")">
                            <td class="text-muted">@row.Key</td>
                            <td class="mono text-xs break-all">@row.A</td>
                            <td class="mono text-xs break-all">@row.B</td>
                        </tr>
                    }
                    </tbody>
                </table>
            } else if (State.Mode == "text") {
                @if (!HasTextFor(viewA)) {
                    <div class="pwb-note">No stored proto text for this version.</div>
                } else if (TextOf(viewA) is { Length: > 0 } textA) {
                    <CodeTextView Text="@textA" MaxHeight="48vh" LineNumbers="true"/>
                } else {
                    <div class="text-muted text-xs">loading...</div>
                }
            } else if (State.B is not { } viewB) {
                <div class="pwb-note">Pick a B side in the rail to diff against.</div>
            } else if (!HasTextFor(viewA) || !HasTextFor(viewB)) {
                <div class="pwb-note">No stored proto text for @(HasTextFor(viewA) ? "B" : "A").</div>
            } else if (Identical()) {
                <div class="pwb-note pwb-note-ok">A and B are the same proto (matching sha). Nothing to diff.</div>
            } else if (State.Cached is { } bundle) {
                @if (_degraded) {
                    <div class="pwb-note pwb-note-warn">These files are too large to diff line by line, so the whole changed region is shown as one block.</div>
                }

                @if (State.Mode == "split") {
                    <DiffSplitView Result="bundle.Split" Filter="@_filter" WordWrap="_wrap" MaxHeight="48vh" OnHunk="OnHunkPicked"/>
                } else if (State.Mode == "unified") {
                    <DiffUnifiedView UnifiedText="@bundle.Unified" Filter="@_filter" WordWrap="_wrap" MaxHeight="48vh"/>
                } else {
                    <ProtoDiffView Diff="bundle.Structural" EmptyText="No structural differences."/>
                }
            } else {
                <div class="text-muted text-xs">comparing...</div>
            }
        </div>
    </section>
    </div>
    </ChildContent>
    </ModalShell>
}

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    const string MissingText = "\u0000";

    const int DefaultContext = 3;

    const int FullContext = 100_000;

    const int DiffRowHeight = 20;

    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public EventCallback<WorkbenchRef> OnRefChanged { get; set; }

    [Parameter] public EventCallback OnClosed { get; set; }

    bool _open;
    bool _dropWired;
    bool _offerBusy;
    bool _settingsOpen;
    bool _registryOpen = true;
    bool _sessionOpen = true;
    string _regPlatform = "";
    string _regFilter = "";
    int _truncLen = 20;
    string _truncMode = "card";
    IJSObjectReference? _strip;
    IJSObjectReference? _download;
    IJSObjectReference? _prefs;
    DotNetObjectReference<ProtoWorkbenchModal>? _selfRef;
    readonly SemaphoreSlim _gate = new(2, 2);
    readonly HashSet<string> _checking = [];
    readonly Dictionary<string, bool> _legacy = [];
    bool _wrap;
    bool _dlOpen;
    bool _degraded;
    int _context = DefaultContext;
    int _hunk;
    string _filter = "";
    string? _notice;
    List<int> _unifiedHunks = [];

    StagedEntry? Selected => State.Find(State.SelectedId);

    RenderFragment Ver(IReadOnlyList<string> segs) => @<span class="dev-verline">
                                                          @for (var i = 0; i < segs.Count; i++) {
                                                              if (i > 0) {
                                                                  <span class="dev-versep">|</span>
                                                              }

                                                              @segs[i]
                                                          }
                                                      </span>;

    RenderFragment Card(StagedEntry e, OfferGroup? g, bool grouped) => @<div class="wb-entry @(State.SelectedId == e.Id ? "selected" : "")"
                                                                             @key="e.Id" @onclick="@(args => Select(e, args))">
                                                                           <div class="flex items-start gap-1">
                                                                               @if (g is { MultiSha: true } grp) {
                                                                                   <input type="radio" class="wb-radio" name="@("wbg-" + grp.Key)"
                                                                                          checked="@(grp.Winner?.Id == e.Id)"
                                                                                          @onclick:stopPropagation="true"
                                                                                          @onchange="@(() => PickWinner(grp, e))"/>
                                                                               }
                                                                               <span class="wb-entry-name">@CardName(e.FileName)</span>
                                                                               @if (RefMark(SessionRef(e)) is { Length: > 0 } mark) {
                                                                                   <span class="pwb-ab @(mark == "A" ? "pwb-ab-a" : "pwb-ab-b")">@mark</span>
                                                                               }
                                                                               <button type="button" class="wb-x" title="Remove" aria-label="Remove"
                                                                                       @onclick:stopPropagation="true" @onclick="@(() => Remove(e))">
                                                                                   <Icon Name="x" Class="icon-sm"/>
                                                                               </button>
                                                                           </div>
                                                                           @if (!grouped && e.IsAnalyzed && Segs(e) is { Count: > 0 } vs) {
                                                                               <div class="text-[0.7rem]">@Ver(vs)</div>
                                                                           }
                                                                           @if (Sha12(e.Result?.ProtoSha) is { Length: > 0 } sha) {
                                                                               <div class="wb-entry-meta">@sha</div>
                                                                           }
                                                                           <div class="wb-entry-foot">
                                                                               @if (!e.IsDone && e.Step is { Length: > 0 } step) {
                                                                                   <span class="text-muted text-[0.65rem] truncate">@step</span>
                                                                               }
                                                                               @if (SessionRef(e) is { } sref) {
                                                                                   <button type="button" class="pwb-pin" title="Set as B" aria-label="Set as B"
                                                                                           @onclick:stopPropagation="true" @onclick="@(() => SetB(sref))">
                                                                                       B
                                                                                   </button>
                                                                               }
                                                                               @if (!grouped && g is { Conflict: false, Status.Offerable: true }) {
                                                                                   <span title="offerable">
                                                                                       <Icon Name="arrow-up" Class="icon-sm wb-st-offer"/>
                                                                                   </span>
                                                                               }
                                                                               <Icon Name="clock" Class="@("icon-sm " + StatusClass(e))"/>
                                                                               <Icon Name="@PlatformIcon(e.Platform)" Class="icon-sm"/>
                                                                           </div>
                                                                       </div>;

    RenderFragment DownloadItem(ProtoRef value, string side) => @<text>
