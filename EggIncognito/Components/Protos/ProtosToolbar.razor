@* Proto-registry toolbar, projected into the top nav via SectionContent (the Inspector/Capture
   pattern). Filtering now lives in the table's per-column filter row, so the toolbar holds only the
   Subscribe (modal) + Sources links and the admin-only Backfill popover. The admin button is hidden
   entirely for non-admins; the server ACL is the real gate. *@
@using EggIncognito.Components.Shared

<div class="protos-toolbar toolbar">
  <button type="button" class="icon-btn" title="Subscribe to updates" aria-label="Subscribe to updates"
          @onclick="@(() => OnSubscribe.InvokeAsync())">
    <Icon Name="bell" />
  </button>
  <button type="button" class="icon-btn" title="Sources" aria-label="Sources"
          @onclick="@(() => OnSources.InvokeAsync())">
    <Icon Name="info" />
  </button>

  @if (IsAdmin)
  {
    <div class="settings-wrap">
      <button type="button" class="icon-btn @(_open ? "active" : "")" title="Backfill" aria-label="Backfill"
              aria-haspopup="true" aria-expanded="@_open" @onclick="@(() => _open = !_open)">
        <Icon Name="database" />
      </button>
      <div class="settings-menu @(_open ? "open" : "")">
        <div class="settings-title">Backfill</div>
        <div class="settings-hint">Trigger an import. Status shows in the admin panel below the table.</div>
        <button type="button" class="btn-mini protos-trigger" @onclick="@(() => Trigger("github"))">GitHub (elgranjero)</button>
        <button type="button" class="btn-mini protos-trigger" @onclick="@(() => Trigger("android"))">Android (Fandom)</button>
        <button type="button" class="btn-mini protos-trigger" @onclick="@(() => Trigger("resync"))">Force re-sync</button>
      </div>
    </div>
  }
</div>

@code {
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback<string> OnTrigger { get; set; }
    [Parameter] public EventCallback OnSubscribe { get; set; }
    [Parameter] public EventCallback OnSources { get; set; }

    bool _open;

    async Task Trigger(string which)
    {
        _open = false;
        await OnTrigger.InvokeAsync(which);
    }
}
