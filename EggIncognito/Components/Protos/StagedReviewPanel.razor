@* Contributor+ review queue for staged proto submissions (public offers + admin crawl imports). Select rows,
   bulk approve/reject, and inline-edit version fields to fix a crawled null before approving. Approve promotes
   to the live registry; reject hides + blocks re-offer of that sha. *@
@rendermode @(RenderMode.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@using System.Text
@using System.Text.Json
@implements IAsyncDisposable

@* Only render when there is something to review. *@
@if (_rows.Count > 0) {
    <section class="panel mb-3">
        <div class="flex items-center gap-2 flex-wrap mb-2">
            <div class="text-sm font-semibold">Staged submissions (@_rows.Count)</div>
            @if (_rows.Any(r => r.IsIncomplete)) {
                <button type="button" class="btn-mini" @onclick="CopyAllMissing"
                        title="Copy a structured report of every row with a missing field, for closer audit">
                    Copy Missing Info (@_rows.Count(r => r.IsIncomplete))
                </button>
            }
        </div>

        @if (_rows.Count == 0) {
            <div class="text-xs text-muted">No pending submissions.</div>
        } else {
            @if (_selected.Count > 0) {
                <div class="flex items-center gap-2 flex-wrap mb-2 p-2 rounded-md bg-panel2 border border-border">
                    <span class="text-xs font-semibold">@_selected.Count selected</span>
                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="BulkApprove">Approve selected</button>
                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="BulkReject">Reject selected</button>
                    <button type="button" class="btn-mini" @onclick="ClearSelection">Clear</button>
                </div>
            }

            <table class="data-table">
                <thead>
                <tr>
                    <th class="w-8">
                        <input type="checkbox" checked="@AllSelected" @onchange="ToggleAll"/>
                    </th>
                    <th>Source</th>
                    <th>Platform</th>
                    <th>App Version</th>
                    <th>Build</th>
                    <th>Client</th>
                    <th>Proto SHA</th>
                    <th>Origin</th>
                    <th class="w-28">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in _rows) {
                    <tr class="reg-row">
                        <td @onclick:stopPropagation="true">
                            <input type="checkbox" checked="@_selected.Contains(r.Id)" @onchange="@(() => ToggleRow(r.Id))"/>
                        </td>
                        <td>
                            <span class="code-chip">@r.Source</span>
                        </td>
                        <td>
                            <input class="protos-filter w-full" style="min-width:5rem" @bind="r.Platform"/>
                        </td>
                        <td>
                            <input class="protos-filter w-full" style="min-width:6rem" placeholder="-" @bind="r.AppVersion"/>
                        </td>
                        <td>
                            <input class="protos-filter w-full" style="min-width:7rem" placeholder="-" @bind="r.Build"/>
                        </td>
                        <td>
                            <input class="protos-filter w-full" style="min-width:4rem" placeholder="-" @bind="r.ClientVersion"/>
                        </td>
                        <td class="text-xs text-muted font-mono">@Short(r.ProtoSha)</td>
                        <td class="text-xs text-muted">
                            @if (r.OriginRepo is not null) {
                                <span>@r.OriginRepo</span>
                                @if (r.Confidence is { } c) {
                                    <span class="@ConfClass(c)"> (@c)</span>
                                }
                            }
                        </td>
                        <td @onclick:stopPropagation="true">
                            <div class="flex gap-1">
                                <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => Approve(r))">Approve</button>
                                <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => Reject(r))">Reject</button>
                                @if (r.IsIncomplete) {
                                    <button type="button" class="btn-mini" @onclick="@(() => CopyOne(r))"
                                            title="Copy this row's audit info">
                                        Copy
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        @if (_status is { } st) {
            <StatusNote Severity="@st.Kind">
                @if (st.Bulk is { } b) {
                    <span class="status-chip status-chip-ok">@b.Approved approved</span>
                    @if (b.Skipped > 0) {
                        <span class="status-chip" title="No version info yet; rows stay staged">@b.Skipped skipped</span>
                    }

                    @if (b.Failed > 0) {
                        <span class="status-chip status-chip-err">@b.Failed failed</span>
                    }
                } else {
                    @st.Text
                }
            </StatusNote>
        }
    </section>
}

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    List<StagedRow> _rows = [];
    readonly HashSet<int> _selected = [];
    bool _busy;
    Status? _status;

    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool IsAdmin { get; set; }


    bool AllSelected => _rows.Count > 0 && _rows.All(r => _selected.Contains(r.Id));

    protected override async Task OnInitializedAsync() {
        await Load();
    }

    public async Task Load() {
        try {
            _rows = await Client().GetFromJsonAsync<List<StagedRow>>("/api/protos/staged", JsonOpts) ?? [];
        }
        catch {
            _rows = [];
        }

        _selected.IntersectWith(_rows.Select(r => r.Id));
        StateHasChanged();
    }

    void ToggleRow(int id) {
        if (!_selected.Add(id)) _selected.Remove(id);
    }

    void ClearSelection() {
        _selected.Clear();
    }

    void ToggleAll(ChangeEventArgs e) {
        if (e.Value is true)
            foreach (var r in _rows)
                _selected.Add(r.Id);
        else
            foreach (var r in _rows)
                _selected.Remove(r.Id);
    }

    static string Short(string sha) {
        return string.IsNullOrEmpty(sha) ? "" : sha.Length <= 12 ? sha : sha[..12];
    }

    static string ConfClass(string c) {
        return c switch {
            "version-file" => "text-accent",
            "subject" => "text-muted",
            _ => "text-red-400"
        };
    }

    static object ApproveBody(StagedRow r) {
        return new { platform = r.Platform, appVersion = r.AppVersion, build = r.Build, clientVersion = r.ClientVersion };
    }

    async Task Approve(StagedRow r) {
        _busy = true;
        _status = null;
        try {
            var resp = await Client().PostAsJsonAsync($"/api/protos/staged/{r.Id}/approve", ApproveBody(r), JsonOpts);
            _status = resp.IsSuccessStatusCode ? Ok("approved") : Err($"approve failed ({(int)resp.StatusCode})");
        }
        catch (Exception ex) {
            _status = Err($"approve error: {ex.Message}");
        }
        finally {
            _busy = false;
        }

        await Load();
        await OnChanged.InvokeAsync();
    }

    async Task Reject(StagedRow r) {
        _busy = true;
        _status = null;
        try {
            var resp = await Client().PostAsJsonAsync($"/api/protos/staged/{r.Id}/reject", new { note = (string?)null }, JsonOpts);
            _status = resp.IsSuccessStatusCode ? Ok("rejected") : Err($"reject failed ({(int)resp.StatusCode})");
        }
        catch (Exception ex) {
            _status = Err($"reject error: {ex.Message}");
        }
        finally {
            _busy = false;
        }

        await Load();
        await OnChanged.InvokeAsync();
    }

    async Task BulkApprove() {
        if (_selected.Count == 0) return;
        _busy = true;
        _status = Busy("approving…");
        try {
            var items = _rows.Where(r => _selected.Contains(r.Id)).Select(r => new {
                id = r.Id, platform = r.Platform, appVersion = r.AppVersion, build = r.Build, clientVersion = r.ClientVersion
            }).ToList();
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/bulk-approve", new { items }, JsonOpts);
            if (resp.IsSuccessStatusCode) {
                var r = await resp.Content.ReadFromJsonAsync<BulkApproveResp>(JsonOpts);
                _status = r is null
                    ? Ok("approved")
                    : new Status(r.Failed > 0 ? StatusNote.Kind.Error : StatusNote.Kind.Ok, "", r);
            } else _status = Err($"bulk approve failed ({(int)resp.StatusCode})");
        }
        catch (Exception ex) {
            _status = Err($"bulk approve error: {ex.Message}");
        }
        finally {
            _busy = false;
        }

        ClearSelection();
        await Load();
        await OnChanged.InvokeAsync();
    }

    async Task BulkReject() {
        if (_selected.Count == 0) return;
        _busy = true;
        _status = Busy("rejecting…");
        try {
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/bulk-reject",
                new { ids = _selected.ToList(), note = (string?)null }, JsonOpts);
            if (resp.IsSuccessStatusCode) {
                var r = await resp.Content.ReadFromJsonAsync<BulkRejectResp>(JsonOpts);
                _status = Ok(r is null ? "rejected" : $"rejected {r.Rejected}");
            } else _status = Err($"bulk reject failed ({(int)resp.StatusCode})");
        }
        catch (Exception ex) {
            _status = Err($"bulk reject error: {ex.Message}");
        }
        finally {
            _busy = false;
        }

        ClearSelection();
        await Load();
        await OnChanged.InvokeAsync();
    }

    IJSObjectReference? _copy;


    static string MissingReport(IEnumerable<StagedRow> rows) {
        var sb = new StringBuilder();
        sb.AppendLine("# Staged proto rows with missing version info");
        sb.AppendLine();
        foreach (var r in rows) {
            sb.AppendLine($"- id={r.Id} sha={r.ProtoSha} source={r.Source} platform={r.Platform}");
            sb.AppendLine($"  have: appVersion={Or(r.AppVersion)} build={Or(r.Build)} clientVersion={Or(r.ClientVersion)}");
            sb.AppendLine($"  MISSING: {string.Join(", ", r.Missing)}");
            if (r.OriginRepo is not null)
                sb.AppendLine($"  origin: repo={r.OriginRepo} commit={Or(r.OriginCommit)} date={r.OriginDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-"} confidence={Or(r.Confidence)}");
            sb.AppendLine();
        }

        return sb.ToString();

        static string Or(string? s) {
            return string.IsNullOrWhiteSpace(s) ? "-" : s;
        }
    }


    async Task CopyAndClear(IReadOnlyList<StagedRow> rows) {
        if (rows.Count == 0) return;
        _busy = true;
        _status = null;
        try {
            _copy ??= await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/copy.js"));
            await _copy.InvokeAsync<bool>("writeText", MissingReport(rows));
        }
        catch (Exception ex) {
            _status = Err($"copy failed (rows kept): {ex.Message}");
            _busy = false;
            StateHasChanged();
            return;
        }

        try {
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/bulk-reject",
                new { ids = rows.Select(r => r.Id).ToList(), note = "set aside: missing version data (copied for audit)" }, JsonOpts);
            var n = resp.IsSuccessStatusCode ? (await resp.Content.ReadFromJsonAsync<BulkRejectResp>(JsonOpts))?.Rejected ?? 0 : 0;
            _status = Ok($"copied {rows.Count} to clipboard, set aside {n} (returns if re-surfaced with more data)");
        }
        catch (Exception ex) {
            _status = Err($"copied, but clear failed: {ex.Message}");
        }
        finally {
            _busy = false;
        }

        ClearSelection();
        await Load();
        await OnChanged.InvokeAsync();
    }

    Task CopyAllMissing() {
        return CopyAndClear(_rows.Where(r => r.IsIncomplete).ToList());
    }

    Task CopyOne(StagedRow r) {
        return CopyAndClear([r]);
    }

    public ValueTask DisposeAsync() {
        return _copy.DisposeModuleQuietAsync();
    }

    sealed record Status(StatusNote.Kind Kind, string Text, BulkApproveResp? Bulk = null);

    static Status Ok(string t) {
        return new Status(StatusNote.Kind.Ok, t);
    }

    static Status Err(string t) {
        return new Status(StatusNote.Kind.Error, t);
    }

    static Status Busy(string t) {
        return new Status(StatusNote.Kind.Busy, t);
    }

    sealed record BulkApproveResp(int Approved, int Skipped, int Failed);

    sealed record BulkRejectResp(int Rejected);

    public sealed class StagedRow {
        public int Id { get; set; }
        public string Source { get; set; } = "";
        public string Platform { get; set; } = "android";
        public string? AppVersion { get; set; }
        public string? Build { get; set; }
        public string? ClientVersion { get; set; }
        public string ProtoSha { get; set; } = "";
        public string? OriginRepo { get; set; }
        public string? OriginCommit { get; set; }
        public DateTimeOffset? OriginDate { get; set; }
        public string? Confidence { get; set; }

        public bool IsIncomplete =>
            string.IsNullOrWhiteSpace(AppVersion) || string.IsNullOrWhiteSpace(Build) || string.IsNullOrWhiteSpace(ClientVersion);

        public IEnumerable<string> Missing {
            get {
                if (string.IsNullOrWhiteSpace(AppVersion)) yield return "appVersion";
                if (string.IsNullOrWhiteSpace(Build)) yield return "build";
                if (string.IsNullOrWhiteSpace(ClientVersion)) yield return "clientVersion";
            }
        }
    }

}
