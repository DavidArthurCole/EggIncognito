@using EggIncognito.Models.Periodicals

<section class="panel pd-w-workbench">
    <div class="flex items-center justify-between mb-3 gap-2">
        <h3 class="text-sm font-semibold m-0">Workbenches</h3>
        <div class="flex items-center gap-1">
            <button type="button" class="btn-mini" @onclick="@(() => OnOpenNotifications.InvokeAsync())">Notifications</button>
            <button type="button" class="btn-mini" @onclick="@(() => OnOpenApiWorkbench.InvokeAsync())">API &amp; Data</button>
        </div>
    </div>
    @if (Summary is { } s) {
        <div class="wbx-kpis">
            <div class="wbx-kpi">
                <span class="wbx-kpi-n">@s.Extracted.Count</span>
                <span class="wbx-kpi-k">sets</span>
            </div>
            <div class="wbx-kpi">
                <span class="wbx-kpi-n">@TotalRows(s)</span>
                <span class="wbx-kpi-k">rows</span>
            </div>
            <div class="wbx-kpi @(FeedsPresent(s) < s.Feeds.Count ? "wbx-kpi-warn" : "")">
                <span class="wbx-kpi-n">@FeedsPresent(s)/@s.Feeds.Count</span>
                <span class="wbx-kpi-k">feeds</span>
            </div>
        </div>
        @if (TopSets(s) is { Count: > 0 } sets) {
            <div class="wbx-bars">
                @foreach (var row in sets) {
                    <div class="wbx-bar">
                        <span class="wbx-bar-k">@row.Key</span>
                        <span class="wbx-bar-track">
                            <span class="wbx-bar-fill" style="@FillStyle(row.Count, sets[0].Count)"></span>
                        </span>
                        <span class="wbx-bar-n">@row.Count</span>
                    </div>
                }
            </div>
        }
        <div class="wbx-foot">
            @if (ExtractVersion(s) is { Length: > 0 } bin) {
                <VersionLine App="@bin"/>
            }
            @foreach (var p in s.Config.Platforms) {
                <span class="wbx-foot-item">
                    <PlatformIcon Platform="@p.Platform"/>
                    <TimeAgo Value="@p.SavedAt"/>
                </span>
            }
        </div>
    }
</section>

@code {
    const int BarCount = 4;

    [Parameter] public PeriodicalsSummary? Summary { get; set; }

    [Parameter] public EventCallback OnOpenNotifications { get; set; }

    [Parameter] public EventCallback OnOpenApiWorkbench { get; set; }

    static int TotalRows(PeriodicalsSummary s) {
        return s.Extracted.Sum(x => x.Count);
    }

    static int FeedsPresent(PeriodicalsSummary s) {
        return s.Feeds.Count(f => f.Present);
    }

    static List<ExtractedRow> TopSets(PeriodicalsSummary s) {
        return [.. s.Extracted.Where(x => x.Count > 0).OrderByDescending(x => x.Count).Take(BarCount)];
    }

    static string FillStyle(int count, int max) {
        return FormattableString.Invariant($"--fill:{(max <= 0 ? 0 : count * 100.0 / max):0.#}%;");
    }

    static string? ExtractVersion(PeriodicalsSummary s) {
        return s.Extracted.Select(x => x.BinaryVersion).FirstOrDefault(v => !string.IsNullOrEmpty(v));
    }

}
