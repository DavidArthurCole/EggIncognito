@* Proto-sources attribution, rendered inside the /protos modal overlay (the modal owns the chrome).
   Counts are live registry-row totals per source; list sources feed the discovery queue, not the
   build-keyed registry. *@
@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor

<p class="text-muted text-xs mb-3">
  Where the registry's proto definitions come from. Counts are live registry-row totals per source.
</p>

<div class="src-list">
  @foreach (var s in Sources)
  {
    <div class="src-row">
      <div class="src-row-head">
        <span class="text-sm font-semibold text-fg">@s.Name</span>
        <span class="ml-auto flex items-center gap-1.5">
          @if (s.HasCount)
          {
            <span class="code-chip">@Count(s.CountKey) versions</span>
          }
          else
          {
            <span class="pill">discovery</span>
          }
          @if (IsAdmin && s.Trigger is not null)
          {
            <button type="button" class="icon-btn icon-btn-sm" title="@s.RefreshTitle" aria-label="@s.RefreshTitle"
                    @onclick="@(() => OnTrigger.InvokeAsync(s.Trigger))"><Icon Name="refresh" /></button>
          }
        </span>
      </div>
      <p class="src-role">@s.Role</p>
      @if (s.Link is not null)
      {
        <a class="proto-version text-xs" href="@s.Link" target="_blank" rel="noopener noreferrer">@s.LinkLabel</a>
      }
      @if (s.License is not null)
      {
        <div class="text-muted text-xs mt-0.5">@s.License</div>
      }
    </div>
  }
</div>

@code {
    static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new(System.Text.Json.JsonSerializerDefaults.Web);

    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback<string> OnTrigger { get; set; }

    static readonly SourceInfo[] Sources =
    [
        new("Device farm", "farm", true,
            "Two physical phones (Android + iOS) on the host. When a device detects a new game build it " +
            "auto-installs it, the server pulls the binary, extracts the proto, and imports it - the live, " +
            "authoritative source of the current schema.",
            null, null, null, Trigger: "farm", RefreshTitle: "Refresh connected devices now"),
        new("elgranjero / EggIncProtos", "elgranjero", true,
            "Community historical timeline: one commit per build with its ei.proto. The substantive backfill.",
            "https://github.com/elgranjero/EggIncProtos", "github.com/elgranjero/EggIncProtos",
            "Licensed GPL-2.0; credited per its terms.", Trigger: "github", RefreshTitle: "Re-import from elgranjero"),
        new("Fandom wiki", "fandom", false,
            "Version_History via the MediaWiki API. Primary list source; carries changelog text.",
            "https://egg-inc.fandom.com/wiki/Version_History", "egg-inc.fandom.com", null,
            Trigger: "android", RefreshTitle: "Re-import from Fandom"),
    ];

    Dictionary<string, int> _counts = new();

    string _baseAddress = "";
    string? _cookie;

    protected override void OnInitialized()
    {
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
    }

    protected override Task OnInitializedAsync() => Load();

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    async Task Load()
    {
        try
        {
            _counts = await Client().GetFromJsonAsync<Dictionary<string, int>>("/api/protos/sources", JsonOpts) ?? new();
        }
        catch { _counts = new(); }
    }

    int Count(string source) => _counts.TryGetValue(source, out var n) ? n : 0;

    record SourceInfo(string Name, string CountKey, bool HasCount, string Role,
        string? Link, string? LinkLabel, string? License, string? Trigger = null, string? RefreshTitle = null);
}
