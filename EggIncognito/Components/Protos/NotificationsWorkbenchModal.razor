@rendermode @(RenderMode.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject NotificationsWorkbenchState State
@inject ILogger<NotificationsWorkbenchModal> Logger
@using System.Text.Json
@using EggIncognito.Components.Shared.Editor
@using EggIncognito.Components.Shared.Workbench
@using EggIncognito.Services.Notifications
@using EggIncognito.Services.Workbench
@implements IAsyncDisposable

<WorkbenchModal Open="_open" Title="Notifications" TitleId="notificationsWorkbenchTitle" CardClass="nwb-card"
                Notice="_notice" NoticeDismissed="DismissNotice" OnClose="CloseAsync">
    <HeadTools>
        @if (Current is { } cur && User.IsAuthenticated) {
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => DeleteSub(cur.Id))">Delete</button>
        }
    </HeadTools>
    <Rail>
        <WorkbenchRail HasFilter="true" Filter="@State.RailFilter" FilterChanged="OnRailFilter" FilterLabel="Filter subscriptions">
            <WorkbenchEntry Selected="@State.Creating" OnClick="@(_ => SelectNew())">
                <Name>New subscription</Name>
            </WorkbenchEntry>
            @if (!User.IsAuthenticated) {
                <div class="wb-note">Log in to see your subscriptions.</div>
            } else {
                <WorkbenchLoad T="Sub" Items="@FilteredOrNull" EmptyText="@EmptyRailText" Context="subs">
                    @foreach (var g in subs.GroupBy(s => s.EventKind).OrderBy(g => g.Key, StringComparer.Ordinal)) {
                        <WorkbenchSection Label="@KindLabel(g.Key)">
                            @foreach (var s in g) {
                                <WorkbenchEntry @key="s.Id" Selected="@(!State.Creating && State.SelectedId == s.Id)"
                                                Status="@HealthStatus(s)" OnClick="@(_ => Select(s))">
                                    <Name>@s.UrlMasked</Name>
                                    <MetaLine>@TriggerLabel(s.EventKind, s.Trigger)</MetaLine>
                                    <Foot>@Health(s)</Foot>
                                </WorkbenchEntry>
                            }
                        </WorkbenchSection>
                    }
                </WorkbenchLoad>
            }
        </WorkbenchRail>
    </Rail>
    <ChildContent>
        @ConfigPane()
    </ChildContent>
</WorkbenchModal>

@code {
    const int PreviewDebounceMs = 500;

    bool _open;
    bool _busy;
    bool _hashWired;
    string? _armed;
    WorkbenchNotice? _notice;

    IJSObjectReference? _nav;
    IJSObjectReference? _navHandle;
    DotNetObjectReference<NotificationsWorkbenchModal>? _selfRef;
    CancellationTokenSource? _debounce;
    int _previewSeq;

    List<KindInfo> _kinds = [];
    List<Sub>? _subs;
    List<PreviewRow>? _preview;

    Sub? Current => State.Creating ? null : _subs?.FirstOrDefault(s => s.Id == State.SelectedId);

    List<Sub>? FilteredOrNull {
        get {
            if (_subs is null) return null;
            var f = State.RailFilter.Trim();
            if (f.Length == 0) return _subs;
            return _subs.Where(s =>
                Has(s.UrlMasked, f) || Has(s.Label, f) || Has(KindLabel(s.EventKind), f) ||
                Has(TriggerLabel(s.EventKind, s.Trigger), f)).ToList();
        }
    }

    string EmptyRailText => _subs is { Count: > 0 } ? "No match." : "No subscriptions yet.";

    static bool Has(string? value, string needle) {
        return value is not null && value.Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    KindInfo? KindOf(string? key) {
        return _kinds.FirstOrDefault(k => k.Key == key);
    }

    string KindLabel(string? key) {
        return KindOf(key)?.Label ?? key ?? "";
    }

    string TriggerLabel(string? kind, string trigger) {
        return KindOf(kind)?.Triggers.FirstOrDefault(t => t.Value == trigger)?.Label ?? trigger;
    }

    IReadOnlyList<TriggerOpt> TriggersOf(string? kind) {
        return KindOf(kind)?.Triggers ?? [];
    }

    IReadOnlyList<FilterOpt> FiltersOf(string? kind) {
        return KindOf(kind)?.Filters ?? [];
    }

    IReadOnlyList<string> VarsOf(string? kind) {
        return KindOf(kind)?.Vars ?? [];
    }

    static string Health(Sub s) {
        if (!s.Active) return "paused";
        return s.FailCount > 0 ? $"{s.FailCount} failed" : s.LastDeliveryAt is null ? "no sends yet" : "healthy";
    }

    static WorkbenchStatusKind HealthStatus(Sub s) {
        if (!s.Active) return WorkbenchStatusKind.Muted;
        if (s.FailCount > 0) return WorkbenchStatusKind.Error;
        return s.LastDeliveryAt is null ? WorkbenchStatusKind.Muted : WorkbenchStatusKind.Done;
    }

    static string Placeholder(string kind) {
        return kind == "periodicals_changed"
            ? "{{feed}} changed (hash {{sha}}) - see {{pageUrl}}"
            : "New build {{appVersion}} ({{build}}) is up on {{platform}}!";
    }

    PreviewRow? SelectedSample {
        get {
            if (_preview is not { Count: > 0 } rows) return null;
            return rows.FirstOrDefault(p => p.Key == State.SampleKey) ?? rows[0];
        }
    }

    RenderFragment ConfigPane() => @<div class="nwb-pane">
                                       @if (State.Creating) {
                                           <label class="sub-field mb-3">
                                               <span class="sub-field-label">Discord webhook URL</span>
                                               <input class="field-input w-full" placeholder="https://discord.com/api/webhooks/..."
                                                      @bind="State.NewDraft.Url" @bind:event="oninput"/>
                                           </label>
                                           <label class="sub-field mb-3">
                                               <span class="sub-field-label">Notify about</span>
                                               <select class="field-input w-full" @bind="State.NewDraft.EventKind" @bind:after="@(() => OnKindChanged(State.NewDraft))">
                                                   @foreach (var k in _kinds) {
                                                       <option value="@k.Key">@k.Label</option>
                                                   }
                                               </select>
                                           </label>
                                           @Fields(State.NewDraft, false)
                                           @if (User.IsAuthenticated) {
                                               <div class="flex items-center gap-3 mt-4">
                                                   <button type="button" class="btn-primary" disabled="@_busy" @onclick="Create">
                                                       @(_busy ? "Sending test..." : "Subscribe")
                                                   </button>
                                                   <span class="text-muted text-xs">A test message is sent to the webhook on save.</span>
                                               </div>
                                           } else {
                                               <div class="sub-login-note mt-4">
                                                   <p class="text-muted text-sm m-0 mb-2">Log in to save this subscription. Preview works without an account.</p>
                                                   <LoginButton Label="Log in" Placement="LoginMenuPlacement.Right"/>
                                               </div>
                                           }

                                           @PreviewBlock()
                                       } else if (Current is { } sub) {
                                           <div class="nwb-url font-mono text-xs mb-3">@sub.UrlMasked</div>
                                           <div class="text-muted text-xs mb-3">@KindLabel(sub.EventKind)</div>
                                           @Fields(State.Draft(sub.Id), true)
                                           @if (User.IsAuthenticated) {
                                               <div class="flex items-center gap-3 mt-4">
                                                   <button type="button" class="btn-primary" disabled="@_busy" @onclick="@(() => Save(sub.Id))">
                                                       @(_busy ? "Saving..." : "Save")
                                                   </button>
                                               </div>
                                           }

                                           @PreviewBlock()
                                       } else {
                                           <div class="text-muted text-sm">Select a subscription, or start a new one.</div>
                                       }
                                   </div>;

    RenderFragment Fields(NotificationDraft d, bool existing) => @<div class="sub-form">
                                                                     <div class="sub-grid">
                                                                         @if (KindOf(d.EventKind)?.PlatformScoped == true) {
                                                                             <fieldset class="sub-field border-0 p-0 m-0">
                                                                                 <legend class="sub-field-label p-0">Platforms</legend>
                                                                                 <div class="sub-checks">
                                                                                     <label class="settings-check">
                                                                                         <input type="checkbox" @bind="d.Android" @bind:after="RefreshPreview"/> Android
                                                                                     </label>
                                                                                     <label class="settings-check">
                                                                                         <input type="checkbox" @bind="d.Ios" @bind:after="RefreshPreview"/> iOS
                                                                                     </label>
                                                                                 </div>
                                                                             </fieldset>
                                                                         }
                                                                         <fieldset class="sub-field border-0 p-0 m-0">
                                                                             <legend class="sub-field-label p-0">Trigger</legend>
                                                                             <select class="field-input" @bind="d.Trigger" @bind:after="RefreshPreview">
                                                                                 @foreach (var t in TriggersOf(d.EventKind)) {
                                                                                     <option value="@t.Value">@t.Label</option>
                                                                                 }
                                                                             </select>
                                                                             @if (existing) {
                                                                                 <label class="settings-check mt-2"><input type="checkbox" @bind="d.Active"/> active</label>
                                                                             }
                                                                         </fieldset>
                                                                     </div>

                                                                     <fieldset class="sub-field border-0 p-0 m-0">
                                                                         <legend class="sub-field-label p-0">Filters</legend>
                                                                         @if (d.Trigger == "suspect") {
                                                                             <span class="text-muted text-xs">Suspect reports every flawed extraction, so filters do not apply.</span>
                                                                         } else {
                                                                             <div class="sub-checks">
                                                                                 @foreach (var f in FiltersOf(d.EventKind)) {
                                                                                     <label class="settings-check">
                                                                                         <input type="checkbox" checked="@d.Filters.Contains(f.Key)"
                                                                                                @onchange="@(e => ToggleFilter(d, f.Key, e))"/> @f.Label
                                                                                     </label>
                                                                                 }
                                                                             </div>
                                                                             <span class="text-muted text-xs">A blocked event is logged instead of being sent.</span>
                                                                         }
                                                                     </fieldset>

                                                                     <div class="sub-field">
                                                                         <span class="sub-field-label">Custom message (optional)</span>
                                                                         <TemplateEditor Value="@d.MessageTemplate" ValueChanged="@(v => OnTemplateChanged(d, v))"
                                                                                         Tokens="@VarsOf(d.EventKind)" Placeholder="@Placeholder(d.EventKind)" Rows="4"/>
                                                                         <span class="text-muted text-xs">Leave blank for the default embed. Click a variable to insert it at the caret.</span>
                                                                     </div>
                                                                 </div>;

    RenderFragment PreviewBlock() => @<div class="nwb-preview">
                                         <div class="nwb-preview-head">
                                             <span class="sub-field-label">Preview</span>
                                             @if (_preview is { Count: > 0 } rows) {
                                                 <select class="field-input" aria-label="Sample event" value="@SelectedSample?.Key" @onchange="OnSampleChanged">
                                                     @foreach (var p in rows) {
                                                         <option value="@p.Key">@p.Label</option>
                                                     }
                                                 </select>
                                             }
                                             <span class="text-muted text-xs">Sample events run against this config. Nothing is sent from this view.</span>
                                             <button type="button" class="btn-mini ml-auto" disabled="@_busy" @onclick="RefreshPreview">Refresh</button>
                                         </div>
                                         <WorkbenchLoad T="PreviewRow" Items="_preview" EmptyText="No samples for this event kind.">
                                             @if (SelectedSample is { } row) {
                                                 <div class="nwb-sample">
                                                     <div class="nwb-sample-head">
                                                         <span class="text-muted font-mono text-xs">@row.Event</span>
                                                         <span class="@OutcomeClass(row)">@Outcome(row)</span>
                                                     </div>
                                                     @if (row.Body is { Length: > 0 }) {
                                                         <CodeSurface Text="@Pretty(row.Body)" Language="json" ShowFilter="false"
                                                                      ShowWrapToggle="false" MaxHeight="16rem"/>
                                                         @if (Current is { } cur && User.IsAuthenticated) {
                                                             <div class="flex items-center gap-2">
                                                                 @if (_armed == row.Key) {
                                                                     <button type="button" class="btn-primary" disabled="@_busy" @onclick="@(() => SendSample(cur.Id, row.Key))">
                                                                         Confirm, post to @cur.UrlMasked
                                                                     </button>
                                                                     <button type="button" class="btn-mini" @onclick="@(() => _armed = null)">Cancel</button>
                                                                 } else {
                                                                     <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => _armed = row.Key)">
                                                                         Send this for real
                                                                     </button>
                                                                 }
                                                             </div>
                                                         }
                                                     }
                                                 </div>
                                             }
                                         </WorkbenchLoad>
                                     </div>;

    static string Outcome(PreviewRow p) {
        if (!p.Matches) return "not this trigger";
        return p.BlockedBy.Count > 0 ? $"blocked: {string.Join(", ", p.BlockedBy)}" : "sends";
    }

    static string OutcomeClass(PreviewRow p) {
        if (!p.Matches) return "text-muted";
        return p.BlockedBy.Count > 0 ? "text-err" : "text-ok";
    }

    static string Pretty(string json) {
        try {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException) {
            return json;
        }
    }

    public async Task Open(int? id = null) {
        _open = true;
        if (id is not null) {
            State.Creating = false;
            State.SelectedId = id;
        }

        await LoadAll();
        await WriteHash(true);
        StateHasChanged();
    }

    async Task CloseAsync() {
        _open = false;
        _armed = null;
        await WriteHash(true, true);
        StateHasChanged();
    }

    void DismissNotice() {
        _notice = null;
    }

    void Note(string text, bool ok) {
        _notice = new WorkbenchNotice(text, ok ? StatusNote.Kind.Ok : StatusNote.Kind.Error);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        try {
            _nav = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/hashnav.js"));
            _selfRef = DotNetObjectReference.Create(this);
            _navHandle = await _nav.InvokeAsync<IJSObjectReference>("listen", _selfRef);
            _hashWired = true;
            var hash = await _nav.InvokeAsync<string>("read");
            await ApplyHash(hash);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "hash navigation could not be wired");
        }
    }

    [JSInvokable]
    public async Task OnHashChanged(string hash) {
        await ApplyHash(hash);
        StateHasChanged();
    }

    async Task ApplyHash(string hash) {
        if (!State.ApplyHash(hash)) {
            if (_open) {
                _open = false;
                StateHasChanged();
            }

            return;
        }

        _open = true;
        await LoadAll();
        StateHasChanged();
    }

    async Task WriteHash(bool push = false, bool clear = false) {
        if (!_hashWired || _nav is null) return;
        var hash = clear ? "" : State.Hash() ?? "";
        await _nav.InvokeVoidAsync(push ? "push" : "write", hash);
    }

    async Task LoadAll() {
        if (_kinds.Count == 0) await LoadKinds();
        if (User.IsAuthenticated && _subs is null) await LoadSubs();
        if (!State.Creating && Current is null && _subs is { Count: > 0 }) {
            State.Creating = true;
            State.SelectedId = null;
        }

        await LoadPreview();
    }

    async Task LoadKinds() {
        _kinds = await Client().ListAsync<KindInfo>("/api/protos/feed/kinds", Logger);
        if (_kinds.Count > 0 && State.NewDraft.Filters.Count == 0) ApplyKindDefaults(State.NewDraft);
    }

    async Task LoadSubs() {
        _subs = await Client().ListAsync<Sub>("/api/protos/feed/mine", Logger);
    }

    async Task LoadPreview() {
        var seq = ++_previewSeq;
        var d = State.Active();
        _preview = null;
        List<PreviewRow> rows;
        try {
            var body = new {
                eventKind = d.EventKind, trigger = d.Trigger, platforms = PlatformsOf(d),
                filters = d.Filters.ToArray(),
                messageTemplate = string.IsNullOrWhiteSpace(d.MessageTemplate) ? null : d.MessageTemplate
            };
            var res = await Client().PostAsJsonAsync("/api/protos/feed/preview", body, SelfCallJson.Web);
            rows = res.IsSuccessStatusCode
                ? await res.Content.ReadFromJsonAsync<List<PreviewRow>>(SelfCallJson.Web) ?? []
                : [];
        }
        catch (Exception ex) {
            Logger.LogDebug(ex, "preview load failed");
            rows = [];
        }

        if (seq != _previewSeq) return;
        _preview = rows;
        if (rows.Count == 0 || rows.All(p => p.Key != State.SampleKey)) {
            State.SampleKey = rows.Count > 0 ? rows[0].Key : "";
        }

        if (_armed is not null && rows.All(p => p.Key != _armed)) _armed = null;
    }

    Task RefreshPreview() {
        _armed = null;
        return LoadPreview();
    }

    void OnSampleChanged(ChangeEventArgs e) {
        State.SampleKey = e.Value?.ToString() ?? "";
        _armed = null;
    }

    void OnRailFilter(string value) {
        State.RailFilter = value;
    }

    async Task OnTemplateChanged(NotificationDraft d, string value) {
        d.MessageTemplate = value;
        _debounce?.Cancel();
        _debounce?.Dispose();
        var cts = new CancellationTokenSource();
        _debounce = cts;
        StateHasChanged();
        try {
            await Task.Delay(PreviewDebounceMs, cts.Token);
        }
        catch (OperationCanceledException) {
            return;
        }

        if (cts.IsCancellationRequested) return;
        await LoadPreview();
        StateHasChanged();
    }

    async Task SelectNew() {
        State.Creating = true;
        State.SelectedId = null;
        _notice = null;
        _armed = null;
        await LoadPreview();
        await WriteHash();
    }

    async Task Select(Sub s) {
        State.Creating = false;
        State.SelectedId = s.Id;
        _notice = null;
        _armed = null;
        var d = State.Draft(s.Id);
        d.EventKind = s.EventKind;
        d.Trigger = s.Trigger;
        d.Android = s.Platforms.Contains("android");
        d.Ios = s.Platforms.Contains("ios");
        d.Active = s.Active;
        d.MessageTemplate = s.MessageTemplate ?? "";
        d.Filters = [.. s.Filters];
        await LoadPreview();
        await WriteHash();
    }

    Task ToggleFilter(NotificationDraft d, string key, ChangeEventArgs e) {
        if (e.Value is true) {
            d.Filters.Add(key);
        } else {
            d.Filters.Remove(key);
        }

        return RefreshPreview();
    }

    void ApplyKindDefaults(NotificationDraft d) {
        d.Trigger = KindOf(d.EventKind)?.DefaultTrigger ?? "version_up";
        d.Filters = [.. FiltersOf(d.EventKind).Where(f => f.DefaultOn).Select(f => f.Key)];
    }

    Task OnKindChanged(NotificationDraft d) {
        ApplyKindDefaults(d);
        State.SampleKey = "";
        return RefreshPreview();
    }

    string[] PlatformsOf(NotificationDraft d) {
        var list = new List<string>();
        if (d.Android) list.Add("android");
        if (d.Ios) list.Add("ios");
        return list.ToArray();
    }

    async Task Create() {
        _busy = true;
        _notice = null;
        try {
            var d = State.NewDraft;
            var body = new {
                webhookUrl = d.Url, eventKind = d.EventKind, platforms = PlatformsOf(d),
                trigger = d.Trigger, label = (string?)null,
                filters = d.Filters.ToArray(),
                messageTemplate = string.IsNullOrWhiteSpace(d.MessageTemplate) ? null : d.MessageTemplate
            };
            var res = await Client().PostAsJsonAsync("/api/protos/feed", body, SelfCallJson.Web);
            if (res.IsSuccessStatusCode) {
                State.ResetNew();
                ApplyKindDefaults(State.NewDraft);
                await LoadSubs();
                if (_subs is { Count: > 0 }) await Select(_subs[0]);
            } else {
                var err = await res.Content.ReadFromJsonAsync<ErrorBody>(SelfCallJson.Web);
                Note(err?.Error ?? $"Subscription failed ({(int)res.StatusCode}).", false);
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "creating subscription failed");
            Note("Subscription failed.", false);
        }

        _busy = false;
    }

    async Task Save(int id) {
        _busy = true;
        _notice = null;
        try {
            var d = State.Draft(id);
            var body = new {
                platforms = PlatformsOf(d), trigger = d.Trigger, active = d.Active,
                filters = d.Filters.ToArray(),
                messageTemplate = string.IsNullOrWhiteSpace(d.MessageTemplate) ? null : d.MessageTemplate
            };
            var res = await Client().PatchAsJsonAsync($"/api/protos/feed/{id}", body, SelfCallJson.Web);
            Note(res.IsSuccessStatusCode ? "Saved." : "Save failed.", res.IsSuccessStatusCode);
            if (res.IsSuccessStatusCode) await LoadSubs();
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "saving subscription {SubId} failed", id);
            Note("Save failed.", false);
        }

        _busy = false;
    }

    async Task SendSample(int id, string sampleKey) {
        _busy = true;
        _notice = null;
        _armed = null;
        try {
            var res = await Client().PostAsync($"/api/protos/feed/{id}/test?sample={Uri.EscapeDataString(sampleKey)}", null);
            Note(res.IsSuccessStatusCode ? "Sent to the webhook." : "The webhook rejected it.", res.IsSuccessStatusCode);
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "sending sample {SampleKey} failed", sampleKey);
            Note("Send failed.", false);
        }

        _busy = false;
    }

    async Task DeleteSub(int id) {
        _busy = true;
        try {
            var res = await Client().DeleteAsync($"/api/protos/feed/{id}");
            if (res.IsSuccessStatusCode) {
                State.Edits.Remove(id);
                await LoadSubs();
                await SelectNew();
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "deleting subscription {SubId} failed", id);
        }

        _busy = false;
    }

    public async ValueTask DisposeAsync() {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = null;
        try {
            if (_navHandle is not null) {
                await _navHandle.InvokeVoidAsync("dispose");
                await _navHandle.DisposeAsync();
            }

            if (_nav is not null) await _nav.DisposeAsync();
        }
        catch (JSDisconnectedException) {
        }
        catch (ObjectDisposedException) {
        }

        _selfRef?.Dispose();
    }

    record ErrorBody(string? Error);

    record TriggerOpt(string Value, string Label);

    record FilterOpt(string Key, string Label, bool DefaultOn);

    record KindInfo(
        string Key,
        string Label,
        List<TriggerOpt> Triggers,
        List<string> Vars,
        string DefaultTrigger,
        bool PlatformScoped,
        List<FilterOpt> Filters);

    record Sub(
        int Id,
        string? Label,
        string EventKind,
        string[] Platforms,
        string Trigger,
        string[] Filters,
        bool Active,
        DateTimeOffset CreatedAt,
        DateTimeOffset? LastDeliveryAt,
        int FailCount,
        string? MessageTemplate,
        string UrlMasked);

    record PreviewRow(string Key, string Label, string Event, bool Matches, List<string> BlockedBy, string? Body);

}
