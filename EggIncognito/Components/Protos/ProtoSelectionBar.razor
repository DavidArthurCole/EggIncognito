@using EggIncognito.Models.Registry
@* Admin bulk-action bar, shown when >=1 registry row is selected. Soft-delete the selection, or merge
   it into one grouped release; the canonical is picked automatically since members are the same version
   and all platforms stay visible on the grouped row. Server ACL is the real gate. *@

<div class="panel">
    <div class="flex items-center gap-3 flex-wrap">
        <span class="text-fg text-sm font-semibold">@Selected.Count selected</span>

        <button type="button" class="btn-mini" disabled="@_busy" @onclick="DeleteSelected">Delete</button>

        @if (Selected.Count >= 2) {
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="MergeSelected">Merge</button>
        }

        <button type="button" class="btn-mini" @onclick="@(() => OnClear.InvokeAsync())">Clear</button>
    </div>
    @if (_msg.Length > 0) {
        <StatusNote Severity="@(_ok ? StatusNoteKind.Ok : StatusNoteKind.Error)" OnDismiss="@(() => _msg = string.Empty)">@_msg</StatusNote>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SelectionKey> Selected { get; set; } = [];
    [Parameter] public Func<string, object, Task<bool>> Post { get; set; } = (_, _) => Task.FromResult(false);
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    bool _busy;
    bool _ok;
    string _msg = "";

    async Task DeleteSelected() {
        _busy = true;
        _msg = "";
        var ok = await Post("/api/protos/versions/delete", new { versions = Selected });
        _ok = ok;
        _msg = ok ? $"deleted {Selected.Count}" : "delete failed (admin only?)";
        _busy = false;
        if (ok) await OnChanged.InvokeAsync();
    }

    async Task MergeSelected() {
        _busy = true;
        _msg = "";
        var ordered = Selected
            .OrderBy(k => k.Platform, StringComparer.OrdinalIgnoreCase)
            .ThenBy(k => k.Build, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var canonical = ordered[0];
        var aliases = ordered.Skip(1).ToList();
        var ok = await Post("/api/protos/versions/merge", new { canonical, aliases });
        _ok = ok;
        _msg = ok ? $"merged {Selected.Count} builds into one release" : "merge failed (admin only?)";
        _busy = false;
        if (ok) await OnChanged.InvokeAsync();
    }

}
