@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@using System.Globalization
@implements IDisposable

<div class="panel">
    <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold my-0">Devices</h3>
        @if (_isAdmin) {
            <button type="button" class="dropzone-open" title="Open device workbench" aria-label="Open device workbench"
                    @onclick="@(() => OnManage.InvokeAsync(null))">
                <Icon Name="chevronRight" Class="icon-sm"/>
            </button>
        }
    </div>
    @if (_devices.Count == 0) {
        <p class="text-muted text-xs">No devices declared on this host.</p>
    } else {
        <div class="flex flex-col gap-1.5">
            @foreach (var d in _devices.OrderBy(x => x.Label, StringComparer.OrdinalIgnoreCase)) {
                <div class="pd-devrow @(_isAdmin ? "dwb-row-click" : "")"
                     @onclick="@(() => {
                                   if (_isAdmin) OnManage.InvokeAsync(d.Id);
                               })">
                    <span class="@(d.Reachable ? "text-ok" : "text-err") shrink-0">
                        <PlatformIcon Platform="@d.Platform"/>
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium truncate">@d.Label</span>
                            @if (DataChip(d) is { } chip) {
                                <span class="@chip.Color shrink-0 self-center inline-flex" title="@chip.Title">
                                    <Icon Name="@chip.Icon" Class="icon-sm"/>
                                </span>
                            }
                        </div>
                        <div class="text-xs mt-0.5 flex items-center gap-2">
                            <VersionLine App="@d.InstalledAppVersion" Build="@d.InstalledBuild" Client="@ClientText(d)"/>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {

    sealed record DeviceStatus(
        string Id,
        string Platform,
        string Label,
        bool Reachable,
        string? InstalledAppVersion,
        string? InstalledBuild,
        string? StoreLatest,
        bool StoreAhead,
        string Result,
        string? Note,
        DateTimeOffset ProbedAt,
        int? ClientVersion);

    [Parameter] public EventCallback<string?> OnManage { get; set; }

    List<DeviceStatus> _devices = [];

    static (string Icon, string Color, string Title)? DataChip(DeviceStatus d) {
        if (!d.Reachable) return null;
        var icon = d.ClientVersion is null ? "info" : "check";
        if (d.Result == "new_version") return (icon, "text-accent", "new build detected");
        return d.ClientVersion is null
            ? (icon, "text-muted", "client version not extracted yet")
            : (icon, "text-ok", "app version, build and client version all known");
    }

    static string? ClientText(DeviceStatus d) {
        return d.ClientVersion?.ToString(CultureInfo.InvariantCulture);
    }

    bool _isAdmin;
    bool _disposed;
    Timer? _timer;

    protected override async Task OnInitializedAsync() {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        await LoadAsync();


        _timer = ComponentTimers.Every(TimeSpan.FromSeconds(30), () => InvokeAsync(TickAsync));
    }

    PageVisibility? _vis;

    PageVisibility Vis => _vis ??= new PageVisibility(JS, Env);

    protected override Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) KickReprobe();
        return Task.CompletedTask;
    }

    async Task TickAsync() {
        if (_disposed || !await Vis.IsVisibleAsync()) return;
        await LoadAsync();
        KickReprobe();
    }

    public async Task LoadAsync() {
        try {
            var rows = await Client().GetFromJsonAsync<List<DeviceStatus>>("/api/devices/status");
            _devices = rows ?? [];
            StateHasChanged();
        }
        catch {
            /* transient; keep last good */
        }
    }

    bool _reprobing;

    void KickReprobe() {
        if (!_isAdmin || _reprobing || _disposed) return;
        _ = Task.Run(ReprobeStaleAsync);
    }


    async Task ReprobeStaleAsync() {
        if (!_isAdmin || _reprobing || _disposed) return;
        var stale = _devices.Where(d => !d.Reachable).Select(d => d.Id).ToList();
        if (stale.Count == 0) return;
        _reprobing = true;
        try {
            foreach (var id in stale) {
                try {
                    await Client().PostAsync($"/api/devices/{id}/refresh", null);
                }
                catch {
                    /* device still down; ignore */
                }
            }

            var rows = await Client().GetFromJsonAsync<List<DeviceStatus>>("/api/devices/status");
            if (rows is not null) {
                _devices = rows;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally {
            _reprobing = false;
        }
    }

    public void Dispose() {
        _disposed = true;
        _timer?.Dispose();
        _ = _vis?.DisposeAsync();
    }

}
