@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject ICurrentUser User
@inject IJSRuntime JS
@using System.Net
@using System.Text.Json
@using EggIncognito.Core.Services.Devices
@implements IDisposable

<div class="panel dev-log-host">
    <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold my-0">Devices</h3>
        @if (_isAdmin) {
            <button class="icon-btn icon-btn-sm relative" title="Device activity log" @onclick="ToggleLog">
                <Icon Name="history"/>
                @if (!_logOpen && _unread > 0) {
                    <span class="dev-log-badge">@_unread</span>
                }
            </button>
        }
    </div>
    @if (_devices.Count == 0) {
        <p class="text-muted text-xs">No devices declared on this host.</p>
    } else {
        <div class="flex flex-col divide-y divide-border">
            @foreach (var d in _devices) {
                var busy = Busy(d.Id);
                <div class="flex items-center gap-2.5 py-2 first:pt-0 last:pb-0">
                    <span class="@(d.Reachable ? "text-green-500" : "text-red-500") shrink-0">
                        <Icon Name="@PlatformIcon(d.Platform)"/>
                    </span>
                    <div class="min-w-0 flex-1 max-w-[19rem]">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium truncate">@d.Label</span>
                            @if (Capture(d.Id) is { } cap) {
                                var v = CaptureVerdict(cap);
                                <span class="@v.Color shrink-0 self-center inline-flex">
                                    <Icon Name="@CaptureIcon(v.Color)" Class="icon-sm"/>
                                </span>
                            }
                            <span class="text-xs text-muted opacity-60 whitespace-nowrap shrink-0">@Ago(d.ProbedAt)</span>
                            @if (d.Result == "new_version") {
                                <span class="dev-badge-new">NEW</span>
                            }
                        </div>
                        <div class="text-xs mt-0.5 flex items-center gap-2">
                            <span class="dev-verline">
                                @(d.InstalledAppVersion ?? "?")
                                <span class="dev-versep">|</span> @(d.InstalledBuild ?? "?")
                                @if (_clientVersion.GetValueOrDefault(d.Id) is int cv) {
                                    <span class="dev-versep">|</span>
                                    <text> @cv</text>
                                }
                            </span>
                        </div>
                    </div>
                    @if (_isAdmin) {
                        @if (d.Result == "new_version") {
                            <button class="icon-btn icon-btn-sm" disabled="@busy" title="Install this version into the proto registry" @onclick="() => Save(d.Id)">
                                <Icon Name="@(busy ? "clock" : "download")"/>
                            </button>
                        }

                        <button class="icon-btn icon-btn-sm" disabled="@busy" title="Check this device's store for an update now" @onclick="() => CheckUpdate(d.Id)">
                            <Icon Name="@(busy ? "clock" : "refresh")"/>
                        </button>
                        <button class="icon-btn icon-btn-sm" disabled="@busy" title="Force-restart Egg Inc to trigger an auxbrain call + capture clientVersion" @onclick="() => RestartApp(d.Id)">
                            <Icon Name="@(busy ? "clock" : "play")"/>
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (_isAdmin && _logOpen) {
        <div class="dev-log-pop">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Activity</span>
                <div class="flex items-center gap-1">
                    <button class="icon-btn icon-btn-sm" title="Clear log" @onclick="ClearLog">
                        <Icon Name="trash"/>
                    </button>
                    <button class="icon-btn icon-btn-sm" title="Collapse" @onclick="ToggleLog">
                        <Icon Name="x"/>
                    </button>
                </div>
            </div>
            @if (_log.Count == 0) {
                <p class="text-muted text-xs my-0">No activity yet.</p>
            } else {
                <div class="flex flex-col divide-y divide-border">
                    @foreach (var e in _log) {
                        <div class="py-1 text-xs">
                            <span class="text-muted opacity-60 font-mono">@e.At.ToLocalTime().ToString("HH:mm:ss")</span>
                            <span class="font-medium mx-1">@e.Label</span>
                            <span class="@(e.IsError ? "text-red-400" : "text-fg")">@e.Message</span>
                        </div>
                    }
                </div>
            }
        </div>
    }

</div>

@code {

    sealed record DeviceStatus(
        string Id,
        string Platform,
        string Label,
        bool Reachable,
        string? InstalledAppVersion,
        string? InstalledBuild,
        string? LatestAvailable,
        string? StoreLatest,
        bool StoreAhead,
        string Result,
        string? Note,
        DateTimeOffset ProbedAt);


    sealed record LogEntry(DateTimeOffset At, string Label, string Message, bool IsError);


    sealed record CaptureBlock(
        bool Listening,
        int Port,
        long ClientConnects,
        long AuxbrainConnects,
        long Flows,
        long RinfoHarvests,
        string? LastDecryptError,
        List<string>? RecentConnects);

    sealed record LiveResponse(bool Found, int? ClientVersion, CaptureBlock? Capture);

    List<DeviceStatus> _devices = [];
    readonly Dictionary<string, CaptureBlock> _capture = new();
    readonly Dictionary<string, int?> _clientVersion = new();
    readonly HashSet<string> _busy = [];
    readonly List<LogEntry> _log = [];
    bool _logOpen;
    int _unread;

    CaptureBlock? Capture(string id) {
        return _capture.GetValueOrDefault(id);
    }


    static DeviceCaptureVerdict.Verdict CaptureVerdict(CaptureBlock c) {
        return DeviceCaptureVerdict.For(
            new DeviceCaptureVerdict.Counters(
                c.Listening, c.Port, c.ClientConnects, c.AuxbrainConnects, c.Flows, c.RinfoHarvests, c.LastDecryptError));
    }

    static string CaptureIcon(string color) {
        return color switch {
            "text-green-400" => "check",
            "text-yellow-400" => "info",
            _ => "x"
        };
    }

    bool _isAdmin;
    bool _disposed;
    Timer? _timer;
    string _baseAddress = "";
    string? _cookie;

    bool Busy(string id) {
        return _busy.Contains(id);
    }

    string LabelFor(string id) {
        return _devices.FirstOrDefault(d => d.Id == id)?.Label ?? id;
    }

    void AddLog(string id, string message, bool isError = false) {
        var label = LabelFor(id);
        if (_log.Count > 0 && _log[0].Label == label && _log[0].Message == message) return;
        _log.Insert(0, new LogEntry(DateTimeOffset.UtcNow, label, message, isError));
        if (_log.Count > 200) _log.RemoveAt(_log.Count - 1);
        if (!_logOpen) _unread++;
    }

    void ToggleLog() {
        _logOpen = !_logOpen;
        if (_logOpen) _unread = 0;
    }

    void ClearLog() {
        _log.Clear();
        _unread = 0;
    }

    protected override async Task OnInitializedAsync() {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null) {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }

        await LoadAsync();


        _timer = new Timer(async _ => await InvokeAsync(TickAsync), null, 30_000, 30_000);
    }

    HttpClient Client() {
        return SelfCallClient.Create(HttpFactory, _baseAddress, _cookie);
    }

    IJSObjectReference? _vis;

    async Task<bool> PageVisibleAsync() {
        try {
            _vis ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop/visibility.js");
            return await _vis.InvokeAsync<bool>("isVisible");
        }
        catch {
            return true;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) KickReprobe();
        return Task.CompletedTask;
    }

    async Task TickAsync() {
        if (_disposed || !await PageVisibleAsync()) return;
        await LoadAsync();
        KickReprobe();
    }

    async Task LoadAsync() {
        try {
            var rows = await Client().GetFromJsonAsync<List<DeviceStatus>>("/api/devices/status");
            _devices = rows ?? [];
            StateHasChanged();
            await LoadCaptureAsync();
        }
        catch {
            /* transient; keep last good */
        }
    }

    bool _reprobing;

    void KickReprobe() {
        if (!_isAdmin || _reprobing || _disposed) return;
        _ = Task.Run(ReprobeStaleAsync);
    }


    async Task ReprobeStaleAsync() {
        if (!_isAdmin || _reprobing || _disposed) return;
        var stale = _devices.Where(d => !d.Reachable).Select(d => d.Id).ToList();
        if (stale.Count == 0) return;
        _reprobing = true;
        try {
            foreach (var id in stale) {
                try {
                    await Client().PostAsync($"/api/devices/{id}/refresh", null);
                }
                catch {
                    /* device still down; ignore */
                }
            }

            var rows = await Client().GetFromJsonAsync<List<DeviceStatus>>("/api/devices/status");
            if (rows is not null) {
                _devices = rows;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally {
            _reprobing = false;
        }
    }


    async Task LoadCaptureAsync() {
        foreach (var d in _devices.ToList()) {
            try {
                var live = await Client().GetFromJsonAsync<LiveResponse>($"/api/devices/{d.Id}/live");
                if (live?.Capture is { } cap) _capture[d.Id] = cap;
                else _capture.Remove(d.Id);
                _clientVersion[d.Id] = live?.ClientVersion;
            }
            catch {
                /* transient / capture off: keep last known, chip hides if never set */
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    [Parameter] public EventCallback OnSaved { get; set; }

    Task Save(string id) {
        return Act(id, $"/api/devices/{id}/save", "pulling + extracting...", "installed to registry", OnSaved);
    }


    async Task RestartApp(string id) {
        _busy.Add(id);
        AddLog(id, "restarting app...");
        StateHasChanged();
        try {
            var resp = await Client().PostAsync($"/api/devices/{id}/restart-app", null);
            if (resp.IsSuccessStatusCode) {
                AddLog(id, "launched, waiting for API call...");
                await InvokeAsync(StateHasChanged);
                var captured = false;
                for (var i = 0; i < 8 && !_disposed; i++) {
                    await Task.Delay(2000);
                    await LoadCaptureAsync();
                    if (_clientVersion.GetValueOrDefault(id) is not null) {
                        captured = true;
                        break;
                    }
                }

                AddLog(id, captured ? "clientVersion captured" : "no clientVersion captured (timed out)", !captured);
            } else {
                AddLog(id, await ReadError(resp), true);
            }
        }
        catch (Exception ex) {
            AddLog(id, ex.Message, true);
        }
        finally {
            _busy.Remove(id);
            await InvokeAsync(StateHasChanged);
        }
    }


    async Task CheckUpdate(string id) {
        _busy.Add(id);
        AddLog(id, "checking store...");
        StateHasChanged();
        try {
            var resp = await Client().PostAsync($"/api/devices/{id}/check-update", null);
            if (resp.StatusCode == HttpStatusCode.Accepted
                || resp.StatusCode == HttpStatusCode.Conflict) {
                if (resp.StatusCode == HttpStatusCode.Conflict)
                    AddLog(id, "check already running");
                await PollCheckStatus(id);
            } else {
                AddLog(id, await ReadError(resp), true);
            }
        }
        catch (Exception ex) {
            AddLog(id, ex.Message, true);
        }
        finally {
            _busy.Remove(id);
            await InvokeAsync(StateHasChanged);
        }
    }


    async Task PollCheckStatus(string id) {
        while (!_disposed) {
            await Task.Delay(3000);
            if (_disposed) return;
            JsonElement body;
            try {
                var resp = await Client().GetAsync($"/api/devices/{id}/check-status");
                if (!resp.IsSuccessStatusCode) {
                    AddLog(id, await ReadError(resp), true);
                    return;
                }

                body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            }
            catch (Exception ex) {
                AddLog(id, ex.Message, true);
                return;
            }

            var state = body.TryGetProperty("state", out var st) ? st.GetString() : null;
            var message = body.TryGetProperty("message", out var m) ? m.GetString() : null;
            var action = body.TryGetProperty("action", out var a) ? a.GetString() : null;
            var after = body.TryGetProperty("installedAfter", out var af) ? af.GetString() : null;

            if (state == "running") {
                if (!string.IsNullOrEmpty(message)) {
                    AddLog(id, message);
                    await InvokeAsync(StateHasChanged);
                }

                continue;
            }


            var (final, isError) = (state, action) switch {
                ("error", _) => (message ?? "check failed", true),
                (_, "up_to_date") => ("up to date", false),
                (_, "updated") => ($"updated to {after}", false),
                (_, "unreachable") => ("device unreachable", true),
                ("idle", _) => ("checked", false),
                _ => (message ?? "checked", false)
            };
            AddLog(id, final, isError);
            await LoadAsync();
            return;
        }
    }


    async Task Act(string id, string url, string busyMsg, string okMsg, EventCallback onSuccess = default) {
        _busy.Add(id);
        AddLog(id, busyMsg);
        StateHasChanged();
        try {
            var resp = await Client().PostAsync(url, null);
            if (resp.IsSuccessStatusCode) {
                AddLog(id, okMsg);
                await LoadAsync();
                if (onSuccess.HasDelegate) await onSuccess.InvokeAsync();
            } else {
                AddLog(id, await ReadError(resp), true);
            }
        }
        catch (Exception ex) {
            AddLog(id, ex.Message, true);
        }
        finally {
            _busy.Remove(id);
            await InvokeAsync(StateHasChanged);
        }
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed ({(int)resp.StatusCode})";
        }
        catch {
            /* not json */
        }

        return $"failed ({(int)resp.StatusCode})";
    }

    static string PlatformIcon(string platform) {
        return platform switch {
            "ios" => "apple",
            "android" => "android",
            _ => "device"
        };
    }

    static string Ago(DateTimeOffset t) {
        var s = (DateTimeOffset.UtcNow - t).TotalSeconds;
        return s < 60 ? "just now" : s < 3600 ? $"{(int)(s / 60)}m ago" : $"{(int)(s / 3600)}h ago";
    }

    public void Dispose() {
        _disposed = true;
        _timer?.Dispose();
        _ = _vis?.DisposeAsync();
    }

}
