@using System.Net.Http.Json
@using System.Text.Json
@using EggIncognito.Services
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject ICurrentUser User
@inject IJSRuntime JS
@implements IDisposable

<div class="panel">
    <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold m-0">Devices</h3>
        <span class="text-muted text-xs">@(_devices.Count == 0 ? "none configured" : $"{_devices.Count} connected")</span>
    </div>
    @if (_devices.Count == 0)
    {
        <p class="text-muted text-xs">No devices declared on this host.</p>
    }
    else
    {
        <div class="flex flex-col divide-y divide-border">
            @foreach (var d in _devices)
            {
                var act = State(d.Id);
                <div class="flex items-center gap-2.5 py-2 first:pt-0 last:pb-0">
                    <span class="@(d.Reachable ? "text-green-500" : "text-red-500") shrink-0" title="@(d.Reachable ? "reachable" : "unreachable")">
                        <Icon Name="@PlatformIcon(d.Platform)" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium truncate">@d.Label</span>
                            <span class="text-xs text-muted opacity-60 whitespace-nowrap shrink-0" title="@d.ProbedAt.ToString("u")">@Ago(d.ProbedAt)</span>
                            @if (d.Result == "new_version")
                            {
                                <span class="dev-badge-new" title="Installed version can populate new registry version">NEW</span>
                            }
                        </div>
                        <div class="text-xs mt-0.5 flex items-center gap-2">
                            @if (act.Message is not null)
                            {
                                <span class="@(act.IsError ? "text-red-400" : "text-green-400")">@act.Message</span>
                            }
                            else
                            {
                                @* version | build | client on one line; clientVersion only shown once captured *@
                                <span class="dev-verline">
                                    @(d.InstalledAppVersion ?? "?")
                                    <span class="dev-versep">|</span> @(d.InstalledBuild ?? "?")
                                    @if (_clientVersion.GetValueOrDefault(d.Id) is int cv)
                                    {
                                        <span class="dev-versep">|</span><text> @cv</text>
                                    }
                                </span>
                            }
                        </div>
                        @{ var cap = Capture(d.Id); }
                        @if (cap is not null)
                        {
                            var v = CaptureVerdict(cap);
                            <div class="text-xs mt-0.5 flex items-center gap-1.5" title="@v.Detail">
                                <span class="@v.Color">capture: @v.Label</span>
                            </div>
                        }
                    </div>
                    @if (_isAdmin)
                    {
                        @if (d.Result == "new_version")
                        {
                            <button class="icon-btn icon-btn-sm" disabled="@act.Busy" title="Install this version into the proto registry" @onclick="() => Save(d.Id)">
                                <Icon Name="@(act.Busy ? "clock" : "download")" />
                            </button>
                        }
                        <button class="icon-btn icon-btn-sm" disabled="@act.Busy" title="Check this device's store for an update now" @onclick="() => CheckUpdate(d.Id)">
                            <Icon Name="@(act.Busy ? "clock" : "refresh")" />
                        </button>
                        <button class="icon-btn icon-btn-sm" disabled="@act.Busy" title="Force-restart Egg Inc to trigger an auxbrain call + capture clientVersion" @onclick="() => RestartApp(d.Id)">
                            <Icon Name="@(act.Busy ? "clock" : "play")" />
                        </button>
                    }
                </div>
            }
        </div>
    }

    @* Dismissable explainer INSIDE the panel (matches the missing-versions note), shown until closed
       (persisted in localStorage). Everyone sees it. *@
    @if (!_infoDismissed)
    {
        <div class="rounded-md border border-border bg-panel2 p-2 mt-3 text-xs text-muted relative">
            <button type="button" class="absolute top-1.5 right-1.5 text-muted hover:text-fg"
                    title="Dismiss" @onclick="DismissInfo">
                <Icon Name="x" Class="icon-sm" />
            </button>
            <div class="flex items-center gap-1.5 text-sm font-medium text-fg mb-1">
                <Icon Name="info" Class="icon-sm" />
                <span>Why two devices?</span>
            </div>
            <p class="m-0 pr-5">
                Two physical phones (one Android, one iOS) stay plugged into this host running Egg, Inc. They
                exist only to keep the proto registry current: when a new app version ships, the device updates
                and its fresh proto definition is pulled in automatically. No accounts, no gameplay, just a
                live source of the latest schema.
            </p>
        </div>
    }
</div>

@code {
    sealed record DeviceStatus(string Id, string Platform, string Label, bool Reachable,
        string? InstalledAppVersion, string? InstalledBuild,
        string? LatestAvailable, string? StoreLatest, bool StoreAhead,
        string Result, string? Note, DateTimeOffset ProbedAt);

   
   
    sealed class ActionState { public bool Busy; public string? Message; public bool IsError; }

    const string InfoDismissKey = "egi:devicesInfoDismissed";

   
   
    sealed record CaptureBlock(bool Listening, int Port, long ClientConnects, long AuxbrainConnects,
        long Flows, long RinfoHarvests, string? LastDecryptError, List<string>? RecentConnects);
    sealed record LiveResponse(bool Found, int? ClientVersion, CaptureBlock? Capture);

    List<DeviceStatus> _devices = [];
    readonly Dictionary<string, CaptureBlock> _capture = new();
    readonly Dictionary<string, int?> _clientVersion = new();
    readonly Dictionary<string, ActionState> _actions = new();

    CaptureBlock? Capture(string id) => _capture.GetValueOrDefault(id);

   
    static EggIncognito.Core.Services.Devices.DeviceCaptureVerdict.Verdict CaptureVerdict(CaptureBlock c) =>
        EggIncognito.Core.Services.Devices.DeviceCaptureVerdict.For(
            new EggIncognito.Core.Services.Devices.DeviceCaptureVerdict.Counters(
                c.Listening, c.Port, c.ClientConnects, c.AuxbrainConnects, c.Flows, c.RinfoHarvests, c.LastDecryptError));
    bool _isAdmin;
    bool _infoDismissed;
    bool _disposed;
    Timer? _timer;
    string _baseAddress = "";
    string? _cookie;

    ActionState State(string id) => _actions.TryGetValue(id, out var s) ? s : new ActionState();

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
        await LoadAsync();
       
       
        _timer = new Timer(async _ => await InvokeAsync(LoadAsync), null, 8_000, 8_000);
    }

   
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var v = await JS.InvokeAsync<string?>("localStorage.getItem", InfoDismissKey);
            if (v == "1") { _infoDismissed = true; StateHasChanged(); }
        }
        catch { /* prerender / JS unavailable: keep the note shown */ }
    }

    async Task DismissInfo()
    {
        _infoDismissed = true;
        try { await JS.InvokeVoidAsync("localStorage.setItem", InfoDismissKey, "1"); } catch { }
    }

    HttpClient Client() => EggIncognito.Services.SelfCallClient.Create(HttpFactory, _baseAddress, _cookie);

    async Task LoadAsync()
    {
        try
        {
            var rows = await Client().GetFromJsonAsync<List<DeviceStatus>>("/api/devices/status");
            _devices = rows ?? [];
            StateHasChanged();
            await LoadCaptureAsync();
            await ReprobeStaleAsync();
        }
        catch { /* transient; keep last good */ }
    }

    bool _reprobing;

   
   
    async Task ReprobeStaleAsync()
    {
        if (!_isAdmin || _reprobing) return;
        var stale = _devices.Where(d => !d.Reachable).Select(d => d.Id).ToList();
        if (stale.Count == 0) return;
        _reprobing = true;
        try
        {
            foreach (var id in stale)
            {
                try { await Client().PostAsync($"/api/devices/{id}/refresh", null); }
                catch { /* device still down; ignore */ }
            }
           
            var rows = await Client().GetFromJsonAsync<List<DeviceStatus>>("/api/devices/status");
            if (rows is not null) { _devices = rows; await InvokeAsync(StateHasChanged); }
        }
        finally { _reprobing = false; }
    }

   
   
    async Task LoadCaptureAsync()
    {
        foreach (var d in _devices.ToList())
        {
            try
            {
                var live = await Client().GetFromJsonAsync<LiveResponse>($"/api/devices/{d.Id}/live");
                if (live?.Capture is { } cap) _capture[d.Id] = cap;
                else _capture.Remove(d.Id);
                _clientVersion[d.Id] = live?.ClientVersion;
            }
            catch { /* transient / capture off: keep last known, chip hides if never set */ }
        }
        await InvokeAsync(StateHasChanged);
    }

    [Parameter] public EventCallback OnSaved { get; set; }

    Task Save(string id) => Act(id, $"/api/devices/{id}/save", "pulling + extracting...", "installed to registry", OnSaved);

   
   
    async Task RestartApp(string id)
    {
        var s = _actions[id] = new ActionState { Busy = true, Message = "restarting app..." };
        StateHasChanged();
        try
        {
            var resp = await Client().PostAsync($"/api/devices/{id}/restart-app", null);
            if (resp.IsSuccessStatusCode)
            {
                s.Message = "launched, waiting for API call...";
               
               
                for (var i = 0; i < 8 && !_disposed; i++)
                {
                    await Task.Delay(2000);
                    await LoadCaptureAsync();
                    if (_clientVersion.GetValueOrDefault(id) is not null) { s.Message = "clientVersion captured"; break; }
                }
            }
            else { s.Message = await ReadError(resp); s.IsError = true; }
        }
        catch (Exception ex) { s.Message = ex.Message; s.IsError = true; }
        finally { s.Busy = false; StateHasChanged(); _ = ClearLater(id); }
    }

   
   
    async Task CheckUpdate(string id)
    {
        var s = _actions[id] = new ActionState { Busy = true, Message = "checking store..." };
        StateHasChanged();
        try
        {
            var resp = await Client().PostAsync($"/api/devices/{id}/check-update", null);
            if (resp.StatusCode == System.Net.HttpStatusCode.Accepted
                || resp.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
                    s.Message = "check already running";
                await PollCheckStatus(id);
            }
            else
            {
                s.Message = await ReadError(resp); s.IsError = true;
                s.Busy = false; StateHasChanged(); _ = ClearLater(id);
            }
        }
        catch (Exception ex)
        {
            s.Message = ex.Message; s.IsError = true;
            s.Busy = false; StateHasChanged(); _ = ClearLater(id);
        }
    }

   
   
    async Task PollCheckStatus(string id)
    {
        var s = _actions.TryGetValue(id, out var existing) ? existing : (_actions[id] = new ActionState { Busy = true });
        while (!_disposed)
        {
            await Task.Delay(3000);
            if (_disposed) return;
            JsonElement body;
            try
            {
                var resp = await Client().GetAsync($"/api/devices/{id}/check-status");
                if (!resp.IsSuccessStatusCode) { s.Message = await ReadError(resp); s.IsError = true; break; }
                body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            }
            catch (Exception ex) { s.Message = ex.Message; s.IsError = true; break; }

            var state = body.TryGetProperty("state", out var st) ? st.GetString() : null;
            var message = body.TryGetProperty("message", out var m) ? m.GetString() : null;
            var action = body.TryGetProperty("action", out var a) ? a.GetString() : null;
            var after = body.TryGetProperty("installedAfter", out var af) ? af.GetString() : null;

            if (state == "running")
            {
                if (!string.IsNullOrEmpty(message)) { s.Message = message; await InvokeAsync(StateHasChanged); }
                continue;
            }

           
            (s.Message, s.IsError) = (state, action) switch
            {
                ("error", _) => (message ?? "check failed", true),
                (_, "up_to_date") => ("up to date", false),
                (_, "updated") => ($"updated to {after}", false),
                (_, "unreachable") => ("device unreachable", true),
                ("idle", _) => ("checked", false),
                _ => (message ?? "checked", false),
            };
            await LoadAsync();
            break;
        }
        s.Busy = false;
        await InvokeAsync(StateHasChanged);
        _ = ClearLater(id);
    }

   
   
   
    async Task Act(string id, string url, string busyMsg, string okMsg, EventCallback onSuccess = default)
    {
        var s = _actions[id] = new ActionState { Busy = true, Message = busyMsg };
        StateHasChanged();
        try
        {
            var resp = await Client().PostAsync(url, null);
            if (resp.IsSuccessStatusCode)
            {
                s.Message = okMsg; s.IsError = false;
                await LoadAsync();
                if (onSuccess.HasDelegate) await onSuccess.InvokeAsync();
            }
            else
            {
                s.Message = await ReadError(resp); s.IsError = true;
            }
        }
        catch (Exception ex)
        {
            s.Message = ex.Message; s.IsError = true;
        }
        finally
        {
            s.Busy = false;
            StateHasChanged();
            _ = ClearLater(id);
        }
    }

    static async Task<string> ReadError(HttpResponseMessage resp)
    {
        try
        {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed ({(int)resp.StatusCode})";
        }
        catch { /* not json */ }
        return $"failed ({(int)resp.StatusCode})";
    }

   
    async Task ClearLater(string id)
    {
        await Task.Delay(6000);
        if (_actions.TryGetValue(id, out var s) && !s.Busy)
        {
            _actions.Remove(id);
            await InvokeAsync(StateHasChanged);
        }
    }

    static string PlatformIcon(string platform) => platform switch
    {
        "ios" => "apple",
        "android" => "android",
        _ => "device",
    };

    static string Ago(DateTimeOffset t)
    {
        var s = (DateTimeOffset.UtcNow - t).TotalSeconds;
        return s < 60 ? "just now" : s < 3600 ? $"{(int)(s / 60)}m ago" : $"{(int)(s / 3600)}h ago";
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
    }
}
