@using EggIncognito.Services
@inject IHttpClientFactory HttpFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject ICurrentUser User
@implements IDisposable

<div class="panel">
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold">Devices</h3>
        <span class="text-muted text-xs">@(_devices.Count == 0 ? "none configured" : $"{_devices.Count} connected")</span>
    </div>
    @if (_devices.Count == 0)
    {
        <p class="text-muted text-xs">No devices declared on this host.</p>
    }
    else
    {
        <div class="flex flex-col gap-2.5">
            @foreach (var d in _devices)
            {
                <div class="flex items-center gap-2.5">
                    <span class="@(d.Reachable ? "text-green-500" : "text-red-500")" title="@(d.Reachable ? "reachable" : "unreachable")">
                        <Icon Name="@PlatformIcon(d.Platform)" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium truncate">@d.Label</span>
                            <span class="code-chip">@(d.InstalledAppVersion ?? "?")</span>
                            @if (d.Result == "new_version")
                            {
                                <span class="dev-badge-new" title="installed version is newer than the latest extracted build">new available</span>
                            }
                        </div>
                        <div class="text-muted text-xs mt-0.5">@StatusLine(d)</div>
                    </div>
                    @if (_isAdmin)
                    {
                        <button class="btn-ghost-sm" disabled="@_busy" title="check this device now" @onclick="() => Refresh(d.Id)">
                            <Icon Name="refresh" Class="icon-sm" />
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    sealed record DeviceStatus(string Id, string Platform, string Label, bool Reachable,
        string? InstalledAppVersion, string? InstalledBuild, string? LatestAvailable,
        string Result, string? Note, DateTimeOffset ProbedAt);

    List<DeviceStatus> _devices = [];
    bool _isAdmin;
    bool _busy;
    Timer? _timer;
    string _baseAddress = "";
    string? _cookie;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        var req = HttpContextAccessor.HttpContext?.Request;
        if (req is not null)
        {
            _baseAddress = $"{req.Scheme}://{req.Host}";
            _cookie = req.Headers.Cookie;
        }
        await LoadAsync();
        _timer = new Timer(async _ => await InvokeAsync(LoadAsync), null, 15_000, 15_000);
    }

    HttpClient Client()
    {
        var c = HttpFactory.CreateClient();
        if (!string.IsNullOrEmpty(_baseAddress)) c.BaseAddress = new Uri(_baseAddress);
        if (!string.IsNullOrEmpty(_cookie)) c.DefaultRequestHeaders.Add("Cookie", _cookie);
        return c;
    }

    async Task LoadAsync()
    {
        try
        {
            var rows = await Client().GetFromJsonAsync<List<DeviceStatus>>("/api/devices/status");
            _devices = rows ?? [];
            StateHasChanged();
        }
        catch { /* transient; keep last good */ }
    }

    async Task Refresh(string id)
    {
        _busy = true; StateHasChanged();
        try { await Client().PostAsync($"/api/devices/{id}/refresh", null); await LoadAsync(); }
        catch { }
        finally { _busy = false; StateHasChanged(); }
    }

    static string PlatformIcon(string platform) => platform switch
    {
        "ios" => "apple",
        "android" => "android",
        _ => "device",
    };

    // One muted line under the label: the probe outcome plus how long ago it ran.
    static string StatusLine(DeviceStatus d)
    {
        var when = Ago(d.ProbedAt);
        var state = d.Result switch
        {
            "unreachable" => "unreachable",
            "error" => string.IsNullOrEmpty(d.Note) ? "probe error" : d.Note!,
            "new_version" => "update available",
            _ => "up to date",
        };
        return $"{state} · {when}";
    }

    static string Ago(DateTimeOffset t)
    {
        var s = (DateTimeOffset.UtcNow - t).TotalSeconds;
        return s < 60 ? "just now" : s < 3600 ? $"{(int)(s / 60)}m ago" : $"{(int)(s / 3600)}h ago";
    }

    public void Dispose() => _timer?.Dispose();
}
