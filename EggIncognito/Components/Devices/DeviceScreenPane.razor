@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<DeviceScreenPane> Logger
@using System.Globalization
@using System.Text.Json
@using EggIdentity.UI
@using EggIncognito.Models.Devices
@implements IAsyncDisposable

@if (_deviceId is null) {
    <div class="wb-note">Pick a device.</div>
} else {
    <div class="dcon-body">
        <div class="dcon-col">
            <div class="dcon-sec-head">Screen</div>

            <div class="dcon-keys">
                <select class="field-input dcon-rate" aria-label="Stream frame rate" value="@_fps"
                        @onchange="FpsChanged">
                    @foreach (var fps in Rates) {
                        <option value="@fps">@fps fps</option>
                    }
                </select>
                <button type="button" class="btn-mini" @onclick="ToggleStreamAsync">
                    @(_live ? "Pause" : "Go live")
                </button>
                <button type="button" class="btn-mini" @onclick="OneFrameAsync">One frame</button>
            </div>

            <div class="dcon-stage">
                <button type="button" class="dcon-shot" @onclick="StageClickAsync"
                        aria-label="Device screen, click to tap">
                    <img class="dcon-img" alt="" @ref="_img"/>
                    @if (_hasFrame && _selected is { HasBounds: true } hl && TapWidth > 0) {
                        <span class="dcon-hl" style="@HighlightStyle(hl)"></span>
                    }
                </button>
                @if (!_hasFrame) {
                    <span class="dcon-stage-empty">@StageEmptyText()</span>
                }
            </div>

            <div class="dcon-keys">
                <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("back"))">Back</button>
                <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("home"))">Home</button>
                <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("recents"))">Recents</button>
                <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("enter"))">Enter</button>
                <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("wake"))">Wake</button>
            </div>

            <div class="dcon-typing">
                <input class="field-input font-mono" placeholder="text for the focused field"
                       aria-label="Text to send" @bind="_text" @bind:event="oninput"/>
                <button type="button" class="btn-mini" disabled="@(_text.Length == 0)" @onclick="SendTextAsync">
                    Send text
                </button>
            </div>

            <div class="dcon-statusbar">
                <span class="dcon-status">@StatusLine()</span>
                <button type="button" class="btn-mini" @onclick="ToggleDetail">
                    @(_showDetail ? "Hide sizes" : "Sizes")
                </button>
            </div>

            @if (_showDetail) {
                <div class="dcon-detail">
                    <div class="dcon-detail-row">
                        <span class="dcon-detail-k">Screenshot</span>
                        <span class="dcon-detail-v">@Dim(_shotW, _shotH) px</span>
                    </div>
                    <div class="dcon-detail-row">
                        <span class="dcon-detail-k">Tap space</span>
                        <span class="dcon-detail-v">@Dim(TapWidth, TapHeight) px, from @TapSpaceSource</span>
                    </div>
                    <div class="dcon-detail-row">
                        <span class="dcon-detail-k">Rendered</span>
                        <span class="dcon-detail-v">@Dim(_renderW, _renderH) css px</span>
                    </div>
                    <div class="dcon-detail-row">
                        <span class="dcon-detail-k">Device</span>
                        <span class="dcon-detail-v">@_deviceId, @(Platform is { Length: > 0 } p ? p : "platform unknown")</span>
                    </div>
                </div>
            }
        </div>

        <div class="dcon-col">
            <div class="dcon-sec-head">Selectors</div>
            <div class="dcon-tree-bar">
                <input class="field-input" type="search" placeholder="filter nodes"
                       aria-label="Filter ui nodes" value="@_filter" @oninput="FilterChanged"/>
                <label class="dcon-check">
                    <input type="checkbox" checked="@_clickableOnly" @onchange="ClickableChanged"/>
                    clickable only
                </label>
                <button type="button" class="btn-mini" disabled="@_dumpBusy" @onclick="LoadDumpAsync">
                    @(_dumpBusy ? "Reading..." : "Read UI tree")
                </button>
            </div>

            @if (_dumpError is { } de) {
                <div class="dcon-tree-note text-err">@de</div>
            } else if (_dump is null) {
                <div class="dcon-tree-note">No UI tree yet.</div>
            } else {
                <div class="dcon-tree-note">
                    @_rows.Count of @_dump.Count nodes
                </div>
                <div class="dcon-tree">
                    @foreach (var node in _rows) {
                        <button type="button" @key="node.Id"
                                class="dcon-node @(_selected?.Id == node.Id ? "dcon-node-on" : "")"
                                style="@IndentStyle(node)" @onclick="@(() => SelectNode(node))">
                            <span class="dcon-node-kind">@node.Kind</span>
                            <span class="dcon-node-label">@node.Label</span>
                            @if (node.Clickable) {
                                <span class="dcon-node-tap">tap</span>
                            }
                        </button>
                    }
                </div>
            }

            @if (_selected is { } sel) {
                <div class="dcon-sel">
                    <div class="dcon-sel-head">
                        <span class="font-mono text-xs">@(sel.ClassName ?? sel.Kind)</span>
                        <span class="text-muted text-xs">
                            @sel.Left,@sel.Top @sel.Width x @sel.Height
                        </span>
                        <button type="button" class="btn-mini" @onclick="TapSelectedAsync">Tap node</button>
                    </div>

                    @if (sel.Selectors.Count == 0) {
                        <div class="dcon-sel-empty">No selectors. Tap by point.</div>
                        <div class="dcon-snip-row">
                            <code class="dcon-snip">@PointStep(sel)</code>
                            <CopyButton Text="@PointStep(sel)" AriaLabel="Copy tap-point step"/>
                        </div>
                    } else {
                        @foreach (var hint in sel.Selectors) {
                            <div class="dcon-snip-row @(hint == sel.Selectors[0] ? "dcon-snip-best" : "")">
                                <span class="dcon-snip-by">@HintLabel(hint)</span>
                                <code class="dcon-snip">@hint.Snippet</code>
                                <CopyButton Text="@hint.Snippet" AriaLabel="Copy selector"/>
                            </div>
                        }

                        <div class="dcon-sel-steps">
                            <div class="dcon-snip-row">
                                <span class="dcon-snip-by">tap step</span>
                                <code class="dcon-snip">@TapStep(sel)</code>
                                <CopyButton Text="@TapStep(sel)" AriaLabel="Copy tap step"/>
                            </div>
                            <div class="dcon-snip-row">
                                <span class="dcon-snip-by">wait step</span>
                                <code class="dcon-snip">@WaitStep(sel)</code>
                                <CopyButton Text="@WaitStep(sel)" AriaLabel="Copy wait step"/>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {

    [Parameter] public string? DeviceId { get; set; }

    [Parameter] public string? Platform { get; set; }

    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback<DeviceNotice> OnNotice { get; set; }

    static readonly int[] Rates = [5, 4, 3, 2, 1];

    bool _disposed;
    bool _live;
    bool _hasFrame;
    bool _showDetail;
    bool _dumpBusy;
    bool _clickableOnly;
    int _fps = 3;
    int _shotW;
    int _shotH;
    int _renderW;
    int _renderH;
    string _filter = "";
    string _text = "";
    string _streamKey = "";
    string? _deviceId;
    string? _streamError;
    string? _dumpError;
    string? _lastTap;

    List<UiNodeRow> _rows = [];
    UiDumpResult? _dump;
    UiNodeRow? _selected;

    ElementReference _img;
    IJSObjectReference? _module;
    DotNetObjectReference<DeviceScreenPane>? _self;

    bool IsIos => string.Equals(Platform, "ios", StringComparison.OrdinalIgnoreCase);

    int TapWidth => IsIos && _dump is { Width: > 0 } d ? d.Width : _shotW;

    int TapHeight => IsIos && _dump is { Height: > 0 } d ? d.Height : _shotH;

    string TapSpaceSource => IsIos && _dump is { Width: > 0 } ? "the ui tree" : "the screenshot";

    protected override async Task OnParametersSetAsync() {
        var next = string.IsNullOrEmpty(DeviceId) ? null : DeviceId;
        if (next != _deviceId) {
            await StopStreamAsync();
            if (_module is { } module) await SafeAsync(() => module.InvokeVoidAsync("clear", _img).AsTask());
            _deviceId = next;
            ResetDevice();
            _live = next is not null;
            return;
        }

        if (!Active) await StopStreamAsync();
    }

    void ResetDevice() {
        _dump = null;
        _rows = [];
        _selected = null;
        _dumpError = null;
        _streamError = null;
        _lastTap = null;
        _hasFrame = false;
        _shotW = _shotH = _renderW = _renderH = 0;
    }

    async Task ToggleStreamAsync() {
        await StopStreamAsync();
        if (_live) {
            _live = false;
            return;
        }

        _streamError = null;
        _live = true;
    }

    void FpsChanged(ChangeEventArgs e) {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var fps)) return;
        _fps = Math.Clamp(fps, 1, 5);
    }

    string StageEmptyText() {
        if (_streamError is not null) return "No picture.";
        return _live ? "Waiting for a frame." : "Paused.";
    }

    string StatusLine() {
        if (_deviceId is null) return "No device.";
        if (_streamError is not null) return "Screen stopped.";
        var head = _live
            ? _hasFrame ? $"Live, {_fps} fps." : "Waiting for a frame."
            : _hasFrame
                ? "One frame."
                : "Paused.";
        return _lastTap is { } tap ? $"{head} Last tap {tap}." : head;
    }

    void ToggleDetail() {
        _showDetail = !_showDetail;
    }

    async Task StageClickAsync(MouseEventArgs e) {
        if (_deviceId is null) return;
        await MeasureAsync();
        if (TapWidth <= 0 || TapHeight <= 0) {
            await Note("no frame measured yet", false);
            return;
        }

        if (_renderW <= 0 || _renderH <= 0) {
            await Note("screen not measured yet", false);
            return;
        }

        var x = Scale(e.OffsetX, _renderW, TapWidth);
        var y = Scale(e.OffsetY, _renderH, TapHeight);
        await TapAsync(x, y);
    }

    static int Scale(double offset, int rendered, int device) {
        var value = (int)Math.Round(offset / rendered * device, MidpointRounding.AwayFromZero);
        return Math.Clamp(value, 0, device - 1);
    }

    async Task TapAsync(int x, int y) {
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/tap",
            new UiTapRequest(x, y), SelfCallJson.Web);
        _lastTap = $"{x}, {y}";
        await Note(res.IsSuccessStatusCode ? $"tapped {x}, {y}" : await ReadError(res), res.IsSuccessStatusCode);
    }

    Task TapSelectedAsync() {
        return _selected is { } sel ? TapAsync(sel.CenterX, sel.CenterY) : Task.CompletedTask;
    }

    async Task SendTextAsync() {
        if (_deviceId is null || _text.Length == 0) return;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/text",
            new UiTextRequest(_text), SelfCallJson.Web);
        await Note(res.IsSuccessStatusCode ? "text sent" : await ReadError(res), res.IsSuccessStatusCode);
    }

    async Task KeyAsync(string key) {
        if (_deviceId is null) return;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/key",
            new UiKeyRequest(key), SelfCallJson.Web);
        await Note(res.IsSuccessStatusCode ? $"sent {key}" : await ReadError(res), res.IsSuccessStatusCode);
    }

    async Task LoadDumpAsync() {
        if (_deviceId is null) return;
        _dumpBusy = true;
        _dumpError = null;
        StateHasChanged();
        try {
            var res = await Client().GetAsync($"/api/devices/{_deviceId}/ui/dump");
            if (!res.IsSuccessStatusCode) {
                _dumpError = await ReadError(res);
                _dump = null;
                _rows = [];
                _selected = null;
                return;
            }

            _dump = await res.Content.ReadFromJsonAsync<UiDumpResult>(SelfCallJson.Web);
            _selected = null;
            ApplyFilter();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Logger.LogDebug(ex, "ui dump read failed");
            _dumpError = ex.Message;
            _dump = null;
            _rows = [];
        }
        finally {
            _dumpBusy = false;
        }
    }

    void FilterChanged(ChangeEventArgs e) {
        _filter = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    void ClickableChanged(ChangeEventArgs e) {
        _clickableOnly = e.Value is true;
        ApplyFilter();
    }

    void ApplyFilter() {
        if (_dump is null) {
            _rows = [];
            return;
        }

        IEnumerable<UiNodeRow> query = _dump.Nodes;
        if (_clickableOnly) query = query.Where(n => n.Clickable);
        var needle = _filter.Trim();
        if (needle.Length > 0) {
            query = query.Where(n => Has(n.Label, needle) || Has(n.ResourceId, needle) || Has(n.Text, needle)
                                     || Has(n.ContentDesc, needle) || Has(n.ClassName, needle));
        }

        _rows = [.. query];
    }

    static bool Has(string? value, string needle) {
        return value is not null && value.Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    void SelectNode(UiNodeRow node) {
        _selected = _selected?.Id == node.Id ? null : node;
    }

    string HighlightStyle(UiNodeRow node) {
        var width = TapWidth;
        var height = TapHeight;
        if (width <= 0 || height <= 0) return "display:none";
        return string.Create(CultureInfo.InvariantCulture,
            $"left:{100.0 * node.Left / width:0.###}%;top:{100.0 * node.Top / height:0.###}%;width:{100.0 * node.Width / width:0.###}%;height:{100.0 * node.Height / height:0.###}%");
    }

    static string IndentStyle(UiNodeRow node) {
        return string.Create(CultureInfo.InvariantCulture, $"--dcon-indent:{Math.Min(node.Depth, 12)}");
    }

    static string HintLabel(UiSelectorHint hint) {
        return hint.Unique ? hint.Label : $"{hint.Label} {hint.Index + 1} of {hint.Matches}";
    }

    static string TapStep(UiNodeRow node) {
        return $"DeviceFlowSteps.Tap({node.Selectors[0].Snippet})";
    }

    static string WaitStep(UiNodeRow node) {
        return $"DeviceFlowSteps.WaitForSelector({node.Selectors[0].Snippet})";
    }

    static string PointStep(UiNodeRow node) {
        return $"DeviceFlowSteps.TapPoint({node.CenterX}, {node.CenterY})";
    }

    static string Dim(int w, int h) {
        return w > 0 && h > 0 ? $"{w} x {h}" : "unknown";
    }

    Task Note(string text, bool ok) {
        return OnNotice.InvokeAsync(new DeviceNotice(text, ok ? StatusNoteKind.Ok : StatusNoteKind.Error));
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed [{(int)resp.StatusCode}]";
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return $"failed [{(int)resp.StatusCode}]";
        }

        return $"failed [{(int)resp.StatusCode}]";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_disposed) return;

        var wanted = _live && Active && _deviceId is not null && _streamError is null;
        var desired = wanted ? $"{_deviceId}|{_fps}" : "";
        if (desired == _streamKey) return;

        if (await ModuleAsync() is not { } module) return;
        await SafeAsync(() => module.InvokeVoidAsync("stop", _img).AsTask());
        _streamKey = desired;
        if (desired.Length == 0) return;

        await SafeAsync(() => module.InvokeAsync<bool>("start", _img, StreamUrl(), Ref()).AsTask());
    }

    async Task StopStreamAsync() {
        _streamKey = "";
        _hasFrame = false;
        if (_module is not { } module) return;
        await SafeAsync(() => module.InvokeVoidAsync("stop", _img).AsTask());
    }

    async Task OneFrameAsync() {
        if (_deviceId is null) return;
        _live = false;
        _streamKey = "";
        _streamError = null;
        if (await ModuleAsync() is not { } module) return;
        await SafeAsync(() => module.InvokeAsync<bool>("once", _img, ScreenshotUrl(), Ref()).AsTask());
    }

    async Task MeasureAsync() {
        if (await ModuleAsync() is not { } module) return;
        var size = await SafeValueAsync(() => module.InvokeAsync<int[]>("measure", _img).AsTask());
        if (size is not { Length: 4 }) return;
        _shotW = size[0];
        _shotH = size[1];
        _renderW = size[2];
        _renderH = size[3];
        _hasFrame = _shotW > 0;
    }

    string StreamUrl() {
        return $"/api/devices/{_deviceId}/ui/stream?fps={_fps}";
    }

    string ScreenshotUrl() {
        return $"/api/devices/{_deviceId}/ui/screenshot";
    }

    [JSInvokable]
    public Task OnFrameSize(int naturalW, int naturalH, int renderW, int renderH) {
        _shotW = naturalW;
        _shotH = naturalH;
        _renderW = renderW;
        _renderH = renderH;
        _hasFrame = naturalW > 0;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnFrameFailed(int status, string note) {
        var live = _live;
        _streamKey = "";
        _live = false;
        _hasFrame = false;
        var failure = FrameFailure(status, note, live);
        _streamError = failure;
        return InvokeAsync(async () => {
            await Note(failure, false);
            StateHasChanged();
        });
    }

    static string FrameFailure(int status, string note, bool live) {
        var detail = status > 0 ? $"{note} [http {status}]" : note;
        var tail = string.IsNullOrWhiteSpace(detail) ? "" : $": {detail}";
        return live ? $"stream ended{tail}" : $"frame failed{tail}";
    }

    DotNetObjectReference<DeviceScreenPane> Ref() {
        _self ??= DotNetObjectReference.Create(this);
        return _self;
    }

    async Task<IJSObjectReference?> ModuleAsync() {
        if (_module is not null) return _module;
        try {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", InteropAsset.Url(Env, "./interop/deviceConsole.js"));
            return _module;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console module import failed");
            return null;
        }
    }

    async Task SafeAsync(Func<Task> call) {
        try {
            await call();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console interop call failed");
        }
    }

    async Task<T?> SafeValueAsync<T>(Func<Task<T>> call) {
        try {
            return await call();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console interop call failed");
            return default;
        }
    }

    public async ValueTask DisposeAsync() {
        _disposed = true;
        if (_module is { } module) await SafeAsync(() => module.InvokeVoidAsync("clear", _img).AsTask());
        await _module.DisposeModuleQuietAsync(logger: Logger);
        _self?.Dispose();
        _self = null;
    }

}
