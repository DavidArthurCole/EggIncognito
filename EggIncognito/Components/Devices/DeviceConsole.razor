@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<DeviceConsole> Logger
@using System.Globalization
@using System.Text.Json
@using EggIdentity.UI
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Devices
@implements IAsyncDisposable

<WorkbenchModal Open="@(_open && _isAdmin)" Title="Device console" TitleId="deviceConsoleTitle"
                Size="WorkbenchSize.Wide" CardClass="dcon-card" OnClose="CloseAsync">
    <Notice>
        @if (_notice is { } n) {
            <StatusNote Severity="@n.Severity" OnDismiss="ClearNotice">@n.Text</StatusNote>
        }
        @if (_streamError is { } se) {
            <StatusNote Severity="StatusNoteKind.Error" OnDismiss="ClearStreamError">
                <ChildContent>@se</ChildContent>
                <Actions>
                    <button type="button" class="btn-mini" @onclick="RetryStreamAsync">Try again</button>
                    <button type="button" class="btn-mini" @onclick="OneFrameAsync">One frame instead</button>
                </Actions>
            </StatusNote>
        }
    </Notice>
    <HeadTools>
        <select class="field-input dcon-pick" aria-label="Device" value="@_deviceId" @onchange="PickDeviceAsync">
            <option value="">Pick a device</option>
            @if (_deviceId is { Length: > 0 } missing && _devices.All(d => d.Id != missing)) {
                <option value="@missing">@missing - not in the device list</option>
            }
            @foreach (var d in Ordered()) {
                <option value="@d.Id">@DeviceLabel(d)</option>
            }
        </select>
        <select class="field-input dcon-rate" aria-label="Stream frame rate" value="@_fps" @onchange="FpsChanged">
            @foreach (int fps in Rates) {
                <option value="@fps">@fps fps</option>
            }
        </select>
        <button type="button" class="btn-mini" disabled="@(_deviceId is null)" @onclick="ToggleStreamAsync">
            @(_streaming ? "Pause" : "Go live")
        </button>
        <button type="button" class="btn-mini" disabled="@(_deviceId is null)" @onclick="OneFrameAsync">
            One frame
        </button>
    </HeadTools>
    <ChildContent>
        @if (_devices.Count == 0 && _deviceId is null) {
            <div class="wb-note">No enabled devices on this host.</div>
        } else if (_deviceId is null) {
            <div class="wb-note">Pick a device to work on it.</div>
        } else {
            <div class="dcon-body">
                <div class="dcon-col">
                    <div class="dcon-sec-head">Recipes</div>
                    @if (_booksBusy && _books.Count == 0) {
                        <div class="wb-note">Reading the recipes this device offers...</div>
                    } else if (_books.Count == 0) {
                        <div class="wb-note">This device offers no recipes.</div>
                    } else {
                        <div class="dcon-books">
                            @foreach (var book in _books) {
                                <div class="dcon-book" @key="book.Id">
                                    <div class="dcon-book-head">
                                        <span class="dcon-book-title">@book.Title</span>
                                        @if (book.Available) {
                                            <button type="button" class="btn-mini" disabled="@_runBusy"
                                                    @onclick="@(() => RunCookbookAsync(book))">
                                                Run
                                            </button>
                                        }
                                    </div>
                                    <div class="dcon-book-sum">@book.Summary</div>
                                    @if (!book.Available) {
                                        <div class="dcon-book-off">
                                            @(book.Unavailable ?? "Not available on this device right now.")
                                        </div>
                                    } else if (book.Options is { Count: > 0 } options) {
                                        <label class="dcon-book-arg">
                                            <span class="dcon-book-arg-k">@(book.ArgumentLabel ?? "Choice")</span>
                                            <select class="field-input" value="@ArgFor(book)" disabled="@_runBusy"
                                                    @onchange="@(e => SetArg(book.Id, e))">
                                                @foreach (var option in options) {
                                                    <option value="@option.Value">@OptionLabel(option)</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (_runTitle is { } title) {
                        <div class="dcon-run">
                            <div class="dcon-run-head">
                                <span class="dcon-run-title">@title</span>
                                <span class="@WorkbenchStatus.Class(WorkbenchStatus.Parse(RunStateWord()))">
                                    @RunStateLine()
                                </span>
                            </div>
                            @if (_runLog.Count == 0) {
                                <div class="dcon-log-empty">No output yet.</div>
                            } else {
                                <div class="dcon-log">
                                    @foreach (string line in _runLog) {
                                        <div class="dcon-log-line">@line</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="dcon-col">
                    <div class="dcon-sec-head">Screen</div>
                    <div class="dcon-stage">
                        <button type="button" class="dcon-shot" @onclick="StageClickAsync"
                                aria-label="Device screen, click to tap">
                            <img class="dcon-img" alt="" @ref="_img"/>
                            @if (_hasFrame && _selected is { HasBounds: true } hl && TapWidth > 0) {
                                <span class="dcon-hl" style="@HighlightStyle(hl)"></span>
                            }
                        </button>
                        @if (!_hasFrame) {
                            <span class="dcon-stage-empty">@StageEmptyText()</span>
                        }
                    </div>

                    <div class="dcon-keys">
                        <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("back"))">Back</button>
                        <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("home"))">Home</button>
                        <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("recents"))">Recents</button>
                        <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("enter"))">Enter</button>
                        <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("wake"))">Wake</button>
                    </div>

                    <div class="dcon-typing">
                        <input class="field-input font-mono" placeholder="text for the focused field"
                               aria-label="Text to send" @bind="_text" @bind:event="oninput"/>
                        <button type="button" class="btn-mini" disabled="@(_text.Length == 0)" @onclick="SendTextAsync">
                            Send text
                        </button>
                    </div>

                    <div class="dcon-statusbar">
                        <span class="dcon-status">@StatusLine()</span>
                        <button type="button" class="btn-mini" @onclick="ToggleDetail">
                            @(_showDetail ? "Hide sizes" : "Sizes")
                        </button>
                    </div>

                    @if (_showDetail) {
                        <div class="dcon-detail">
                            <div class="dcon-detail-row">
                                <span class="dcon-detail-k">Screenshot</span>
                                <span class="dcon-detail-v">@Dim(_shotW, _shotH) px</span>
                            </div>
                            <div class="dcon-detail-row">
                                <span class="dcon-detail-k">Tap space</span>
                                <span class="dcon-detail-v">@Dim(TapWidth, TapHeight) px, from @TapSpaceSource</span>
                            </div>
                            <div class="dcon-detail-row">
                                <span class="dcon-detail-k">Rendered</span>
                                <span class="dcon-detail-v">@Dim(_renderW, _renderH) css px</span>
                            </div>
                            <div class="dcon-detail-row">
                                <span class="dcon-detail-k">Device</span>
                                <span class="dcon-detail-v">@_deviceId, @(CurrentDevice?.Platform ?? "platform unknown")</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="dcon-col">
                    <div class="dcon-sec-head">Selectors</div>
                    <div class="dcon-tree-bar">
                        <input class="field-input" type="search" placeholder="filter nodes"
                               aria-label="Filter ui nodes" value="@_filter" @oninput="FilterChanged"/>
                        <label class="dcon-check">
                            <input type="checkbox" checked="@_clickableOnly" @onchange="ClickableChanged"/>
                            clickable only
                        </label>
                        <button type="button" class="btn-mini" disabled="@_dumpBusy" @onclick="LoadDumpAsync">
                            @(_dumpBusy ? "Reading..." : "Read UI tree")
                        </button>
                    </div>

                    @if (_dumpError is { } de) {
                        <div class="dcon-tree-note text-err">@de</div>
                    } else if (_dump is null) {
                        <div class="dcon-tree-note">No UI tree read yet.</div>
                    } else {
                        <div class="dcon-tree-note">
                            @_rows.Count of @_dump.Count nodes
                        </div>
                        <div class="dcon-tree">
                            @foreach (var node in _rows) {
                                <button type="button" @key="node.Id"
                                        class="dcon-node @(_selected?.Id == node.Id ? "dcon-node-on" : "")"
                                        style="@IndentStyle(node)" @onclick="@(() => SelectNode(node))">
                                    <span class="dcon-node-kind">@node.Kind</span>
                                    <span class="dcon-node-label">@node.Label</span>
                                    @if (node.Clickable) {
                                        <span class="dcon-node-tap">tap</span>
                                    }
                                </button>
                            }
                        </div>
                    }

                    @if (_selected is { } sel) {
                        <div class="dcon-sel">
                            <div class="dcon-sel-head">
                                <span class="font-mono text-xs">@(sel.ClassName ?? sel.Kind)</span>
                                <span class="text-muted text-xs">
                                    @sel.Left,@sel.Top @sel.Width x @sel.Height
                                </span>
                                <button type="button" class="btn-mini" @onclick="TapSelectedAsync">Tap node</button>
                            </div>

                            @if (sel.Selectors.Count == 0) {
                                <div class="dcon-sel-empty">
                                    Nothing selectable on this node. Tap it by point instead.
                                </div>
                                <div class="dcon-snip-row">
                                    <code class="dcon-snip">@PointStep(sel)</code>
                                    <CopyButton Text="@PointStep(sel)" AriaLabel="Copy tap-point step"/>
                                </div>
                            } else {
                                @foreach (var hint in sel.Selectors) {
                                    <div class="dcon-snip-row @(hint == sel.Selectors[0] ? "dcon-snip-best" : "")">
                                        <span class="dcon-snip-by">@HintLabel(hint)</span>
                                        <code class="dcon-snip">@hint.Snippet</code>
                                        <CopyButton Text="@hint.Snippet" AriaLabel="Copy selector"/>
                                    </div>
                                }
                                <div class="dcon-sel-steps">
                                    <div class="dcon-snip-row">
                                        <span class="dcon-snip-by">tap step</span>
                                        <code class="dcon-snip">@TapStep(sel)</code>
                                        <CopyButton Text="@TapStep(sel)" AriaLabel="Copy tap step"/>
                                    </div>
                                    <div class="dcon-snip-row">
                                        <span class="dcon-snip-by">wait step</span>
                                        <code class="dcon-snip">@WaitStep(sel)</code>
                                        <CopyButton Text="@WaitStep(sel)" AriaLabel="Copy wait step"/>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </ChildContent>
</WorkbenchModal>

@code {

    [Parameter] public EventCallback OnChanged { get; set; }

    static readonly int[] Rates = [5, 4, 3, 2, 1];
    static readonly string[] JobIdNames = ["jobId", "JobId", "runId", "RunId", "id", "Id"];

    bool _open;
    bool _isAdmin;
    bool _disposed;
    bool _streaming;
    bool _hasFrame;
    bool _showDetail;
    bool _dumpBusy;
    bool _clickableOnly;
    bool _booksBusy;
    bool _runBusy;
    bool _runDone;
    bool _runOk;
    int _fps = 3;
    int _shotW;
    int _shotH;
    int _renderW;
    int _renderH;
    string _filter = "";
    string _text = "";
    string _streamKey = "";
    string? _deviceId;
    string? _streamError;
    string? _dumpError;
    string? _lastTap;
    string? _runTitle;
    string? _runJobId;
    string? _runNote;
    string? _runFailedStep;
    (string Text, StatusNoteKind Severity)? _notice;

    List<DeviceRow> _devices = [];
    List<UiNodeRow> _rows = [];
    List<DeviceCookbookInfo> _books = [];
    List<string> _runLog = [];
    readonly Dictionary<string, string> _args = [];
    UiDumpResult? _dump;
    UiNodeRow? _selected;

    Timer? _runTimer;
    ElementReference _img;
    IJSObjectReference? _module;
    DotNetObjectReference<DeviceConsole>? _self;

    DeviceRow? CurrentDevice => _devices.FirstOrDefault(d => d.Id == _deviceId);

    bool IsIos => string.Equals(CurrentDevice?.Platform, "ios", StringComparison.OrdinalIgnoreCase);

    int TapWidth => IsIos && _dump is { Width: > 0 } d ? d.Width : _shotW;

    int TapHeight => IsIos && _dump is { Height: > 0 } d ? d.Height : _shotH;

    string TapSpaceSource => IsIos && _dump is { Width: > 0 } ? "the ui tree" : "the screenshot";

    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    public async Task Open(string? deviceId = null) {
        if (!_isAdmin) return;
        _open = true;
        _devices = await Client().ListAsync<DeviceRow>("/api/devices/status", Logger);
        await SelectDeviceAsync(deviceId ?? _deviceId ?? Ordered().FirstOrDefault()?.Id);
        StateHasChanged();
    }

    async Task CloseAsync() {
        await StopStreamAsync();
        StopRunTimer();
        _open = false;
        StateHasChanged();
    }

    Task PickDeviceAsync(ChangeEventArgs e) => SelectDeviceAsync(e.Value?.ToString());

    async Task SelectDeviceAsync(string? id) {
        string? next = string.IsNullOrEmpty(id) ? null : id;
        await StopStreamAsync();
        if (_module is { } module) await SafeAsync(() => module.InvokeVoidAsync("clear", _img).AsTask());
        StopRunTimer();

        _deviceId = next;
        _dump = null;
        _rows = [];
        _selected = null;
        _dumpError = null;
        _streamError = null;
        _notice = null;
        _lastTap = null;
        _hasFrame = false;
        _shotW = _shotH = _renderW = _renderH = 0;
        _books = [];
        _args.Clear();
        _runTitle = null;
        _runJobId = null;
        _runLog = [];
        _runBusy = false;
        _streaming = next is not null;

        if (next is not null) await LoadCookbooksAsync();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    async Task ToggleStreamAsync() {
        if (_streaming) {
            await StopStreamAsync();
            return;
        }

        _streamError = null;
        _streaming = true;
    }

    async Task RetryStreamAsync() {
        await StopStreamAsync();
        _streamError = null;
        _streaming = true;
    }

    void FpsChanged(ChangeEventArgs e) {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int fps)) return;
        _fps = Math.Clamp(fps, 1, 5);
    }

    void ClearStreamError() {
        _streamError = null;
    }

    string StageEmptyText() {
        if (_streamError is not null) return "No picture. Read the message above the toolbar.";
        return _streaming ? "Waiting for the first frame." : "Screen paused. The last frame is not kept.";
    }

    string StatusLine() {
        if (_deviceId is null) return "No device picked.";
        if (_streamError is not null) return "The screen is not running.";
        string head = _streaming
            ? _hasFrame ? $"Live at {_fps} fps." : "Waiting for the first frame."
            : _hasFrame ? "Showing one frame." : "Screen paused. Go live for a stream, or One frame for a single shot.";
        return _lastTap is { } tap ? $"{head} Last tap at {tap}." : head;
    }

    void ToggleDetail() {
        _showDetail = !_showDetail;
    }

    async Task StageClickAsync(MouseEventArgs e) {
        if (_deviceId is null) return;
        await MeasureAsync();
        if (TapWidth <= 0 || TapHeight <= 0) {
            Note("No frame has been measured yet, so a click cannot be mapped to device pixels.", false);
            return;
        }

        if (_renderW <= 0 || _renderH <= 0) {
            Note("The screen has no rendered size yet.", false);
            return;
        }

        int x = Scale(e.OffsetX, _renderW, TapWidth);
        int y = Scale(e.OffsetY, _renderH, TapHeight);
        await TapAsync(x, y);
    }

    static int Scale(double offset, int rendered, int device) {
        int value = (int)Math.Round(offset / rendered * device, MidpointRounding.AwayFromZero);
        return Math.Clamp(value, 0, device - 1);
    }

    async Task TapAsync(int x, int y) {
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/tap",
            new UiTapRequest(x, y), SelfCallJson.Web);
        _lastTap = $"{x}, {y}";
        Note(res.IsSuccessStatusCode ? $"Tapped {x}, {y}." : await ReadError(res), res.IsSuccessStatusCode);
    }

    Task TapSelectedAsync() =>
        _selected is { } sel ? TapAsync(sel.CenterX, sel.CenterY) : Task.CompletedTask;

    async Task SendTextAsync() {
        if (_deviceId is null || _text.Length == 0) return;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/text",
            new UiTextRequest(_text), SelfCallJson.Web);
        Note(res.IsSuccessStatusCode ? "Text sent." : await ReadError(res), res.IsSuccessStatusCode);
    }

    async Task KeyAsync(string key) {
        if (_deviceId is null) return;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/key",
            new UiKeyRequest(key), SelfCallJson.Web);
        Note(res.IsSuccessStatusCode ? $"Sent {key}." : await ReadError(res), res.IsSuccessStatusCode);
    }

    async Task LoadCookbooksAsync() {
        if (_deviceId is null) return;
        _booksBusy = true;
        StateHasChanged();
        _books = await Client().ListAsync<DeviceCookbookInfo>($"/api/devices/{_deviceId}/cookbooks", Logger);
        foreach (var book in _books) {
            if (book.Options is not { Count: > 0 } options) continue;
            if (_args.ContainsKey(book.Id)) continue;
            _args[book.Id] = (options.FirstOrDefault(o => o.Recommended) ?? options[0]).Value;
        }

        _booksBusy = false;
        StateHasChanged();
    }

    string ArgFor(DeviceCookbookInfo book) {
        if (_args.TryGetValue(book.Id, out string? chosen)) return chosen;
        if (book.Options is not { Count: > 0 } options) return "";
        return (options.FirstOrDefault(o => o.Recommended) ?? options[0]).Value;
    }

    void SetArg(string bookId, ChangeEventArgs e) {
        _args[bookId] = e.Value?.ToString() ?? "";
    }

    static string OptionLabel(DeviceCookbookOption option) =>
        option.Recommended ? $"{option.Label} (recommended)" : option.Label;

    async Task RunCookbookAsync(DeviceCookbookInfo book) {
        if (_deviceId is null || _runBusy) return;
        StopRunTimer();
        _runBusy = true;
        _runDone = false;
        _runOk = false;
        _runTitle = book.Title;
        _runJobId = null;
        _runNote = null;
        _runFailedStep = null;
        _runLog = [];
        _notice = null;
        StateHasChanged();

        string? argument = book.Options is { Count: > 0 } ? ArgFor(book) : null;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/cookbooks",
            new DeviceCookbookRequest(book.Id, argument), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) {
            string failed = await ReadError(res);
            _runBusy = false;
            _runDone = true;
            _runNote = failed;
            Note(failed, false);
            return;
        }

        _runJobId = await ReadJobId(res);
        if (_runJobId is null) {
            _runBusy = false;
            _runDone = true;
            _runNote = "the run started but the server did not name a job to follow";
            return;
        }

        _runTimer = ComponentTimers.Every(TimeSpan.FromSeconds(1), () => InvokeAsync(PollRunAsync), Logger);
    }

    async Task PollRunAsync() {
        if (_disposed || _deviceId is null || _runJobId is null) {
            StopRunTimer();
            return;
        }

        var status = await Client().OneAsync<CookbookRunStatus>(
            $"/api/devices/{_deviceId}/cookbooks/run/{_runJobId}", Logger);
        if (status is null) return;

        if (status.Log is { } log) _runLog = [.. log];
        _runNote = status.Note ?? _runNote;
        _runFailedStep = status.FailedStep ?? _runFailedStep;
        if (status.Finished) {
            _runDone = true;
            _runOk = status.Succeeded;
            _runBusy = false;
            StopRunTimer();
            await LoadCookbooksAsync();
        }

        StateHasChanged();
    }

    void StopRunTimer() {
        _runTimer?.Dispose();
        _runTimer = null;
    }

    string RunStateWord() => !_runDone ? "running" : _runOk ? "succeeded" : "failed";

    string RunStateLine() {
        if (!_runDone) return "running";
        if (_runOk) return _runNote is { Length: > 0 } ok ? $"done, {ok}" : "done";
        if (_runFailedStep is { Length: > 0 } step) return $"failed at {step}";
        return _runNote is { Length: > 0 } note ? $"failed, {note}" : "failed";
    }

    async Task LoadDumpAsync() {
        if (_deviceId is null) return;
        _dumpBusy = true;
        _dumpError = null;
        StateHasChanged();
        try {
            var res = await Client().GetAsync($"/api/devices/{_deviceId}/ui/dump");
            if (!res.IsSuccessStatusCode) {
                _dumpError = await ReadError(res);
                _dump = null;
                _rows = [];
                _selected = null;
                return;
            }

            _dump = await res.Content.ReadFromJsonAsync<UiDumpResult>(SelfCallJson.Web);
            _selected = null;
            ApplyFilter();
        } catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Logger.LogDebug(ex, "ui dump read failed");
            _dumpError = ex.Message;
            _dump = null;
            _rows = [];
        } finally {
            _dumpBusy = false;
        }
    }

    void FilterChanged(ChangeEventArgs e) {
        _filter = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    void ClickableChanged(ChangeEventArgs e) {
        _clickableOnly = e.Value is true;
        ApplyFilter();
    }

    void ApplyFilter() {
        if (_dump is null) {
            _rows = [];
            return;
        }

        IEnumerable<UiNodeRow> query = _dump.Nodes;
        if (_clickableOnly) query = query.Where(n => n.Clickable);
        string needle = _filter.Trim();
        if (needle.Length > 0) {
            query = query.Where(n => Has(n.Label, needle) || Has(n.ResourceId, needle) || Has(n.Text, needle)
                                     || Has(n.ContentDesc, needle) || Has(n.ClassName, needle));
        }

        _rows = [.. query];
    }

    static bool Has(string? value, string needle) =>
        value is not null && value.Contains(needle, StringComparison.OrdinalIgnoreCase);

    void SelectNode(UiNodeRow node) {
        _selected = _selected?.Id == node.Id ? null : node;
    }

    string HighlightStyle(UiNodeRow node) {
        int width = TapWidth;
        int height = TapHeight;
        if (width <= 0 || height <= 0) return "display:none";
        return string.Create(CultureInfo.InvariantCulture,
            $"left:{100.0 * node.Left / width:0.###}%;top:{100.0 * node.Top / height:0.###}%;width:{100.0 * node.Width / width:0.###}%;height:{100.0 * node.Height / height:0.###}%");
    }

    static string IndentStyle(UiNodeRow node) =>
        string.Create(CultureInfo.InvariantCulture, $"--dcon-indent:{Math.Min(node.Depth, 12)}");

    static string HintLabel(UiSelectorHint hint) =>
        hint.Unique ? hint.Label : $"{hint.Label} {hint.Index + 1} of {hint.Matches}";

    static string TapStep(UiNodeRow node) => $"DeviceFlowSteps.Tap({node.Selectors[0].Snippet})";

    static string WaitStep(UiNodeRow node) => $"DeviceFlowSteps.WaitForSelector({node.Selectors[0].Snippet})";

    static string PointStep(UiNodeRow node) => $"DeviceFlowSteps.TapPoint({node.CenterX}, {node.CenterY})";

    static string Dim(int w, int h) => w > 0 && h > 0 ? $"{w} x {h}" : "unknown";

    static string DeviceLabel(DeviceRow d) =>
        d.Reachable ? $"{d.Label} - {d.Platform}" : $"{d.Label} - {d.Platform} - unreachable";

    IEnumerable<DeviceRow> Ordered() =>
        _devices
            .OrderBy(d => d.Platform == "ios" ? 0 : d.Platform == "android" ? 1 : 2)
            .ThenBy(d => d.Label, StringComparer.OrdinalIgnoreCase);

    void ClearNotice() {
        _notice = null;
    }

    void Note(string text, bool ok) {
        _notice = (text, ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
    }

    static async Task<string?> ReadJobId(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind != JsonValueKind.Object) return null;
            foreach (string name in JobIdNames) {
                if (!body.TryGetProperty(name, out var value)) continue;
                string? text = value.ValueKind switch {
                    JsonValueKind.String => value.GetString(),
                    JsonValueKind.Number => value.GetRawText(),
                    _ => null
                };
                if (!string.IsNullOrEmpty(text)) return text;
            }
        } catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return null;
        }

        return null;
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed [{(int)resp.StatusCode}]";
        } catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return $"failed [{(int)resp.StatusCode}]";
        }

        return $"failed [{(int)resp.StatusCode}]";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_disposed || !_open || !_isAdmin) return;

        string desired = _streaming && _deviceId is not null && _streamError is null ? $"{_deviceId}|{_fps}" : "";
        if (desired == _streamKey) return;

        if (await ModuleAsync() is not { } module) return;
        await SafeAsync(() => module.InvokeVoidAsync("stop", _img).AsTask());
        _streamKey = desired;
        if (desired.Length == 0) return;

        await SafeAsync(() => module.InvokeAsync<bool>("start", _img, StreamUrl(), Ref()).AsTask());
    }

    async Task StopStreamAsync() {
        _streaming = false;
        _streamKey = "";
        _hasFrame = false;
        if (_module is not { } module) return;
        await SafeAsync(() => module.InvokeVoidAsync("stop", _img).AsTask());
    }

    async Task OneFrameAsync() {
        if (_deviceId is null) return;
        _streaming = false;
        _streamKey = "";
        _streamError = null;
        if (await ModuleAsync() is not { } module) return;
        await SafeAsync(() => module.InvokeAsync<bool>("once", _img, ScreenshotUrl(), Ref()).AsTask());
    }

    async Task MeasureAsync() {
        if (await ModuleAsync() is not { } module) return;
        int[]? size = await SafeValueAsync(() => module.InvokeAsync<int[]>("measure", _img).AsTask());
        if (size is not { Length: 4 }) return;
        _shotW = size[0];
        _shotH = size[1];
        _renderW = size[2];
        _renderH = size[3];
        _hasFrame = _shotW > 0;
    }

    string StreamUrl() => $"/api/devices/{_deviceId}/ui/stream?fps={_fps}";

    string ScreenshotUrl() => $"/api/devices/{_deviceId}/ui/screenshot";

    [JSInvokable]
    public Task OnFrameSize(int naturalW, int naturalH, int renderW, int renderH) {
        _shotW = naturalW;
        _shotH = naturalH;
        _renderW = renderW;
        _renderH = renderH;
        _hasFrame = naturalW > 0;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnFrameFailed(int status, string note) {
        bool live = _streaming;
        _streamKey = "";
        _streaming = false;
        _hasFrame = false;
        _streamError = FrameFailure(status, note, live);
        return InvokeAsync(StateHasChanged);
    }

    static string FrameFailure(int status, string note, bool live) {
        string detail = status > 0 ? $"{note} [http {status}]" : note;
        string tail = string.IsNullOrWhiteSpace(detail) ? "" : $" The browser said: {detail}.";
        return live
            ? $"The live screen did not run. A device streams to one console at a time, so another viewer may be holding it.{tail}"
            : $"That frame did not load.{tail}";
    }

    DotNetObjectReference<DeviceConsole> Ref() {
        _self ??= DotNetObjectReference.Create(this);
        return _self;
    }

    async Task<IJSObjectReference?> ModuleAsync() {
        if (_module is not null) return _module;
        try {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", InteropAsset.Url(Env, "./interop/deviceConsole.js"));
            return _module;
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console module import failed");
            return null;
        }
    }

    async Task SafeAsync(Func<Task> call) {
        try {
            await call();
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console interop call failed");
        }
    }

    async Task<T?> SafeValueAsync<T>(Func<Task<T>> call) {
        try {
            return await call();
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console interop call failed");
            return default;
        }
    }

    public async ValueTask DisposeAsync() {
        _disposed = true;
        StopRunTimer();
        if (_module is { } module) await SafeAsync(() => module.InvokeVoidAsync("clear", _img).AsTask());
        await _module.DisposeModuleQuietAsync(logger: Logger);
        _self?.Dispose();
        _self = null;
    }

}
