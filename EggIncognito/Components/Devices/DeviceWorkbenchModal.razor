@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IServiceProvider Services
@inject DeviceWorkbenchState State
@inject AdminNotifier Notifier
@inject ILogger<DeviceWorkbenchModal> Logger
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Threading.Channels
@using EggIdentity.UI
@using EggIncognito.Capture
@using EggIncognito.Components.Capture
@using EggIncognito.Core
@using EggIncognito.Models.Devices
@using EggIncognito.Services.Devices
@implements IDisposable

<WorkbenchModal Open="@(_open && _isAdmin)" Title="Devices" TitleId="deviceWorkbenchTitle"
                Size="WorkbenchSize.Wide" CardClass="dwb-card" BodyId="deviceWorkbench" OnClose="CloseModal">
    <Notice>
        @if (_notice is { } n) {
            <StatusNote Severity="@n.Kind" OnDismiss="ClearNotice">@n.Text</StatusNote>
        }
    </Notice>
    <HeadTools>
        <button type="button" class="btn-mini" disabled="@_bulkBusy" @onclick="ProbeAll">Probe all</button>
        <button type="button" class="btn-mini" disabled="@_bulkBusy" @onclick="PokeAll">Poke all</button>
    </HeadTools>
    <Rail>
        <WorkbenchRail>
            @if (Physical().Any()) {
                <WorkbenchSection Label="Physical">
                    @foreach (var d in Physical()) {
                        @DeviceEntry(d)
                    }
                </WorkbenchSection>
            }
            @if (Virtual().Any()) {
                <WorkbenchSection Label="Virtual">
                    @foreach (var d in Virtual()) {
                        @DeviceEntry(d)
                    }
                </WorkbenchSection>
            }
            <WorkbenchSection Label="Fleet">
                <WorkbenchEntry Selected="@State.FleetSelected" OnClick="SelectFleet">
                    <Name>Virtual fleet</Name>
                    <MetaLine>provision, images, integrity</MetaLine>
                </WorkbenchEntry>
            </WorkbenchSection>
        </WorkbenchRail>
    </Rail>
    <ChildContent>
        @if (State.FleetSelected) {
            <DeviceFleetPane Active="true" OnNotice="Notice" OnChanged="ReloadDevices" OnConsole="OpenScreenFor"/>
        } else if (Current is not { } dev) {
            <div class="wb-note">@(_devices.Count == 0 ? "No devices declared on this host." : "Pick a device.")</div>
        } else {
            <div class="dwb-tabs">
                <WorkbenchModes Modes="@Tabs()" Current="@State.Mode" CurrentChanged="SelectTab" Label="Device view"/>
            </div>

            <div class="dwb-pane">
                @if (State.Mode == DeviceWorkbenchState.TabOverview) {
                    <div class="dwb-groups">
                        <div class="dwb-group">
                            <div class="dwb-group-head">Reachability</div>
                            <dl class="dwb-facts">
                                <dt>state</dt>
                                <dd class="@(dev.Reachable ? "text-ok" : "text-err")">
                                    @(dev.Reachable ? "reachable" : "unreachable")
                                </dd>
                                <dt>probed</dt>
                                <dd>
                                    <TimeAgo Value="@dev.ProbedAt"/>
                                </dd>
                                <dt>target</dt>
                                <dd class="font-mono truncate" title="@dev.Target">@(dev.Target ?? "?")</dd>
                            </dl>
                        </div>
                        <div class="dwb-group">
                            <div class="dwb-group-head">App</div>
                            <dl class="dwb-facts">
                                <dt>package</dt>
                                <dd class="font-mono truncate" title="@dev.Package">@(dev.Package ?? "?")</dd>
                                <dt>installed</dt>
                                <dd>
                                    <VersionLine App="@dev.InstalledAppVersion" Build="@dev.InstalledBuild"
                                                 Client="@Number(dev.ClientVersion)"/>
                                </dd>
                                <dt>store</dt>
                                <dd class="@(dev.StoreAhead ? "dwb-warn" : "")">
                                    @(dev.StoreLatest is { Length: > 0 } ? dev.StoreLatest : "unknown")@(dev.StoreAhead ? " (ahead)" : "")
                                </dd>
                            </dl>
                        </div>
                        <div class="dwb-group">
                            <div class="dwb-group-head">Pipelines</div>
                            <dl class="dwb-facts">
                                <dt>harvest</dt>
                                <dd>@HarvestLine()</dd>
                                <dt>capture</dt>
                                <dd>@CaptureLine()</dd>
                                <dt>last job</dt>
                                <dd>@LastJobLine()</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="dwb-actions">
                        <button type="button" class="btn-mini" disabled="@Busy" @onclick="ProbeNow">Probe now</button>
                        <button type="button" class="btn-mini" disabled="@Busy" @onclick="CheckStore">Check store</button>
                        <button type="button" class="btn-mini" disabled="@Busy" @onclick="RestartApp">Restart app</button>
                        @if (dev.Platform == "android") {
                            <button type="button" class="btn-mini" disabled="@Busy" @onclick="Recert">Recert</button>
                        }
                        @if (_harvest is { InRegistry: false }) {
                            <button type="button" class="btn-mini" disabled="@Busy" @onclick="SaveToRegistry">
                                Save to registry
                            </button>
                        }
                        <button type="button" class="btn-mini" disabled="@Busy" @onclick="Poke">Poke harvest</button>
                    </div>

                    @if (!string.IsNullOrEmpty(dev.Note)) {
                        <div class="font-mono text-xs text-muted mt-2">@dev.Note</div>
                    }

                    @if (RunningFor(dev.Id) is { } run) {
                        <div class="wb-st-run text-xs mt-2">@run.Kind: @run.Message</div>
                    }

                    @if (_recert is { } rc) {
                        <div class="dwb-job-lines mt-2">
                            <div class="dwb-job-line @(rc.Ok ? "text-ok" : "text-err")">
                                @(rc.Ok ? "recert ok" : $"recert failed at {rc.FailedStep ?? "?"}")
                            </div>
                            @if (rc.Fields.TryGetValue("expiry", out var expiry)) {
                                <div class="dwb-job-line text-muted">expiry @expiry</div>
                            }
                            @foreach (var line in rc.Log) {
                                <div class="dwb-job-line font-mono text-xs text-muted">@line</div>
                            }
                        </div>
                    }
                }

                @if (State.Mode == DeviceWorkbenchState.TabScreen) {
                    <DeviceScreenPane DeviceId="@dev.Id" Platform="@dev.Platform" Active="true" OnNotice="Notice"/>
                }

                @if (State.Mode == DeviceWorkbenchState.TabRecipes) {
                    <DeviceRecipesPane DeviceId="@dev.Id" Active="true" OnNotice="Notice"
                                       OnRunFinished="ReloadDevices"/>
                }

                @if (State.Mode == DeviceWorkbenchState.TabJobs) {
                    <WorkbenchLoad T="JobGroupRow" Items="_jobs" EmptyText="No jobs yet." Context="jobs">
                        <div class="dwb-jobs">
                            @foreach (var j in jobs) {
                                var open = State.Expanded.Contains(j.Id);
                                <div class="dwb-job @(open ? "dwb-job-open" : "")" @key="j.Id">
                                    <button type="button" class="dwb-job-head" @onclick="@(() => ToggleJob(j))">
                                        <span class="dwb-job-at">@Stamp(j.LastAt)</span>
                                        <span class="dwb-job-kind">@j.Kind</span>
                                        <span class="@StateClass(j.State)">@(j.Outcome ?? j.State)</span>
                                        @if (j.Repeat > 1) {
                                            <span class="dwb-job-rep">x@(j.Repeat), since @Stamp(j.StartedAt)</span>
                                        }
                                        <span class="dwb-job-dur">@Duration(j)</span>
                                        <span class="dwb-job-trigger">@j.Trigger</span>
                                    </button>
                                    @if (open) {
                                        <div class="dwb-job-lines">
                                            @if (!string.IsNullOrEmpty(j.Message)) {
                                                <div class="dwb-job-line text-muted">@j.Message</div>
                                            }
                                            @foreach (var l in LinesFor(j.Id)) {
                                                <div class="dwb-job-line">
                                                    <span class="font-mono text-muted">@l.At.ToLocalTime().ToString("HH:mm:ss")</span>
                                                    @if (l.Entry is not null) {
                                                        <span class="font-mono">@l.Entry</span>
                                                    }
                                                    <span class="@LevelClass(l.Level)">@l.Text</span>
                                                    @if (l.Bytes is > 0) {
                                                        <span class="text-muted font-mono">@ByteFormat.Mb(l.Bytes.Value, "F1")</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (_jobsMore is not null) {
                            <button type="button" class="btn-mini mt-2" disabled="@_jobsBusy" @onclick="LoadMoreJobsAsync">
                                @(_jobsBusy ? "Loading..." : "Older jobs")
                            </button>
                        }
                    </WorkbenchLoad>
                }

                @if (State.Mode == DeviceWorkbenchState.TabCapture) {
                    @if (_hub is null) {
                        <div class="wb-note">Capture is not configured for this device on this host.</div>
                    } else {
                        <div class="dwb-capture">
                            <div class="dwb-capture-bar">
                                <StatsPanel Stats="_stats" FlowCount="_flows.Count" Running="_capturing" Port="_port"/>
                                <a class="btn-mini no-underline" href="/capture/device/@dev.Id">Open full capture</a>
                            </div>
                            <div class="dwb-capture-body">
                                <FlowList Flows="_flows" SelectedId="_selectedFlowId" Connected="true"
                                          View="State.Capture" OnSelect="SelectFlow"/>
                                <DetailPane Flow="_selectedFlow" View="State.Capture" ClientFactory="Client"/>
                            </div>
                        </div>
                    }
                }

                @if (State.Mode == DeviceWorkbenchState.TabBinaries) {
                    <div class="reg-wrap">
                        <table class="data-table">
                            <thead>
                            <tr>
                                <th>Version</th><th>SHA-256</th><th>Size</th><th>Symbols</th><th>Source</th><th>Pulled</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var b in (_binaries ?? []).Where(x => x.Platform == dev.Platform)) {
                                <tr>
                                    <td>
                                        <VersionLine App="@b.Version"/>
                                    </td>
                                    <td class="font-mono text-xs">@(b.Sha256.Length >= 12 ? b.Sha256[..12] : b.Sha256)</td>
                                    <td class="font-mono text-xs">@ByteFormat.Mb(b.ByteSize, "F1")</td>
                                    <td class="font-mono text-xs">@(b.EffectiveSymbols > 0 ? b.EffectiveSymbols : b.NativeSymbols)</td>
                                    <td class="text-xs">@b.Source</td>
                                    <td class="text-muted text-xs">@b.PulledAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (_harvest is { Entries.Count: > 0 }) {
                        <div class="sub-section-head mt-4 mb-2">Latest harvest</div>
                        <div class="reg-wrap">
                            <table class="data-table">
                                <thead>
                                <tr>
                                    <th>Entry</th><th>Outcome</th><th>Size</th><th>Detail</th><th>When</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var e in _harvest.Entries) {
                                    <tr>
                                        <td class="font-mono text-xs">@e.Entry</td>
                                        <td class="text-xs">@e.Outcome</td>
                                        <td class="font-mono text-xs">@ByteFormat.Mb(e.Bytes, "F1")</td>
                                        <td class="text-muted text-xs">@e.Note</td>
                                        <td class="text-muted text-xs">@e.RanAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
</WorkbenchModal>

@code {

    [Parameter] public EventCallback OnChanged { get; set; }

    bool _open;
    bool _isAdmin;
    bool _bulkBusy;
    bool _disposed;
    bool _jobsBusy;
    bool _refreshing;
    DeviceNotice? _notice;
    IDisposable? _topics;

    List<DeviceRow> _devices = [];
    List<LiveJob> _live = [];
    List<JobGroupRow>? _jobs;
    long? _jobsMore;
    readonly Dictionary<long, List<JobLineRow>> _jobLines = [];
    List<StoredBinaryRow>? _binaries;
    HarvestInfo? _harvest;
    RecertResultDto? _recert;

    CaptureHub? _hub;
    IDisposable? _subscription;
    CancellationTokenSource? _loopCts;
    readonly List<DashboardFlow> _flows = [];
    readonly Dictionary<long, int> _flowIndex = new();
    CaptureStats? _stats;
    bool _capturing;
    int _port;
    long? _selectedFlowId;
    DashboardFlow? _selectedFlow;

    DeviceRow? Current => State.FleetSelected ? null : _devices.FirstOrDefault(d => d.Id == State.SelectedId);

    DeviceJobFeed? Feed => Services.GetService(typeof(DeviceJobFeed)) as DeviceJobFeed;

    bool Busy => Current is not null && RunningFor(Current.Id) is not null;

    LiveJob? RunningFor(string id) {
        return _live.FirstOrDefault(j => j.Device == id);
    }

    IEnumerable<DeviceRow> Physical() {
        return Ordered().Where(d => !d.Virtual);
    }

    IEnumerable<DeviceRow> Virtual() {
        return Ordered().Where(d => d.Virtual);
    }

    RenderFragment DeviceEntry(DeviceRow d) => @<WorkbenchEntry Selected="@(State.SelectedId == d.Id)" @key="d.Id"
                                                                Tone="@(d.Reachable ? WorkbenchTone.Normal : WorkbenchTone.Muted)"
                                                                OnClick="@(() => Select(d.Id))">
                                                   <Lead>
                                                       <span class="@(d.Reachable ? "dwb-dot-ok" : "dwb-dot-bad")"></span>
                                                       <PlatformIcon Platform="@d.Platform"/>
                                                   </Lead>
                                                   <Name>@d.Label</Name>
                                                   <MetaLine>
                                                       <VersionLine App="@d.InstalledAppVersion" Build="@d.InstalledBuild" Client="@Number(d.ClientVersion)"/>
                                                   </MetaLine>
                                                   <Foot>
                                                       @if (RunningFor(d.Id) is { } busy) {
                                                           <span class="wb-st-run">@busy.Kind</span>
                                                       }
                                                   </Foot>
                                               </WorkbenchEntry>;

    IReadOnlyList<(string Key, string Label, int? Count)> Tabs() {
        return [.. State.Modes.Select(m => (m.Key, m.Label, TabCount(m.Key)))];
    }

    int? TabCount(string key) {
        return key switch {
            DeviceWorkbenchState.TabJobs => _jobs?.Count,
            DeviceWorkbenchState.TabCapture => _flows.Count,
            DeviceWorkbenchState.TabBinaries => _binaries?.Count(x => x.Platform == Current?.Platform),
            _ => null
        };
    }

    string CaptureLine() {
        if (_hub is null) return "not configured";
        return _capturing ? $"running :{_port}" : "idle";
    }

    string LastJobLine() {
        if (_jobs is not { Count: > 0 } jobs) return "none";
        var j = jobs[0];
        return $"{j.Kind} {j.Outcome ?? j.State}, {Stamp(j.LastAt)}";
    }

    static string Stamp(DateTimeOffset at) {
        return at.ToLocalTime().ToString("MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
    }

    static string? Number(int? value) {
        return value?.ToString(CultureInfo.InvariantCulture);
    }

    IEnumerable<DeviceRow> Ordered() {
        return _devices
            .OrderBy(d => d.Platform == "ios" ? 0 : d.Platform == "android" ? 1 : 2)
            .ThenBy(d => d.Label, StringComparer.OrdinalIgnoreCase);
    }

    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    public async Task Open(string? deviceId = null) {
        if (!_isAdmin) return;
        _open = true;
        if (deviceId is not null) State.SelectedId = deviceId;
        await LoadAsync();
        State.SelectedId ??= Ordered().FirstOrDefault()?.Id;
        await LoadForDeviceAsync();
        await LoadBinariesAsync();
        _topics ??= Notifier.Subscribe(OnTopic);
        StateHasChanged();
    }

    public async Task OpenScreen(string? deviceId = null) {
        State.Mode = DeviceWorkbenchState.TabScreen;
        await Open(deviceId);
    }

    public async Task OpenFleet() {
        State.SelectedId = DeviceWorkbenchState.FleetId;
        await Open(DeviceWorkbenchState.FleetId);
    }

    void CloseModal() {
        _open = false;
        Unsubscribe();
        DetachCapture();
        StateHasChanged();
    }

    void Unsubscribe() {
        _topics?.Dispose();
        _topics = null;
    }

    async Task Select(string id) {
        if (State.SelectedId == id) return;
        State.SelectedId = id;
        _notice = null;
        _recert = null;
        _jobs = null;
        _jobsMore = null;
        _jobLines.Clear();
        DetachCapture();
        await LoadForDeviceAsync();
    }

    void SelectFleet() {
        if (State.FleetSelected) return;
        State.SelectedId = DeviceWorkbenchState.FleetId;
        _notice = null;
        DetachCapture();
    }

    async Task OpenScreenFor(string deviceId) {
        State.Mode = DeviceWorkbenchState.TabScreen;
        await Select(deviceId);
    }

    async Task SelectTab(string tab) {
        State.Mode = tab;
        if (State.Mode == DeviceWorkbenchState.TabCapture) AttachCapture();
        if (State.Mode == DeviceWorkbenchState.TabJobs) await LoadJobsAsync();
    }

    void OnTopic(string topic) {
        if (_disposed || !_open || topic != AdminTopics.DeviceStatus) return;
        _ = InvokeAsync(RefreshAsync);
    }

    async Task RefreshAsync() {
        if (_disposed || !_open || _refreshing) return;
        _refreshing = true;
        try {
            await LoadLiveAsync();
            if (State.Mode == DeviceWorkbenchState.TabJobs && !State.FleetSelected) await RefreshJobsAsync();
            if (_subscription is null) ResolveHub();
            StateHasChanged();
        }
        finally {
            _refreshing = false;
        }
    }

    async Task LoadAsync() {
        _devices = await Client().ListAsync<DeviceRow>("/api/devices/status", Logger);
        await LoadLiveAsync();
    }

    async Task ReloadDevices() {
        await LoadAsync();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    async Task LoadForDeviceAsync() {
        if (Current is null) return;
        ResolveHub();
        await LoadHarvestAsync();
        await LoadJobsAsync();
        if (State.Mode == DeviceWorkbenchState.TabCapture) AttachCapture();
    }

    async Task LoadLiveAsync() {
        if (!_isAdmin || Feed is not { } feed) {
            _live = [];
            return;
        }

        _live = [.. await feed.LiveAsync(CancellationToken.None)];
    }

    async Task LoadJobsAsync() {
        if (!_isAdmin || Current is not { } dev || Feed is not { } feed) return;
        var page = await feed.PageAsync(dev.Id, JobGroupCollapser.DefaultTake, null, CancellationToken.None);
        _jobs = [.. page.Rows];
        _jobsMore = page.NextBefore;
    }

    async Task RefreshJobsAsync() {
        if (!_isAdmin || Current is not { } dev || Feed is not { } feed) return;
        var page = await feed.PageAsync(dev.Id, JobGroupCollapser.DefaultTake, null, CancellationToken.None);
        if (_jobs is not { Count: > 0 } loaded) {
            _jobs = [.. page.Rows];
            _jobsMore = page.NextBefore;
        } else if (page.Rows.Count == 0) {
            _jobs = [];
            _jobsMore = null;
        } else {
            long oldest = page.Rows[^1].Id;
            _jobs = [.. page.Rows, .. loaded.Where(g => g.Id < oldest)];
        }

        PruneJobState();
        await RefreshOpenLinesAsync(dev.Id, feed);
    }

    void PruneJobState() {
        if (_jobs is not { } jobs) return;
        var ids = jobs.Select(j => j.Id).ToHashSet();
        State.Expanded.RemoveWhere(id => !ids.Contains(id));
        foreach (long id in _jobLines.Keys.Where(id => !ids.Contains(id)).ToList()) _jobLines.Remove(id);
    }

    async Task RefreshOpenLinesAsync(string deviceId, DeviceJobFeed feed) {
        if (_jobs is not { } jobs) return;
        foreach (var job in jobs.Where(j => j.FinishedAt is null && State.Expanded.Contains(j.Id))) {
            _jobLines[job.Id] = [.. await feed.LinesAsync(deviceId, job.Id, CancellationToken.None)];
        }
    }

    async Task LoadMoreJobsAsync() {
        if (!_isAdmin || Current is not { } dev || Feed is not { } feed) return;
        if (_jobsMore is not { } before || _jobsBusy) return;
        _jobsBusy = true;
        try {
            var page = await feed.PageAsync(dev.Id, JobGroupCollapser.DefaultTake, before, CancellationToken.None);
            _jobs = [.. _jobs ?? [], .. page.Rows];
            _jobsMore = page.NextBefore;
        }
        finally {
            _jobsBusy = false;
        }
    }

    IReadOnlyList<JobLineRow> LinesFor(long jobId) {
        return _jobLines.TryGetValue(jobId, out var lines) ? lines : [];
    }

    async Task ToggleJob(JobGroupRow job) {
        if (State.Expanded.Remove(job.Id)) return;
        State.Expanded.Add(job.Id);
        if (!_isAdmin || Current is not { } dev || Feed is not { } feed) return;
        if (_jobLines.ContainsKey(job.Id)) return;
        _jobLines[job.Id] = [.. await feed.LinesAsync(dev.Id, job.Id, CancellationToken.None)];
    }

    async Task LoadHarvestAsync() {
        if (Current is not { } dev) return;
        _harvest = await Client().OneAsync<HarvestInfo>($"/api/devices/{dev.Id}/harvest", Logger);
    }

    async Task LoadBinariesAsync() {
        var list = await Client().OneAsync<StoredBinaryList>("/api/decomp/stored-binaries", Logger);
        _binaries = list?.Binaries ?? [];
    }

    string HarvestLine() {
        if (_harvest is null) return "?";
        var state = _harvest.Harvesting ? "harvesting" : _harvest.Stale ? "stale" : "current";
        return $"{state} | {_harvest.LastHarvestStatus}";
    }

    static string StateClass(string state) {
        return WorkbenchStatus.Class(WorkbenchStatus.Parse(state));
    }

    static string LevelClass(string level) {
        return level switch {
            "error" => "text-err",
            "warn" => "dwb-warn",
            _ => "text-fg"
        };
    }

    static string Duration(JobGroupRow j) {
        if (j.FinishedAt is not { } end) return "running";
        var span = end - j.LastAt;
        return span.TotalSeconds < 1 ? "<1s" : $"{(int)span.TotalSeconds}s";
    }

    void ClearNotice() {
        _notice = null;
    }

    void Notice(DeviceNotice notice) {
        _notice = notice;
        StateHasChanged();
    }

    void Note(string text, bool ok) {
        _notice = new DeviceNotice(text, ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
    }

    async Task Act(string url, string ok) {
        if (Current is null) return;
        _notice = null;
        var res = await Client().PostAsync(url, null);
        var good = res.IsSuccessStatusCode || res.StatusCode == HttpStatusCode.Accepted;
        Note(good ? ok : await ReadError(res), good);
        await LoadAsync();
        await LoadForDeviceAsync();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    Task ProbeNow() {
        return Act($"/api/devices/{Current!.Id}/refresh", "probed");
    }

    Task CheckStore() {
        return Act($"/api/devices/{Current!.Id}/check-update", "store check started");
    }

    Task SaveToRegistry() {
        return Act($"/api/devices/{Current!.Id}/save", "installed to registry");
    }

    Task Poke() {
        return Act($"/api/devices/{Current!.Id}/poke", "harvest queued");
    }

    async Task RestartApp() {
        if (Current is not { } dev) return;
        var id = dev.Id;
        _notice = null;
        var res = await Client().PostAsync($"/api/devices/{id}/restart-app", null);
        if (!res.IsSuccessStatusCode) {
            Note(await ReadError(res), false);
            return;
        }

        Note("launched, waiting for an API call...", true);
        StateHasChanged();
        for (var i = 0; i < 8 && !_disposed; i++) {
            await Task.Delay(2000);
            if (await LiveClientVersion(id) is not null) {
                Note("clientVersion captured", true);
                await LoadAsync();
                return;
            }
        }

        Note("no clientVersion captured (timed out)", false);
    }

    async Task Recert() {
        if (Current is not { } dev) return;
        var id = dev.Id;
        _notice = null;
        _recert = null;
        var res = await Client().PostAsync($"/api/devices/{id}/recert", null);
        if (!res.IsSuccessStatusCode) {
            Note(await ReadError(res), false);
            return;
        }

        _recert = await res.Content.ReadFromJsonAsync<RecertResultDto>(SelfCallJson.Web);
        Note(_recert is { Ok: true } ? "recert ok" : $"recert failed at {_recert?.FailedStep ?? "?"}",
            _recert is { Ok: true });
        await LoadJobsAsync();
    }

    async Task<int?> LiveClientVersion(string id) {
        var probe = await Client().OneAsync<LiveProbe>($"/api/devices/{id}/live", Logger);
        return probe?.ClientVersion;
    }

    async Task ProbeAll() {
        _bulkBusy = true;
        var res = await Client().PostAsync("/api/devices/refresh-all", null);
        Note(res.IsSuccessStatusCode ? "probed every device" : "probe all failed", res.IsSuccessStatusCode);
        await LoadAsync();
        _bulkBusy = false;
    }

    async Task PokeAll() {
        _bulkBusy = true;
        var res = await Client().PostAsync("/api/devices/poke-all", null);
        var good = res.IsSuccessStatusCode || res.StatusCode == HttpStatusCode.Accepted;
        Note(good ? "harvest queued on every device" : "poke all failed", good);
        _bulkBusy = false;
    }

    void ResolveHub() {
        if (Current is not { } dev) return;
        if (Services.GetService(typeof(DeviceCaptureManager)) is not DeviceCaptureManager dcm) return;
        if (dcm.HubFor(dev.Id) is not { } hub) return;
        _hub = hub;
        foreach (var f in hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(hub.StatsSnapshot());
    }

    void AttachCapture() {
        if (_hub is not { } hub || _subscription is not null) return;

        var (reader, subscription) = hub.Subscribe();
        _subscription = subscription;
        foreach (var f in hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(hub.StatsSnapshot());

        _loopCts = new CancellationTokenSource();
        var ct = _loopCts.Token;
        _ = Task.Run(async () => {
            try {
                await foreach (var env in reader.ReadAllAsync(ct)) {
                    await InvokeAsync(() => ApplyEnvelope(env));
                }
            }
            catch (OperationCanceledException) {
            }
            catch (ChannelClosedException) {
            }
        }, ct);
    }

    void DetachCapture() {
        _loopCts?.Cancel();
        _loopCts?.Dispose();
        _loopCts = null;
        _subscription?.Dispose();
        _subscription = null;
        _hub = null;
        _flows.Clear();
        _flowIndex.Clear();
        _selectedFlowId = null;
        _selectedFlow = null;
        _stats = null;
        _capturing = false;
        _port = 0;
    }

    void ApplyEnvelope(CaptureEnvelope env) {
        switch (env.Kind) {
            case "flow" when env.Flow is not null:
                AddOrUpdateFlow(env.Flow);
                break;
            case "stats" when env.Stats is not null:
                ApplyStats(env.Stats);
                break;
        }

        StateHasChanged();
    }

    void AddOrUpdateFlow(DashboardFlow flow) {
        if (_flowIndex.TryGetValue(flow.Id, out var idx)) {
            _flows[idx] = flow;
            if (_selectedFlowId == flow.Id) _selectedFlow = flow;
            return;
        }

        _flowIndex[flow.Id] = _flows.Count;
        _flows.Add(flow);
    }

    void ApplyStats(CaptureStats stats) {
        _stats = stats;
        _capturing = stats.Running;
        _port = stats.Port;
    }

    void SelectFlow(long id) {
        _selectedFlowId = id;
        _selectedFlow = _flowIndex.TryGetValue(id, out var idx) ? _flows[idx] : null;
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed ({(int)resp.StatusCode})";
        }
        catch {
        }

        return $"failed ({(int)resp.StatusCode})";
    }

    public void Dispose() {
        _disposed = true;
        Unsubscribe();
        DetachCapture();
    }

}
