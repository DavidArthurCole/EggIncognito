@rendermode @(RenderMode.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IServiceProvider Services
@inject DeviceWorkbenchState State
@inject ILogger<DeviceWorkbenchModal> Logger
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Threading.Channels
@using EggIncognito.Capture
@using EggIncognito.Components.Capture
@using EggIncognito.Components.Shared.Workbench
@using EggIncognito.Core
@using EggIncognito.Services.Devices
@using EggIncognito.Services.Workbench
@implements IDisposable

<WorkbenchModal Open="@(_open && _isAdmin)" Title="Devices" TitleId="deviceWorkbenchTitle"
                Notice="@_notice" OnClose="CloseModal">
    <HeadTools>
        <button type="button" class="btn-mini" disabled="@_bulkBusy" @onclick="ProbeAll">Probe all</button>
        <button type="button" class="btn-mini" disabled="@_bulkBusy" @onclick="PokeAll">Poke all</button>
    </HeadTools>
    <Rail>
        <WorkbenchRail>
            @if (_devices.Count == 0) {
                <div class="wb-note">No devices declared on this host.</div>
            } else {
                @foreach (var d in Ordered()) {
                    <WorkbenchEntry @key="d.Id" Selected="@(State.SelectedId == d.Id)" Title="@d.Id"
                                    Status="@RunStatus(d.Id)" Foot="@JobFoot(d.Id)"
                                    OnClick="@(_ => Select(d.Id))">
                        <Lead>
                            <span class="@(d.Reachable ? "dwb-dot-ok" : "dwb-dot-bad")"></span>
                        </Lead>
                        <Name>@d.Label</Name>
                        <MetaLine>
                            <VersionLine App="@d.InstalledAppVersion" Build="@d.InstalledBuild"
                                         Client="@Number(d.ClientVersion)" Platform="@d.Platform"/>
                        </MetaLine>
                    </WorkbenchEntry>
                }
            }
        </WorkbenchRail>
    </Rail>
    <ChildContent>
        @if (Current is null) {
            <div class="wb-note">Select a device.</div>
        } else {
            <div class="mb-3">
                <WorkbenchModes Modes="State.Modes" Current="@State.Mode" CurrentChanged="SetMode"/>
            </div>

            @if (State.Mode == DeviceWorkbenchState.ModeStatus && Current is { } dev) {
                <div class="dwb-grid">
                    <div class="ds-state">
                        <span class="ds-state-k">Reachable</span>
                        <span class="@(dev.Reachable ? "text-ok" : "text-err")">
                            @(dev.Reachable ? "yes" : "no")
                        </span>
                        <div class="ds-state-sub">probed @dev.ProbedAt.ToLocalTime().ToString("HH:mm:ss")</div>
                    </div>
                    <div class="ds-state">
                        <span class="ds-state-k">Installed</span>
                        <VersionLine App="@dev.InstalledAppVersion" Build="@dev.InstalledBuild"
                                     Client="@Number(dev.ClientVersion)"/>
                    </div>
                    <div class="ds-state">
                        <span class="ds-state-k">Store</span>
                        @if (dev.StoreLatest is { Length: > 0 }) {
                            <VersionLine App="@dev.StoreLatest"/>
                        } else {
                            <span class="text-muted text-xs">unknown</span>
                        }
                        @if (dev.StoreAhead) {
                            <div class="ds-state-sub dwb-warn">newer than installed</div>
                        }
                    </div>
                    <div class="ds-state">
                        <span class="ds-state-k">Harvest</span>
                        <span class="font-mono whitespace-nowrap">@HarvestLine()</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(dev.Note)) {
                    <div class="font-mono text-xs text-muted mt-2">@dev.Note</div>
                }

                <div class="dwb-actions">
                    <button type="button" class="btn-mini" disabled="@Busy" title="@BusyTitle" @onclick="ProbeNow">Probe now</button>
                    <button type="button" class="btn-mini" disabled="@Busy" title="@BusyTitle" @onclick="CheckStore">Check store</button>
                    <button type="button" class="btn-mini" disabled="@Busy" title="@BusyTitle" @onclick="RestartApp">Restart app</button>
                    <button type="button" class="btn-mini" disabled="@Busy" title="@BusyTitle" @onclick="SaveToRegistry">Save to registry</button>
                    <button type="button" class="btn-mini" disabled="@Busy" title="@BusyTitle" @onclick="Poke">Poke harvest</button>
                </div>
                @if (RunningFor(dev.Id) is { } run) {
                    <div class="wb-st-run text-xs mt-2">@run.Kind: @run.Message</div>
                }
            }

            @if (State.Mode == DeviceWorkbenchState.ModeJobs) {
                <WorkbenchLoad T="JobRow" Items="_jobs" EmptyText="No jobs yet." Context="jobs">
                    <div class="flex flex-col">
                        @foreach (var j in jobs) {
                            <div class="dwb-job">
                                <button type="button" class="dwb-job-head" @onclick="@(() => ToggleJob(j.Id))">
                                    <span class="font-mono text-muted">@j.StartedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                                    <span class="font-medium">@j.Kind</span>
                                    <span class="@StateClass(j.State)">@(j.Outcome ?? j.State)</span>
                                    <span class="text-muted truncate">@j.Message</span>
                                    <span class="text-muted font-mono">@Duration(j)</span>
                                    <span class="text-muted">@j.Trigger</span>
                                </button>
                                @if (State.Expanded.Contains(j.Id) && j.Lines.Count > 0) {
                                    <div class="dwb-job-lines">
                                        @foreach (var l in j.Lines) {
                                            <div class="dwb-job-line">
                                                <span class="font-mono text-muted">@l.At.ToLocalTime().ToString("HH:mm:ss")</span>
                                                @if (l.Entry is not null) {
                                                    <span class="font-mono">@l.Entry</span>
                                                }
                                                <span class="@LevelClass(l.Level)">@l.Text</span>
                                                @if (l.Bytes is > 0) {
                                                    <span class="text-muted font-mono">@ByteFormat.Mb(l.Bytes.Value, "F1")</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </WorkbenchLoad>
            }

            @if (State.Mode == DeviceWorkbenchState.ModeCapture) {
                @if (_hub is null) {
                    <div class="wb-note">Capture is not configured for this device on this host.</div>
                } else {
                    <div class="dwb-capture">
                        <StatsPanel Stats="_stats" FlowCount="_flows.Count" Running="_capturing" Port="_port"/>
                        <div class="flex gap-2 items-center my-2">
                            <button type="button" class="btn-mini" disabled="@Busy" title="@BusyTitle" @onclick="RestartApp">Restart app</button>
                            <a class="btn-mini no-underline" href="/capture/device/@Current!.Id">Open full capture</a>
                        </div>
                        <FlowList Flows="_flows" SelectedId="_selectedFlowId" Connected="true"
                                  View="State.Capture" OnSelect="SelectFlow"/>
                        <DetailPane Flow="_selectedFlow" View="State.Capture" ClientFactory="Client"/>
                    </div>
                }
            }

            @if (State.Mode == DeviceWorkbenchState.ModeBinaries) {
                <div class="flex items-center gap-2 mb-2">
                    <button type="button" class="btn-mini" disabled="@Busy" title="@BusyTitle" @onclick="Poke">Poke harvest</button>
                </div>
                <div class="reg-wrap">
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th>Version</th><th>SHA-256</th><th>Size</th><th>Symbols</th><th>Source</th><th>Pulled</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var b in _binaries.Where(x => x.Platform == Current!.Platform)) {
                            <tr>
                                <td>
                                    <VersionLine App="@b.Version"/>
                                </td>
                                <td class="font-mono text-xs">@(b.Sha256.Length >= 12 ? b.Sha256[..12] : b.Sha256)</td>
                                <td class="font-mono text-xs">@ByteFormat.Mb(b.ByteSize, "F1")</td>
                                <td class="font-mono text-xs">@(b.EffectiveSymbols > 0 ? b.EffectiveSymbols : b.NativeSymbols)</td>
                                <td class="text-xs">@b.Source</td>
                                <td class="text-muted text-xs">@b.PulledAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (_harvest is { Entries.Count: > 0 }) {
                    <div class="sub-section-head mt-4 mb-2">Latest harvest</div>
                    <div class="reg-wrap">
                        <table class="data-table">
                            <thead>
                            <tr>
                                <th>Entry</th><th>Outcome</th><th>Size</th><th>When</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var e in _harvest.Entries) {
                                <tr>
                                    <td class="font-mono text-xs">@e.Entry</td>
                                    <td class="text-xs">@e.Outcome</td>
                                    <td class="font-mono text-xs">@ByteFormat.Mb(e.Bytes, "F1")</td>
                                    <td class="text-muted text-xs">@e.RanAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (State.Mode == DeviceWorkbenchState.ModeConfig && Current is { } cfg) {
                <div class="dwb-grid">
                    <div class="ds-state">
                        <span class="ds-state-k">Id</span><span class="font-mono text-xs">@cfg.Id</span>
                    </div>
                    <div class="ds-state">
                        <span class="ds-state-k">Platform</span>
                        <PlatformIcon Platform="@cfg.Platform" Title="@cfg.Platform"/>
                    </div>
                    <div class="ds-state">
                        <span class="ds-state-k">Label</span><span class="text-xs">@cfg.Label</span>
                    </div>
                    <div class="ds-state">
                        <span class="ds-state-k">Target</span><span class="font-mono text-xs">@(cfg.Target ?? "?")</span>
                    </div>
                    <div class="ds-state">
                        <span class="ds-state-k">Package</span><span class="font-mono text-xs">@(cfg.Package ?? "?")</span>
                    </div>
                    <div class="ds-state">
                        <span class="ds-state-k">Capture</span>
                        <span class="font-mono text-xs">@(_hub is null ? "not configured" : $"port {_port}")</span>
                    </div>
                </div>
                <p class="text-muted text-xs mt-3 mb-0">
                    Devices are declared in configuration and seeded on start. Nothing here is editable.
                </p>
            }
        }
    </ChildContent>
</WorkbenchModal>

@code {

    [Parameter] public EventCallback OnChanged { get; set; }

    bool _open;
    bool _isAdmin;
    bool _bulkBusy;
    bool _disposed;
    WorkbenchNotice? _notice;
    Timer? _timer;

    List<DeviceRow> _devices = [];
    List<LiveJob> _live = [];
    List<JobRow>? _jobs;
    List<BinaryRow> _binaries = [];
    HarvestInfo? _harvest;

    CaptureHub? _hub;
    IDisposable? _subscription;
    CancellationTokenSource? _loopCts;
    readonly List<DashboardFlow> _flows = [];
    readonly Dictionary<long, int> _flowIndex = new();
    CaptureStats? _stats;
    bool _capturing;
    int _port;
    long? _selectedFlowId;
    DashboardFlow? _selectedFlow;

    DeviceRow? Current => _devices.FirstOrDefault(d => d.Id == State.SelectedId);

    bool Busy => Current is not null && RunningFor(Current.Id) is not null;

    string? BusyTitle => Current is null ? null
        : RunningFor(Current.Id) is { } j ? $"{j.Kind} is already running on this device" : null;

    LiveJob? RunningFor(string id) {
        return _live.FirstOrDefault(j => j.Device == id);
    }

    WorkbenchStatusKind? RunStatus(string id) {
        return RunningFor(id) is null ? null : WorkbenchStatusKind.Running;
    }

    RenderFragment? JobFoot(string id) {
        return RunningFor(id) is { } job ? KindFragment(job) : null;
    }

    RenderFragment KindFragment(LiveJob job) => @<text>@job.Kind</text>;

    static string? Number(int? value) {
        return value?.ToString(CultureInfo.InvariantCulture);
    }

    IEnumerable<DeviceRow> Ordered() {
        return _devices
            .OrderBy(d => d.Platform == "ios" ? 0 : d.Platform == "android" ? 1 : 2)
            .ThenBy(d => d.Label, StringComparer.OrdinalIgnoreCase);
    }

    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    public async Task Open(string? deviceId = null) {
        if (!_isAdmin) return;
        _open = true;
        if (deviceId is not null) State.SelectedId = deviceId;
        await LoadAsync();
        State.SelectedId ??= Ordered().FirstOrDefault()?.Id;
        await LoadForDeviceAsync();
        await LoadBinariesAsync();
        _timer ??= ComponentTimers.Every(TimeSpan.FromSeconds(2), () => InvokeAsync(TickAsync));
        StateHasChanged();
    }

    void CloseModal() {
        _open = false;
        _timer?.Dispose();
        _timer = null;
        DetachCapture();
        StateHasChanged();
    }

    async Task Select(string id) {
        if (State.SelectedId == id) return;
        State.SelectedId = id;
        _notice = null;
        DetachCapture();
        await LoadForDeviceAsync();
    }

    async Task SetMode(string mode) {
        State.Mode = mode;
        if (State.Mode == DeviceWorkbenchState.ModeCapture) AttachCapture();
        if (State.Mode == DeviceWorkbenchState.ModeJobs) await LoadJobsAsync();
    }

    async Task TickAsync() {
        if (_disposed || !_open) return;
        await LoadLiveAsync();
        if (State.Mode == DeviceWorkbenchState.ModeJobs) await LoadJobsAsync();
        StateHasChanged();
    }

    async Task LoadAsync() {
        _devices = await Client().ListAsync<DeviceRow>("/api/devices/status", Logger);
        await LoadLiveAsync();
    }

    async Task LoadForDeviceAsync() {
        await LoadHarvestAsync();
        await LoadJobsAsync();
        if (State.Mode == DeviceWorkbenchState.ModeCapture) AttachCapture();
    }

    async Task LoadLiveAsync() {
        _live = await Client().ListAsync<LiveJob>("/api/devices/jobs/live", Logger);
    }

    async Task LoadJobsAsync() {
        if (Current is null) return;
        _jobs = await Client().ListAsync<JobRow>($"/api/devices/{Current.Id}/jobs?n=50", Logger);
    }

    async Task LoadHarvestAsync() {
        if (Current is null) return;
        _harvest = await Client().OneAsync<HarvestInfo>($"/api/devices/{Current.Id}/harvest", Logger);
    }

    async Task LoadBinariesAsync() {
        var list = await Client().OneAsync<BinaryList>("/api/decomp/stored-binaries", Logger);
        _binaries = list?.Binaries ?? [];
    }

    string HarvestLine() {
        if (_harvest is null) return "?";
        var state = _harvest.Harvesting ? "harvesting" : _harvest.Stale ? "stale" : "current";
        return $"{state} | {_harvest.LastHarvestStatus}";
    }

    static string StateClass(string state) {
        return WorkbenchStatus.Class(WorkbenchStatus.Parse(state));
    }

    static string LevelClass(string level) {
        return level switch {
            "error" => "text-err",
            "warn" => "dwb-warn",
            _ => "text-fg"
        };
    }

    static string Duration(JobRow j) {
        if (j.FinishedAt is not { } end) return "running";
        var span = end - j.StartedAt;
        return span.TotalSeconds < 1 ? "<1s" : $"{(int)span.TotalSeconds}s";
    }

    void ToggleJob(long id) {
        if (!State.Expanded.Remove(id)) State.Expanded.Add(id);
    }

    void Note(string text, bool ok) {
        _notice = new WorkbenchNotice(text, ok ? StatusNote.Kind.Ok : StatusNote.Kind.Error);
    }

    async Task Act(string url, string ok) {
        if (Current is null) return;
        _notice = null;
        var res = await Client().PostAsync(url, null);
        var good = res.IsSuccessStatusCode || res.StatusCode == HttpStatusCode.Accepted;
        Note(good ? ok : await ReadError(res), good);
        await LoadAsync();
        await LoadForDeviceAsync();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    Task ProbeNow() {
        return Act($"/api/devices/{Current!.Id}/refresh", "probed");
    }

    Task CheckStore() {
        return Act($"/api/devices/{Current!.Id}/check-update", "store check started");
    }

    Task SaveToRegistry() {
        return Act($"/api/devices/{Current!.Id}/save", "installed to registry");
    }

    Task Poke() {
        return Act($"/api/devices/{Current!.Id}/poke", "harvest queued");
    }

    async Task RestartApp() {
        if (Current is null) return;
        var id = Current.Id;
        _notice = null;
        var res = await Client().PostAsync($"/api/devices/{id}/restart-app", null);
        if (!res.IsSuccessStatusCode) {
            Note(await ReadError(res), false);
            return;
        }

        Note("launched, waiting for an API call...", true);
        StateHasChanged();
        for (var i = 0; i < 8 && !_disposed; i++) {
            await Task.Delay(2000);
            if (await LiveClientVersion(id) is not null) {
                Note("clientVersion captured", true);
                await LoadAsync();
                return;
            }
        }

        Note("no clientVersion captured (timed out)", false);
    }

    async Task<int?> LiveClientVersion(string id) {
        var probe = await Client().OneAsync<LiveProbe>($"/api/devices/{id}/live", Logger);
        return probe?.ClientVersion;
    }

    async Task ProbeAll() {
        _bulkBusy = true;
        var res = await Client().PostAsync("/api/devices/refresh-all", null);
        Note(res.IsSuccessStatusCode ? "probed every device" : "probe all failed", res.IsSuccessStatusCode);
        await LoadAsync();
        _bulkBusy = false;
    }

    async Task PokeAll() {
        _bulkBusy = true;
        var res = await Client().PostAsync("/api/devices/poke-all", null);
        var good = res.IsSuccessStatusCode || res.StatusCode == HttpStatusCode.Accepted;
        Note(good ? "harvest queued on every device" : "poke all failed", good);
        _bulkBusy = false;
    }

    void AttachCapture() {
        if (_hub is not null || Current is null) return;
        if (Services.GetService(typeof(DeviceCaptureManager)) is not DeviceCaptureManager dcm) return;
        if (dcm.HubFor(Current.Id) is not { } hub) return;
        _hub = hub;

        var (reader, subscription) = hub.Subscribe();
        _subscription = subscription;
        foreach (var f in hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(hub.StatsSnapshot());

        _loopCts = new CancellationTokenSource();
        var ct = _loopCts.Token;
        _ = Task.Run(async () => {
            try {
                await foreach (var env in reader.ReadAllAsync(ct)) {
                    await InvokeAsync(() => ApplyEnvelope(env));
                }
            }
            catch (OperationCanceledException) {
            }
            catch (ChannelClosedException) {
            }
        }, ct);
    }

    void DetachCapture() {
        _loopCts?.Cancel();
        _loopCts?.Dispose();
        _loopCts = null;
        _subscription?.Dispose();
        _subscription = null;
        _hub = null;
        _flows.Clear();
        _flowIndex.Clear();
        _selectedFlowId = null;
        _selectedFlow = null;
        _stats = null;
        _capturing = false;
        _port = 0;
    }

    void ApplyEnvelope(CaptureEnvelope env) {
        switch (env.Kind) {
            case "flow" when env.Flow is not null:
                AddOrUpdateFlow(env.Flow);
                break;
            case "stats" when env.Stats is not null:
                ApplyStats(env.Stats);
                break;
        }

        StateHasChanged();
    }

    void AddOrUpdateFlow(DashboardFlow flow) {
        if (_flowIndex.TryGetValue(flow.Id, out var idx)) {
            _flows[idx] = flow;
            if (_selectedFlowId == flow.Id) _selectedFlow = flow;
            return;
        }

        _flowIndex[flow.Id] = _flows.Count;
        _flows.Add(flow);
    }

    void ApplyStats(CaptureStats stats) {
        _stats = stats;
        _capturing = stats.Running;
        _port = stats.Port;
    }

    void SelectFlow(long id) {
        _selectedFlowId = id;
        _selectedFlow = _flowIndex.TryGetValue(id, out var idx) ? _flows[idx] : null;
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed ({(int)resp.StatusCode})";
        }
        catch {
        }

        return $"failed ({(int)resp.StatusCode})";
    }

    public void Dispose() {
        _disposed = true;
        _timer?.Dispose();
        DetachCapture();
    }

    public sealed record DeviceRow(
        string Id,
        string Platform,
        string Label,
        string? Target,
        string? Package,
        bool Reachable,
        string? InstalledAppVersion,
        string? InstalledBuild,
        string? StoreLatest,
        bool StoreAhead,
        string Result,
        string? Note,
        DateTimeOffset ProbedAt,
        int? ClientVersion);

    public sealed record LiveJob(string Device, long Id, string Kind, string? Message, DateTimeOffset StartedAt);

    public sealed record JobRow(
        long Id,
        string Kind,
        string State,
        string Trigger,
        DateTimeOffset StartedAt,
        DateTimeOffset? FinishedAt,
        string? Outcome,
        string? Message,
        string? AppVersion,
        string? Build,
        string? Revision,
        List<JobLineRow> Lines);

    public sealed record JobLineRow(
        DateTimeOffset At,
        string Level,
        string Text,
        string? Entry,
        long? Bytes,
        string? Sha256);

    public sealed record HarvestInfo(
        string Device,
        string Platform,
        string? AppVersion,
        string Revision,
        string? HarvestedRevision,
        bool Stale,
        bool Dirty,
        bool Harvesting,
        DateTimeOffset? LastHarvestAt,
        string LastHarvestStatus,
        string? LastHarvestNote,
        List<HarvestEntryRow> Entries);

    public sealed record HarvestEntryRow(
        DateTimeOffset RanAt,
        string? Entry,
        string? Kind,
        string Outcome,
        string? Note,
        long Bytes,
        string? Sha256);

    public sealed record BinaryRow(
        string Platform,
        string Version,
        string Sha256,
        long ByteSize,
        int NativeSymbols,
        int EffectiveSymbols,
        string Source,
        DateTimeOffset PulledAt);

    public sealed record BinaryList(bool Ok, int Count, List<BinaryRow> Binaries);

    public sealed record LiveProbe(int? ClientVersion);

}
