@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IServiceProvider Services
@inject AdminNotifier Notifier
@inject ILogger<DeviceRecipesPane> Logger
@using System.Globalization
@using System.Text.Json
@using EggIdentity.UI
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Devices
@using EggIncognito.Services.Devices
@implements IDisposable

@if (_deviceId is null) {
    <div class="wb-note">Pick a device.</div>
} else {
    <div class="dcon-col">
        <div class="dcon-sec-head">Recipes</div>

        <div class="dcon-ready">
            <div class="dcon-ready-head">
                <span class="dcon-sec-head">Readiness</span>
                <button type="button" class="btn-mini" disabled="@_readinessBusy" @onclick="LoadReadinessAsync">
                    @(_readinessBusy ? "Reading..." : "Refresh")
                </button>
            </div>
            @if (_readiness is { } r && !AllUnknown(r)) {
                @foreach (var row in ReadinessRows(r)) {
                    <div class="dcon-ready-row @(row.Check.Ok ? "dcon-ready-ok" : "dcon-ready-no")">
                        <span class="dcon-ready-k">@row.Label</span>
                        @if (row.Check.Note is { Length: > 0 } note) {
                            <span class="dcon-ready-note">@note</span>
                        }
                    </div>
                }
            } else if (_readinessBusy) {
                <div class="dcon-ready-unknown">Reading...</div>
            } else {
                <div class="dcon-ready-unknown">Not read yet.</div>
            }
        </div>

        @if (_booksBusy && _books.Count == 0) {
            <div class="wb-note">Reading recipes...</div>
        } else if (_books.Count == 0) {
            <div class="wb-note">No recipes for this device.</div>
        } else {
            @if (Workflows() is { Count: > 0 } workflows) {
                <div class="dcon-books">
                    @foreach (var book in workflows) {
                        @BookCard(book)
                    }
                </div>
            }

            @if (Steps() is { Count: > 0 } steps) {
                <div class="dcon-adv">
                    <button type="button" class="dcon-adv-toggle" aria-expanded="@_showAdvanced"
                            @onclick="ToggleAdvanced">
                        <span class="dcon-adv-caret @(_showAdvanced ? "dcon-adv-caret-open" : "")"></span>
                        Advanced steps
                    </button>
                    @if (_showAdvanced) {
                        <div class="dcon-books">
                            @foreach (var book in steps) {
                                @BookCard(book)
                            }
                        </div>
                    }
                </div>
            }
        }

        @if (_runTitle is { } title) {
            <div class="dcon-run">
                <div class="dcon-run-head">
                    <span class="dcon-run-title">@title</span>
                    <span class="@WorkbenchStatus.Class(WorkbenchStatus.Parse(RunStateWord()))">
                        @RunStateLine()
                    </span>
                    <CopyButton GetText="RunReport" Label="Copy" CopiedLabel="Copied" ShowIcon="false"/>
                    @if (_runJobId is not null && !_runDone) {
                        <button type="button" class="btn-mini" disabled="@_stopBusy" @onclick="StopRunAsync">
                            @(_stopBusy ? "Stopping..." : "Stop")
                        </button>
                    }
                </div>
                @if (_steps.Count > 0) {
                    <div class="dcon-steps">
                        @foreach (var step in _steps) {
                            <div class="dcon-step dcon-step-@StepClass(step.Status)">
                                <span class="dcon-step-title">@step.Title</span>
                                <span class="dcon-step-state">@StepStateWord(step.Status)</span>
                                @if (step.Note is { Length: > 0 } stepNote) {
                                    <span class="dcon-step-note">@stepNote</span>
                                }
                            </div>
                        }
                    </div>
                }
                @if (_runLog.Count == 0) {
                    <div class="dcon-log-empty">No output yet.</div>
                } else {
                    <div class="dcon-log">
                        @foreach (var line in _runLog) {
                            <div class="dcon-log-line">@line</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {

    [Parameter] public string? DeviceId { get; set; }

    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback<DeviceNotice> OnNotice { get; set; }

    [Parameter] public EventCallback OnRunFinished { get; set; }

    static readonly string[] JobIdNames = ["jobId", "JobId", "runId", "RunId", "id", "Id"];

    bool _disposed;
    bool _isAdmin;
    bool _loaded;
    bool _booksBusy;
    bool _runBusy;
    bool _runDone;
    bool _runOk;
    bool _runCancelled;
    bool _stopBusy;
    bool _showAdvanced;
    bool _readinessBusy;
    bool _refreshing;
    string? _deviceId;
    string? _runTitle;
    long? _runJobId;
    string? _runNote;
    string? _runFailedStep;

    List<DeviceCookbookInfo> _books = [];
    List<string> _runLog = [];
    List<CookbookStepResult> _steps = [];
    DeviceReadiness? _readiness;
    readonly Dictionary<string, string> _args = [];

    IDisposable? _topics;

    DeviceCookbookFeed? Feed => Services.GetService(typeof(DeviceCookbookFeed)) as DeviceCookbookFeed;

    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    protected override async Task OnParametersSetAsync() {
        var next = string.IsNullOrEmpty(DeviceId) ? null : DeviceId;
        if (next != _deviceId) {
            StopRunWatch();
            _deviceId = next;
            _loaded = false;
            ResetDevice();
        }

        if (!Active) {
            StopRunWatch();
            return;
        }

        if (_deviceId is null) return;
        if (!_loaded) {
            _loaded = true;
            await LoadCookbooksAsync();
            await LoadReadinessAsync();
            await CheckRunningAsync();
            return;
        }

        if (_runJobId is not null && !_runDone) StartRunWatch();
    }

    void ResetDevice() {
        _books = [];
        _args.Clear();
        _runTitle = null;
        _runJobId = null;
        _runNote = null;
        _runFailedStep = null;
        _runLog = [];
        _steps = [];
        _readiness = null;
        _readinessBusy = false;
        _booksBusy = false;
        _runBusy = false;
        _runDone = false;
        _runOk = false;
        _runCancelled = false;
        _stopBusy = false;
    }

    async Task LoadCookbooksAsync() {
        if (_deviceId is null) return;
        _booksBusy = true;
        StateHasChanged();
        _books = await Client().ListAsync<DeviceCookbookInfo>($"/api/devices/{_deviceId}/cookbooks", Logger);
        foreach (var book in _books) {
            if (book.Options is not { Count: > 0 } options) continue;
            if (_args.ContainsKey(book.Id)) continue;
            _args[book.Id] = (options.FirstOrDefault(o => o.Recommended) ?? options[0]).Value;
        }

        _booksBusy = false;
        StateHasChanged();
    }

    async Task LoadReadinessAsync() {
        if (_deviceId is null) return;
        _readinessBusy = true;
        StateHasChanged();
        _readiness = await Client().OneAsync<DeviceReadiness>($"/api/devices/{_deviceId}/readiness", Logger);
        _readinessBusy = false;
        StateHasChanged();
    }

    List<DeviceCookbookInfo> Workflows() {
        return [.. _books.Where(b => string.Equals(b.Group, CookbookGroups.Workflow, StringComparison.OrdinalIgnoreCase))];
    }

    List<DeviceCookbookInfo> Steps() {
        return [.. _books.Where(b => !string.Equals(b.Group, CookbookGroups.Workflow, StringComparison.OrdinalIgnoreCase))];
    }

    void ToggleAdvanced() {
        _showAdvanced = !_showAdvanced;
    }

    IEnumerable<(string Label, ReadinessCheck Check)> ReadinessRows(DeviceReadiness r) {
        yield return ("Installed", r.Installed);
        yield return ("Capture CA", r.CaptureCa);
        yield return ("Google Play", r.GooglePlay);
        yield return ("Rooted", r.Rooted);
        yield return ("Integrity module", r.IntegrityModule);
        yield return ("Launched", r.Launched);
    }

    static bool AllUnknown(DeviceReadiness r) {
        return ReadinessAll(r).All(c => !c.Ok && string.IsNullOrEmpty(c.Note));
    }

    static IEnumerable<ReadinessCheck> ReadinessAll(DeviceReadiness r) {
        return [r.Installed, r.CaptureCa, r.GooglePlay, r.Rooted, r.IntegrityModule, r.Launched];
    }

    static string StepClass(CookbookStepStatus status) {
        return status switch {
            CookbookStepStatus.Ok => "ok",
            CookbookStepStatus.Skipped => "skip",
            _ => "fail"
        };
    }

    static string StepStateWord(CookbookStepStatus status) {
        return status switch {
            CookbookStepStatus.Ok => "done",
            CookbookStepStatus.Skipped => "skipped",
            _ => "failed"
        };
    }

    RenderFragment BookCard(DeviceCookbookInfo book) => @<div class="dcon-book" @key="book.Id">
                                                            <div class="dcon-book-head">
                                                                <span class="dcon-book-title">@book.Title</span>
                                                                @if (book.Available) {
                                                                    <button type="button" class="btn-mini" disabled="@_runBusy"
                                                                            @onclick="@(() => RunCookbookAsync(book))">
                                                                        Run
                                                                    </button>
                                                                }
                                                            </div>
                                                            <div class="dcon-book-sum">@book.Summary</div>
                                                            @if (!book.Available) {
                                                                <div class="dcon-book-off">
                                                                    @(book.Unavailable ?? "Not available here.")
                                                                </div>
                                                            } else if (book.Options is { Count: > 0 } options) {
                                                                <label class="dcon-book-arg">
                                                                    <span class="dcon-book-arg-k">@(book.ArgumentLabel ?? "Choice")</span>
                                                                    <select class="field-input" value="@ArgFor(book)" disabled="@_runBusy"
                                                                            @onchange="@(e => SetArg(book.Id, e))">
                                                                        @foreach (var option in options) {
                                                                            <option value="@option.Value">@OptionLabel(option)</option>
                                                                        }
                                                                    </select>
                                                                </label>
                                                            }
                                                        </div>;

    string ArgFor(DeviceCookbookInfo book) {
        if (_args.TryGetValue(book.Id, out var chosen)) return chosen;
        if (book.Options is not { Count: > 0 } options) return "";
        return (options.FirstOrDefault(o => o.Recommended) ?? options[0]).Value;
    }

    void SetArg(string bookId, ChangeEventArgs e) {
        _args[bookId] = e.Value?.ToString() ?? "";
    }

    static string OptionLabel(DeviceCookbookOption option) {
        return option.Recommended ? $"{option.Label} (recommended)" : option.Label;
    }

    async Task RunCookbookAsync(DeviceCookbookInfo book) {
        if (_deviceId is null || _runBusy) return;
        StopRunWatch();
        _runBusy = true;
        _runDone = false;
        _runOk = false;
        _runCancelled = false;
        _stopBusy = false;
        _runTitle = book.Title;
        _runJobId = null;
        _runNote = null;
        _runFailedStep = null;
        _runLog = [];
        _steps = [];
        StateHasChanged();

        var argument = book.Options is { Count: > 0 } ? ArgFor(book) : null;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/cookbooks",
            new DeviceCookbookRequest(book.Id, argument), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) {
            var failed = await ReadError(res);
            _runBusy = false;
            _runDone = true;
            _runNote = failed;
            await Note(failed, false);
            return;
        }

        _runJobId = await ReadJobId(res);
        if (_runJobId is null) {
            _runBusy = false;
            _runDone = true;
            _runNote = "run started but no job id came back";
            return;
        }

        StartRunWatch();
        await RefreshRunAsync();
    }

    async Task CheckRunningAsync() {
        if (_deviceId is null) return;
        var status = await Client().OneAsync<CookbookRunningInfo>(
            $"/api/devices/{_deviceId}/cookbooks/running", Logger);
        if (status is not { Running: true, JobId: { } jobId } || _deviceId is null) return;

        StopRunWatch();
        _runBusy = true;
        _runDone = false;
        _runOk = false;
        _runCancelled = false;
        _stopBusy = false;
        _runTitle = "Cookbook run (resumed)";
        _runJobId = jobId;
        _runNote = null;
        _runFailedStep = null;
        _runLog = [];
        _steps = [];
        StartRunWatch();
        await RefreshRunAsync();
        StateHasChanged();
    }

    async Task StopRunAsync() {
        if (_deviceId is null || _runJobId is null || _stopBusy) return;
        _stopBusy = true;
        StateHasChanged();

        var res = await Client().PostAsync($"/api/devices/{_deviceId}/cookbooks/stop", null);
        _stopBusy = false;
        await Note(res.IsSuccessStatusCode ? "stop requested" : await ReadError(res), res.IsSuccessStatusCode);
        StateHasChanged();
    }

    void OnTopic(string topic) {
        if (_disposed || topic != AdminTopics.DeviceStatus) return;
        _ = InvokeAsync(RefreshRunAsync);
    }

    async Task RefreshRunAsync() {
        if (_disposed || !Active || _deviceId is null || _runJobId is null) {
            StopRunWatch();
            return;
        }

        if (_refreshing || !_isAdmin || Feed is not { } feed) return;
        _refreshing = true;
        try {
            if (await feed.RunAsync(_deviceId, _runJobId.Value, CancellationToken.None) is not { } status) {
                StopRunWatch();
                _runBusy = false;
                _runNote = "run fell out of the job history window";
                StateHasChanged();
                return;
            }


            if (status.Log is { } log) _runLog = [.. log];
            if (status.Steps is { } steps) _steps = [.. steps];
            _runNote = status.Note ?? _runNote;
            _runFailedStep = status.FailedStep ?? _runFailedStep;
            if (status.Finished) {
                _runDone = true;
                _runOk = status.Succeeded;
                _runCancelled = status.Cancelled;
                _runBusy = false;
                StopRunWatch();
                await LoadCookbooksAsync();
                await LoadReadinessAsync();
                if (OnRunFinished.HasDelegate) await OnRunFinished.InvokeAsync();
            }

            StateHasChanged();
        }
        finally {
            _refreshing = false;
        }
    }

    void StartRunWatch() {
        _topics ??= Notifier.Subscribe(OnTopic);
    }

    void StopRunWatch() {
        _topics?.Dispose();
        _topics = null;
    }

    string RunStateWord() {
        return !_runDone ? "running" : _runCancelled ? "cancelled" : _runOk ? "succeeded" : "failed";
    }

    string RunStateLine() {
        if (!_runDone) return "running";
        if (_runCancelled) return _runNote is { Length: > 0 } stopNote ? $"stopped, {stopNote}" : "stopped";
        if (_runOk) return _runNote is { Length: > 0 } ok ? $"done, {ok}" : "done";
        if (_runFailedStep is { Length: > 0 } step
            && !string.Equals(step, _runTitle, StringComparison.OrdinalIgnoreCase)) return $"failed at {step}";
        return "failed";
    }

    string RunReport() {
        var sb = new System.Text.StringBuilder();
        sb.Append(_runTitle ?? "run").Append(' ').AppendLine(RunStateLine());
        foreach (var step in _steps) {
            sb.Append("- ").Append(step.Title).Append(": ").Append(StepStateWord(step.Status));
            if (step.Note is { Length: > 0 } note) sb.Append(" (").Append(note).Append(')');
            sb.AppendLine();
        }

        if (_runLog.Count > 0) {
            sb.AppendLine();
            foreach (var line in _runLog) sb.AppendLine(line);
        }

        return sb.ToString();
    }

    Task Note(string text, bool ok) {
        return OnNotice.InvokeAsync(new DeviceNotice(text, ok ? StatusNoteKind.Ok : StatusNoteKind.Error));
    }

    static async Task<long?> ReadJobId(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind != JsonValueKind.Object) return null;
            foreach (var name in JobIdNames) {
                if (!body.TryGetProperty(name, out var value)) continue;
                var text = value.ValueKind switch {
                    JsonValueKind.String => value.GetString(),
                    JsonValueKind.Number => value.GetRawText(),
                    _ => null
                };
                if (long.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out long id)) return id;
            }
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return null;
        }

        return null;
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed [{(int)resp.StatusCode}]";
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return $"failed [{(int)resp.StatusCode}]";
        }

        return $"failed [{(int)resp.StatusCode}]";
    }

    public void Dispose() {
        _disposed = true;
        StopRunWatch();
    }

}
