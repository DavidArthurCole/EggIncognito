@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="/brand/icon-trimmed.png" />

    <meta name="description" content="@_meta.Description" />
    <meta name="theme-color" content="#ef7559" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EggIncognito" />
    <meta property="og:title" content="@_meta.Title" />
    <meta property="og:description" content="@_meta.Description" />
    <meta property="og:url" content="@_canonicalUrl" />
    <meta property="og:image" content="https://eggincognito.davidarthurcole.me/brand/logo.png" />
    <meta property="og:image:alt" content="EggIncognito" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@_meta.Title" />
    <meta name="twitter:description" content="@_meta.Description" />
    <meta name="twitter:image" content="https://eggincognito.davidarthurcole.me/brand/logo.png" />

    <link rel="stylesheet" href="@($"/nav.css?v={_assetVersion}")" />
    <link rel="stylesheet" href="@($"/tailwind.css?v={_assetVersion}")" />
    <link rel="stylesheet" href="@($"/EggIncognito.styles.css?v={_assetVersion}")" />
    <HeadOutlet />
</head>
<body class="m-0 bg-bg text-fg font-sans">
    <Routes />

    <dialog id="components-reconnect-modal" class="reconnect-modal">
      <div class="reconnect-card">
        <div class="components-rejoining-animation reconnect-spinner" aria-hidden="true"></div>
        <p class="reconnect-msg reconnect-first">Lost the connection to the server. Trying to get you back...</p>
        <p class="reconnect-msg reconnect-repeated">Still trying to reconnect. Next attempt in
          <span id="components-seconds-to-next-attempt"></span>s...</p>
        <p class="reconnect-msg reconnect-failed">Could not reconnect. Check your network, then try again.</p>
        <p class="reconnect-msg reconnect-pause">Connection paused. Picking it back up...</p>
        <p class="reconnect-msg reconnect-resume-failed">This session has expired. Reload to pick up where you left off.</p>
        <div class="reconnect-actions">
          <button type="button" id="components-reconnect-button" class="btn-primary">Try again</button>
          <button type="button" id="components-resume-button" class="btn-primary">Reload</button>
        </div>
      </div>
    </dialog>

    <script src="_framework/blazor.web.js"></script>
    <script src="@($"/interop/reconnectWatcher.js?v={_assetVersion}")"></script>
</body>
</html>

@code {
    static readonly string _assetVersion =
        EggIncognito.Services.BuildInfo.FromAssembly("https://github.com/davidarthurcole/EggIncognito").ShortSha;

    EggIncognito.Services.PageMeta.Meta _meta;
    string _canonicalUrl = "https://eggincognito.davidarthurcole.me/";

    protected override void OnInitialized()
    {
        var req = HttpContextAccessor.HttpContext?.Request;
        var path = req?.Path.Value;
        _meta = EggIncognito.Services.PageMeta.For(path);
        if (req is not null)
            _canonicalUrl = $"https://eggincognito.davidarthurcole.me{(string.IsNullOrEmpty(path) ? "/" : path)}";
    }
}
