@* Recursive proto field editor. One row per FieldNode: message fields recurse into a child FieldTree;
   repeated fields render an add/remove item list; enums/bools render a select; scalars a typed input. *@

@foreach (var node in Nodes) {
    @if (node.IsMessage) {
        <div class="field-row">
            <div class="field-name" style="grid-column: 1 / -1;">
                @node.Field.JsonName<span class="fnum">#@node.Field.Number</span>
                <span class="ftype">@(node.Field.Repeated ? "repeated " : "")message @node.Field.MessageType</span>
            </div>
        </div>
        <div style="grid-column: 1 / -1;">
            <FieldTree Nodes="node.Children" Nested="true" OnChanged="OnChanged"/>
        </div>
    } else {
        <div class="field-row @(Nested ? "nested" : "")">
            <div class="field-name">
                @node.Field.JsonName<span class="fnum">#@node.Field.Number</span>
                <span class="ftype">@(node.Field.Repeated ? "repeated " : "")@node.Field.Type</span>
            </div>
            @if (node.IsRepeated) {
                <div class="repeated-items">
                    @for (var i = 0; i < node.Items.Count; i++) {
                        var idx = i;
                        <div class="repeated-item">
                            <input class="rep-input field-input" placeholder="@node.Field.Type"
                                   value="@node.Items[idx]"
                                   autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                                   @oninput="e => SetItem(node, idx, e.Value?.ToString())"/>
                            <button type="button" class="btn-mini" @onclick="() => Remove(node, idx)">x</button>
                        </div>
                    }
                    <button type="button" class="btn-mini" @onclick="() => Add(node)">+ add</button>
                </div>
            } else if (node.IsEnum) {
                <select class="field-input @(node.Locked ? "env-locked" : "")" disabled="@node.Locked"
                        value="@node.Value" @onchange="e => Set(node, e.Value?.ToString())">
                    <option value="">(unset)</option>
                    @foreach (var v in node.Field.EnumValues ?? []) {
                        <option value="@v.Name">@v.Name (@v.Number)</option>
                    }
                </select>
            } else if (node.IsBool) {
                <select class="field-input @(node.Locked ? "env-locked" : "")" disabled="@node.Locked"
                        value="@node.Value" @onchange="e => Set(node, e.Value?.ToString())">
                    <option value="">(unset)</option>
                    <option value="true">true</option>
                    <option value="false">false</option>
                </select>
            } else {
                <input class="field-input @(node.Locked ? "env-locked" : "")" disabled="@node.Locked"
                       placeholder="@node.Field.Type" value="@node.Value"
                       title="@(node.Locked ? "Set by the Environment panel above" : "")"
                       autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                       @oninput="e => Set(node, e.Value?.ToString())"/>
            }
        </div>
    }
}

@code {
    [Parameter] public required List<FieldNode> Nodes { get; set; }
    [Parameter] public bool Nested { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    Task Set(FieldNode n, string? v) {
        n.Value = v ?? "";
        return OnChanged.InvokeAsync();
    }

    Task SetItem(FieldNode n, int i, string? v) {
        n.Items[i] = v ?? "";
        return OnChanged.InvokeAsync();
    }

    Task Add(FieldNode n) {
        n.AddItem();
        return OnChanged.InvokeAsync();
    }

    Task Remove(FieldNode n, int i) {
        n.RemoveItem(i);
        return OnChanged.InvokeAsync();
    }

}
