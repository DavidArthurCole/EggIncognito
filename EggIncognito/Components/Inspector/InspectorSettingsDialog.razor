@if (Open) {
    <ModalShell Title="Inspector settings" TitleId="inspectorSettingsTitle"
                Width="ModalShell.ModalWidth.Small" OnClose="OnClose">
        <div class="modal-body">
            <label class="settings-check">
                <input type="checkbox" checked="@HistoryEnabled" @onchange="OnToggle"/>
                Save request history
            </label>
            <p class="text-muted text-sm mt-1 mb-0">
                Keeps a client-side list of built requests for quick re-use
                (stored only in this browser). Turn off to stop saving; existing history stays until cleared.
            </p>
            <div class="insp-dialog-foot">
                <button type="button" class="btn-primary" @onclick="OnClose">Done</button>
            </div>
        </div>
    </ModalShell>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool HistoryEnabled { get; set; }
    [Parameter] public EventCallback<bool> HistoryEnabledChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    Task OnToggle(ChangeEventArgs e) {
        return HistoryEnabledChanged.InvokeAsync(e.Value is bool b && b);
    }

}
