@using System.Text.Json
@using EggIncognito.Services.Inspector
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject AdminNotifier Notifier

<div class="doc-head">
    <h2 class="doc-title">@Title</h2>
    <span class="tag-chips">
        @foreach (var t in _tags) {
            @if (_canTag) {
                <button type="button" class="doc-tag doc-tag-btn" style="@TagStyle(t.Color)"
                        title="Detach @t.Label" disabled="@_busy" @onclick="() => Detach(t.Id)">
                    @t.Label &times;
                </button>
            } else {
                <span class="doc-tag" style="@TagStyle(t.Color)">@t.Label</span>
            }
        }
        @if (_canTag && Attachable().Count > 0) {
            <select @key="@_tags.Count" class="doc-tag-add" aria-label="Attach a tag" value=""
                    disabled="@_busy" @onchange="Attach">
                <option value="">attach...</option>
                @foreach (var t in Attachable()) {
                    <option value="@t.Id">@t.Label</option>
                }
            </select>
        }
    </span>
</div>
<PaneNotice @ref="_notice"/>

@if (Aside is not null) {
    @Aside
}

<div class="doc-body">
    @if (string.IsNullOrEmpty(_bodyMd)) {
        <div class="muted">No documentation yet.</div>
    } else {
        <Markdown Body="@_bodyMd"/>
    }
</div>

<MarkdownEditor @key="@_editorKey" Kind="@Slug" Key="@Key" Initial="@_bodyMd" OnSaved="OnDocSaved"/>

@if (Footer is not null) {
    @Footer
}

@code {
    [Parameter] public DocSubjectKind Kind { get; set; }
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    PaneNotice? _notice;

    string? _bodyMd;
    List<TagRow> _tags = [];
    List<TagRow> _allTags = [];
    string? _loadedFor;
    bool _canTag;
    bool _busy;

    string Slug => DocSubjectKinds.Slug(Kind);

    string _editorKey = "";

    protected override void OnInitialized() {
        base.OnInitialized();
        _canTag = User.IsAtLeast(UserRole.Admin);
    }

    protected override async Task OnParametersSetAsync() {
        var subject = Slug + "/" + Key;
        if (string.IsNullOrEmpty(Key) || subject == _loadedFor) return;
        _loadedFor = subject;
        _editorKey = subject;
        _bodyMd = null;
        _tags = [];
        await LoadAsync($"/api/docs/doc/{Slug}/{Uri.EscapeDataString(Key)}",
            $"/api/docs/subject-tags/{Slug}/{Uri.EscapeDataString(Key)}");
        if (_canTag) await LoadAllTags();
    }

    List<TagRow> Attachable() {
        return _allTags.Where(t => _tags.TrueForAll(a => a.Id != t.Id)).ToList();
    }

    async Task LoadAllTags() {
        try {
            _allTags = await Client().GetFromJsonAsync<List<TagRow>>("/api/docs/tags", JsonOpts) ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            _allTags = [];
        }
    }

    Task Attach(ChangeEventArgs e) {
        if (!long.TryParse(e.Value?.ToString(), out long id)) return Task.CompletedTask;
        return SetTags([.. _tags.Select(t => t.Id), id]);
    }

    Task Detach(long id) {
        return SetTags([.. _tags.Select(t => t.Id).Where(x => x != id)]);
    }

    async Task SetTags(long[] tagIds) {
        _busy = true;
        _notice?.Clear();
        try {
            var res = await Client().PostAsJsonAsync("/api/docs/subject-tags",
                new { subjectKind = Slug, subjectKey = Key, tagIds }, JsonOpts);
            if (res.IsSuccessStatusCode) {
                _tags = _allTags.Where(t => tagIds.Contains(t.Id)).OrderBy(t => t.Label, StringComparer.Ordinal)
                    .ToList();
                Notifier.Publish(AdminTopics.Tags);
            } else {
                _notice?.Fail((int)res.StatusCode == 403
                    ? "Not authorized."
                    : $"Tag update failed: HTTP {(int)res.StatusCode}");
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            _notice?.Fail($"Tag update failed: {ex.Message}");
        }
        finally {
            _busy = false;
        }
    }

    async Task LoadAsync(string docUrl, string tagsUrl) {
        var client = Client();
        try {
            var doc = await client.GetFromJsonAsync<DocResult>(docUrl, JsonOpts);
            _bodyMd = doc?.BodyMd;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            _bodyMd = null;
        }

        try {
            _tags = await client.GetFromJsonAsync<List<TagRow>>(tagsUrl, JsonOpts) ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            _tags = [];
        }
    }

    Task OnDocSaved(string body) {
        _bodyMd = string.IsNullOrWhiteSpace(body) ? null : body;
        return Task.CompletedTask;
    }

    static string TagStyle(string? color) {
        return string.IsNullOrEmpty(color) ? "" : $"color: {color};";
    }

}
