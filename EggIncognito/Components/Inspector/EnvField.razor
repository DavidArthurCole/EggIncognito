@using EggIncognito.Services.Inspector
@if (Row is not null) {
    <label class="env-cell @WidthClass" title="@Row.Key">
        <span class="env-key">@Row.Key</span>
        @if (Row.Editor == EnvEditor.Select) {
            <select class="env-input" value="@Row.Value" @onchange="OnSelect">
                @foreach (var opt in Row.Options ?? []) {
                    <option value="@opt">@opt</option>
                }
            </select>
        } else if (Row.Editor == EnvEditor.Bool) {
            <input class="env-check" type="checkbox" checked="@(Row.Value == "true")" @onchange="OnBool"/>
        } else {
            <input class="env-input @(Row.IsInvalid() ? "env-invalid" : "")" list="@ListId"
                   value="@Row.Value" placeholder="@Row.Hint" @attributes="InputAttrs.NoAutofill"
                   @oninput="OnText"/>
        }
    </label>
}

@code {
    [Parameter] public EnvRow? Row { get; set; }
    [Parameter] public string? WidthClass { get; set; }
    [Parameter] public EventCallback<EnvRow> OnChanged { get; set; }

    string? ListId => Row?.Editor == EnvEditor.Eid ? "recentEids" : null;

    Task OnSelect(ChangeEventArgs e) {
        return Commit(e.Value?.ToString());
    }

    Task OnText(ChangeEventArgs e) {
        return Commit(e.Value?.ToString());
    }

    Task OnBool(ChangeEventArgs e) {
        return Commit(e.Value is bool b && b ? "true" : "false");
    }

    Task Commit(string? value) {
        if (Row is null) return Task.CompletedTask;
        Row.Value = value ?? "";
        return OnChanged.InvokeAsync(Row);
    }

}
