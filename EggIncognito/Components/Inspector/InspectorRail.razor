@using EggIncognito.Components.Shared.Workbench
@using EggIncognito.Services.Inspector
@using EggIncognito.Services.Workbench
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IRouteCatalog Catalog
@inject IProtoReflection Reflection

@if (Overlay) {
    <button type="button" class="insp-rail-scrim" aria-label="Close the picker" @onclick="OnDismiss"></button>
}
<div class="insp-rail">
    <WorkbenchRail Width="100%">
        <div class="insp-rail-top">
            <WorkbenchModes Modes="ListModes" Current="@ListKey" CurrentChanged="OnListChanged" Label="Left list"/>
            <a class="icon-btn icon-btn-sm ml-auto" href="/api/tools/postman-collection" download
               title="Download Postman collection" aria-label="Download Postman collection">
                <Icon Name="postman"/>
            </a>
            @if (State.RailList == InspectorRailList.Endpoints) {
                <button type="button" class="icon-btn icon-btn-sm @(StatusLoading ? "spinning" : "")"
                        title="@(string.IsNullOrEmpty(StatusSummary) ? "Endpoint status" : $"Endpoint status {StatusSummary}")"
                        aria-label="Endpoint status" @onclick="OnOpenStatus">
                    <Icon Name="refresh"/>
                </button>
            }
            <button type="button" class="icon-btn icon-btn-sm" title="Inspector settings"
                    aria-label="Inspector settings" @onclick="OnOpenSettings">
                <Icon Name="gear"/>
            </button>
        </div>

        <button type="button" class="insp-salt @(State.HasSalt ? "on" : "")"
                title="@(State.HasSalt ? "Signing salt is set (stored in this browser). Click to change it." : "No signing salt set. Click to set it.")"
                @onclick="OnOpenSalt">
            @(State.HasSalt ? "salt set" : "salt unset")
        </button>

        @if (!string.IsNullOrEmpty(State.Notice)) {
            <StatusNote Severity="StatusNote.Kind.Error">@State.Notice</StatusNote>
        }

        <FilterInput Class="insp-filter" Placeholder="@FilterPlaceholder" AriaLabel="@FilterPlaceholder"
                     Value="@State.RailFilter" ValueChanged="OnFilterChanged"/>

        @if (State.RailList == InspectorRailList.Endpoints) {
            <WorkbenchSection Label="Endpoints" Scroll="true" MaxHeight="@ListMaxHeight">
                <div class="insp-list">
                    <Virtualize Items="EndpointRows()" Context="row" ItemSize="24" OverscanCount="12">
                        @if (row.Route is null) {
                            <div class="ep-ns" @onclick="@(() => ToggleGroup(row.Ns))">
                                <span class="ep-caret @(_collapsed.Contains(row.Ns) ? "" : "ep-caret-open")"></span>@(row.Ns)/
                            </div>
                        } else {
                            <div class="ep @(State.Selected?.Path == row.Route.Path ? "active" : "")"
                                 @onclick="@(() => OnSelectEndpoint.InvokeAsync(row.Route))">
                                <span class="ep-name">@row.Label</span>
                                @if (row.Route.RequestWrapped) {
                                    <span class="ep-signed" title="wrapped + signed in an AuthenticatedMessage">
                                        <Icon Name="lock" Class="icon-sm"/>
                                    </span>
                                }
                            </div>
                        }
                    </Virtualize>
                </div>
            </WorkbenchSection>
        } else {
            <WorkbenchSection Label="Objects" Scroll="true" MaxHeight="@ListMaxHeight">
                <div class="insp-list">
                    <Virtualize Items="ObjectRows()" Context="name" ItemSize="24" OverscanCount="12">
                        <div class="ep obj-row @(State.SelectedObject == name ? "active" : "")"
                             @onclick="@(() => OnSelectObject.InvokeAsync(name))">
                            <span class="obj-name">@name</span>
                        </div>
                    </Virtualize>
                </div>
            </WorkbenchSection>
        }

        <WorkbenchSection Label="History">
            <HistoryPanel HistoryEnabled="State.HistoryEnabled" History="State.History"
                          OnRestoreHistory="OnRestoreHistory" OnDeleteHistory="OnDeleteHistory"
                          OnClearHistory="OnClearHistory"/>
        </WorkbenchSection>
    </WorkbenchRail>
</div>

@code {
    [Inject] public InspectorState State { get; set; } = default!;

    [Parameter] public bool Overlay { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public EventCallback<RouteInfo> OnSelectEndpoint { get; set; }
    [Parameter] public EventCallback<string> OnSelectObject { get; set; }
    [Parameter] public EventCallback OnOpenSalt { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback OnOpenStatus { get; set; }
    [Parameter] public bool StatusLoading { get; set; }
    [Parameter] public string StatusSummary { get; set; } = "";
    [Parameter] public EventCallback<InspectorHistoryEntry> OnRestoreHistory { get; set; }
    [Parameter] public EventCallback<string> OnDeleteHistory { get; set; }
    [Parameter] public EventCallback OnClearHistory { get; set; }

    const string EndpointsKey = "endpoints";
    const string ObjectsKey = "objects";
    const string ListMaxHeight = "60vh";

    static readonly WorkbenchMode[] ListModes = [
        new(EndpointsKey, "Endpoints", "Mock and live API routes"),
        new(ObjectsKey, "Objects", "Proto message types")
    ];

    readonly HashSet<string> _collapsed = [];

    List<RouteInfo>? _routes;
    List<string>? _messages;
    List<RailRow>? _rows;
    string? _rowsKey;

    string ListKey => State.RailList == InspectorRailList.Objects ? ObjectsKey : EndpointsKey;

    string FilterPlaceholder =>
        State.RailList == InspectorRailList.Objects ? "filter objects..." : "filter routes...";

    void OnListChanged(string key) {
        State.RailList = key == ObjectsKey ? InspectorRailList.Objects : InspectorRailList.Endpoints;
    }

    void OnFilterChanged(string value) {
        State.RailFilter = value;
        _rowsKey = null;
    }

    void ToggleGroup(string ns) {
        if (!_collapsed.Remove(ns)) _collapsed.Add(ns);
        _rowsKey = null;
    }

    List<RailRow> EndpointRows() {
        var key = State.RailFilter.Trim();
        if (_rowsKey == key && _rows is not null) return _rows;
        _rowsKey = key;
        _rows = BuildEndpointRows(key);
        return _rows;
    }

    List<RailRow> BuildEndpointRows(string needle) {
        _routes ??= Catalog.All().ToList();
        var source = needle.Length == 0
            ? _routes
            : _routes.Where(e => e.Path.Contains(needle, StringComparison.OrdinalIgnoreCase)).ToList();

        var rows = new List<RailRow>();
        foreach (var group in source.GroupBy(e => e.Path.Split('/')[0]).OrderBy(g => g.Key, StringComparer.Ordinal)) {
            var ns = group.Key;
            rows.Add(new RailRow(ns.ToLowerInvariant(), null, ""));
            if (_collapsed.Contains(ns.ToLowerInvariant())) continue;
            foreach (var e in group) rows.Add(new RailRow(ns.ToLowerInvariant(), e, e.Path[(ns.Length + 1)..]));
        }

        return rows;
    }

    List<string> ObjectRows() {
        _messages ??= Reflection.AllMessageTypeNames().ToList();
        var needle = State.RailFilter.Trim();
        return needle.Length == 0
            ? _messages
            : _messages.Where(n => n.Contains(needle, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    sealed record RailRow(string Ns, RouteInfo? Route, string Label);

}
