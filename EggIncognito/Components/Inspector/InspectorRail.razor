@using EggIncognito.Models.Inspector
@using EggIncognito.Services.Api
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IRouteCatalog Catalog
@inject IProtoReflection Reflection

<div class="insp-rail-top">
    <a class="icon-btn icon-btn-sm" href="/api/tools/postman-collection" download
       aria-label="Download Postman collection">
        <Icon Name="send"/>
    </a>
    <button type="button" class="icon-btn icon-btn-sm @(StatusLoading ? "spinning" : "")"
            aria-label="Endpoint status" @onclick="OnOpenStatus">
        <Icon Name="refresh-cw"/>
    </button>
    <button type="button" class="icon-btn icon-btn-sm ml-auto"
            aria-label="Inspector settings" @onclick="OnOpenSettings">
        <Icon Name="settings"/>
    </button>
</div>

<button type="button" class="insp-salt @(State.HasSalt ? "on" : "")"
        @onclick="OnOpenSalt">
    @(State.HasSalt ? "salt set" : "salt unset")
</button>

@if (!string.IsNullOrEmpty(State.Notice)) {
    <StatusNote Severity="StatusNoteKind.Error">@State.Notice</StatusNote>
}

<FilterInput Class="insp-filter" AriaLabel="Filter routes"
             Value="@State.RailFilter" ValueChanged="OnFilterChanged"/>

<div class="awb-rail-list">
    <WorkbenchSection Label="@EndpointsLabel" Scroll="true">
        <div class="insp-list">
            <Virtualize Items="EndpointRows()" Context="row" ItemSize="24" OverscanCount="12">
                @if (row.Route is null) {
                    <div class="ep-ns" @onclick="@(() => ToggleGroup(row.Ns))">
                        <span class="ep-caret @(_collapsed.Contains(row.Ns) ? "" : "ep-caret-open")"></span>@(row.Ns)/
                    </div>
                } else {
                    <div class="ep @(State.Selected?.Path == row.Route.Path ? "active" : "")"
                         @onclick="@(() => OnSelectEndpoint.InvokeAsync(row.Route))">
                        <span class="ep-name">@row.Label</span>
                        @if (row.Route.RequestWrapped) {
                            <span class="ep-signed">
                                <Icon Name="lock" Class="icon-sm"/>
                            </span>
                        }
                    </div>
                }
            </Virtualize>
        </div>
    </WorkbenchSection>
</div>

<div class="awb-rail-hist">
    <WorkbenchSection Label="@HistoryLabel" Scroll="true">
        <HistoryPanel HistoryEnabled="State.HistoryEnabled" History="State.History"
                      OnRestoreHistory="OnRestoreHistory" OnDeleteHistory="OnDeleteHistory"
                      OnClearHistory="OnClearHistory"/>
    </WorkbenchSection>
</div>

@code {
    [Inject] public ApiWorkbenchState State { get; set; } = default!;

    [Parameter] public EventCallback<RouteInfo> OnSelectEndpoint { get; set; }
    [Parameter] public EventCallback OnOpenSalt { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback OnOpenStatus { get; set; }
    [Parameter] public bool StatusLoading { get; set; }
    [Parameter] public EventCallback<InspectorHistoryEntry> OnRestoreHistory { get; set; }
    [Parameter] public EventCallback<string> OnDeleteHistory { get; set; }
    [Parameter] public EventCallback OnClearHistory { get; set; }

    readonly HashSet<string> _collapsed = [];

    List<RouteInfo>? _routes;
    List<RailRow>? _rows;
    string? _rowsKey;

    string EndpointsLabel => $"Endpoints ({Routes().Count})";
    string HistoryLabel => State.History.Count > 0 ? $"History ({State.History.Count})" : "History";

    List<RouteInfo> Routes() {
        return _routes ??= Catalog.All().ToList();
    }

    void OnFilterChanged(string value) {
        State.RailFilter = value;
        _rowsKey = null;
    }

    void ToggleGroup(string ns) {
        if (!_collapsed.Remove(ns)) _collapsed.Add(ns);
        _rowsKey = null;
    }

    List<RailRow> EndpointRows() {
        var key = State.RailFilter.Trim();
        if (_rowsKey == key && _rows is not null) return _rows;
        _rowsKey = key;
        _rows = BuildEndpointRows(key);
        return _rows;
    }

    List<RailRow> BuildEndpointRows(string needle) {
        var routes = Routes();
        var source = needle.Length == 0
            ? routes
            : routes.Where(e => e.Path.Contains(needle, StringComparison.OrdinalIgnoreCase)).ToList();

        var rows = new List<RailRow>();
        foreach (var group in source.GroupBy(e => e.Path.Split('/')[0]).OrderBy(g => g.Key, StringComparer.Ordinal)) {
            var ns = group.Key;
            rows.Add(new RailRow(ns.ToLowerInvariant(), null, ""));
            if (_collapsed.Contains(ns.ToLowerInvariant())) continue;
            foreach (var e in group) rows.Add(new RailRow(ns.ToLowerInvariant(), e, e.Path[(ns.Length + 1)..]));
        }

        return rows;
    }

}
