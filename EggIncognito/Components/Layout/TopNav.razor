@inject ICurrentUser User
@inject AuthState Auth
<nav class="app-nav">
    <a href="/" class="app-nav-brand">
        <img src="/brand/logo.png" alt="EggIncognito"/>
    </a>
    <div class="nav-right">
        <NavToolbarOutlet/>
        @if (Auth.Enabled || Auth.LocalIdentityActive) {
            <span class="auth-nav">
                @if (User.IsAuthenticated) {
                    <AccountModal/>
                    @if (Auth.Enabled) {
                        <form method="post" action="/logout" style="margin:0;">
                            <button type="submit" class="auth-btn">Log out</button>
                        </form>
                    }
                } else if (Auth.WidgetEnabled) {
                    <LoginButton CssClass="auth-btn" Label="Log in"/>
                }
            </span>
        }
    </div>
</nav>
