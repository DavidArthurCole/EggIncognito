@inject ICurrentUser User
@inject AuthState Auth
<nav class="app-nav">
    <a href="/" class="app-nav-brand">
        <img src="/brand/logo.png" alt="EggIncognito"/>
    </a>
    <NavLink href="inspector" Match="NavLinkMatch.Prefix" ActiveClass="active">Inspector</NavLink>
    <NavLink href="protos" Match="NavLinkMatch.Prefix" ActiveClass="active">Protos & Data</NavLink>
    @if (User.IsAtLeast(UserRole.Contributor)) {
        <NavLink href="playground" ActiveClass="active">Playground</NavLink>
    }
    <NavLink href="capture" ActiveClass="active">Capture</NavLink>
    @if (User.IsAtLeast(UserRole.Admin)) {
        <NavLink href="admin" ActiveClass="active">Admin</NavLink>
    }
    <div class="nav-right">
        <NavToolbarOutlet/>
        @if (Auth.Enabled || Auth.LocalIdentityActive) {
            <span class="auth-nav">
                @if (User.IsAuthenticated) {
                    <AccountModal/>
                    @if (Auth.Enabled) {
                        <form method="post" action="/logout" style="margin:0;">
                            <button type="submit" class="auth-btn">Log out</button>
                        </form>
                    }
                } else if (Auth.WidgetEnabled) {
                    <LoginButton CssClass="auth-btn" Label="Log in"/>
                }
            </span>
        }
    </div>
</nav>
