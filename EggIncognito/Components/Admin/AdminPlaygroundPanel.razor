@rendermode @(RenderMode.InteractiveServer)
@using EggIncognito.Models.Playground
@inherits SelfCallComponentBase

<section class="panel admin-card" @onclick="Open">
    <div class="admin-panel-head">
        <h2 class="admin-panel-title">Farm Playground</h2>
        <div class="flex items-center gap-2">
            @if (!string.IsNullOrEmpty(Stat)) {
                <span class="text-muted text-xs">@Stat</span>
            }
            <button type="button" class="dropzone-open" aria-label="Open Farm Playground"
                    @onclick="Open" @onclick:stopPropagation="true">
                <Icon Name="chevronRight" Class="icon-sm"/>
            </button>
        </div>
    </div>
    <div class="admin-card-summary">
        @if (_failed) {
            <div class="text-xs text-muted">design and showcase counts are unavailable</div>
        } else {
            <div class="text-xs text-muted">@_designs saved @(_designs == 1 ? "design" : "designs") &middot; @_presets showcase @(_presets == 1 ? "preset" : "presets")</div>
            @foreach (var d in Recent()) {
                <div class="admin-card-extra text-xs text-muted">
                    <span class="truncate">@d.Name</span>
                    <TimeAgo Value="@d.UpdatedAt"/>
                </div>
            }
            @if (_designs == 0) {
                <div class="admin-card-extra text-xs text-muted">no farms saved yet</div>
            }
        }
    </div>
</section>

@code {

    [Parameter] public EventCallback OnOpen { get; set; }

    DesignRow[] _rows = [];
    int _designs;
    int _presets;
    bool _failed;
    bool _loaded;

    string Stat => _failed ? "" : $"{_designs} saved";

    IEnumerable<DesignRow> Recent() {
        return _rows.OrderByDescending(r => r.UpdatedAt).Take(3);
    }

    Task Open() {
        return OnOpen.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || _loaded) return;
        _loaded = true;
        await LoadAsync();
        StateHasChanged();
    }

    async Task LoadAsync() {
        var ok = false;
        try {
            var designs = await Client().GetFromJsonAsync<DesignListResult>("/api/env/designs");
            _rows = designs?.Designs ?? [];
            _designs = _rows.Length;
            ok = true;
        }
        catch {
            _rows = [];
            _designs = 0;
        }

        try {
            var showcase = await Client().GetFromJsonAsync<ShowcaseResult>("/api/farm/showcase");
            _presets = showcase?.Count ?? 0;
            ok = true;
        }
        catch {
            _presets = 0;
        }

        _failed = !ok;
    }

}
