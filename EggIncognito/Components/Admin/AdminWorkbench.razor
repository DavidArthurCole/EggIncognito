@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Components.Playground
@using EggIncognito.Components.Protos
@inject AdminWorkbenchState State
@inject NavigationManager Nav

<div class="admin-wb">
    <nav class="admin-wb-rail">
        @foreach (var group in AdminPanes.All.GroupBy(p => p.Group)) {
            <div class="admin-wb-group">@group.Key</div>
            @foreach (var pane in group) {
                <button type="button"
                        class="admin-wb-tab @(State.SelectedPane == pane.Key ? "is-active" : "")"
                        @onclick="() => Select(pane.Key)">
                    @pane.Label
                </button>
            }
        }
    </nav>
    <div class="admin-wb-host">
        @foreach (var pane in AdminPanes.All.Where(p => State.Visited.Contains(p.Key))) {
            <section class="panel admin-pane" hidden="@(State.SelectedPane != pane.Key)" @key="pane.Key">
                @switch (pane.Key) {
                    case AdminPanes.Traffic:
                        <AdminTrafficPanel/>
                        break;
                    case AdminPanes.DeviceStatus:
                        <DeviceStatusPanel OnManage="OpenDeviceWorkbench"/>
                        break;
                    case AdminPanes.Users:
                        <AdminUsersPanel/>
                        break;
                    case AdminPanes.Notifications:
                        <AdminNotificationsPanel/>
                        break;
                    case AdminPanes.ThemePolicy:
                        <AdminThemePolicyPanel/>
                        break;
                    case AdminPanes.DataStatus:
                        <AdminDataStatusPanel/>
                        break;
                    case AdminPanes.Binaries:
                        <AdminBinariesPanel/>
                        break;
                    case AdminPanes.GameData:
                        <AdminGameDataPanel/>
                        break;
                    case AdminPanes.Events:
                        <AdminEventsPanel/>
                        break;
                    case AdminPanes.Contracts:
                        <AdminContractsPanel/>
                        break;
                    case AdminPanes.Staged:
                        <AdminStagedPanel/>
                        break;
                    case AdminPanes.Contributions:
                        <AdminContributionsPanel/>
                        break;
                    case AdminPanes.Sessions:
                        <AdminSessionsPanel/>
                        break;
                    case AdminPanes.Console:
                        <AdminConsolePanel/>
                        break;
                    case AdminPanes.BotConfig:
                        <AdminBotConfigPanel/>
                        break;
                    case AdminPanes.Maintenance:
                        <AdminMaintenancePanel/>
                        break;
                    case AdminPanes.Settings:
                        <AdminSettingsPanel/>
                        break;
                    case AdminPanes.VirtualDevices:
                        <AdminVirtualDevicesPanel OnConsole="OpenConsole"/>
                        break;
                    case AdminPanes.Playground:
                        <AdminPlaygroundPanel OnOpen="OpenPlayground"/>
                        break;
                }
            </section>
        }
    </div>
</div>

<DeviceWorkbenchModal @ref="_deviceWorkbench"/>
<DeviceConsole @ref="_console"/>
<PlaygroundWorkbenchModal @ref="_playground"/>

@code {
    DeviceWorkbenchModal? _deviceWorkbench;
    DeviceConsole? _console;
    PlaygroundWorkbenchModal? _playground;

    void Select(string key) {
        State.Select(key);
    }

    Task OpenDeviceWorkbench(string? deviceId) {
        return _deviceWorkbench?.Open(deviceId) ?? Task.CompletedTask;
    }

    Task OpenConsole(string? deviceId) {
        return _console?.Open(deviceId) ?? Task.CompletedTask;
    }

    Task OpenPlayground() {
        return _playground?.Open() ?? Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        if (string.Equals(fragment, "playground", StringComparison.Ordinal)) await OpenPlayground();
        else if (string.Equals(fragment, "console", StringComparison.Ordinal)) await OpenConsole(null);
    }

}
