@rendermode @(RenderMode.InteractiveServer)
@inherits BrowserApiComponentBase

<section class="panel mb-4">
    <div class="admin-panel-head">
        <h2 class="admin-panel-title">Routes</h2>
        <span class="text-muted text-xs">@FilteredRows().Count of @_rows.Count</span>
    </div>

    @if (_binaryUnavailable) {
        <p class="text-muted text-xs m-0 mb-2">Binary route status unavailable (no database).</p>
    } else if (_binary is not null) {
        <div class="routes-binary-status">
            <span class="text-muted">
                last refresh @(_binary.LastRefresh is { } lr ? lr.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "never")
                &middot;
                @if (!string.IsNullOrWhiteSpace(_binary.BinaryVersion)) {
                    <text>binary </text>
                    <VersionLine App="@_binary.BinaryVersion"/>
                } else {
                    <text>binary unknown</text>
                }
                &middot; @_binary.Discovered discovered / @_binary.NewCount new / @_binary.DriftCount drift
            </span>
            <button type="button" class="btn-mini" disabled="@_refreshing" @onclick="RefreshBinary">@(_refreshing ? "Refreshing..." : "Refresh now")</button>
        </div>
    }

    <FilterInput Class="reg-filter-input mb-2" Placeholder="filter by path..." @bind-Value="_filter"/>

    <datalist id="routeMessageTypes">
        @foreach (var m in _messages) {
            <option value="@m"/>
        }
    </datalist>

    @if (_loading) {
        <p class="text-muted text-sm m-0">Loading routes...</p>
    } else if (FilteredRows().Count == 0) {
        <p class="text-muted text-sm m-0">No routes match this filter.</p>
    } else {
        <div class="reg-wrap admin-routes-scroll">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Path</th><th></th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in FilteredRows()) {
                    var drift = DriftFor(row.Path);
                    <tr class="reg-row cursor-pointer @(drift.Count > 0 ? "route-drift-row" : "")" @onclick="() => ToggleExpand(row)">
                        <td class="mono text-xs">@row.Path</td>
                        <td>
                            <div class="flex gap-1">
                                @if (row.Override is not null) {
                                    <span class="route-flag text-accent">edited</span>
                                }
                                @if (row.Source == "db") {
                                    <span class="route-flag text-info">db</span>
                                }
                                @if (BinaryPopulated && !IsInBinary(row.Path)) {
                                    <span class="route-flag text-ok">no binary</span>
                                }
                                @if (row.Source == "orphan") {
                                    <span class="route-flag text-err">orphan</span>
                                }
                            </div>
                        </td>
                        <td class="text-muted text-xs">@(drift.Count > 0 ? "drift" : "")</td>
                    </tr>
                    @if (_expandedPath == row.Path) {
                        <tr class="reg-edit-row">
                            <td colspan="3">
                                <div class="routes-editor">
                                    @if (row.Source != "orphan") {
                                        <p class="text-muted text-xs m-0">Saving persists this route definition to the database. It drives Inspector, capture decode, and docs.</p>
                                    } else {
                                        <p class="text-muted text-xs m-0">No matching route in yaml or the db catalog. Only Reset is available.</p>
                                    }
                                    <div class="routes-editor-fields">
                                        <label class="routes-editor-field">
                                            Request type
                                            <input class="reg-filter-input w-auto" list="routeMessageTypes" value="@_draftRequest" @oninput="OnDraftRequest"/>
                                        </label>
                                        <label class="routes-editor-field">
                                            Response type
                                            <input class="reg-filter-input w-auto" list="routeMessageTypes" value="@_draftResponse" @oninput="OnDraftResponse"/>
                                        </label>
                                        <label class="routes-editor-field">
                                            Request wrapped
                                            <select class="reg-filter-input w-auto" value="@_draftRequestWrapped" @onchange="OnDraftRequestWrapped">
                                                <option value="true">true</option>
                                                <option value="false">false</option>
                                            </select>
                                        </label>
                                        <label class="routes-editor-field">
                                            Response wrapped
                                            <select class="reg-filter-input w-auto" value="@_draftResponseWrapped" @onchange="OnDraftResponseWrapped">
                                                <option value="true">true</option>
                                                <option value="false">false</option>
                                            </select>
                                        </label>
                                        <label class="routes-editor-field">
                                            Path param
                                            <select class="reg-filter-input w-auto" value="@_draftPathParam" @onchange="OnDraftPathParam">
                                                <option value="true">true</option>
                                                <option value="false">false</option>
                                            </select>
                                        </label>
                                    </div>
                                    @if (drift.Count > 0) {
                                        <div class="flex flex-col gap-1">
                                            @foreach (var d in drift) {
                                                <div class="routes-drift-row">
                                                    <span class="route-flag @(d.Reliable ? "text-accent" : "text-info")">@(d.Reliable ? "drift" : "advisory")</span>
                                                    <span class="text-muted">@d.Field: effective @(d.EffectiveValue ?? "-") vs binary @(d.BinaryValue ?? "-")</span>
                                                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="() => ApplyDrift(d)">Apply</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="flex gap-1">
                                        @if (row.Source != "orphan") {
                                            <button type="button" class="btn-mini" disabled="@_busy" @onclick="() => Save(row)">Save</button>
                                        }
                                        @if (row.Override is not null) {
                                            <button type="button" class="btn-mini btn-danger" disabled="@_busy" @onclick="() => Clear(row.Path)">Reset</button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }

    @if (_msg is not null) {
        <StatusNote>@_msg</StatusNote>
    }
</section>

@code {
    List<RouteRow> _rows = [];
    List<string> _messages = [];
    BinaryStatus? _binary;
    bool _binaryUnavailable;
    bool _loading = true;
    bool _busy;
    bool _refreshing;
    string _filter = "";
    string? _msg;
    string? _expandedPath;

    string _draftRequest = "";
    string _draftResponse = "";
    string _draftRequestWrapped = "false";
    string _draftResponseWrapped = "false";
    string _draftPathParam = "false";

    protected override async Task OnApiReadyAsync() {
        await LoadMessages();
        await LoadRoutes();
        await LoadBinary();
    }

    void OnDraftRequest(ChangeEventArgs e) {
        _draftRequest = e.Value?.ToString() ?? "";
    }

    void OnDraftResponse(ChangeEventArgs e) {
        _draftResponse = e.Value?.ToString() ?? "";
    }

    void OnDraftRequestWrapped(ChangeEventArgs e) {
        _draftRequestWrapped = e.Value?.ToString() ?? "false";
    }

    void OnDraftResponseWrapped(ChangeEventArgs e) {
        _draftResponseWrapped = e.Value?.ToString() ?? "false";
    }

    void OnDraftPathParam(ChangeEventArgs e) {
        _draftPathParam = e.Value?.ToString() ?? "false";
    }

    List<RouteRow> FilteredRows() {
        if (string.IsNullOrEmpty(_filter)) return _rows;
        return _rows.Where(r => r.Path.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    List<DriftRow> DriftFor(string path) {
        if (_binary is null) return [];
        return _binary.Drift.Where(d => d.Path == path && d.Field != "new").ToList();
    }

    bool IsInBinary(string path) {
        return _binary?.Rows.Any(r => r.Path == path) ?? false;
    }

    bool BinaryPopulated => _binary is { Rows.Count: > 0 };

    static string Bool(bool? v) {
        return v == true ? "true" : "false";
    }

    static bool? ParseTriState(string v) {
        return v switch {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    void ToggleExpand(RouteRow row) {
        if (_expandedPath == row.Path) {
            _expandedPath = null;
            return;
        }

        _expandedPath = row.Path;
        _msg = null;
        SeedDrafts(row);
    }

    void SeedDrafts(RouteRow row) {
        _draftRequest = row.Override?.Request ?? row.Effective?.Request ?? "";
        _draftResponse = row.Override?.Response ?? row.Effective?.Response ?? "";
        _draftRequestWrapped = Bool(row.Override?.RequestWrapped ?? row.Effective?.RequestWrapped);
        _draftResponseWrapped = Bool(row.Override?.ResponseWrapped ?? row.Effective?.ResponseWrapped);
        _draftPathParam = Bool(row.Override?.PathParam ?? row.Effective?.PathParam);
    }

    async Task LoadMessages() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/inspector/messages");
        if (res.Ok) _messages = res.Json<List<string>>() ?? [];
    }

    async Task LoadRoutes() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/routes");
        if (res.Ok) _rows = res.Json<List<RouteRow>>() ?? [];
        else _msg = $"load routes failed: {res.Describe()}";

        _loading = false;
    }

    async Task LoadBinary() {
        if (Api is null) return;
        _binaryUnavailable = false;
        var res = await Api.GetAsync("/api/admin/routes/binary");
        if (res.Status == 503) {
            _binaryUnavailable = true;
            _binary = null;
            return;
        }

        _binary = res.Ok ? res.Json<BinaryStatus>() : null;
    }

    async Task RefreshBinary() {
        if (Api is null) return;
        _refreshing = true;
        _msg = null;
        StateHasChanged();
        var res = await Api.PostAsync("/api/admin/routes/binary/refresh");
        if (res.Status == 503) {
            _msg = "refresh unavailable (no database)";
        } else if (res.Ok) {
            var d = res.Json<RefreshResult>();
            _msg = d is null
                ? "refresh complete"
                : $"refresh complete: {d.Discovered} discovered, {d.New} new, {d.DriftCount} drift" +
                  (string.IsNullOrEmpty(d.Note) ? "" : $" ({d.Note})");
        } else {
            _msg = $"refresh failed: {res.Describe()}";
        }

        await LoadBinary();
        await LoadRoutes();
        _refreshing = false;
    }

    async Task Save(RouteRow row) {
        if (Api is null) return;
        var body = new UpsertBody(
            string.IsNullOrWhiteSpace(_draftRequest) ? null : _draftRequest,
            string.IsNullOrWhiteSpace(_draftResponse) ? null : _draftResponse,
            ParseTriState(_draftRequestWrapped),
            ParseTriState(_draftResponseWrapped),
            ParseTriState(_draftPathParam));

        if (body.Request is null && body.Response is null && body.RequestWrapped is null
            && body.ResponseWrapped is null && body.PathParam is null) {
            _msg = "nothing to save; set at least one field or use Reset";
            return;
        }

        _busy = true;
        _msg = null;
        var res = await Api.PutJsonAsync($"/api/admin/routes/{row.Path}", body);
        _msg = res.Ok ? $"saved {row.Path}" : $"save failed: {res.Describe()}";
        if (res.Ok) _expandedPath = null;
        await LoadRoutes();
        await LoadBinary();
        _busy = false;
    }

    async Task Clear(string path) {
        if (Api is null) return;
        _busy = true;
        _msg = null;
        var res = await Api.DeleteAsync($"/api/admin/routes/{path}");
        _msg = res.Ok ? $"cleared {path}" : $"clear failed: {res.Describe()}";
        if (res.Ok) _expandedPath = null;
        await LoadRoutes();
        await LoadBinary();
        _busy = false;
    }

    async Task ApplyDrift(DriftRow d) {
        if (Api is null || d.BinaryValue is null || !bool.TryParse(d.BinaryValue, out var value)) return;
        _busy = true;
        _msg = null;
        var row = _rows.FirstOrDefault(r => r.Path == d.Path);
        var current = row?.Override;
        var eff = row?.Effective;
        var body = new UpsertBody(
            current?.Request ?? eff?.Request,
            current?.Response ?? eff?.Response,
            d.Field == "requestWrapped" ? value : current?.RequestWrapped ?? eff?.RequestWrapped,
            d.Field == "responseWrapped" ? value : current?.ResponseWrapped ?? eff?.ResponseWrapped,
            current?.PathParam ?? eff?.PathParam);
        var res = await Api.PutJsonAsync($"/api/admin/routes/{d.Path}", body);
        _msg = res.Ok ? $"applied {d.Field} for {d.Path}" : $"apply failed: {res.Describe()}";
        await LoadRoutes();
        await LoadBinary();
        if (_expandedPath == d.Path && _rows.FirstOrDefault(r => r.Path == d.Path) is { } fresh) {
            SeedDrafts(fresh);
        }

        _busy = false;
    }

    record RouteRow(string Path, string Source, EffectiveInfo? Effective, OverrideInfo? Override);

    record EffectiveInfo(string? Request, string? Response, bool RequestWrapped, bool ResponseWrapped, bool PathParam);

    record OverrideInfo(
        string? Request,
        string? Response,
        bool? RequestWrapped,
        bool? ResponseWrapped,
        bool? PathParam,
        DateTimeOffset UpdatedAt,
        Guid? UpdatedBy);

    record BinaryStatus(
        DateTimeOffset? LastRefresh,
        string? BinaryVersion,
        int Discovered,
        int NewCount,
        int DriftCount,
        List<BinaryRow> Rows,
        List<DriftRow> Drift);

    record BinaryRow(
        string Path,
        string? Method,
        string? Request,
        string? Response,
        bool RequestWrapped,
        bool ResponseWrapped,
        string? BinaryVersion,
        DateTimeOffset RefreshedAt);

    record DriftRow(string Path, string Field, string? EffectiveValue, string? BinaryValue, bool Reliable);

    record RefreshResult(int Discovered, int New, int DriftCount, string? BinaryVersion, string? Note);

    record UpsertBody(string? Request, string? Response, bool? RequestWrapped, bool? ResponseWrapped, bool? PathParam);

}
