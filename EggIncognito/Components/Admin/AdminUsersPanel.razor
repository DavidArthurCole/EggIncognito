@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.AdminUi
@using EggIncognito.Services.Assets
@inherits AdminPaneBase

<div class="admin-pane-head">
    <h2 class="admin-pane-title">Users</h2>
    <span class="text-muted text-xs">@_users.Count total @((MarkupString)(_users.Count == 0 ? "" : " &middot; " + RoleBreakdown()))</span>
</div>
<PaneNotice @ref="_notice"/>
<div class="reg-wrap admin-users-scroll">
    <table class="data-table admin-users-table">
        <thead>
        <tr>
            <th>User</th><th>OIDC Sources</th><th>Role</th><th>Last login</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var u in _users) {
            <tr>
                <td class="font-medium">@u.Username</td>
                <td>
                    @{ var provs = u.Providers ?? []; }
                    <div class="oidc-sources">
                        @if (provs.Count == 0) {
                            <span class="text-muted text-xs">none</span>
                        } else {
                            @foreach (var p in provs) {
                                <span class="oidc-icon"><Icon Name="@ProviderIcon(p)" Class="icon-sm" Icons="@ProviderGlyphs.Overrides"/></span>
                            }
                        }
                    </div>
                </td>
                <td>
                    <select class="reg-filter-input w-auto" value="@u.Role" @onchange="e => SetRole(u.DiscordId, (string?)e.Value)">
                        @foreach (var role in Roles) {
                            <option value="@role">@role</option>
                        }
                    </select>
                </td>
                <td class="text-muted text-xs">@u.LastLoginAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    static readonly string[] Roles = Enum.GetValues<UserRole>().Select(UserRoles.ToName).ToArray();

    PaneNotice? _notice;
    List<UserRow> _users = [];

    protected override IReadOnlyList<string> Topics => [AdminTopics.Users];

    protected override Task LoadAsync() => LoadUsers();

    string RoleBreakdown() {
        var counts = _users.GroupBy(u => u.Role).ToDictionary(g => g.Key, g => g.Count());
        var parts = Enum.GetValues<UserRole>()
            .OrderByDescending(r => r)
            .Select(UserRoles.ToName)
            .Where(counts.ContainsKey)
            .Select(n => $"{counts[n]} {n}");
        return string.Join(" &middot; ", parts);
    }

    async Task LoadUsers() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/users");
        _users = res.Ok ? res.Json<List<UserRow>>() ?? [] : [];
        if (!res.Ok) _notice?.Fail($"load users failed: {res.Describe()}");
    }

    async Task SetRole(string discordId, string? role) {
        if (Api is null || string.IsNullOrEmpty(role)) return;
        var res = await Api.PostJsonAsync($"/api/admin/users/{discordId}/role", new { role });
        if (!res.Ok) {
            _notice?.Fail(res.Describe());
            return;
        }

        var d = res.Json<SetRoleResult>();
        var i = _users.FindIndex(x => x.DiscordId == discordId);
        if (i >= 0 && d is not null) _users[i] = _users[i] with { Role = d.Role };
        _notice?.Ok($"set {discordId} -> {d?.Role}");
        Notifier.Publish(AdminTopics.Users);
    }

    static string ProviderIcon(string provider) => provider is "microsoft" ? "brand-microsoft" : provider is "discord" or "google" or "github" ? $"brand-{provider}" : "circle";

}
