@rendermode @(RenderMode.InteractiveServer)
@inherits BrowserApiComponentBase
@implements IDisposable

<section class="panel mb-4">
    <div class="admin-panel-head">
        <h2 class="admin-panel-title">Devices</h2>
        <div class="flex gap-1 items-center">
            <select class="reg-filter-input w-auto" value="@_hours" @onchange="OnWindowChanged">
                <option value="24">24h</option>
                <option value="168">7d</option>
            </select>
            <span class="text-muted text-xs">@_rows.Count total</span>
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="Load">Refresh</button>
        </div>
    </div>
    @if (_rows.Count == 0) {
        <p class="text-muted text-sm m-0">No devices declared.</p>
    } else {
        <div class="flex flex-col gap-2">
            @foreach (var d in _rows) {
                <div class="env-box">
                    <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                        <span class="@(d.LatestProbe?.Reachable == true ? "text-green-400" : "text-red-400") shrink-0">
                            <Icon Name="@PlatformIcon(d.Platform)" Class="icon-sm"/>
                        </span>
                        <span class="font-semibold text-sm">@d.Label</span>
                        @if (d.LatestProbe is { } headProbe) {
                            <span class="text-xs text-muted">@headProbe.Result</span>
                        }
                        @if (!d.Enabled) {
                            <span class="text-muted text-xs">(disabled)</span>
                        }
                        <span class="flex-1"></span>
                        <button type="button" class="btn-mini" disabled="@IsBusy(d.Id)" @onclick="() => ProbeNow(d.Id)">Probe now</button>
                    </div>

                    <div class="flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-muted mb-1.5">
                        <span>reachable @d.Stats.ReachablePct% (@d.Stats.ReachableCount/@d.Stats.Total)</span>
                        <span>failures in a row @d.Stats.ConsecutiveFailures</span>
                        <span>last ok @FormatLocal(d.Stats.LastSuccessAt)</span>
                        <span>last fail @FormatLocal(d.Stats.LastFailureAt)</span>
                    </div>

                    @if (d.LatestProbe is { Note: { Length: > 0 } } lp) {
                        <div class="mono text-xs @(lp.Reachable ? "text-muted" : "text-red-400") mb-1.5">@lp.Note</div>
                    }

                    <div class="text-xs mb-1.5">
                        <span class="mono">@(d.Versions.Installed ?? "?")</span>
                        <span class="text-muted"> | registry </span>
                        <span class="mono">@(d.Versions.RegistryLatest ?? "?")</span>
                        <span class="text-muted"> | store </span>
                        <span class="mono @(d.Versions.StoreAhead ? "text-yellow-400" : "")">@(d.Versions.StoreLatest ?? "?")</span>
                        <span class="text-muted"> | cv </span>
                        <span class="mono">@(d.Versions.ClientVersion?.ToString() ?? "?")</span>
                    </div>

                    @if (d.Capture is { } cap) {
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs mb-1.5">
                            <span class="@cap.Verdict.Color font-semibold">@cap.Verdict.Label</span>
                            <span class="text-muted">@cap.Verdict.Detail</span>
                            <span class="mono text-muted">flows @cap.Flows</span>
                            <span class="mono text-muted">rinfo @cap.RinfoHarvests</span>
                            <a class="btn-mini no-underline" href="/capture/device/@d.Id">live view</a>
                        </div>
                    }

                    <div class="flex gap-3 text-xs">
                        <span class="cursor-pointer text-accent" @onclick="() => ToggleProbes(d.Id)">
                            @(IsProbesOpen(d.Id) ? "hide probes" : "show probes") (@d.ProbeHistory.Count)
                        </span>
                        <span class="cursor-pointer text-accent" @onclick="() => ToggleUpdates(d.Id)">
                            @(IsUpdatesOpen(d.Id) ? "hide updates" : "show updates") (@d.Updates.Recent.Count)
                        </span>
                    </div>

                    @if (IsProbesOpen(d.Id)) {
                        <div class="reg-wrap mt-1.5">
                            <table class="data-table">
                                <thead>
                                <tr>
                                    <th>Time</th><th>Reachable</th><th>Result</th><th>Trigger</th><th>Note</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var p in d.ProbeHistory) {
                                    <tr>
                                        <td class="mono text-xs">@FormatLocalShort(p.ProbedAt)</td>
                                        <td class="@(p.Reachable ? "text-green-400" : "text-red-400") text-xs">@p.Reachable</td>
                                        <td class="text-xs">@p.Result</td>
                                        <td class="text-xs">@p.TriggeredBy</td>
                                        <td class="mono text-xs">@p.Note</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (IsUpdatesOpen(d.Id)) {
                        <div class="reg-wrap mt-1.5">
                            <table class="data-table">
                                <thead>
                                <tr>
                                    <th>Time</th><th>Status</th><th>From</th><th>To</th><th>Trigger</th><th>Note</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var u in d.Updates.Recent) {
                                    <tr>
                                        <td class="mono text-xs">@FormatLocalShort(u.AttemptedAt)</td>
                                        <td class="text-xs">@u.Status</td>
                                        <td class="mono text-xs">@(u.FromVersion ?? "?")</td>
                                        <td class="mono text-xs">@(u.ToVersion ?? "?")</td>
                                        <td class="text-xs">@u.TriggeredBy</td>
                                        <td class="mono text-xs">@u.Note</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (_msg is not null) {
        <StatusNote>@_msg</StatusNote>
    }
</section>

@code {
    List<DeviceStatsRow> _rows = [];
    readonly HashSet<string> _probeBusy = [];
    readonly HashSet<string> _probesOpen = [];
    readonly HashSet<string> _updatesOpen = [];
    int _hours = 24;
    bool _busy;
    bool _disposed;
    string? _msg;
    Timer? _timer;

    protected override async Task OnApiReadyAsync() {
        await Load();
        _timer = new Timer(async _ => await InvokeAsync(TickAsync), null, 30_000, 30_000);
    }

    PageVisibility? _vis;

    PageVisibility Vis => _vis ??= new PageVisibility(Js, Env);

    async Task TickAsync() {
        if (_disposed || !await Vis.IsVisibleAsync()) return;
        await Load();
        StateHasChanged();
    }

    async Task OnWindowChanged(ChangeEventArgs e) {
        if (int.TryParse(e.Value?.ToString(), out var h)) _hours = h;
        await Load();
    }

    async Task Load() {
        if (Api is null) return;
        _busy = true;
        var res = await Api.GetAsync($"/api/admin/devices/stats?hours={_hours}");
        if (res.Ok) _rows = res.Json<List<DeviceStatsRow>>() ?? [];
        else _msg = $"load failed: {res.Describe()}";

        _busy = false;
        StateHasChanged();
    }

    bool IsBusy(string id) {
        return _probeBusy.Contains(id);
    }

    bool IsProbesOpen(string id) {
        return _probesOpen.Contains(id);
    }

    bool IsUpdatesOpen(string id) {
        return _updatesOpen.Contains(id);
    }

    void ToggleProbes(string id) {
        if (!_probesOpen.Remove(id)) _probesOpen.Add(id);
    }

    void ToggleUpdates(string id) {
        if (!_updatesOpen.Remove(id)) _updatesOpen.Add(id);
    }

    async Task ProbeNow(string id) {
        if (Api is null) return;
        _probeBusy.Add(id);
        _msg = null;
        StateHasChanged();
        var res = await Api.PostAsync($"/api/devices/{id}/refresh");
        _msg = res.Ok ? $"probed {id}" : $"probe failed: {res.Describe()}";
        await Load();
        _probeBusy.Remove(id);
        StateHasChanged();
    }

    static string PlatformIcon(string platform) {
        return platform switch {
            "ios" => "apple",
            "android" => "android",
            _ => "device"
        };
    }

    static string FormatLocal(DateTimeOffset? at) {
        return at is { } v ? v.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never";
    }

    static string FormatLocalShort(DateTimeOffset at) {
        return at.ToLocalTime().ToString("HH:mm:ss");
    }

    public void Dispose() {
        _disposed = true;
        _timer?.Dispose();
        _ = _vis?.DisposeAsync();
    }

    record DeviceStatsRow(
        string Id,
        string Platform,
        string Label,
        string Target,
        string Package,
        bool Enabled,
        ProbeInfo? LatestProbe,
        StatsInfo Stats,
        VersionsInfo Versions,
        UpdatesInfo Updates,
        List<ProbeHistoryRow> ProbeHistory,
        CaptureInfo? Capture,
        RinfoInfo? Rinfo);

    record ProbeInfo(
        DateTimeOffset ProbedAt,
        bool Reachable,
        string? InstalledAppVersion,
        string? InstalledBuild,
        string Result,
        string TriggeredBy,
        string? Note);

    record StatsInfo(
        int WindowHours,
        int Total,
        int ReachableCount,
        int ReachablePct,
        DateTimeOffset? LastSuccessAt,
        DateTimeOffset? LastFailureAt,
        int ConsecutiveFailures,
        Dictionary<string, int> ResultCounts);

    record VersionsInfo(
        string? Installed,
        string? InstalledBuild,
        string? RegistryLatest,
        string? StoreLatest,
        bool StoreAhead,
        int? ClientVersion);

    record UpdatesInfo(UpdateRow? Latest, List<UpdateRow> Recent);

    record UpdateRow(
        DateTimeOffset AttemptedAt,
        string? FromVersion,
        string? ToVersion,
        string Status,
        string? Note,
        string TriggeredBy);

    record ProbeHistoryRow(DateTimeOffset ProbedAt, bool Reachable, string Result, string TriggeredBy, string? Note);

    record CaptureInfo(
        bool Listening,
        int Port,
        long ClientConnects,
        long AuxbrainConnects,
        long Flows,
        long RinfoHarvests,
        string? LastDecryptError,
        VerdictInfo Verdict);

    record VerdictInfo(string Label, string Color, string Detail);

    record RinfoInfo(string? Version, string? Build, int? ClientVersion, string LastSeen);

}
