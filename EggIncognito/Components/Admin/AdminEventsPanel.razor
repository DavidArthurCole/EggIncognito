@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Events
@using EggIncognito.Services.Events
@inherits AdminPaneBase

<div class="admin-pane-head">
    <h2 class="admin-pane-title">Events</h2>
    <span class="text-muted text-xs">@StatText</span>
</div>
<div class="sub-section-head">Store</div>
<div class="reg-wrap">
    <table class="data-table">
        <tbody>
        <tr>
            <td>total</td><td class="mono">@(_stats?.Total ?? 0)</td>
        </tr>
        <tr>
            <td>device</td><td class="mono">@(_stats?.Device ?? 0)</td>
        </tr>
        <tr>
            <td>carpet</td><td class="mono">@(_stats?.Carpet ?? 0)</td>
        </tr>
        </tbody>
    </table>
</div>
@if (_latest.Count > 0) {
    <div class="sub-section-head">Recent</div>
    <div class="reg-wrap">
        <table class="data-table">
            <tbody>
            @foreach (var e in _latest) {
                <tr>
                    <td>@e.Type</td><td class="text-muted text-xs">@FormatStart(e.StartTimestamp)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<div class="text-xs text-muted mt-2">Historical data courtesy of carpetsage/egg. Backfill tools live in the Maintenance pane.</div>
@if (_msg is not null) {
    <StatusNote>@_msg</StatusNote>
}

@code {
    EventStatsResponse? _stats;
    List<GameEventDto> _latest = [];
    string? _msg;

    string StatText => _stats is null ? "" : $"{_stats.Total} total, {_stats.Device} device, {_stats.Carpet} carpet";

    static string FormatStart(double startTimestamp) {
        return UnixSeconds.ToTime(startTimestamp).ToLocalTime().ToString("yyyy-MM-dd");
    }

    protected override IReadOnlyList<string> Topics => [AdminTopics.Events];

    protected override Task LoadAsync() => Load();

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/events/stats");
        if (!res.Ok) {
            _msg = $"load failed: {res.Describe()}";
            return;
        }

        _stats = res.Json<EventStatsResponse>();

        var latestRes = await Api.GetAsync("/api/v1/events?limit=3");
        _latest = latestRes.Ok ? latestRes.Json<GameEventListResponse>()?.Events.ToList() ?? [] : [];
    }

}
