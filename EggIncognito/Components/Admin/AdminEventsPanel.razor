@rendermode @(RenderMode.InteractiveServer)
@using EggIncognito.Models.Events
@using EggIncognito.Services.Events
@inherits BrowserApiComponentBase

<AdminCard Title="Events" Stat="@StatText" OnOpened="Load">
    <Summary>
        @if (_stats is null || _stats.Total == 0) {
            <div class="text-sm text-muted">
                <span>no events stored</span>
            </div>
        } else {
            <div class="text-xs text-muted">@((MarkupString)TotalsBySource())</div>
            @foreach (var e in _latest) {
                <div class="admin-card-extra text-xs text-muted">@e.Type &middot; @FormatStart(e.StartTimestamp)</div>
            }
        }
    </Summary>
    <Detail>
        <div class="sub-section-head">Store</div>
        <div class="reg-wrap">
            <table class="data-table">
                <tbody>
                <tr>
                    <td>total</td><td class="mono">@(_stats?.Total ?? 0)</td>
                </tr>
                <tr>
                    <td>device</td><td class="mono">@(_stats?.Device ?? 0)</td>
                </tr>
                <tr>
                    <td>carpet</td><td class="mono">@(_stats?.Carpet ?? 0)</td>
                </tr>
                </tbody>
            </table>
        </div>
        <div class="text-xs text-muted">Historical data courtesy of carpetsage/egg. Backfill tools live in the Maintenance card.</div>
        @if (_msg is not null) {
            <StatusNote>@_msg</StatusNote>
        }
    </Detail>
</AdminCard>

@code {
    EventStatsResponse? _stats;
    List<GameEventDto> _latest = [];
    string? _msg;

    string StatText => _stats?.Total.ToString() ?? "";

    string TotalsBySource() {
        return _stats is null ? "" : $"{_stats.Total} total &middot; {_stats.Device} device &middot; {_stats.Carpet} carpet";
    }

    static string FormatStart(double startTimestamp) {
        return UnixSeconds.ToTime(startTimestamp).ToLocalTime().ToString("yyyy-MM-dd");
    }

    protected override async Task OnApiReadyAsync() {
        await Load();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/events/stats");
        if (!res.Ok) {
            _msg = $"load failed: {res.Describe()}";
            return;
        }

        _stats = res.Json<EventStatsResponse>();

        var latestRes = await Api.GetAsync("/api/v1/events?limit=3");
        _latest = latestRes.Ok ? latestRes.Json<GameEventListResponse>()?.Events.ToList() ?? [] : [];
    }

}
