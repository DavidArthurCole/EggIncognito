@rendermode @(RenderMode.InteractiveServer)
@using EggIncognito.Models.Events
@using EggIncognito.Services.Events
@inherits BrowserApiComponentBase

<AdminCard Title="Events" Stat="@StatText" OnOpened="Load">
    <Summary>
        @if (_stats is null || _stats.Total == 0) {
            <div class="text-sm text-muted">
                <span>no events stored</span>
            </div>
        } else {
            <div class="text-xs text-muted">@((MarkupString)TotalsBySource())</div>
            @foreach (var e in _latest) {
                <div class="admin-card-extra text-xs text-muted">@e.Type &middot; @FormatStart(e.StartTimestamp)</div>
            }
        }
    </Summary>
    <Detail>
        <div class="sub-section-head">Store</div>
        <div class="reg-wrap">
            <table class="data-table">
                <tbody>
                <tr>
                    <td>total</td><td class="mono">@(_stats?.Total ?? 0)</td>
                </tr>
                <tr>
                    <td>device</td><td class="mono">@(_stats?.Device ?? 0)</td>
                </tr>
                <tr>
                    <td>carpet</td><td class="mono">@(_stats?.Carpet ?? 0)</td>
                </tr>
                </tbody>
            </table>
        </div>
        <div class="sub-section-head">Backfill</div>
        <div class="flex gap-1 items-center">
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="Sweep">Sweep stored snapshots</button>
        </div>
        <div class="flex gap-1 items-center">
            <input class="reg-filter-input w-auto" @bind="_url" placeholder="@CarpetPlaceholder"/>
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="ImportCarpet">Import carpet history</button>
        </div>
        <div class="text-xs text-muted">Historical data courtesy of carpetsage/egg.</div>
        @if (_msg is not null) {
            <StatusNote>@_msg</StatusNote>
        }
    </Detail>
</AdminCard>

@code {
    EventStatsResponse? _stats;
    List<GameEventDto> _latest = [];
    string _url = "";
    string? _msg;
    bool _busy;

    string StatText => _stats?.Total.ToString() ?? "";

    string TotalsBySource() {
        return _stats is null ? "" : $"{_stats.Total} total &middot; {_stats.Device} device &middot; {_stats.Carpet} carpet";
    }

    static string FormatStart(double startTimestamp) {
        return UnixSeconds.ToTime(startTimestamp).ToLocalTime().ToString("yyyy-MM-dd");
    }

    static string CarpetPlaceholder =>
        "https://raw.githubusercontent.com/carpetsage/egg/master/periodicals/data/events.json";

    protected override async Task OnApiReadyAsync() {
        await Load();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/events/stats");
        if (!res.Ok) {
            _msg = $"load failed: {res.Describe()}";
            return;
        }

        _stats = res.Json<EventStatsResponse>();

        var latestRes = await Api.GetAsync("/api/v1/events?limit=3");
        _latest = latestRes.Ok ? latestRes.Json<GameEventListResponse>()?.Events.ToList() ?? [] : [];
    }

    async Task Sweep() {
        if (Api is null) return;
        _busy = true;
        _msg = null;
        var res = await Api.PostAsync("/api/admin/events/sweep-snapshots", TimeSpan.FromMinutes(10));
        _msg = res.Ok ? Describe(res.Json<EventBackfillResult>()) : $"sweep failed: {res.Describe()}";
        await Load();
        _busy = false;
    }

    async Task ImportCarpet() {
        if (Api is null) return;
        _busy = true;
        _msg = null;
        var res = await Api.PostJsonAsync(
            "/api/admin/events/import-carpet", new CarpetImportRequest(_url), TimeSpan.FromMinutes(10));
        _msg = res.Ok ? Describe(res.Json<EventBackfillResult>()) : $"import failed: {res.Describe()}";
        await Load();
        _busy = false;
    }

    static string Describe(EventBackfillResult? r) {
        return r is null ? "done" : $"scanned {r.Scanned}, inserted {r.Inserted}, updated {r.Updated}, skipped {r.Skipped}";
    }

}
