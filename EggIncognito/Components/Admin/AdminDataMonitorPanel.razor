@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@implements IDisposable

<section class="panel mb-4">
  <div class="admin-panel-head">
    <h2 class="admin-panel-title">Served data</h2>
    <span class="text-muted text-xs">game-effect + periodicals freshness</span>
  </div>

  @if (_status is null)
  {
    <p class="text-muted text-sm m-0">Loading…</p>
  }
  else
  {
    <div class="data-mon-group">
      <div class="data-mon-head">Game data <span class="text-muted">(GameData nupkg, by id)</span></div>
      <div class="reg-wrap">
        <table class="reg-table">
          <thead><tr><th>Family</th><th class="text-right">Rows</th><th>Provenance</th></tr></thead>
          <tbody>
            @foreach (var g in _status.GameData)
            {
              var p = Prov(g.Provenance);
              <tr>
                <td class="font-medium">@g.Key</td>
                <td class="text-right mono">@g.Count</td>
                <td>
                  <span class="prov-chip @p.Cls">@p.Label</span>
                  @if (!string.IsNullOrEmpty(g.Provenance)) { <span class="text-muted text-xs mono" title="@g.Provenance">@Short(g.Provenance)</span> }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="data-mon-group">
      <div class="data-mon-head">Config store <span class="text-muted">(DLCCatalog per platform)</span></div>
      @if (!_status.Config.Enabled)
      {
        <p class="text-muted text-xs m-0">Not configured (no <code class="code-chip">ConfigStore:Dir</code> / <code class="code-chip">ShipAssets:OutputDir</code>).</p>
      }
      else if (_status.Config.Platforms.Count == 0)
      {
        <p class="text-muted text-xs m-0">Enabled, nothing stored yet.</p>
      }
      else
      {
        <div class="reg-wrap">
          <table class="reg-table">
            <thead><tr><th>Platform</th><th class="text-right">Size</th><th>Stored</th></tr></thead>
            <tbody>
              @foreach (var c in _status.Config.Platforms)
              {
                <tr>
                  <td class="font-medium">@c.Platform</td>
                  <td class="text-right mono">@Kb(c.Bytes)</td>
                  <td class="text-muted text-xs">@c.SavedAt.ToLocalTime().ToString("g")</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>

    <div class="data-mon-group">
      <div class="data-mon-head">Endpoint fixtures <span class="text-muted">(ei/*.json served source-of-truth)</span></div>
      @if (_status.Fixtures.Count == 0)
      {
        <p class="text-muted text-xs m-0">No ei fixtures on disk.</p>
      }
      else
      {
        <div class="reg-wrap" style="max-height:40vh;overflow:auto;">
          <table class="reg-table">
            <thead><tr><th>Endpoint</th><th class="text-right">Size</th><th>Updated</th><th>State</th></tr></thead>
            <tbody>
              @foreach (var f in _status.Fixtures)
              {
                <tr>
                  <td class="mono text-xs">@f.Name</td>
                  <td class="text-right mono">@Kb(f.Bytes)</td>
                  <td class="text-muted text-xs">@f.UpdatedAt.ToLocalTime().ToString("g")</td>
                  <td><span class="@StatusCls(f.Status)">@f.Status</span></td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  }
</section>

@code {
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }

    static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new(System.Text.Json.JsonSerializerDefaults.Web);

    DataStatus? _status;
    System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync() => await Load();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _timer = new System.Threading.Timer(async _ => await InvokeAsync(async () => { await Load(); StateHasChanged(); }),
                null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    async Task Load()
    {
        if (ClientFactory is null) return;
        try { _status = await ClientFactory().GetFromJsonAsync<DataStatus>("/api/admin/data-status", JsonOpts); }
        catch { }
    }

    static string Kb(long bytes) => bytes >= 1024 ? $"{bytes / 1024}KB" : $"{bytes}B";

    static string Short(string prov)
    {
        var cut = prov.IndexOfAny([',', ';']);
        return cut > 0 ? prov[..cut] : prov;
    }

    static (string Label, string Cls) Prov(string p)
    {
        if (p.StartsWith("captured@", StringComparison.Ordinal)) return ("captured", "prov-captured");
        if (p.StartsWith("binary@", StringComparison.Ordinal)) return ("binary", "prov-binary");
        if (p.StartsWith("extracted@", StringComparison.Ordinal)) return ("extracted", "prov-extracted");
        return (string.IsNullOrEmpty(p) ? "unknown" : "mixed", "prov-unknown");
    }

    static string StatusCls(string s) => s switch
    {
        "ok" => "text-xs text-ok",
        "empty" => "text-xs text-muted",
        _ => "text-xs text-err",
    };

    public void Dispose() => _timer?.Dispose();

    record DataStatus(List<GdRow> GameData, ConfigInfo Config, List<FixtureRow> Fixtures);
    record GdRow(string Key, int Count, string Provenance);
    record ConfigInfo(bool Enabled, List<PlatformRow> Platforms);
    record PlatformRow(string Platform, DateTimeOffset SavedAt, long Bytes);
    record FixtureRow(string Name, long Bytes, DateTimeOffset UpdatedAt, string Status);
}
