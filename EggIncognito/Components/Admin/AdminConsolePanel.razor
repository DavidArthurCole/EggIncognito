@using System.Text
@using System.Text.Json
@rendermode @(RenderMode.InteractiveServer)

<section class="panel mb-4">
    <div class="admin-panel-head">
        <h2 class="admin-panel-title">API console</h2>
        <span class="text-muted text-xs">@_endpoints.Count endpoints</span>
    </div>

    @if (_endpoints.Count == 0) {
        <p class="text-muted text-sm m-0">No endpoints available.</p>
    } else {
        <select class="reg-filter-input w-full" @onchange="OnSelect">
            <option value="">Pick an endpoint…</option>
            @foreach (var group in Grouped()) {
                <optgroup label="@group.Key">
                    @foreach (var e in group) {
                        <option value="@Key(e)" selected="@(_selected == e)">@e.Method @ShortRoute(e.Route)</option>
                    }
                </optgroup>
            }
        </select>

        @if (_selected is not null) {
            <div class="mt-2 mb-2">
                <span class="console-method console-@(_selected.Method.ToLower())">@_selected.Method</span>
                <span class="font-mono text-xs break-all">@_selected.Route</span>
            </div>

            @foreach (var p in _selected.Query) {
                <label class="block text-xs text-muted mt-1">
                    @p.Name <span class="opacity-60">(@p.Source, @p.Type)</span>
                    <input class="reg-filter-input w-full" @bind="_paramValues[p.Name]"/>
                </label>
            }

            @if (_selected.HasFile) {
                <div class="settings-title mt-2">File</div>
                <InputFile OnChange="OnFile" class="text-xs"/>
                @if (_fileName is not null) {
                    <div class="text-xs text-muted">@_fileName (@(_fileBytes?.Length ?? 0) bytes)</div>
                }
            }

            @if (_selected.HasBody) {
                <div class="settings-title mt-2">JSON body @(_selected.BodyType is not null ? $"({_selected.BodyType})" : "")</div>
                <textarea class="reg-filter-input w-full font-mono text-xs" rows="4" @bind="_body" placeholder="{ }"></textarea>
            }

            <button class="btn-primary mt-2" @onclick="Send" disabled="@_busy">@(_busy ? "Sending…" : "Send")</button>

            @if (_status is not null) {
                <div class="mt-2 text-xs @(_ok ? "text-muted" : "err")">@_statusLine</div>
                @if (_isBinary) {
                    <div class="text-xs text-muted mt-1">Binary response (@_respBytes bytes). <a class="underline" href="@_blobUrl" download="@_downloadName">Download</a></div>
                } else {
                    <pre class="result-pre mt-1" style="max-height:40vh;overflow:auto;">@_response</pre>
                }
            }
        }
    }
</section>

@code {
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }

    List<Endpoint> _endpoints = [];
    Endpoint? _selected;

    readonly Dictionary<string, string?> _paramValues = new(StringComparer.Ordinal);
    string _body = "";
    byte[]? _fileBytes;
    string? _fileName;

    bool _busy, _ok, _isBinary;
    int? _status;
    string? _statusLine;
    string _response = "";
    long _respBytes;
    string? _blobUrl;
    string? _downloadName;

    protected override async Task OnInitializedAsync() {
        if (ClientFactory is null) return;
        try {
            var res = await ClientFactory().GetFromJsonAsync<EndpointList>("/api/console/endpoints");
            _endpoints = res?.Endpoints?.ToList() ?? [];
        }
        catch {
            _endpoints = [];
        }
    }

    IEnumerable<IGrouping<string, Endpoint>> Grouped() {
        return _endpoints.GroupBy(Namespace).OrderBy(g => g.Key, StringComparer.Ordinal);
    }

    static string Namespace(Endpoint e) {
        var parts = e.Route.TrimStart('/').Split('/');
        return parts.Length >= 2 && parts[0] == "api" ? parts[1] : parts.ElementAtOrDefault(0) ?? "api";
    }

    static string ShortRoute(string route) {
        var parts = route.TrimStart('/').Split('/');
        return parts.Length > 2 && parts[0] == "api" ? "/" + string.Join('/', parts.Skip(2)) : route;
    }

    static string Key(Endpoint e) {
        return $"{e.Method} {e.Route}";
    }

    void OnSelect(ChangeEventArgs e) {
        var key = (string?)e.Value ?? "";
        Select(_endpoints.FirstOrDefault(x => Key(x) == key));
    }

    void Select(Endpoint? e) {
        _selected = e;
        _paramValues.Clear();
        if (e is not null)
            foreach (var p in e.Query)
                _paramValues[p.Name] = "";
        _body = "";
        _fileBytes = null;
        _fileName = null;
        _status = null;
        _statusLine = null;
        _response = "";
        _isBinary = false;
        _blobUrl = null;
    }

    async Task OnFile(InputFileChangeEventArgs e) {
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(200_000_000).CopyToAsync(ms);
        _fileBytes = ms.ToArray();
        _fileName = e.File.Name;
    }

    async Task Send() {
        if (_selected is null || ClientFactory is null) return;
        _busy = true;
        _status = null;
        _isBinary = false;
        _blobUrl = null;
        try {
            var route = _selected.Route;
            var query = new List<string>();
            foreach (var p in _selected.Query) {
                var v = _paramValues.GetValueOrDefault(p.Name) ?? "";
                if (p.Source == "Path") route = route.Replace($"{{{p.Name}}}", Uri.EscapeDataString(v));
                else if (!string.IsNullOrEmpty(v)) query.Add($"{Uri.EscapeDataString(p.Name)}={Uri.EscapeDataString(v)}");
            }

            if (query.Count > 0) route += "?" + string.Join("&", query);

            var req = new HttpRequestMessage(new HttpMethod(_selected.Method), route);
            if (_selected.HasFile && _fileBytes is not null) {
                var mp = new MultipartFormDataContent();
                mp.Add(new ByteArrayContent(_fileBytes), "file", _fileName ?? "file");
                req.Content = mp;
            } else if (_selected.HasBody && !string.IsNullOrWhiteSpace(_body)) {
                req.Content = new StringContent(_body, Encoding.UTF8, "application/json");
            }

            var res = await ClientFactory().SendAsync(req);
            _status = (int)res.StatusCode;
            _ok = res.IsSuccessStatusCode;
            var ctype = res.Content.Headers.ContentType?.MediaType ?? "";
            _statusLine = $"HTTP {_status} {res.ReasonPhrase} ({ctype})";

            if (ctype.StartsWith("application/json") || ctype.StartsWith("text/")) {
                _response = Pretty(await res.Content.ReadAsStringAsync());
            } else {
                var bytes = await res.Content.ReadAsByteArrayAsync();
                _respBytes = bytes.Length;
                _isBinary = true;
                _blobUrl = $"data:{ctype};base64,{Convert.ToBase64String(bytes)}";
                _downloadName = res.Content.Headers.ContentDisposition?.FileName?.Trim('"') ?? "response.bin";
            }
        }
        catch (Exception ex) {
            _ok = false;
            _statusLine = ex.Message;
            _response = "";
        }
        finally {
            _busy = false;
        }
    }

    static string Pretty(string json) {
        try {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch {
            return json;
        }
    }

    record Endpoint(string Method, string Route, List<ParamRow> Query, bool HasBody, string? BodyType, bool HasFile);

    record ParamRow(string Name, string Source, string Type, bool Required);

    record EndpointList(int Count, Endpoint[]? Endpoints);

}
