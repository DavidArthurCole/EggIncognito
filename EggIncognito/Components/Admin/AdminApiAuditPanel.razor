@* API audit: bucketed request counts (Internal / Cross / External) plus per-path, per-IP, and recent-request
   views. Polls the admin audit endpoints. In-process, resets on server restart. *@
@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@implements IDisposable

<section class="panel mb-4">
  <div class="admin-panel-head">
    <h2 class="admin-panel-title">API audit</h2>
    <span class="text-muted text-xs">in-process, resets on restart</span>
  </div>

  <div class="audit-buckets mb-3">
    <div class="audit-bucket">
      <span class="audit-bucket-label">Internal</span>
      <span class="audit-bucket-val" title="site calling its own API">@_buckets.Internal</span>
    </div>
    <div class="audit-bucket">
      <span class="audit-bucket-label">Cross</span>
      <span class="audit-bucket-val" title="a real browser / Blazor client of this site">@_buckets.Cross</span>
    </div>
    <div class="audit-bucket">
      <span class="audit-bucket-label">External</span>
      <span class="audit-bucket-val" title="Postman, game client, scripts, foreign origin">@_buckets.External</span>
    </div>
  </div>

  <div class="flex gap-2 mb-3">
    @foreach (var t in Tabs)
    {
      <button type="button" class="btn-mini @(_tab == t.Key ? "btn-primary" : "")" @onclick="() => _tab = t.Key">@t.Label</button>
    }
  </div>

  @if (_tab == "paths")
  {
    @if (_paths.Count == 0) { <p class="text-muted text-sm m-0">No API traffic yet.</p> }
    else
    {
      <div class="reg-wrap">
        <table class="reg-table">
          <thead><tr><th>Path</th><th>Total</th><th>Int</th><th>Cross</th><th>Ext</th><th>Last</th></tr></thead>
          <tbody>
            @foreach (var p in _paths)
            {
              <tr>
                <td class="mono text-xs">@p.Path</td>
                <td class="mono text-xs">@p.Total</td>
                <td class="mono text-xs text-muted">@p.Internal</td>
                <td class="mono text-xs text-muted">@p.Cross</td>
                <td class="mono text-xs @(p.External > 0 ? "text-yellow-400" : "text-muted")">@p.External</td>
                <td class="text-muted text-xs">@Ago(p.LastSeen)</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  }
  else if (_tab == "ips")
  {
    @if (_ips.Count == 0) { <p class="text-muted text-sm m-0">No client IPs seen yet.</p> }
    else
    {
      <div class="reg-wrap">
        <table class="reg-table">
          <thead><tr><th>IP</th><th>Requests</th><th>Distinct paths</th><th>Last</th></tr></thead>
          <tbody>
            @foreach (var ip in _ips)
            {
              <tr>
                <td class="mono text-xs">@ip.Ip</td>
                <td class="mono text-xs">@ip.Total</td>
                <td class="mono text-xs text-muted">@ip.DistinctPaths</td>
                <td class="text-muted text-xs">@Ago(ip.LastSeen)</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  }
  else
  {
    @if (_recent.Count == 0) { <p class="text-muted text-sm m-0">No recent requests.</p> }
    else
    {
      <div class="reg-wrap" style="max-height:40vh;overflow:auto;">
        <table class="reg-table">
          <thead><tr><th>Time</th><th>Method</th><th>Path</th><th>Status</th><th>Bucket</th><th>IP</th></tr></thead>
          <tbody>
            @foreach (var e in _recent)
            {
              <tr>
                <td class="text-muted text-xs">@e.Ts.ToLocalTime().ToString("HH:mm:ss")</td>
                <td class="mono text-xs">@e.Method</td>
                <td class="mono text-xs">@e.Path</td>
                <td class="mono text-xs @StatusClass(e.Status)">@e.Status</td>
                <td class="text-xs @BucketClass(e.Bucket)">@e.Bucket</td>
                <td class="mono text-xs text-muted">@e.Ip</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  }
</section>

@code {
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }

    static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new(System.Text.Json.JsonSerializerDefaults.Web);
    static readonly (string Key, string Label)[] Tabs = [("paths", "By path"), ("ips", "By IP"), ("recent", "Recent")];

    string _tab = "paths";
    Buckets _buckets = new(0, 0, 0, 0);
    List<PathRow> _paths = [];
    List<IpRow> _ips = [];
    List<RecentRow> _recent = [];
    System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync() => await Load();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _timer = new System.Threading.Timer(async _ => await InvokeAsync(async () => { await Load(); StateHasChanged(); }),
                null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    async Task Load()
    {
        if (ClientFactory is null) return;
        var c = ClientFactory();
        try { _buckets = await c.GetFromJsonAsync<Buckets>("/api/admin/audit/buckets", JsonOpts) ?? _buckets; } catch { }
        try { _paths = await c.GetFromJsonAsync<List<PathRow>>("/api/admin/audit/paths", JsonOpts) ?? []; } catch { }
        try { _ips = await c.GetFromJsonAsync<List<IpRow>>("/api/admin/audit/ips", JsonOpts) ?? []; } catch { }
        try { _recent = await c.GetFromJsonAsync<List<RecentRow>>("/api/admin/audit/recent?take=200", JsonOpts) ?? []; } catch { }
    }

    static string StatusClass(int s) => s >= 500 ? "text-err" : s == 429 ? "text-yellow-400" : s >= 400 ? "text-yellow-400" : "text-green-400";
    static string BucketClass(string b) => b switch
    {
        "Internal" => "text-muted",
        "Cross" => "text-accent2",
        _ => "text-yellow-400",
    };

    static string Ago(DateTimeOffset t)
    {
        var s = (DateTimeOffset.UtcNow - t).TotalSeconds;
        if (s < 0) s = 0;
        return s < 60 ? $"{(int)s}s ago" : s < 3600 ? $"{(int)(s / 60)}m ago" : $"{(int)(s / 3600)}h ago";
    }

    public void Dispose() => _timer?.Dispose();

    record Buckets(long Internal, long Cross, long External, long KeysCapped);
    record PathRow(string Path, long Total, long Internal, long Cross, long External, DateTimeOffset LastSeen);
    record IpRow(string Ip, long Total, int DistinctPaths, DateTimeOffset LastSeen);
    record RecentRow(DateTimeOffset Ts, string Method, string Path, int Status, string Bucket, string Ip, string? User);
}
