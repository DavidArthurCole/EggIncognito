@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Admin
@inherits BrowserApiComponentBase

<AdminCard Title="Data status" Stat="@StatText" OnOpened="Load">
    <Summary>
        @if (_data is null) {
            <div class="text-sm text-muted">no data</div>
        } else {
            <table class="data-table">
                <tbody>
                @{ var faceRows = _data.GameData.Take(6).ToList(); }
                @for (var i = 0; i < faceRows.Count; i++) {
                    var g = faceRows[i];
                    <tr class="@(i >= 3 ? "admin-card-extra" : "")">
                        <td>@g.Key</td><td class="mono">@g.Count</td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="text-xs text-muted">@_data.Missing.Count missing docs / config @(_data.Config.Enabled ? "on" : "off") / @_data.Fixtures.Count fixtures</div>
        }
    </Summary>
    <Detail>
        <div class="flex gap-1 items-center">
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="Load">Refresh</button>
        </div>
        @if (_data is not null) {
            <div class="sub-section-head">Game data families</div>
            <div class="reg-wrap">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Key</th><th>Count</th><th>Provenance</th><th>Game version</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var g in _data.GameData) {
                        <tr>
                            <td>@g.Key</td>
                            <td class="mono">@g.Count</td>
                            <td class="mono text-xs">@g.Provenance</td>
                            <td class="text-xs text-muted">@g.GameVersion</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="sub-section-head">Config platforms</div>
            <div class="reg-wrap">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Platform</th><th>Saved</th><th>Bytes</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (_data.Config.Platforms.Count == 0) {
                        <tr>
                            <td colspan="3" class="text-muted text-xs">no stored config</td>
                        </tr>
                    } else {
                        @foreach (var p in _data.Config.Platforms) {
                            <tr>
                                <td>@p.Platform</td>
                                <td class="text-xs">
                                    <TimeAgo Value="@p.SavedAt"/>
                                </td>
                                <td class="mono text-xs">@p.Bytes</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

            <div class="sub-section-head">Fixtures</div>
            <div class="reg-wrap">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Name</th><th>Bytes</th><th>Updated</th><th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var f in _data.Fixtures) {
                        <tr>
                            <td class="mono text-xs">@f.Name</td>
                            <td class="mono text-xs">@f.Bytes</td>
                            <td class="text-xs">
                                <TimeAgo Value="@f.UpdatedAt"/>
                            </td>
                            <td class="text-xs">@f.Status</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (_msg is not null) {
            <StatusNote>@_msg</StatusNote>
        }
    </Detail>
</AdminCard>

@code {
    DataStatusResponse? _data;
    bool _busy;
    string? _msg;

    string StatText => _data is null ? "" : $"{_data.GameData.Count} stores";

    protected override async Task OnApiReadyAsync() {
        await Load();
    }

    async Task Load() {
        if (Api is null) return;
        _busy = true;
        _msg = null;
        var res = await Api.GetAsync("/api/admin/data-status");
        if (!res.Ok) {
            _msg = $"load failed: {res.Describe()}";
            _busy = false;
            return;
        }

        _data = res.Json<DataStatusResponse>();
        _busy = false;
    }

}
