@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Core
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Devices
@inherits BrowserApiComponentBase

<div class="admin-pane-head">
    <h2 class="admin-pane-title">Virtual devices</h2>
    <span class="text-muted text-xs">@StatText</span>
</div>
<div class="vd-head">
            <div class="sub-section-head">Fleet</div>
            <div class="vd-head-meta text-xs text-muted">
                <span>@(_status?.LiveCount ?? 0) of @(_status?.MaxInstances ?? 0) live</span>
                <span class="mono">@(_status?.Kind ?? "?")</span>
                <span class="mono">@(_status?.Image ?? "?")</span>
            </div>
            <div class="vd-head-actions">
                <button type="button" class="btn-primary" disabled="@(_busy || _status?.Enabled != true)"
                        @onclick="Create">
                    Provision
                </button>
                <button type="button" class="btn-secondary" disabled="@_busy" @onclick="Reconcile">Reconcile</button>
                <button type="button" class="btn-secondary" disabled="@_busy" @onclick="Load">Refresh</button>
            </div>
        </div>

        @if (_status?.Note is { Length: > 0 } note) {
            <div class="text-xs text-muted">@note</div>
        }

        @if (_msg is { Length: > 0 }) {
            <StatusNote Severity="@_msgKind" OnDismiss="Clear">@_msg</StatusNote>
        }

        @if (_status is null || _status.Instances.Count == 0) {
            <div class="vd-empty text-sm text-muted">
                No instances provisioned. Provision one to get an Android container on the fleet host.
            </div>
        } else {
            <div class="vd-grid">
                @foreach (var i in _status.Instances) {
                    <div class="vd-card">
                        <div class="vd-card-head">
                            <span class="vd-dot @DotCss(i)"></span>
                            <span class="vd-id mono">@i.InstanceId</span>
                            <span class="vd-state">@StateLabel(i)</span>
                        </div>
                        <dl class="vd-facts">
                            <dt>target</dt>
                            <dd class="mono">@(i.Target ?? "no address yet")</dd>
                            <dt>device</dt>
                            <dd class="mono">@(i.DeviceId ?? "not registered")</dd>
                            <dt>capture</dt>
                            <dd>@FlowLine(i)</dd>
                            @if (i.DeviceId is { Length: > 0 } rid && _readiness.TryGetValue(rid, out var rr)) {
                                <dt>ready</dt>
                                <dd class="vd-ready">
                                    <span class="@ReadyCss(rr.GooglePlay)">GMS</span>
                                    <span class="@ReadyCss(rr.Rooted)">root</span>
                                    <span class="@ReadyCss(rr.IntegrityModule)">integrity</span>
                                </dd>
                            }
                            <dt>up</dt>
                            <dd>
                                <TimeAgo Value="@i.CreatedAt" Hover="false"/>
                            </dd>
                        </dl>
                        @if (i.Note is { Length: > 0 } rowNote) {
                            <div class="vd-note text-xs text-muted">@rowNote</div>
                        }
                        <div class="vd-card-actions">
                            @if (i.DeviceId is { Length: > 0 } did) {
                                <button type="button" class="btn-mini" disabled="@_busy"
                                        @onclick="() => OnConsole.InvokeAsync(did)">
                                    console
                                </button>
                            }
                            <button type="button" class="btn-mini btn-danger" disabled="@_busy"
                                    @onclick="() => Destroy(i.InstanceId)">
                                destroy
                            </button>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="vd-sub">
            <div class="sub-section-head">Images</div>
            @if (_images is { } iv) {
                <div class="vd-head-meta text-xs text-muted">
                    <span>active <span class="mono">@(iv.ActiveTag is { Length: > 0 } ? iv.ActiveTag : iv.ConfigImage)</span></span>
                    @if (!iv.DockerOk) {
                        <span class="text-err">docker unreachable</span>
                    }
                </div>
                @if (iv.Note is { Length: > 0 } inote) {
                    <div class="text-xs text-muted">@inote</div>
                }

                <div class="vd-build">
                    <input type="text" class="field-input" @bind="_buildVer" placeholder="11.0.0"/>
                    <label class="vd-check"><input type="checkbox" @bind="_gapps"/> gapps</label>
                    <label class="vd-check"><input type="checkbox" @bind="_magisk"/> magisk</label>
                    <label class="vd-check"><input type="checkbox" @bind="_ndk"/> ndk</label>
                    <button type="button" class="btn-primary" disabled="@(_busy || !iv.BuildEnabled)" @onclick="BuildImage">
                        Build
                    </button>
                </div>
                @if (!iv.BuildEnabled) {
                    <div class="text-xs text-muted">builds disabled (Devices:Virtual:Build:Enabled)</div>
                }

                @if (_build is { } b) {
                    <div class="vd-note text-xs @(b.State == ImageBuildStates.Failed ? "text-err" : "text-muted")">
                        build <span class="mono">@b.Tag</span>: @b.State@(b.Note is { Length: > 0 } bn ? $" - {bn}" : "")
                    </div>
                }

                @if (iv.Images.Count == 0) {
                    <div class="text-xs text-muted">no redroid images on this host</div>
                } else {
                    <div class="reg-wrap">
                        <table class="data-table">
                            <thead>
                            <tr>
                                <th>Tag</th><th>Size</th><th>Created</th><th></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var img in iv.Images) {
                                <tr class="@(img.Active ? "vd-row-active" : "")">
                                    <td class="mono text-xs">@(img.Tag ?? "none")</td>
                                    <td class="mono text-xs">@ByteFormat.Mb(img.Size, "F0")</td>
                                    <td class="text-muted text-xs">
                                        <TimeAgo Value="@img.Created" Hover="false"/>
                                    </td>
                                    <td class="vd-row-actions">
                                        @if (img.Tag is { Length: > 0 } t) {
                                            @if (!img.Active) {
                                                <button type="button" class="btn-mini" disabled="@_busy"
                                                        @onclick="() => UseImage(t)">
                                                    use
                                                </button>
                                            }

                                            <button type="button" class="btn-mini btn-danger" disabled="@_busy"
                                                    @onclick="() => RemoveImage(t)">
                                                remove
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            } else if (_imagesErr is { Length: > 0 } ierr) {
                <div class="text-xs text-muted">images unavailable: @ierr</div>
            } else {
                <div class="text-xs text-muted">loading</div>
            }
        </div>

        <div class="vd-sub">
            <div class="vd-head">
                <div class="sub-section-head">Integrity modules</div>
                <div class="vd-head-actions">
                    <button type="button" class="btn-secondary" disabled="@_busy" @onclick="RefreshModules">
                        Refresh cache
                    </button>
                </div>
            </div>
            @if (_modules is { Count: > 0 } mods) {
                <div class="reg-wrap">
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th>Module</th><th>Version</th><th>Size</th><th>Source</th><th>State</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var m in mods) {
                            <tr>
                                <td class="mono text-xs">@m.Name</td>
                                <td class="text-xs">@(m.Version ?? "?")</td>
                                <td class="mono text-xs">@ByteFormat.Mb(m.ByteSize, "F1")</td>
                                <td class="text-muted text-xs truncate">@m.Source</td>
                                <td class="text-xs @(m.Error is { Length: > 0 } ? "text-err" : "")">
                                    @(m.Error is { Length: > 0 } err ? err : m.Cached ? "cached" : "fetched")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            } else {
                <div class="text-xs text-muted">no modules cached yet</div>
            }
        </div>

@code {
    [Parameter] public EventCallback<string> OnConsole { get; set; }

    VirtualDevicesStatus? _status;
    readonly Dictionary<string, DeviceReadiness> _readiness = [];
    ImagesView? _images;
    string? _imagesErr;
    List<ModuleCacheRow>? _modules;
    ImageBuildStatusView? _build;
    string _buildVer = "11.0.0";
    bool _gapps = true;
    bool _magisk = true;
    bool _ndk = true;
    string? _msg;
    StatusNoteKind _msgKind = StatusNoteKind.Info;
    bool _busy;
    CancellationTokenSource? _loopCts;
    PageVisibility? _vis;

    PageVisibility Vis => _vis ??= new PageVisibility(Js, Env);

    string StatText => _status is null ? "" : $"{_status.LiveCount}/{_status.MaxInstances}";

    string StateLine() {
        if (_status is null || _status.ByState.Count == 0) return "no instances";
        return string.Join(", ", _status.ByState.OrderBy(p => p.Key, StringComparer.Ordinal)
            .Select(p => $"{p.Value} {p.Key}"));
    }

    static string FlowLine(VirtualInstanceRow row) {
        if (row.DeviceId is not { Length: > 0 }) return "not registered";
        if (row.Flows == 0) return "no flows yet";
        return row.LastFlowAt is { Length: > 0 } at ? $"{row.Flows} flows, last {at}" : $"{row.Flows} flows";
    }

    static string StateLabel(VirtualInstanceRow row) {
        return row.ContainerPresent ? row.State : $"{row.State}, no container";
    }

    static string ReadyCss(ReadinessCheck check) {
        return check.Ok ? "vd-ready-ok" : "vd-ready-no";
    }

    static string DotCss(VirtualInstanceRow row) {
        if (!row.ContainerPresent || row.State is "failed") return "vd-dot-bad";
        if (row.State is "ready") return "vd-dot-ready";
        return "vd-dot-busy";
    }

    protected override async Task OnApiReadyAsync() {
        await Load();
        _loopCts = new CancellationTokenSource();
        _ = RunLoopAsync(_loopCts.Token);
    }

    async Task RunLoopAsync(CancellationToken ct) {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try {
            while (await timer.WaitForNextTickAsync(ct)) {
                if (_busy || !await Vis.IsVisibleAsync()) continue;
                await Load(true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) {
        }
    }

    public override async ValueTask DisposeAsync() {
        if (_loopCts is not null) {
            await _loopCts.CancelAsync();
            _loopCts.Dispose();
        }

        if (_vis is not null) await _vis.DisposeAsync();
        await base.DisposeAsync();
    }

    Task Load() {
        return Load(false);
    }

    async Task Load(bool quiet) {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/devices/virtual");
        if (!res.Ok) {
            if (!quiet) Say($"load failed: {res.Describe()}", StatusNoteKind.Error);
            return;
        }

        _status = res.Json<VirtualDevicesStatus>();
        if (!quiet) {
            await LoadReadiness();
            await LoadImages();
            await LoadModules();
        }
    }

    async Task LoadImages() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/devices/virtual/images");
        if (res.Ok) {
            _images = res.Json<ImagesView>();
            _imagesErr = null;
        } else {
            _imagesErr = res.Describe();
        }
    }

    async Task LoadModules() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/devices/virtual/modules");
        if (res.Ok) _modules = res.Json<List<ModuleCacheRow>>();
    }

    async Task LoadReadiness() {
        if (Api is null || _status is null) return;
        _readiness.Clear();
        foreach (var i in _status.Instances) {
            if (i.DeviceId is not { Length: > 0 } did) continue;
            var res = await Api.GetAsync($"/api/devices/{did}/readiness");
            if (res.Ok && res.Json<DeviceReadiness>() is { } r) _readiness[did] = r;
        }
    }

    async Task Create() {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostJsonAsync("/api/devices/virtual", new VirtualCreateRequest(null),
                TimeSpan.FromMinutes(2));
            var body = res.Json<VirtualActionResult>();
            Say(res.Ok
                    ? $"provisioned {body?.InstanceId ?? "instance"}"
                    : $"provision failed: {body?.Note ?? res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        }
        finally {
            _busy = false;
        }

        await Load();
    }

    async Task Destroy(string instanceId) {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.DeleteAsync($"/api/devices/virtual/{instanceId}");
            var body = res.Json<VirtualActionResult>();
            Say(res.Ok ? $"destroyed {instanceId}" : $"destroy refused: {body?.Note ?? res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        }
        finally {
            _busy = false;
        }

        await Load();
    }

    async Task Reconcile() {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostAsync("/api/devices/virtual/reconcile", TimeSpan.FromMinutes(2));
            var body = res.Json<VirtualActionResult>();
            Say(res.Ok ? body?.Note ?? "reconciled" : $"reconcile failed: {res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        }
        finally {
            _busy = false;
        }

        await Load();
    }

    async Task BuildImage() {
        if (Api is null || _busy) return;
        _busy = true;
        _build = null;
        long? id = null;
        try {
            var req = new ImageBuildRequest(_buildVer, _gapps, _magisk, _ndk, null);
            var res = await Api.PostJsonAsync("/api/devices/virtual/images/build", req, TimeSpan.FromMinutes(2));
            var start = res.Json<ImageBuildStartResult>();
            if (!res.Ok || start is not { Ok: true, Id: { } sid }) {
                Say($"build refused: {start?.Note ?? res.Describe()}", StatusNoteKind.Error);
                return;
            }

            id = sid;
            Say($"build {start.Tag} started, running in the background", StatusNoteKind.Ok);
        }
        finally {
            _busy = false;
        }

        if (id is { } bid) _ = PollBuild(bid);
    }

    async Task PollBuild(long id) {
        for (var i = 0; i < 300; i++) {
            await Task.Delay(2000);
            if (Api is null) return;
            var res = await Api.GetAsync($"/api/devices/virtual/images/build/{id}");
            if (!res.Ok || res.Json<ImageBuildStatusView>() is not { } b) continue;

            _build = b;
            await InvokeAsync(StateHasChanged);
            if (!ImageBuildStates.IsTerminal(b.State)) continue;

            Say(b.State == ImageBuildStates.Ready ? $"image {b.Tag} built" : $"build failed: {b.Note ?? "see log"}",
                b.State == ImageBuildStates.Ready ? StatusNoteKind.Ok : StatusNoteKind.Error);
            await LoadImages();
            await InvokeAsync(StateHasChanged);
            return;
        }
    }

    async Task UseImage(string tag) {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostJsonAsync("/api/devices/virtual/images/use", new ImageUseRequest(tag));
            var body = res.Json<VirtualActionResult>();
            Say(res.Ok ? body?.Note ?? $"active image set to {tag}" : $"use failed: {res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        }
        finally {
            _busy = false;
        }

        await LoadImages();
    }

    async Task RemoveImage(string tag) {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostJsonAsync("/api/devices/virtual/images/remove", new ImageRemoveRequest(tag));
            var body = res.Json<VirtualActionResult>();
            Say(res.Ok ? $"removed {tag}" : $"remove refused: {body?.Note ?? res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        }
        finally {
            _busy = false;
        }

        await LoadImages();
    }

    async Task RefreshModules() {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostAsync("/api/devices/virtual/modules/refresh", TimeSpan.FromMinutes(2));
            if (res.Ok) {
                _modules = res.Json<List<ModuleCacheRow>>();
                Say("module cache refreshed", StatusNoteKind.Ok);
            } else {
                Say($"refresh failed: {res.Describe()}", StatusNoteKind.Error);
            }
        }
        finally {
            _busy = false;
        }
    }

    void Say(string message, StatusNoteKind kind) {
        _msg = message;
        _msgKind = kind;
    }

    void Clear() {
        _msg = null;
    }

}
