@rendermode @(RenderMode.InteractiveServer)
@using EggIncognito.Models.AdminUi
@using TableApiKeyRow = EggIncognito.Models.Admin.ApiKeyRow
@inherits BrowserApiComponentBase

<AdminCard Title="API keys" Stat="@($"{_rows.Count} total")">
    <Summary>
        @if (_rows.Count == 0) {
            <p class="text-muted text-sm m-0">no api keys</p>
        } else {
            <p class="text-muted text-xs m-0">@_rows.Count(k => !k.Revoked) active &middot; @_rows.Count(k => k.Revoked) revoked</p>
            @foreach (var k in RecentlyUsed) {
                <div class="admin-card-extra text-xs text-muted">@k.OwnerUserId &middot; @k.Prefix &middot; <TimeAgo Value="@k.LastUsedAt!.Value" Hover="false"/></div>
            }
        }
    </Summary>
    <Detail>
        @if (_rows.Count == 0) {
            <p class="text-muted text-sm m-0">no api keys</p>
        } else {
            <ApiKeysTable Rows="@TableRows" ShowOwner="true" Busy="_busy" OnRevoke="Revoke" OnDelete="Delete"/>
        }
        @if (_msg is not null) {
            <StatusNote>@_msg</StatusNote>
        }
    </Detail>
</AdminCard>

@code {
    List<ApiKeyRow> _rows = [];
    bool _busy;
    string? _msg;

    List<TableApiKeyRow> TableRows => _rows.Select(r => new TableApiKeyRow(r.Id, r.OwnerUserId, r.Name, r.Prefix, r.LastUsedAt, r.RequestCount, r.Revoked)).ToList();

    List<ApiKeyRow> RecentlyUsed => _rows.Where(k => k.LastUsedAt is not null).OrderByDescending(k => k.LastUsedAt).Take(3).ToList();

    protected override async Task OnApiReadyAsync() {
        await Load();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/api-keys");
        if (res.Ok) _rows = res.Json<List<ApiKeyRow>>() ?? [];
    }

    async Task Revoke(long id) {
        if (Api is null) return;
        _busy = true;
        _msg = null;
        var res = await Api.DeleteAsync($"/api/admin/api-keys/{id}");
        _msg = res.Ok ? $"revoked key {id}" : $"revoke failed: {res.Describe()}";
        await Load();
        _busy = false;
    }

    async Task Delete(long id) {
        if (Api is null) return;
        _busy = true;
        _msg = null;
        var res = await Api.DeleteAsync($"/api/admin/api-keys/{id}/purge");
        _msg = res.Ok ? $"deleted key {id}" : $"delete failed: {res.Describe()}";
        await Load();
        _busy = false;
    }

}
