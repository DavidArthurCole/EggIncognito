@using System.Text.Json
@rendermode @(RenderMode.InteractiveServer)

<section class="panel mb-4">
    <div class="admin-panel-head">
        <h2 class="admin-panel-title">API keys</h2>
        <span class="text-muted text-xs">@_rows.Count total</span>
    </div>
    @if (_rows.Count == 0) {
        <p class="text-muted text-sm m-0">No API keys.</p>
    } else {
        <div class="reg-wrap">
            <table class="reg-table">
                <thead>
                <tr>
                    <th>Owner</th><th>Name</th><th>Prefix</th><th>Last used</th><th>Requests</th><th>Status</th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var k in _rows) {
                    <tr>
                        <td class="mono text-xs">@k.OwnerUserId</td>
                        <td class="font-medium">@k.Name</td>
                        <td class="mono text-xs">@k.Prefix</td>
                        <td class="text-muted text-xs">@(k.LastUsedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "never")</td>
                        <td class="mono text-xs">@k.RequestCount</td>
                        <td>
                            <span class="@(k.Revoked ? "text-muted" : "text-green-400")">@(k.Revoked ? "revoked" : "active")</span>
                        </td>
                        <td>
                            <div class="flex gap-1 justify-end">
                                @if (!k.Revoked) {
                                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="() => Revoke(k.Id)">Revoke</button>
                                }
                                <button type="button" class="btn-mini btn-danger" disabled="@_busy" @onclick="() => Delete(k.Id)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    @if (_msg is not null) {
        <p class="text-xs text-muted mt-2 mb-0">@_msg</p>
    }
</section>

@code {
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    List<Row> _rows = [];
    bool _busy;
    string? _msg;

    protected override async Task OnInitializedAsync() {
        await Load();
    }

    async Task Load() {
        if (ClientFactory is null) return;
        try {
            _rows = await ClientFactory().GetFromJsonAsync<List<Row>>("/api/admin/api-keys", JsonOpts) ?? [];
        }
        catch {
        }
    }

    async Task Revoke(long id) {
        if (ClientFactory is null) return;
        _busy = true;
        _msg = null;
        try {
            var res = await ClientFactory().DeleteAsync($"/api/admin/api-keys/{id}");
            _msg = res.IsSuccessStatusCode ? $"revoked key {id}" : $"revoke failed ({(int)res.StatusCode})";
            await Load();
        }
        catch (Exception ex) {
            _msg = $"revoke error: {ex.Message}";
        }

        _busy = false;
    }

    async Task Delete(long id) {
        if (ClientFactory is null) return;
        _busy = true;
        _msg = null;
        try {
            var res = await ClientFactory().DeleteAsync($"/api/admin/api-keys/{id}/purge");
            _msg = res.IsSuccessStatusCode ? $"deleted key {id}" : $"delete failed ({(int)res.StatusCode})";
            await Load();
        }
        catch (Exception ex) {
            _msg = $"delete error: {ex.Message}";
        }

        _busy = false;
    }

    record Row(
        long Id,
        string Name,
        string Prefix,
        string OwnerUserId,
        DateTimeOffset CreatedAt,
        DateTimeOffset? LastUsedAt,
        long RequestCount,
        bool Revoked,
        DateTimeOffset? RevokedAt);

}
