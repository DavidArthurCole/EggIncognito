@* Admin oversight of active capture sessions: list + a kill button per row, polling /api/admin/sessions. *@
@rendermode @(RenderMode.InteractiveServer)
@using System.Net.Http.Json
@using EggIncognito.Components.Shared
@implements IDisposable

<section class="panel mb-4">
  <div class="admin-panel-head">
    <h2 class="admin-panel-title">Capture sessions</h2>
    <span class="text-muted text-xs">@_rows.Count active</span>
  </div>
  @if (_rows.Count == 0)
  {
    <p class="text-muted text-sm m-0">No active capture sessions.</p>
  }
  else
  {
    <div class="reg-wrap">
      <table class="reg-table">
        <thead>
          <tr><th>Session</th><th>Kind</th><th>State</th><th>Port</th><th>Flows</th><th>Conns</th><th>Devices</th><th>Decrypt</th><th></th></tr>
        </thead>
        <tbody>
          @foreach (var s in _rows)
          {
            <tr>
              <td class="mono text-xs">@Label(s.Key)</td>
              <td><span class="sess-kind @KindClass(s.Kind)">@s.Kind</span></td>
              <td><span class="@(s.Running ? "text-green-400" : "text-muted")">@(s.Running ? "running" : "stopped")</span></td>
              <td class="mono text-xs">@s.Port</td>
              <td class="mono text-xs">@s.Flows</td>
              <td class="mono text-xs">@s.Connections</td>
              <td class="mono text-xs">@s.Devices</td>
              <td class="mono text-xs">@s.DecryptOk ok / <span class="@(s.DecryptErr > 0 ? "text-err" : "")">@s.DecryptErr err</span></td>
              <td>
                @if (s.Killable)
                {
                  <button type="button" class="btn-mini btn-danger" disabled="@_busy" @onclick="() => Kill(s.Key)">Kill</button>
                }
                else
                {
                  <span class="text-muted text-xs" title="host-managed capture, not killable">host</span>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  @if (_msg is not null) { <p class="text-xs text-muted mt-2 mb-0">@_msg</p> }
</section>

@code {
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }

    static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new(System.Text.Json.JsonSerializerDefaults.Web);

    List<Row> _rows = [];
    bool _busy;
    string? _msg;
    System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync() => await Load();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _timer = new System.Threading.Timer(async _ => await InvokeAsync(async () => { await Load(); StateHasChanged(); }),
                null, TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
    }

    async Task Load()
    {
        if (ClientFactory is null) return;
        try { _rows = await ClientFactory().GetFromJsonAsync<List<Row>>("/api/admin/sessions", JsonOpts) ?? []; }
        catch { }
    }

    async Task Kill(string key)
    {
        if (ClientFactory is null) return;
        _busy = true; _msg = null;
        try
        {
            var res = await ClientFactory().DeleteAsync($"/api/admin/sessions/{Uri.EscapeDataString(key)}");
            _msg = res.IsSuccessStatusCode ? $"killed {Label(key)}" : $"kill failed ({(int)res.StatusCode})";
            await Load();
        }
        catch (Exception ex) { _msg = $"kill error: {ex.Message}"; }
        _busy = false;
    }

   
   
    static string Label(string key) => key == "__local" ? "local (anonymous)" : key;

   
   
    static string KindClass(string kind) => kind switch
    {
        "user" => "sess-kind-user",
        "device" => "sess-kind-device",
        _ => "sess-kind-local",
    };

    public void Dispose() => _timer?.Dispose();

    record Row(string Key, string Kind, bool Killable, bool Running, int Port, long Flows, long Connections, int Devices, long DecryptOk, int DecryptErr);
}
