@* Admin oversight of active capture sessions: list + a kill button per row, polling /api/admin/sessions. *@
@rendermode @(RenderMode.InteractiveServer)
@inherits BrowserApiComponentBase
@using EggIncognito.Models.AdminUi
@implements IDisposable

<AdminCard Title="Capture sessions" Stat="@($"{_rows.Count} active")">
    <Summary>
        @if (_rows.Count == 0) {
            <p class="text-muted text-sm m-0">No active capture sessions.</p>
        } else {
            <p class="text-muted text-xs m-0">@((MarkupString)KindBreakdown())</p>
            @foreach (var s in _rows.Take(4)) {
                <div class="text-xs text-muted">@Label(s.Key) &middot; <span class="sess-kind @KindClass(s.Kind)">@s.Kind</span> &middot; @(s.Running ? "running" : "stopped")</div>
            }
        }
    </Summary>
    <Detail>
        <div class="reg-wrap">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Session</th><th>Kind</th><th>State</th><th>Port</th><th>Flows</th><th>Conns</th><th>Devices</th><th>Decrypt</th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var s in _rows) {
                    <tr>
                        <td class="mono text-xs">@Label(s.Key)</td>
                        <td>
                            <span class="sess-kind @KindClass(s.Kind)">@s.Kind</span>
                        </td>
                        <td>
                            <span class="@(s.Running ? "text-green-400" : "text-muted")">@(s.Running ? "running" : "stopped")</span>
                        </td>
                        <td class="mono text-xs">@s.Port</td>
                        <td class="mono text-xs">@s.Flows</td>
                        <td class="mono text-xs">@s.Connections</td>
                        <td class="mono text-xs">@s.Devices</td>
                        <td class="mono text-xs">@s.DecryptOk ok / <span class="@(s.DecryptErr > 0 ? "text-err" : "")">@s.DecryptErr err</span></td>
                        <td>
                            @if (s.Kind == "device") {
                                <a class="btn-mini no-underline" href="/capture/device/@DeviceId(s.Key)">View</a>
                            } else if (s.Killable) {
                                <button type="button" class="btn-mini btn-danger" disabled="@_busy" @onclick="() => Kill(s.Key)">Kill</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (_msg is not null) {
            <StatusNote>@_msg</StatusNote>
        }
    </Detail>
</AdminCard>

@code {
    List<SessionRow> _rows = [];
    bool _busy;
    string? _msg;
    Timer? _timer;

    protected override async Task OnApiReadyAsync() {
        await Load();
        _timer = ComponentTimers.Every(TimeSpan.FromSeconds(15), () => InvokeAsync(async () => {
            if (!await Vis.IsVisibleAsync()) return;
            await Load();
            StateHasChanged();
        }));
    }

    PageVisibility? _vis;

    PageVisibility Vis => _vis ??= new PageVisibility(Js, Env);

    string KindBreakdown() {
        var user = _rows.Count(r => r.Kind == "user");
        var device = _rows.Count(r => r.Kind == "device");
        var local = _rows.Count - user - device;
        var parts = new List<string>();
        if (user > 0) parts.Add($"{user} user");
        if (device > 0) parts.Add($"{device} device");
        if (local > 0) parts.Add($"{local} local");
        return string.Join(" &middot; ", parts);
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/sessions");
        if (res.Ok) _rows = res.Json<List<SessionRow>>() ?? [];
    }

    async Task Kill(string key) {
        if (Api is null) return;
        _busy = true;
        _msg = null;
        var res = await Api.DeleteAsync($"/api/admin/sessions/{Uri.EscapeDataString(key)}");
        _msg = res.Ok ? $"killed {Label(key)}" : $"kill failed: {res.Describe()}";
        await Load();
        _busy = false;
    }

    static string Label(string key) {
        return key == "__local" ? "local (anonymous)" : key;
    }

    static string DeviceId(string key) {
        return key.StartsWith("device:", StringComparison.Ordinal) ? key["device:".Length..] : key;
    }

    static string KindClass(string kind) {
        return kind switch {
            "user" => "sess-kind-user",
            "device" => "sess-kind-device",
            _ => "sess-kind-local"
        };
    }

    public void Dispose() {
        _timer?.Dispose();
        _ = _vis?.DisposeAsync();
    }

}
