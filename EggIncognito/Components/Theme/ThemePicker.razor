@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IJSRuntime Js
@inject IWebHostEnvironment HostEnv
@using System.Text
@using System.Text.Json
@using EggIdentity.Styles.Theming
@using EggIncognito.Models.Theme
@using EggIncognito.Services.Theme
@implements IAsyncDisposable

<div class="theme-picker">
    <div class="sub-section-head">Appearance</div>
    @if (!User.IsAuthenticated) {
        <p class="text-muted text-xs m-0">Pick a preset to retheme this browser. Logging in saves themes and syncs them across devices.</p>
    }
    <div class="theme-preset-grid">
        @foreach (var preset in ThemePresets.All) {
            <button type="button" class="theme-preset-card" style="border-color: @AccentCss(preset)" @onclick="() => ApplyPresetAsync(preset)">
                <span style="color: @AccentCss(preset)">@preset.Name</span>
            </button>
        }
    </div>
    @StatusFor(ThemeStatusSource.Presets)
    @if (User.IsAuthenticated) {
        <label class="theme-field">
            <span>My themes</span>
            <select class="reg-filter-input w-auto" value="@_activeSlug" @onchange="OnThemeSelectedAsync">
                <option value="">Default (no theme)</option>
                @foreach (var t in _themes) {
                    <option value="@t.Slug">@t.Name</option>
                }
            </select>
        </label>
        @StatusFor(ThemeStatusSource.Themes)
    }
    <div class="theme-picker-actions">
        <button type="button" class="btn-mini" @onclick="() => _wbOpen = true">Open theme workbench</button>
        @if (!User.IsAuthenticated) {
            <button type="button" class="btn-mini" @onclick="ResetLocalAsync">Reset</button>
        }
    </div>
    @StatusFor(ThemeStatusSource.Actions)
</div>

<ThemeWorkbenchModal Open="_wbOpen" OnClose="CloseWorkbenchAsync"/>

@code {

    readonly List<ThemeRow> _themes = [];
    string _activeSlug = "";
    bool _wbOpen;
    ThemeStatus? _status;
    IJSObjectReference? _prefs;
    IJSObjectReference? _preview;

    protected override async Task OnInitializedAsync() {
        await LoadThemesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            try {
                _prefs = await Js.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(HostEnv, "./interop/uiPrefs.js"));
                _preview = await Js.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(HostEnv, "./interop/themePreview.js"));
            }
            catch (JSDisconnectedException) {
            }
            catch (JSException) {
            }
        }
    }

    async Task LoadThemesAsync() {
        _themes.Clear();
        _activeSlug = "";
        if (!User.IsAuthenticated) return;
        try {
            using var client = Client();
            var resp = await client.GetFromJsonAsync<ThemeListResponse>("/api/theme");
            foreach (var row in resp?.Themes ?? []) {
                _themes.Add(new ThemeRow(row.Slug ?? "", row.Name ?? "", row.IsActive));
                if (row.IsActive) _activeSlug = row.Slug ?? "";
            }
        }
        catch (HttpRequestException) {
        }
        catch (JsonException) {
        }
    }

    async Task ApplyPresetAsync(ThemeModel preset) {
        if (User.IsAuthenticated) {
            using var client = Client();
            var slug = "preset-" + preset.Slug;
            var model = preset with { Slug = slug };
            var save = await client.PutAsync($"/api/theme/{slug}",
                new StringContent(model.ToJson(), Encoding.UTF8, "application/json"));
            if (!save.IsSuccessStatusCode) {
                SetStatus("could not save the preset", StatusNoteKind.Error, ThemeStatusSource.Presets);
                return;
            }

            var activate = await client.PostAsync($"/api/theme/{slug}/activate", null);
            if (activate.IsSuccessStatusCode) {
                SetStatus($"{preset.Name} active; reload to apply everywhere", StatusNoteKind.Ok, ThemeStatusSource.Presets, true);
                await LoadThemesAsync();
            } else SetStatus("preset failed validation", StatusNoteKind.Error, ThemeStatusSource.Presets);

            return;
        }

        if (_prefs is null || _preview is null) return;
        await _prefs.InvokeVoidAsync("set", "theme.model", preset.ToJson());
        await _prefs.InvokeVoidAsync("set", "theme.active", "1");
        await _preview.InvokeVoidAsync("applyTokens", TokenCssMap(preset));
        SetStatus($"{preset.Name} applied in this browser", StatusNoteKind.Ok, ThemeStatusSource.Presets);
    }

    async Task OnThemeSelectedAsync(ChangeEventArgs e) {
        var slug = e.Value?.ToString() ?? "";
        using var client = Client();
        if (slug.Length == 0) {
            var resp = await client.PostAsync("/api/theme/deactivate", null);
            if (resp.IsSuccessStatusCode) SetStatus("theme off; reload to apply", StatusNoteKind.Ok, ThemeStatusSource.Themes, true);
            else SetStatus("could not deactivate", StatusNoteKind.Error, ThemeStatusSource.Themes);
        } else {
            var resp = await client.PostAsync($"/api/theme/{Uri.EscapeDataString(slug)}/activate", null);
            if (resp.IsSuccessStatusCode) SetStatus($"{slug} active; reload to apply", StatusNoteKind.Ok, ThemeStatusSource.Themes, true);
            else SetStatus("activation failed contrast checks", StatusNoteKind.Error, ThemeStatusSource.Themes);
        }

        await LoadThemesAsync();
    }

    async Task ResetLocalAsync() {
        if (_prefs is null || _preview is null) return;
        await _prefs.InvokeVoidAsync("remove", "theme.model");
        await _prefs.InvokeVoidAsync("remove", "theme.active");
        await _preview.InvokeVoidAsync("clearTokens", ThemeTokens.Settable);
        SetStatus("reset to the shipped default", StatusNoteKind.Ok, ThemeStatusSource.Actions);
    }

    async Task CloseWorkbenchAsync() {
        _wbOpen = false;
        await LoadThemesAsync();
    }

    static Dictionary<string, string> TokenCssMap(ThemeModel model) {
        var map = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var token in ThemeTokens.Settable) map[token] = model.TokenOrDefault(token).ToCss();
        return map;
    }

    static string AccentCss(ThemeModel preset) {
        return preset.TokenOrDefault("accent").ToCss();
    }

    void SetStatus(string message, StatusNoteKind kind, ThemeStatusSource source, bool needsReload = false) {
        _status = new ThemeStatus(message, kind, source, needsReload);
    }

    void ClearStatus() {
        _status = null;
    }

    RenderFragment? StatusFor(ThemeStatusSource source) {
        if (_status is not { } s || s.Source != source) return null;
        return @<StatusNote Severity="@s.Kind" OnDismiss="ClearStatus">
                   <ChildContent>@s.Message</ChildContent>
                   <Actions>
                       @if (s.NeedsReload) {
                           <ReloadButton/>
                       }
                   </Actions>
               </StatusNote>;
    }

    public async ValueTask DisposeAsync() {
        foreach (var module in new[] { _prefs, _preview }) {
            if (module is not null) {
                try {
                    await module.DisposeAsync();
                }
                catch (JSDisconnectedException) {
                }
            }
        }
    }

}
