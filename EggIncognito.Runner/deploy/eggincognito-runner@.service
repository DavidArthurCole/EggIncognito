[Unit]
Description=EggIncognito device runner (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eggfarm
Group=eggfarm
WorkingDirectory=/opt/eggincognito-runner
ExecStart=/opt/eggincognito-runner/EggIncognito.Runner
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/opt/platform-tools
Environment=PLATFORM=%i
Environment=PACKAGE=com.auxbrain.egginc
Environment=ADB_TARGET=127.0.0.1:5555
Environment=STATE_FILE=/opt/eggincognito-runner/state-%i.json
Environment=APK_STASH_DIR=/opt/eggincognito-runner/apks
Environment=POLL_INTERVAL=300
Environment=EXTRACTOR_REPO=/opt/eggincognito-runner/proto-extract
Environment=EXTRACTOR_PYTHON=/opt/eggincognito-runner/proto-extract/.venv/bin/python3
Environment=RUNNER_TRIGGER_URLS=http://127.0.0.1:5055
EnvironmentFile=/etc/eggincognito-runner/secret.env
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eggincognito-runner
PrivateTmp=false

[Install]
WantedBy=multi-user.target
